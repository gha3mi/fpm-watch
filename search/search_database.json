d-target command, accept sampled fingerprints,\nand refresh dependency membership before running. A changed target mapping\nor failed refresh falls back to the original command. Existing baselines survive\nthe refresh so edits during synchronous commands are detected on the next poll. Optional rescans refresh the graph and run the full command if paths or\nfingerprints changed. A pending manifest refresh is retried on later edits\nor rescans. Stop-file checks occur between commands and around waits. Type Bound watcher_t Arguments Type Intent Optional Attributes Name class( watcher_t ), intent(inout) :: self Calls proc~~watcher_run~~CallsGraph proc~watcher_run watcher_t%watcher_run exists exists proc~watcher_run->exists join_path join_path proc~watcher_run->join_path proc~accept_changes accept_changes proc~watcher_run->proc~accept_changes proc~any_configuration_changed any_configuration_changed proc~watcher_run->proc~any_configuration_changed proc~build_run_command build_run_command proc~watcher_run->proc~build_run_command proc~handle_manifest_change handle_manifest_change proc~watcher_run->proc~handle_manifest_change proc~log_event log_event proc~watcher_run->proc~log_event proc~log_string log_string proc~watcher_run->proc~log_string proc~rebuild_watch_list rebuild_watch_list proc~watcher_run->proc~rebuild_watch_list proc~report_changes report_changes proc~watcher_run->proc~report_changes proc~run_once run_once proc~watcher_run->proc~run_once proc~scan_changes scan_changes proc~watcher_run->proc~scan_changes proc~sleep_seconds sleep_seconds proc~watcher_run->proc~sleep_seconds proc~termination_requested termination_requested proc~watcher_run->proc~termination_requested basename basename proc~any_configuration_changed->basename proc~inject_names_into_cmd inject_names_into_cmd proc~build_run_command->proc~inject_names_into_cmd proc~quote_arg quote_arg proc~build_run_command->proc~quote_arg proc~handle_manifest_change->proc~log_event proc~handle_manifest_change->proc~r