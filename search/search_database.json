. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Present watcher startup and file-list events through the shared logger. module watch_banner use watch_types , only : watch_opts_t use watch_util , only : ftoa , trim_or_default , join_csv use watch_log , only : log_event , log_int , log_real , log_string , log_strings , log_bool use fpm_strings , only : string_t , str use fpm_command_line , only : fpm_build_settings , fpm_test_settings , fpm_run_settings implicit none private public print_banner , print_file_list , print_configuration contains !> Emit a startup summary and optional configuration/timing records. !! !! `watch.ready` uses normal verbosity; configuration/timings require level 1. !! Read `mode` from typed settings. Unallocated files count as zero; time !! inputs are seconds and event timing fields are milliseconds. Quiet mode !! suppresses these records. File-list output is handled separately by the engine. subroutine print_banner ( full_cmdline , settings , w , files , build_secs , roots_count , secs_model , secs_targets , secs_watch ) character ( len =* ), intent ( in ) :: full_cmdline class ( fpm_build_settings ), intent ( in ) :: settings type ( watch_opts_t ), intent ( in ) :: w type ( string_t ), allocatable , intent ( in ) :: files (:) real , intent ( in ) :: build_secs , secs_model , secs_targets , secs_watch integer , intent ( in ) :: roots_count integer :: nfiles character ( len = :), allocatable :: mode , message nfiles = 0 if ( allocated ( files )) nfiles = size ( files ) mode = command_mode ( settings ) message = \"Watching \" // str ( nfiles ) // \" files (\" // mode // \")\" if ( w % once ) then message = message // \"; one-shot\" else message = message // \"; Ctrl+C or touch .fpm-watch.stop to stop\" end if call log_event ( \"info\" , \"watch.ready\" , message , & [ log_int ( \"file_count\" , nfiles ), log_int ( \"root_count\" , roots_count ), & log_string ( \"mode\" , mode ), log_string ( \"command\" , full_cmdline ), log_bool ( \"once\" , w % once )]) call print_configuration ( settings , w ) call log_event ( \"info\" , \"watch.initialized\" , \"Watch list initialized in \" // ftoa ( build_secs ) // \"s\" , & [ log_real ( \"duration_ms\" , build_secs * 100 0.0 ), log_real ( \"model_ms\" , secs_model * 100 0.0 ), & log_real ( \"targets_ms\" , secs_targets * 100 0.0 ), log_real ( \"watch_list_ms\" , secs_watch * 100 0.0 )], verbosity = 1 ) end subroutine print_banner !> Report effective model/watch settings at verbosity 1 after startup or refresh. !! !! Features are a comma-separated fpm feature string; include/ignore attributes !! are arrays. Poll/debounce fields are milliseconds and rescan is seconds. subroutine print_configuration ( settings , w ) class ( fpm_build_settings ), intent ( in ) :: settings type ( watch_opts_t ), intent ( in ) :: w character ( len = :), allocatable :: features , profile , compiler , build_dir profile = trim_or_default ( settings % profile , \"default\" ) compiler = trim_or_default ( settings % compiler , \"(auto)\" ) build_dir = trim_or_default ( settings % build_dir , \"build\" ) features = \"(none)\" if ( allocated ( settings % features )) features = join_csv ( settings % features , \"(none)\" ) call log_event ( \"info\" , \"watch.configuration\" , & \"Compiler \" // compiler // \"; profile \" // profile // \"; build directory \" // build_dir // & \"; features \" // features , & [ log_string ( \"compiler\" , compiler ), log_string ( \"profile\" , profile ), log_string ( \"build_dir\" , build_dir ), & log_string ( \"features\" , features ), log_bool ( \"prune\" , settings % prune ), log_bool ( \"deps\" , w % watch_deps ), & log_bool ( \"silent_fpm\" , w % silent_fpm ), & log_bool ( \"run_on_start\" , w % run_on_start ), log_real ( \"poll_ms\" , w % poll * 100 0.0 ), & log_real ( \"debounce_ms\" , w % debounce * 100 0.0 ), log_real ( \"rescan_s\" , w % rescan ), & log_strings ( \"ignore\" , w % ignore ), log_strings ( \"include\" , w % include )], verbosity = 1 ) end subroutine print_configuration !> Emit up to 200 `watch.file` records when verbosity is at least 2. !! !! Larger lists produce an omitted-count record. Unallocated lists are ignored. !! The engine calls this at startup only when `print_files_once` is enabled, !! and after successful refreshes whenever verbosity is at least 2. subroutine print_file_list ( files , w ) type ( string_t ), allocatable , intent ( in ) :: files (:) type ( watch_opts_t ), intent ( in ) :: w integer :: i integer , parameter :: cap = 200 if ( w % verbosity < 2 ) return if (. not . allocated ( files )) return do i = 1 , min ( size ( files ), cap ) call log_event ( \"info\" , \"watch.file\" , files ( i )% s , [ log_string ( \"path\" , files ( i )% s )], verbosity = 2 ) end do if ( size ( files ) > cap ) then call log_event ( \"info\" , \"watch.files_truncated\" , str ( size ( files ) - cap ) // \" more watched files\" , & [ log_int ( \"omitted_count\" , size ( files ) - cap )], verbosity = 2 ) end if end subroutine print_file_list !> Describe the selected fpm command. pure function command_mode ( settings ) result ( mode ) class ( fpm_build_settings ), intent ( in ) :: settings character ( len = :), allocatable :: mode select type ( s => settings ) type is ( fpm_test_settings ) mode = \"test\" type is ( fpm_run_settings ) mode = \"run\" if ( s % example ) mode = \"run --example\" class default mode = \"build\" end select end function command_mode end module watch_banner","tags":"","url":"sourcefile/watch_banner.f90.html"},{"title":"watch_graph_worker.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_graph_worker.f90~~EfferentGraph sourcefile~watch_graph_worker.f90 watch_graph_worker.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_fpm_graph.f90 watch_fpm_graph.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_fpm_graph.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_log.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_platform.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_types.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_util.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_log.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_platform.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_types.f90 sourcefile~watch_filter.f90 watch_filter.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_filter.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_util.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 sourcefile~watch_filter.f90->sourcefile~watch_util.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_graph_worker.f90~~AfferentGraph sourcefile~watch_graph_worker.f90 watch_graph_worker.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_graph_worker.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Isolate fpm model construction in a short-lived worker process. !! !! fpm owns resources that cannot all be released through its public model API. !! Each refresh therefore runs in the actual watcher executable and returns one !! validated TOML snapshot. A private workspace also contains fpm probe files; !! the parent removes the whole workspace after success, failure, or cancellation. Byte strings use hexadecimal encoding so native paths !! survive control bytes and invalid UTF-8 without relying on TOML string encoding. module watch_graph_worker use , intrinsic :: iso_fortran_env , only : int64 use , intrinsic :: ieee_arithmetic , only : ieee_is_finite use watch_types , only : watch_config_t , root_info_t use watch_cmdline , only : get_arg , quote_arg use watch_platform , only : create_temp_directory , remove_temp_directory , set_temp_directory , execute_command use watch_fpm_graph , only : compute_watch_files_from_settings use watch_log , only : log_event use fpm_strings , only : string_t , str use fpm_error , only : error_t , fatal_error use fpm_os , only : change_directory use fpm_filesystem , only : join_path , dirname use fpm_toml , only : toml_table , toml_array , toml_load , toml_error , new_table , add_array , len use tomlf , only : get_value , set_value , toml_dump , toml_stat implicit none private public compute_watch_snapshot , run_graph_worker , read_graph_response integer , parameter :: RESPONSE_VERSION = 1 contains !> Launch the watcher itself with original argv and accept only a complete response. subroutine compute_watch_snapshot ( cfg , files , file_mask , roots , manifest_key , & build_secs , secs_model , secs_targets , secs_watch , error ) type ( watch_config_t ), intent ( inout ) :: cfg type ( string_t ), allocatable , intent ( out ) :: files (:) integer ( int64 ), allocatable , intent ( out ) :: file_mask (:) type ( root_info_t ), allocatable , intent ( out ) :: roots (:) integer ( int64 ), intent ( out ) :: manifest_key real , intent ( out ) :: build_secs , secs_model , secs_targets , secs_watch type ( error_t ), allocatable , intent ( out ) :: error character ( len = :), allocatable :: workspace , response_path , command , format integer :: i , status manifest_key = 0_int64 build_secs = 0.0 secs_model = 0.0 secs_targets = 0.0 secs_watch = 0.0 call create_temp_directory ( workspace , error ) if ( allocated ( error )) return response_path = join_path ( workspace , \"response.toml\" ) format = \"text\" if ( allocated ( cfg % w % log_format )) format = cfg % w % log_format command = quote_arg ( get_arg ( 0 )) // \" --watch-graph-worker \" // quote_arg ( response_path ) // \" \" // quote_arg ( format ) do i = 1 , command_argument_count () command = command // \" \" // quote_arg ( get_arg ( i )) end do call execute_command ( command , status ) if ( status == 0 ) then call read_graph_response ( response_path , files , file_mask , roots , manifest_key , & build_secs , secs_model , secs_targets , secs_watch , error ) else call fatal_error ( error , \"Watch graph worker exited with status \" // str ( status )) end if call remove_temp_directory ( workspace ) end subroutine compute_watch_snapshot !> Change to the selected project, compute its graph, and write a worker response. subroutine run_graph_worker ( cfg , response_path ) type ( watch_config_t ), intent ( inout ) :: cfg character ( len =* ), intent ( in ) :: response_path type ( string_t ), allocatable :: files (:) integer ( int64 ), allocatable :: file_mask (:) type ( root_info_t ), allocatable :: roots (:) type ( error_t ), allocatable :: error , write_error integer ( int64 ) :: manifest_key real :: build_secs , secs_model , secs_targets , secs_watch manifest_key = 0_int64 build_secs = 0.0 secs_model = 0.0 secs_targets = 0.0 secs_watch = 0.0 call set_temp_directory ( dirname ( response_path ), error ) if (. not . allocated ( error )) then if ( allocated ( cfg % project_dir )) then call change_directory ( cfg % project_dir , error ) else call fatal_error ( error , \"Watch graph worker has no project directory\" ) end if end if if (. not . allocated ( error )) then call compute_watch_files_from_settings ( cfg % settings , cfg % w , files , file_mask , roots , manifest_key , & build_secs , secs_model , secs_targets , secs_watch , error , & metadata_files = cfg % response_files ) end if call write_graph_response ( response_path , files , file_mask , roots , manifest_key , & [ build_secs , secs_model , secs_targets , secs_watch ], error , write_error ) if ( allocated ( write_error )) then call log_event ( \"error\" , \"graph.worker_failed\" , write_error % message ) stop 1 end if end subroutine run_graph_worker !> Write one versioned TOML response using fpm's TOML dependency. subroutine write_graph_response ( path , files , file_mask , roots , manifest_key , timings , graph_error , error ) character ( len =* ), intent ( in ) :: path type ( string_t ), allocatable , intent ( in ) :: files (:) integer ( int64 ), allocatable , intent ( in ) :: file_mask (:) type ( root_info_t ), allocatable , intent ( in ) :: roots (:) integer ( int64 ), intent ( in ) :: manifest_key real , intent ( in ) :: timings ( 4 ) type ( error_t ), allocatable , intent ( in ) :: graph_error type ( error_t ), allocatable , intent ( out ) :: error type ( toml_table ) :: table type ( toml_array ), pointer :: array type ( toml_error ), allocatable :: serialization_error integer :: i , unit , status , close_status character ( len = 512 ) :: message call new_table ( table ) call set_value ( table , \"version\" , RESPONSE_VERSION ) call set_value ( table , \"success\" , . not . allocated ( graph_error )) if ( allocated ( graph_error )) then call set_value ( table , \"error\" , encode_bytes ( graph_error % message )) else call set_value ( table , \"manifest-key\" , manifest_key ) call add_array ( table , \"files\" , array ) do i = 1 , size ( files ) call set_value ( array , i , encode_bytes ( files ( i )% s )) end do call add_array ( table , \"file-masks\" , array ) do i = 1 , size ( file_mask ) call set_value ( array , i , file_mask ( i )) end do call add_array ( table , \"root-names\" , array ) do i = 1 , size ( roots ) call set_value ( array , i , encode_bytes ( roots ( i )% name )) end do call add_array ( table , \"root-masks\" , array ) do i = 1 , size ( roots ) call set_value ( array , i , roots ( i )% mask ) end do call add_array ( table , \"timings\" , array ) do i = 1 , size ( timings ) call set_value ( array , i , timings ( i )) end do end if open ( newunit = unit , file = path , status = \"new\" , action = \"write\" , iostat = status , iomsg = message ) if ( status /= 0 ) then call fatal_error ( error , \"Cannot write watch graph response: \" // trim ( message )) return end if call toml_dump ( table , unit , serialization_error ) close ( unit , iostat = close_status , iomsg = message ) if ( allocated ( serialization_error )) then call fatal_error ( error , \"Cannot serialize watch graph response: \" // serialization_error % message ) else if ( close_status /= 0 ) then call fatal_error ( error , \"Cannot close watch graph response: \" // trim ( message )) end if end subroutine write_graph_response !> Validate version, fields, alignment, masks, paths, and timings before accepting a response. subroutine read_graph_response ( path , files , file_mask , roots , manifest_key , & build_secs , secs_model , secs_targets , secs_watch , error ) character ( len =* ), intent ( in ) :: path type ( string_t ), allocatable , intent ( out ) :: files (:) integer ( int64 ), allocatable , intent ( out ) :: file_mask (:) type ( root_info_t ), allocatable , intent ( out ) :: roots (:) integer ( int64 ), intent ( out ) :: manifest_key real , intent ( out ) :: build_secs , secs_model , secs_targets , secs_watch type ( error_t ), allocatable , intent ( out ) :: error type ( toml_table ), allocatable :: table type ( toml_array ), pointer :: paths , masks , names , root_masks , times type ( toml_error ), allocatable :: parse_error type ( string_t ), allocatable :: candidate_files (:) integer ( int64 ), allocatable :: candidate_masks (:) type ( root_info_t ), allocatable :: candidate_roots (:) character ( len = :), allocatable :: encoded , decoded character ( len = 512 ) :: message integer :: unit , status , version , i , nfiles , nroots integer ( int64 ) :: key , allowed_mask real :: timings ( 4 ) logical :: success , valid manifest_key = 0_int64 build_secs = 0.0 secs_model = 0.0 secs_targets = 0.0 secs_watch = 0.0 open ( newunit = unit , file = path , status = \"old\" , action = \"read\" , iostat = status , iomsg = message ) if ( status /= 0 ) then call fatal_error ( error , \"Cannot read watch graph response: \" // trim ( message )) return end if call toml_load ( table , unit , error = parse_error ) close ( unit ) if ( allocated ( parse_error )) then call invalid_response ( error , \"invalid TOML\" ) return end if if (. not . allocated ( table )) then call invalid_response ( error , \"empty response\" ) return end if call get_value ( table , \"version\" , version , stat = status ) if ( status /= toml_stat % success ) then call invalid_response ( error , \"missing version\" ) return end if if ( version /= RESPONSE_VERSION ) then call invalid_response ( error , \"unsupported version\" ) return end if call get_value ( table , \"success\" , success , stat = status ) if ( status /= toml_stat % success ) then call invalid_response ( error , \"missing success state\" ) return end if if (. not . success ) then call get_value ( table , \"error\" , encoded , stat = status ) if ( status /= toml_stat % success . or . . not . allocated ( encoded )) then call invalid_response ( error , \"missing error message\" ) return end if call decode_bytes ( encoded , decoded , valid ) if (. not . valid . or . len ( decoded ) == 0 ) then call invalid_response ( error , \"invalid error message\" ) else call fatal_error ( error , decoded ) end if return end if call get_value ( table , \"manifest-key\" , key , stat = status ) if ( status /= toml_stat % success ) then call invalid_response ( error , \"missing manifest key\" ) return end if call get_value ( table , \"files\" , paths , requested = . false .) call get_value ( table , \"file-masks\" , masks , requested = . false .) call get_value ( table , \"root-names\" , names , requested = . false .) call get_value ( table , \"root-masks\" , root_masks , requested = . false .) call get_value ( table , \"timings\" , times , requested = . false .) if (. not . associated ( paths ) . or . . not . associated ( masks ) . or . . not . associated ( names ) . or . & . not . associated ( root_masks ) . or . . not . associated ( times )) then call invalid_response ( error , \"missing snapshot arrays\" ) return end if nfiles = len ( paths ) nroots = len ( names ) if ( len ( masks ) /= nfiles . or . len ( root_masks ) /= nroots . or . len ( times ) /= 4 . or . nroots > 64 ) then call invalid_response ( error , \"misaligned snapshot arrays\" ) return end if allocate ( candidate_files ( nfiles ), candidate_masks ( nfiles ), candidate_roots ( nroots )) allowed_mask = 0_int64 do i = 1 , nroots call get_value ( names , i , encoded , stat = status ) if ( status /= toml_stat % success ) exit call decode_bytes ( encoded , candidate_roots ( i )% name , valid ) if (. not . valid ) exit if ( len ( candidate_roots ( i )% name ) == 0 ) exit call get_value ( root_masks , i , candidate_roots ( i )% mask , stat = status ) if ( status /= toml_stat % success ) exit if ( popcnt ( candidate_roots ( i )% mask ) /= 1 ) exit if ( iand ( allowed_mask , candidate_roots ( i )% mask ) /= 0_int64 ) exit allowed_mask = ior ( allowed_mask , candidate_roots ( i )% mask ) end do if ( i <= nroots ) then call invalid_response ( error , \"invalid root entry\" ) return end if do i = 1 , nfiles call get_value ( paths , i , encoded , stat = status ) if ( status /= toml_stat % success ) exit call decode_bytes ( encoded , candidate_files ( i )% s , valid ) if (. not . valid ) exit if ( len ( candidate_files ( i )% s ) == 0 ) exit call get_value ( masks , i , candidate_masks ( i ), stat = status ) if ( status /= toml_stat % success ) exit if ( iand ( candidate_masks ( i ), not ( allowed_mask )) /= 0_int64 ) exit end do if ( i <= nfiles ) then call invalid_response ( error , \"invalid file entry\" ) return end if do i = 1 , 4 call get_value ( times , i , timings ( i ), stat = status ) if ( status /= toml_stat % success ) exit if (. not . ieee_is_finite ( timings ( i ))) exit if ( timings ( i ) < 0.0 ) exit end do if ( i <= 4 ) then call invalid_response ( error , \"invalid timing entry\" ) return end if call move_alloc ( candidate_files , files ) call move_alloc ( candidate_masks , file_mask ) call move_alloc ( candidate_roots , roots ) manifest_key = key build_secs = timings ( 1 ) secs_model = timings ( 2 ) secs_targets = timings ( 3 ) secs_watch = timings ( 4 ) end subroutine read_graph_response !> Report malformed worker data without accepting a partial snapshot. subroutine invalid_response ( error , detail ) type ( error_t ), allocatable , intent ( out ) :: error character ( len =* ), intent ( in ) :: detail call fatal_error ( error , \"Invalid watch graph worker response: \" // detail ) end subroutine invalid_response !> Encode arbitrary native bytes in portable ASCII TOML strings. pure function encode_bytes ( value ) result ( encoded ) character ( len =* ), intent ( in ) :: value character ( len = :), allocatable :: encoded character ( len =* ), parameter :: digits = \"0123456789abcdef\" integer :: i , byte allocate ( character ( len = 2 * len ( value )) :: encoded ) do i = 1 , len ( value ) byte = iachar ( value ( i : i )) encoded ( 2 * i - 1 : 2 * i - 1 ) = digits ( byte / 16 + 1 : byte / 16 + 1 ) encoded ( 2 * i : 2 * i ) = digits ( mod ( byte , 16 ) + 1 : mod ( byte , 16 ) + 1 ) end do end function encode_bytes !> Decode hexadecimal byte strings, rejecting malformed data and embedded NULs. pure subroutine decode_bytes ( encoded , decoded , valid ) character ( len =* ), intent ( in ) :: encoded character ( len = :), allocatable , intent ( out ) :: decoded logical , intent ( out ) :: valid character ( len =* ), parameter :: digits = \"0123456789abcdef\" integer :: i , high , low , byte valid = . false . decoded = \"\" if ( mod ( len ( encoded ), 2 ) /= 0 ) return deallocate ( decoded ) allocate ( character ( len = len ( encoded ) / 2 ) :: decoded ) do i = 1 , len ( decoded ) high = index ( digits , encoded ( 2 * i - 1 : 2 * i - 1 )) - 1 low = index ( digits , encoded ( 2 * i : 2 * i )) - 1 if ( high < 0 . or . low < 0 ) return byte = 16 * high + low if ( byte == 0 ) return decoded ( i : i ) = achar ( byte ) end do valid = . true . end subroutine decode_bytes end module watch_graph_worker","tags":"","url":"sourcefile/watch_graph_worker.f90.html"},{"title":"watch_exec.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_exec.f90~~EfferentGraph sourcefile~watch_exec.f90 watch_exec.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_exec.f90->sourcefile~watch_log.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_exec.f90->sourcefile~watch_platform.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_exec.f90->sourcefile~watch_types.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_exec.f90->sourcefile~watch_util.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_util.f90 sourcefile~watch_cmdsplice.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_exec.f90~~AfferentGraph sourcefile~watch_exec.f90 watch_exec.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_exec.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Select affected targets, execute fpm, and emit command-cycle events. !! !! Commands run synchronously through `watch_platform`. Structured logging !! sends raw command stdout to stderr; optional boundary markers correlate !! that stream with command events. Target injection preserves explicit names. module watch_exec use , intrinsic :: iso_fortran_env , only : int64 , error_unit use watch_types , only : watch_opts_t , root_info_t use watch_util , only : ftoa use watch_cmdline , only : quote_arg use watch_platform , only : execute_command , termination_requested use fpm_strings , only : string_t , str use fpm_command_line , only : fpm_build_settings , fpm_test_settings , fpm_run_settings use watch_log , only : log_event , log_int , log_real , log_string , log_strings , log_bool , structured_logging implicit none private public report_changes , run_command_and_report , build_run_command !> Process-local command counter, incremented before each start event. integer ( int64 ), save :: cycle_number = 0_int64 contains !> Emit changed paths and a summary unless quiet mode suppresses them. !! !! `changed_idx(:changed_count)` contains 1-based indices into `files`. !! Structured summaries include every valid path; verbosity 1 emits individual records !! for at most the first eight changed indices. subroutine report_changes ( files , changed_idx , changed_count , w ) type ( string_t ), allocatable , intent ( in ) :: files (:) integer , intent ( in ) :: changed_idx (:) integer , intent ( in ) :: changed_count type ( watch_opts_t ), intent ( in ) :: w integer :: i , idx , n type ( string_t ), allocatable :: paths (:) character ( len = :), allocatable :: message if ( w % verbosity < 0 . or . changed_count == 0 ) return if (. not . allocated ( files )) return idx = changed_idx ( 1 ) message = str ( changed_count ) // \" files changed\" if ( idx >= 1 . and . idx <= size ( files )) then if ( changed_count == 1 ) message = \"Changed \" // files ( idx )% s end if if ( structured_logging ()) then allocate ( paths ( changed_count )) n = 0 do i = 1 , changed_count idx = changed_idx ( i ) if ( idx < 1 . or . idx > size ( files )) cycle n = n + 1 paths ( n ) = files ( idx ) end do call log_event ( \"info\" , \"watch.changed\" , message , & [ log_int ( \"file_count\" , changed_count ), log_strings ( \"paths\" , paths (: n )), & log_real ( \"debounce_ms\" , w % debounce * 100 0.0 )]) else call log_event ( \"info\" , \"watch.changed\" , message ) end if do i = 1 , min ( changed_count , 8 ) idx = changed_idx ( i ) if ( idx < 1 . or . idx > size ( files )) cycle call log_event ( \"info\" , \"watch.changed_file\" , \"Changed \" // files ( idx )% s , & [ log_string ( \"path\" , files ( idx )% s )], verbosity = 1 ) end do end subroutine report_changes !> Execute synchronously and report start, completion, exit status, and seconds. !! !! `cycle_id` combines the supervisor generation and a process-local counter. !! Structured mode sends raw command stdout to stderr; silent mode suppresses !! both child streams. In structured mode only, output markers bracket stderr !! and force both command events through quiet filtering. Failures are errors; !! a latched user interruption is reported as an interrupted completion. subroutine run_command_and_report ( cmd , w , exitstat , secs ) character ( len =* ), intent ( in ) :: cmd !! Complete serialized command to execute synchronously. type ( watch_opts_t ), intent ( in ) :: w !! Output suppression, cycle generation, and optional output-marker settings. integer , intent ( out ) :: exitstat !! Command status, including 127 when the platform wrapper cannot launch or wait. real , intent ( out ) :: secs !! Elapsed command time in seconds, excluding event formatting and boundary writes. integer ( int64 ) :: rate , t0 , t1 character ( len = :), allocatable :: action , message , level , cycle_id logical :: interrupted , protocol action = \"Command\" if ( index ( cmd , \"fpm build\" ) == 1 ) action = \"Build\" if ( index ( cmd , \"fpm test\" ) == 1 ) action = \"Tests\" if ( index ( cmd , \"fpm run\" ) == 1 ) action = \"Application\" cycle_number = cycle_number + 1_int64 cycle_id = str ( w % restart_count ) // \":\" // str ( cycle_number ) protocol = w % output_markers . and . structured_logging () call log_event ( \"info\" , \"command.started\" , \"Running \" // trim ( cmd ), & [ log_string ( \"command\" , trim ( cmd )), log_bool ( \"silent_fpm\" , w % silent_fpm ), & log_string ( \"cycle_id\" , cycle_id )], force = protocol ) call output_boundary ( \"started\" , cycle_id , protocol ) call system_clock ( count_rate = rate ) if ( rate <= 0_int64 ) rate = 1000_int64 call system_clock ( t0 ) call execute_command ( trim ( cmd ), exitstat , silent = w % silent_fpm , stderr = structured_logging (), & inherit_workspace = . false .) call system_clock ( t1 ) secs = real ( t1 - t0 ) / real ( rate ) interrupted = termination_requested () level = \"info\" message = action // \" succeeded in \" // ftoa ( secs ) // \"s\" if ( exitstat /= 0 ) then level = \"error\" message = action // \" failed (exit \" // str ( exitstat ) // \") after \" // ftoa ( secs ) // \"s\" end if if ( interrupted ) then level = \"info\" message = action // \" interrupted\" end if call log_event ( level , \"command.finished\" , message , & [ log_string ( \"command\" , trim ( cmd )), log_int ( \"exit_code\" , exitstat ), & log_int ( \"duration_ms\" , nint ( secs * 100 0.0 , int64 )), log_bool ( \"interrupted\" , interrupted ), & log_string ( \"cycle_id\" , cycle_id )], force = protocol ) call output_boundary ( \"finished\" , cycle_id , protocol ) end subroutine run_command_and_report !> Flush a stderr boundary marker when the structured output protocol is enabled. !! !! The marker follows a blank line and contains the same opaque `cycle_id` !! as the command events; stdout and stderr delivery order need not match. subroutine output_boundary ( state , cycle_id , enabled ) character ( len =* ), intent ( in ) :: state , cycle_id logical , intent ( in ) :: enabled if (. not . enabled ) return write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"@@fpm-watch:\" // state // \":\" // cycle_id // \"@@\" flush ( error_unit ) end subroutine output_boundary !> Inject affected root names into an unpinned run/test command. !! !! `changed_idx(:changed_count)` indexes `file_mask`, whose bits correspond !! to `roots`. Combine those bits and quote the matching root names before !! the program-argument `--` delimiter. Return `full_cmdline` unchanged for !! build mode, explicit target patterns, unavailable masks/roots, a changed !! zero-mask file (global metadata), no matched names, or an empty prefix. function build_run_command ( settings , full_cmdline , cmd_prefix , cmd_rest , roots , file_mask , changed_idx , changed_count ) result ( cmd ) use watch_cmdsplice , only : inject_names_into_cmd class ( fpm_build_settings ), intent ( in ) :: settings !! Run/test type and explicit target patterns used to decide whether injection is allowed. character ( len =* ), intent ( in ) :: full_cmdline !! Complete serialized command, returned when no target injection is possible. character ( len =* ), intent ( in ) :: cmd_prefix !! Serialized executable/subcommand prefix for the replacement command. character ( len =* ), intent ( in ) :: cmd_rest !! Serialized forwarded fpm/program arguments after the subcommand. type ( root_info_t ), allocatable , intent ( in ) :: roots (:) !! Root executable names and their single-bit membership masks. integer ( int64 ), allocatable , intent ( in ) :: file_mask (:) !! Root bits per watched file, indexed by changed_idx. integer , intent ( in ) :: changed_idx (:) !! 1-based file indices; only the first changed_count entries are read. integer , intent ( in ) :: changed_count !! Number of changed indices in the active buffer prefix. character ( len = :), allocatable :: cmd logical :: is_test , is_run integer ( int64 ) :: hitmask character ( len = :), allocatable :: names_str integer :: j , idx logical :: user_pinned_names is_test = . false . is_run = . false . user_pinned_names = . false . select type ( s => settings ) type is ( fpm_test_settings ) is_test = . true . if ( allocated ( s % name )) user_pinned_names = ( size ( s % name ) > 0 ) type is ( fpm_run_settings ) is_run = . true . if ( allocated ( s % name )) user_pinned_names = ( size ( s % name ) > 0 ) class default continue end select if ( user_pinned_names ) then cmd = trim ( full_cmdline ) return end if if (. not . is_test . and . . not . is_run ) then cmd = trim ( full_cmdline ) return end if if (. not . allocated ( roots )) then cmd = trim ( full_cmdline ) return end if if ( size ( roots ) == 0 ) then cmd = trim ( full_cmdline ) return end if if (. not . allocated ( file_mask )) then cmd = trim ( full_cmdline ) return end if hitmask = 0_int64 do j = 1 , changed_count idx = changed_idx ( j ) if ( idx < 1 . or . idx > size ( file_mask )) cycle if ( file_mask ( idx ) == 0_int64 ) then cmd = trim ( full_cmdline ) return end if hitmask = ior ( hitmask , file_mask ( idx )) end do if ( hitmask == 0_int64 ) then cmd = trim ( full_cmdline ) return end if names_str = join_names_from_mask ( roots , hitmask ) if ( len_trim ( names_str ) == 0 ) then cmd = trim ( full_cmdline ) return end if if ( len_trim ( cmd_prefix ) == 0 ) then cmd = trim ( full_cmdline ) return end if cmd = inject_names_into_cmd ( cmd_prefix , cmd_rest , names_str ) contains !> Join quoted, nonempty root names whose bits intersect `mask`, in root order. function join_names_from_mask ( roots , mask ) result ( s ) type ( root_info_t ), intent ( in ) :: roots (:) integer ( int64 ), intent ( in ) :: mask character ( len = :), allocatable :: s integer :: rr character ( len = :), allocatable :: nm s = \"\" do rr = 1 , size ( roots ) if ( iand ( mask , roots ( rr )% mask ) == 0_int64 ) cycle if (. not . allocated ( roots ( rr )% name )) cycle nm = trim ( roots ( rr )% name ) if ( len_trim ( nm ) == 0 ) cycle if ( len ( s ) > 0 ) s = s // \" \" s = s // quote_arg ( nm ) end do end function join_names_from_mask end function build_run_command end module watch_exec","tags":"","url":"sourcefile/watch_exec.f90.html"},{"title":"watch_config.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_config.f90~~EfferentGraph sourcefile~watch_config.f90 watch_config.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_config.f90->sourcefile~watch_types.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_config.f90~~AfferentGraph sourcefile~watch_config.f90 watch_config.f90 sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_cli.f90->sourcefile~watch_config.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_cli.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Read watcher and supervisor defaults through fpm's TOML interface. !! !! Missing or unreadable watcher tables leave existing values unchanged. !! Scalar keys replace defaults; manifest lists replace existing arrays. !! CLI list options subsequently append unique entries through `push_feature`. module watch_config use , intrinsic :: ieee_arithmetic , only : ieee_is_finite use watch_types , only : watch_opts_t use fpm_strings , only : string_t use fpm_filesystem , only : exists use fpm_error , only : error_t use fpm_toml , only : read_package_file , get_list use tomlf , only : toml_table , toml_stat , get_value implicit none private public set_watch_defaults , apply_watch_from_manifest , normalize_watch_opts , push_feature contains !> Reset scalar watcher options and ensure list arrays are allocated. !! !! Existing include/ignore arrays are retained. Fresh options receive empty arrays. subroutine set_watch_defaults ( w ) type ( watch_opts_t ), intent ( inout ) :: w w % verbosity = 0 w % log_format = \"text\" w % fpm_executable = \"fpm\" w % debug = . false . w % poll = 0.5 w % debounce = 0.2 w % rescan = 0.0 w % run_on_start = . true . w % print_files_once = . false . w % silent_fpm = . false . w % output_markers = . false . w % restart_count = 0 w % watch_deps = . false . w % once = . false . if (. not . allocated ( w % ignore )) allocate ( w % ignore ( 0 )) if (. not . allocated ( w % include )) allocate ( w % include ( 0 )) w % auto_restart = . false . w % is_child = . false . w % restart_delay = 1.0 w % restart_max = 0 w % self_exe = \"\" end subroutine set_watch_defaults !> Normalize timing bounds, verbosity, and the executable name. !! !! Clamp poll to at least 0.05 s, debounce/rescan to nonnegative values, and !! verbosity to -1..2. Restore an empty/unallocated fpm executable to `fpm`. !! Log-format validation and list allocation are handled separately. subroutine normalize_watch_opts ( w ) type ( watch_opts_t ), intent ( inout ) :: w if ( w % poll < 0.05 ) w % poll = 0.05 if ( w % debounce < 0.0 ) w % debounce = 0.0 if ( w % rescan < 0.0 ) w % rescan = 0.0 if ( w % restart_delay < 0.0 ) w % restart_delay = 0.0 if ( w % restart_max < 0 ) w % restart_max = 0 if ( w % verbosity > 2 ) w % verbosity = 2 if ( w % verbosity < - 1 ) w % verbosity = - 1 if (. not . allocated ( w % fpm_executable )) w % fpm_executable = \"fpm\" if ( len_trim ( w % fpm_executable ) == 0 ) w % fpm_executable = \"fpm\" end subroutine normalize_watch_opts !> Replace recognized options from `[extra.fpm-watch]` and normalize them. !! !! Missing keys or values that TOML getters cannot read leave existing options !! unchanged. Successfully read lists replace existing arrays. Log-format validation !! belongs to CLI configuration assembly. subroutine apply_watch_from_manifest ( w , manifest ) type ( watch_opts_t ), intent ( inout ) :: w character ( len =* ), intent ( in ) :: manifest type ( toml_table ), allocatable :: root type ( toml_table ), pointer :: wt logical :: ok call load_watch_table ( root , wt , ok , manifest ) if (. not . ok ) return call toml_get_real ( wt , \"poll\" , w % poll ) call toml_get_real ( wt , \"debounce\" , w % debounce ) call toml_get_real ( wt , \"rescan\" , w % rescan ) call toml_get_logical ( wt , \"debug\" , w % debug ) call toml_get_logical ( wt , \"print-files\" , w % print_files_once ) call toml_get_logical ( wt , \"silent-fpm\" , w % silent_fpm ) call toml_get_logical ( wt , \"output-markers\" , w % output_markers ) call toml_get_logical ( wt , \"run-on-start\" , w % run_on_start ) call toml_get_logical ( wt , \"deps\" , w % watch_deps ) call toml_get_logical ( wt , \"once\" , w % once ) call toml_get_int ( wt , \"verbosity\" , w % verbosity ) call toml_get_string ( wt , \"log-format\" , w % log_format ) call toml_get_string ( wt , \"fpm-executable\" , w % fpm_executable ) call toml_get_list_strings ( wt , \"ignore\" , w % ignore ) call toml_get_list_strings ( wt , \"include\" , w % include ) call toml_get_logical ( wt , \"auto-restart\" , w % auto_restart ) call toml_get_real ( wt , \"restart-delay\" , w % restart_delay ) call toml_get_int ( wt , \"restart-max\" , w % restart_max ) call toml_get_string ( wt , \"self\" , w % self_exe ) call normalize_watch_opts ( w ) end subroutine apply_watch_from_manifest !> Locate `[extra.fpm-watch]` in the selected project manifest. !! !! `ok` is false and `wt` is null when the file/table is absent or unreadable. !! On success, `wt` points inside `root` and remains valid only while `root` !! remains allocated. subroutine load_watch_table ( root , wt , ok , manifest ) type ( toml_table ), allocatable , intent ( out ) :: root type ( toml_table ), pointer , intent ( out ) :: wt logical , intent ( out ) :: ok character ( len =* ), intent ( in ) :: manifest type ( toml_table ), pointer :: extra type ( error_t ), allocatable :: err integer :: stat ok = . false . wt => null () extra => null () if (. not . exists ( manifest )) return call read_package_file ( root , manifest , err ) if ( allocated ( err )) return call get_value ( root , \"extra\" , extra , requested = . false ., stat = stat ) if ( stat /= toml_stat % success ) return if (. not . associated ( extra )) return call get_value ( extra , \"fpm-watch\" , wt , requested = . false ., stat = stat ) if ( stat /= toml_stat % success ) return if (. not . associated ( wt )) return ok = . true . end subroutine load_watch_table !> Read a finite TOML real value if present; otherwise retain the existing value. subroutine toml_get_real ( table , key , v ) type ( toml_table ), intent ( inout ) :: table character ( len =* ), intent ( in ) :: key real , intent ( inout ) :: v real :: tmp integer :: stat tmp = v call get_value ( table , key , tmp , stat = stat ) if ( stat == toml_stat % success ) then if ( ieee_is_finite ( tmp )) v = tmp end if end subroutine toml_get_real !> Read a TOML integer value if present. subroutine toml_get_int ( table , key , v ) type ( toml_table ), intent ( inout ) :: table character ( len =* ), intent ( in ) :: key integer , intent ( inout ) :: v integer :: tmp , stat tmp = v call get_value ( table , key , tmp , stat = stat ) if ( stat == toml_stat % success ) v = tmp end subroutine toml_get_int !> Read a TOML logical value if present. subroutine toml_get_logical ( table , key , v ) type ( toml_table ), intent ( inout ) :: table character ( len =* ), intent ( in ) :: key logical , intent ( inout ) :: v logical :: tmp integer :: stat tmp = v call get_value ( table , key , tmp , stat = stat ) if ( stat == toml_stat % success ) v = tmp end subroutine toml_get_logical !> Read a TOML string value if present. subroutine toml_get_string ( table , key , v ) type ( toml_table ), intent ( inout ) :: table character ( len =* ), intent ( in ) :: key character ( len = :), allocatable , intent ( inout ) :: v character ( len = :), allocatable :: tmp integer :: stat call get_value ( table , key , tmp , stat = stat ) if ( stat == toml_stat % success ) then if ( allocated ( tmp )) then v = tmp else v = \"\" end if end if end subroutine toml_get_string !> Read a TOML string list into an allocatable `string_t` array. subroutine toml_get_list_strings ( table , key , list ) type ( toml_table ), intent ( inout ) :: table character ( len =* ), intent ( in ) :: key type ( string_t ), allocatable , intent ( inout ) :: list (:) type ( error_t ), allocatable :: err type ( string_t ), allocatable :: tmp (:) if (. not . allocated ( list )) allocate ( list ( 0 )) call get_list ( table , key , tmp , err ) if ( allocated ( err )) then if ( allocated ( tmp )) deallocate ( tmp ) return end if if (. not . allocated ( tmp )) return call move_alloc ( tmp , list ) end subroutine toml_get_list_strings !> Append a unique, nonempty, right-trimmed string to an allocatable list. !! !! Used for fpm features, target patterns, and filters. !! Comparisons are case-sensitive; leading whitespace is retained. subroutine push_feature ( features , name ) type ( string_t ), allocatable , intent ( inout ) :: features (:) character ( len =* ), intent ( in ) :: name integer :: n , i type ( string_t ), allocatable :: tmp (:) if ( len_trim ( name ) == 0 ) return if (. not . allocated ( features )) then allocate ( features ( 1 )) features ( 1 )% s = trim ( name ) return end if do i = 1 , size ( features ) if ( trim ( features ( i )% s ) == trim ( name )) return end do n = size ( features ) allocate ( tmp ( n + 1 )) tmp ( 1 : n ) = features tmp ( n + 1 )% s = trim ( name ) call move_alloc ( tmp , features ) end subroutine push_feature end module watch_config","tags":"","url":"sourcefile/watch_config.f90.html"},{"title":"watch_log.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_log.f90~~EfferentGraph sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_log.f90~~AfferentGraph sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_banner.f90 watch_banner.f90 sourcefile~watch_banner.f90->sourcefile~watch_log.f90 sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_cli.f90->sourcefile~watch_log.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_cli.f90->sourcefile~watch_platform.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_log.f90 sourcefile~watch_engine.f90->sourcefile~watch_banner.f90 sourcefile~watch_engine.f90->sourcefile~watch_cli.f90 sourcefile~watch_exec.f90 watch_exec.f90 sourcefile~watch_engine.f90->sourcefile~watch_exec.f90 sourcefile~watch_graph_worker.f90 watch_graph_worker.f90 sourcefile~watch_engine.f90->sourcefile~watch_graph_worker.f90 sourcefile~watch_engine.f90->sourcefile~watch_platform.f90 sourcefile~watch_exec.f90->sourcefile~watch_log.f90 sourcefile~watch_exec.f90->sourcefile~watch_platform.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_fpm_graph.f90 watch_fpm_graph.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_log.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_platform.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_log.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_fpm_graph.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_platform.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 sourcefile~watch_restart.f90 watch_restart.f90 sourcefile~watch_restart.f90->sourcefile~watch_log.f90 sourcefile~watch_restart.f90->sourcefile~watch_platform.f90 sourcefile~watch_restart.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_cmdsplice.f90->sourcefile~watch_cmdline.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Emit terminal text, JSON Lines, and logfmt using process-wide settings. !! !! Structured records, including errors, use stdout; text errors use stderr. !! Each emitted record is flushed immediately and occupies one physical line. !! Field constructors serialize typed values as JSON; logfmt quotes array values. !! Structured strings escape controls and replace invalid UTF-8 bytes with U+FFFD. module watch_log use , intrinsic :: iso_fortran_env , only : int64 , output_unit , error_unit use watch_types , only : watch_opts_t use watch_util , only : ftoa use fpm_strings , only : string_t implicit none private public configure_logging , log_event public log_field_t , log_string , log_strings , log_int , log_real , log_bool public format_log_record , json_quote , valid_log_format , structured_logging !> A typed event attribute, stored as its JSON representation. type log_field_t !> Attribute name (`key`) and its complete serialized JSON representation (`value`). character ( len = :), allocatable :: key , value end type log_field_t interface log_int module procedure log_default_int , log_int64 end interface log_int !> Selected process format; unallocated state is treated as text. character ( len = :), allocatable , save :: active_format !> Minimum-detail filter: -1 quiet, 0 normal, 1..2 additional detail. integer , save :: active_verbosity = 0 !> Allow debug-level records when verbosity also permits them. logical , save :: active_debug = . false . contains !> Copy format, verbosity, and debug options into process-wide logger state. !! !! An unallocated format selects text. Callers must validate format names; !! this routine neither normalizes nor validates the configuration. subroutine configure_logging ( w ) type ( watch_opts_t ), intent ( in ) :: w active_format = \"text\" if ( allocated ( w % log_format )) active_format = w % log_format active_verbosity = w % verbosity active_debug = w % debug end subroutine configure_logging !> Accept exactly the case-sensitive format names `text`, `json`, and `logfmt`. pure logical function valid_log_format ( name ) result ( valid ) character ( len =* ), intent ( in ) :: name valid = name == \"text\" . or . name == \"json\" . or . name == \"logfmt\" end function valid_log_format !> Return whether the process currently emits a machine-readable stream. logical function structured_logging () result ( structured ) structured = . false . if ( allocated ( active_format )) structured = active_format /= \"text\" end function structured_logging !> Format, write, and flush one timestamped event with optional typed attributes. !! !! `verbosity` is the minimum detail level, defaulting to zero. Quiet mode !! suppresses non-error records; debug records additionally require debug mode. !! `force=true` and errors bypass both filters. Structured output always uses !! stdout; only text errors use stderr. `fields` should use the typed constructors. !! Output errors are nonfatal so a disconnected terminal cannot replace a !! command or cancellation status with a Fortran runtime I/O failure. subroutine log_event ( level , event , message , fields , verbosity , force ) character ( len =* ), intent ( in ) :: level , event , message !! Severity, stable event identifier, and human-readable message, respectively. type ( log_field_t ), intent ( in ), optional :: fields (:) !! Typed attributes constructed with log_string/log_strings/log_int/log_real/log_bool. integer , intent ( in ), optional :: verbosity !! Minimum active verbosity for this non-error event; defaults to zero. logical , intent ( in ), optional :: force !! Bypass verbosity/debug filters for required protocol events; defaults to false. integer :: unit , detail , io_status logical :: required character ( len = :), allocatable :: line , timestamp if (. not . allocated ( active_format )) active_format = \"text\" required = . false . if ( present ( force )) required = force if ( level /= \"error\" . and . . not . required ) then if ( active_verbosity < 0 ) return detail = 0 if ( present ( verbosity )) detail = verbosity if ( active_verbosity < detail ) return if ( level == \"debug\" . and . . not . active_debug ) return end if timestamp = log_timestamp () line = format_log_record ( active_format , timestamp , level , event , message , fields ) unit = output_unit if ( active_format == \"text\" . and . level == \"error\" ) unit = error_unit write ( unit , \"(a)\" , iostat = io_status ) line if ( io_status /= 0 ) return flush ( unit , iostat = io_status ) if ( io_status /= 0 ) return end subroutine log_event !> Render text, JSON, or logfmt without logging I/O or reading the clock. !! !! `timestamp` must provide RFC 3339 text (at least 19 characters for text mode). !! Structured fields require allocated keys and nonempty serialized JSON values. !! Text uses HH:MM:SS, level, and message; it omits event/attribute fields. !! Unrecognized formats use text. This routine does not apply verbosity filters. pure function format_log_record ( format , timestamp , level , event , message , fields ) result ( line ) character ( len =* ), intent ( in ) :: format , timestamp , level , event , message type ( log_field_t ), intent ( in ), optional :: fields (:) character ( len = :), allocatable :: line , label , prefix integer :: i , total , position select case ( format ) case ( \"json\" ) prefix = '{\"timestamp\":' // json_quote ( timestamp ) // ',\"level\":' // json_quote ( level ) // & ',\"event\":' // json_quote ( event ) // ',\"message\":' // json_quote ( message ) total = len ( prefix ) + 1 if ( present ( fields )) then do i = 1 , size ( fields ) total = total + 4 + escaped_length ( fields ( i )% key , . true .) + len ( fields ( i )% value ) end do end if allocate ( character ( len = total ) :: line ) position = 1 call put_text ( line , position , prefix ) if ( present ( fields )) then do i = 1 , size ( fields ) call put_text ( line , position , \",\" ) call put_json_string ( line , position , fields ( i )% key ) call put_text ( line , position , \":\" ) call put_text ( line , position , fields ( i )% value ) end do end if call put_text ( line , position , \"}\" ) case ( \"logfmt\" ) prefix = \"timestamp=\" // timestamp // \" level=\" // level // \" event=\" // event // & \" msg=\" // json_quote ( message ) total = len ( prefix ) if ( present ( fields )) then do i = 1 , size ( fields ) total = total + 2 + len ( fields ( i )% key ) if ( fields ( i )% value ( 1 : 1 ) == \"[\" ) then total = total + 2 + escaped_length ( fields ( i )% value , . true .) else total = total + len ( fields ( i )% value ) end if end do end if allocate ( character ( len = total ) :: line ) position = 1 call put_text ( line , position , prefix ) if ( present ( fields )) then do i = 1 , size ( fields ) call put_text ( line , position , \" \" // fields ( i )% key // \"=\" ) if ( fields ( i )% value ( 1 : 1 ) == \"[\" ) then call put_json_string ( line , position , fields ( i )% value ) else call put_text ( line , position , fields ( i )% value ) end if end do end if case default select case ( level ) case ( \"error\" ) label = \"ERROR\" case ( \"warn\" ) label = \"WARN \" case ( \"debug\" ) label = \"DEBUG\" case default label = \"INFO \" end select line = timestamp ( 12 : 19 ) // \" \" // label // \" \" // escape_text ( message , . false .) end select end function format_log_record !> Quote a byte string as JSON, escaping controls and replacing invalid UTF-8 bytes with U+FFFD. pure function json_quote ( value ) result ( quoted ) character ( len =* ), intent ( in ) :: value character ( len = :), allocatable :: quoted integer :: position , total total = escaped_length ( value , . true .) + 2 allocate ( character ( len = total ) :: quoted ) position = 1 call put_json_string ( quoted , position , value ) end function json_quote !> Escape control bytes so a message stays on one physical line. !! !! When `delimiters` is true, also escape quotes/backslashes and replace invalid !! UTF-8 bytes with JSON U+FFFD escapes. Text mode preserves non-ASCII bytes. pure function escape_text ( value , delimiters ) result ( escaped ) character ( len =* ), intent ( in ) :: value logical , intent ( in ) :: delimiters character ( len = :), allocatable :: escaped integer :: position , total total = escaped_length ( value , delimiters ) allocate ( character ( len = total ) :: escaped ) position = 1 call put_escaped ( escaped , position , value , delimiters ) end function escape_text !> Count escaped bytes using the same encoder as the output pass. pure integer function escaped_length ( value , delimiters ) result ( length ) character ( len =* ), intent ( in ) :: value logical , intent ( in ) :: delimiters character ( len = 6 ) :: piece integer :: i , consumed , written length = 0 i = 1 do while ( i <= len ( value )) call escape_piece ( value , i , delimiters , piece , consumed , written ) length = length + written i = i + consumed end do end function escaped_length !> Append bytes into an already sized buffer without reallocating it. pure subroutine put_text ( buffer , position , value ) !> Caller-owned capacity and untouched bytes must remain unchanged while appending. ! allow(C072) character ( len =* ), intent ( inout ) :: buffer integer , intent ( inout ) :: position character ( len =* ), intent ( in ) :: value buffer ( position : position + len ( value ) - 1 ) = value position = position + len ( value ) end subroutine put_text !> Append one quoted JSON string to an already sized buffer. pure subroutine put_json_string ( buffer , position , value ) !> Caller-owned capacity and untouched bytes must remain unchanged while appending. ! allow(C072) character ( len =* ), intent ( inout ) :: buffer integer , intent ( inout ) :: position character ( len =* ), intent ( in ) :: value call put_text ( buffer , position , '\"' ) call put_escaped ( buffer , position , value , . true .) call put_text ( buffer , position , '\"' ) end subroutine put_json_string !> Append escaped bytes in one pass using bounded six-byte fragments. pure subroutine put_escaped ( buffer , position , value , delimiters ) !> Caller-owned capacity and untouched bytes must remain unchanged while appending. ! allow(C072) character ( len =* ), intent ( inout ) :: buffer integer , intent ( inout ) :: position character ( len =* ), intent ( in ) :: value logical , intent ( in ) :: delimiters character ( len = 6 ) :: piece integer :: i , consumed , written i = 1 do while ( i <= len ( value )) call escape_piece ( value , i , delimiters , piece , consumed , written ) call put_text ( buffer , position , piece (: written )) i = i + consumed end do end subroutine put_escaped !> Encode one ASCII byte or UTF-8 sequence and report consumed/output lengths. pure subroutine escape_piece ( value , position , delimiters , piece , consumed , written ) character ( len =* ), intent ( in ) :: value integer , intent ( in ) :: position logical , intent ( in ) :: delimiters character ( len = 6 ), intent ( out ) :: piece integer , intent ( out ) :: consumed , written character ( len = 4 ) :: hex integer :: code , width code = iachar ( value ( position : position )) consumed = 1 written = 1 piece = value ( position : position ) select case ( code ) case ( 34 , 92 ) if ( delimiters ) then piece = achar ( 92 ) // value ( position : position ) written = 2 end if case ( 8 , 9 , 10 , 12 , 13 ) select case ( code ) case ( 8 ) piece = achar ( 92 ) // \"b\" case ( 9 ) piece = achar ( 92 ) // \"t\" case ( 10 ) piece = achar ( 92 ) // \"n\" case ( 12 ) piece = achar ( 92 ) // \"f\" case default piece = achar ( 92 ) // \"r\" end select written = 2 case ( 0 : 7 , 11 , 14 : 31 ) write ( hex , \"(z4.4)\" ) code piece = achar ( 92 ) // \"u\" // hex written = 6 case ( 128 : 255 ) if (. not . delimiters ) return width = utf8_width ( value , position ) if ( width == 0 ) then piece = achar ( 92 ) // \"uFFFD\" written = 6 else piece = value ( position : position + width - 1 ) consumed = width written = width end if case default continue end select end subroutine escape_piece !> Validate a multibyte UTF-8 sequence at a valid 1-based byte position. !! !! Return 2..4 for a valid sequence, or zero for invalid/truncated input, !! ASCII bytes, surrogate encodings, or out-of-range Unicode values. pure integer function utf8_width ( value , position ) result ( width ) character ( len =* ), intent ( in ) :: value integer , intent ( in ) :: position integer :: first , second , i , expected width = 0 first = iachar ( value ( position : position )) select case ( first ) case ( 194 : 223 ) expected = 2 case ( 224 : 239 ) expected = 3 case ( 240 : 244 ) expected = 4 case default return end select if ( position + expected - 1 > len ( value )) return do i = position + 1 , position + expected - 1 second = iachar ( value ( i : i )) if ( second < 128 . or . second > 191 ) return end do second = iachar ( value ( position + 1 : position + 1 )) if ( first == 224 . and . second < 160 ) return if ( first == 237 . and . second > 159 ) return if ( first == 240 . and . second < 144 ) return if ( first == 244 . and . second > 143 ) return width = expected end function utf8_width !> Construct a string attribute without trimming meaningful whitespace. pure function log_string ( key , value ) result ( field ) character ( len =* ), intent ( in ) :: key , value type ( log_field_t ) :: field field % key = key field % value = json_quote ( value ) end function log_string !> Construct a JSON string array; logfmt represents it as a quoted JSON value. pure function log_strings ( key , values ) result ( field ) character ( len =* ), intent ( in ) :: key type ( string_t ), intent ( in ) :: values (:) type ( log_field_t ) :: field integer :: i , total , position field % key = key total = 2 + max ( 0 , size ( values ) - 1 ) do i = 1 , size ( values ) total = total + 2 + escaped_length ( values ( i )% s , . true .) end do allocate ( character ( len = total ) :: field % value ) position = 1 call put_text ( field % value , position , \"[\" ) do i = 1 , size ( values ) if ( i > 1 ) call put_text ( field % value , position , \",\" ) call put_json_string ( field % value , position , values ( i )% s ) end do call put_text ( field % value , position , \"]\" ) end function log_strings !> Construct a default-integer attribute. pure function log_default_int ( key , value ) result ( field ) character ( len =* ), intent ( in ) :: key integer , intent ( in ) :: value type ( log_field_t ) :: field field = log_int64 ( key , int ( value , int64 )) end function log_default_int !> Construct an integer attribute, including long-running counters. pure function log_int64 ( key , value ) result ( field ) character ( len =* ), intent ( in ) :: key integer ( int64 ), intent ( in ) :: value type ( log_field_t ) :: field character ( len = 32 ) :: buffer write ( buffer , \"(i0)\" ) value field % key = key field % value = trim ( buffer ) end function log_int64 !> Serialize a real with three decimal places (scientific fallback); nonfinite values become JSON null. pure function log_real ( key , value ) result ( field ) use , intrinsic :: ieee_arithmetic , only : ieee_is_finite character ( len =* ), intent ( in ) :: key real , intent ( in ) :: value type ( log_field_t ) :: field field % key = key field % value = \"null\" if (. not . ieee_is_finite ( value )) return field % value = ftoa ( value , precision = 3 ) end function log_real !> Construct a boolean attribute. pure function log_bool ( key , value ) result ( field ) character ( len =* ), intent ( in ) :: key logical , intent ( in ) :: value type ( log_field_t ) :: field field % key = key field % value = \"false\" if ( value ) field % value = \"true\" end function log_bool !> Read local wall time with milliseconds and its explicit UTC offset. function log_timestamp () result ( timestamp ) character ( len = :), allocatable :: timestamp character ( len = 29 ) :: buffer character ( len = 5 ) :: zone integer :: values ( 8 ) call date_and_time ( zone = zone , values = values ) write ( buffer , \"(i4.4,a,i2.2,a,i2.2,a,i2.2,a,i2.2,a,i2.2,a,i3.3,a,a,a)\" ) & values ( 1 ), \"-\" , values ( 2 ), \"-\" , values ( 3 ), \"T\" , values ( 5 ), \":\" , values ( 6 ), \":\" , & values ( 7 ), \".\" , values ( 8 ), zone ( 1 : 3 ), \":\" , zone ( 4 : 5 ) timestamp = buffer end function log_timestamp end module watch_log","tags":"","url":"sourcefile/watch_log.f90.html"},{"title":"watch_fpm_graph.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_fpm_graph.f90~~EfferentGraph sourcefile~watch_fpm_graph.f90 watch_fpm_graph.f90 sourcefile~watch_filter.f90 watch_filter.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_filter.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_log.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_platform.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_types.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_util.f90 sourcefile~watch_filter.f90->sourcefile~watch_util.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_fpm_graph.f90~~AfferentGraph sourcefile~watch_fpm_graph.f90 watch_fpm_graph.f90 sourcefile~watch_graph_worker.f90 watch_graph_worker.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_fpm_graph.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_graph_worker.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Build watch lists from fpm's manifest, model, and target graph. !! !! Build mode watches every model source. Run/test mode selects named executable !! source closures. Link-only sources are conservatively retained because fpm !! does not expose its linker graph independently of its pruning allocator. !! Sources, include candidates, manifests, and version files form one normalized path list. !! Optional dependency watching includes dependency paths under the build tree. !! Up to 64 run/test roots receive bitmasks for later affected-target selection. module watch_fpm_graph use , intrinsic :: iso_fortran_env , only : int64 use , intrinsic :: iso_c_binding , only : c_int use watch_types , only : watch_opts_t , root_info_t use watch_log , only : log_event , log_int , log_real , structured_logging use watch_platform , only : begin_raw_output , end_raw_output use watch_filter , only : normalize_path , is_ignored_path , filter_watch_files , starts_with use watch_util , only : ftoa , trim_or_empty use fpm , only : build_model use fpm_manifest , only : package_config_t , get_package_data use fpm_model , only : fpm_model_t , srcfile_t , FPM_SCOPE_APP , FPM_SCOPE_TEST , FPM_SCOPE_EXAMPLE , & FPM_SCOPE_LIB , FPM_SCOPE_DEP , FPM_UNIT_PROGRAM , FPM_UNIT_SUBMODULE , & FPM_UNIT_SUBPROGRAM , FPM_UNIT_CSOURCE , FPM_UNIT_CPPSOURCE use fpm_targets , only : build_target_ptr , new_target , resolve_module_dependencies , add_dependency , FPM_TARGET_OBJECT use fpm_sources , only : get_exe_name_with_suffix use fpm_source_parsing , only : parse_f_source , parse_c_source use fpm_filesystem , only : basename , exists , join_path , dirname , canon_path , is_absolute_path use fpm_strings , only : string_t , glob , str , fnv_1a , operator (. in .) use fpm_error , only : error_t use fpm_toml , only : read_package_file , get_value use fpm_versioning , only : version_t , new_version use tomlf , only : toml_table use fpm_dependency , only : dependency_tree_t use fpm_command_line , only : fpm_build_settings , fpm_run_settings , fpm_test_settings implicit none private public compute_watch_files_from_settings !> Include edges parsed once per unique path during one graph construction. type include_edges_t integer , allocatable :: children (:) integer :: count = 0 logical :: parsed = . false . end type include_edges_t !> Shared growable path/mask collection with indexed, cached include edges. type file_collection_t type ( string_t ), allocatable :: paths (:) !> Internal root bits also drive include propagation and cycle detection. integer ( int64 ), allocatable :: masks (:) !> Global metadata bypasses filters and exports a zero mask regardless of internal root bits. logical , allocatable :: protected (:) type ( include_edges_t ), allocatable :: includes (:) integer , allocatable :: slots (:) integer :: count = 0 contains procedure :: add => collection_add procedure :: finish => collection_finish end type file_collection_t contains !> Build fpm's model and return the filtered source/include/manifest closure. !! !! `settings` may be updated by fpm model construction. `files` contains !! unique normalized paths; aligned `file_mask` entries map files to `roots`. !! Run/test select named roots; unselected library modules are omitted unless !! reached through fpm module dependencies or submodule implementations. With !! pruning disabled or separate library outputs, retain whole library inputs. !! Mapping is disabled when there are no roots or more than 64, yielding !! empty `roots` and zero file masks while retaining the selected closure. !! !! `manifest_key` is always zero here; the engine computes it after refresh. !! Timing outputs are seconds: `build_secs` sums model, target, and collection !! time, excluding manifest reading. Build watches all model files conservatively; !! it does not reproduce fpm pruning. On manifest/model/target failure, return !! allocated `error` if supplied, otherwise log the stage and exit with status 1. !! Watch-list outputs are only usable after a successful return. subroutine compute_watch_files_from_settings ( settings , w , files , file_mask , roots , & manifest_key , build_secs , secs_model , secs_targets , secs_watch , error , metadata_files ) class ( fpm_build_settings ), intent ( inout ) :: settings !! Typed build/run/test settings; fpm may update these while constructing its model. type ( watch_opts_t ), intent ( in ) :: w !! Watcher dependency/filter/logging options; unallocated filters impose no restriction. type ( string_t ), allocatable , intent ( out ) :: files (:) !! Unique normalized watched paths, allocated on success (possibly empty). integer ( int64 ), allocatable , intent ( out ) :: file_mask (:) !! Root-membership bits aligned with files; zero when root mapping is disabled. type ( root_info_t ), allocatable , intent ( out ) :: roots (:) !! Executable names and distinct mask bits; empty for build mode or unsupported root counts. integer ( int64 ), intent ( out ) :: manifest_key !! Reserved output, always zero; computed from accepted files by the engine. real , intent ( out ) :: build_secs !! Sum of model, target-construction, and watch-list collection times in seconds. real , intent ( out ) :: secs_model , secs_targets , secs_watch !! Separate stage durations in seconds, respectively model, targets, and file collection. type ( error_t ), allocatable , intent ( out ), optional :: error !! Allocated for manifest/model/target failure; omitted error output makes those failures fatal. type ( string_t ), allocatable , intent ( in ), optional :: metadata_files (:) !! Additional protected metadata paths, including missing lookup candidates. type ( package_config_t ), allocatable :: package type ( fpm_model_t ), allocatable :: model type ( build_target_ptr ), allocatable :: targets (:) type ( error_t ), allocatable :: err logical , allocatable :: keep (:) logical , allocatable :: visited (:), metadata (:) integer ( int64 ), allocatable :: target_mask (:) type ( string_t ), allocatable :: dep_dirs (:) type ( file_collection_t ) :: collected integer :: i , r , nroots logical :: whole_libraries integer ( int64 ) :: rate , t0 , t1 , tw0 , tw1 integer :: n_before , n_after integer ( c_int ) :: saved_output secs_model = 0.0 secs_targets = 0.0 secs_watch = 0.0 build_secs = 0.0 manifest_key = 0_int64 call system_clock ( count_rate = rate ) if ( rate <= 0_int64 ) rate = 1000_int64 allocate ( package , model ) call begin_raw_output ( structured_logging (), saved_output ) call get_package_data ( package , \"fpm.toml\" , err , apply_defaults = . true .) call end_raw_output ( saved_output ) if ( allocated ( err )) then call handle_graph_error ( err , error , \"manifest\" ) return end if call system_clock ( t0 ) call begin_raw_output ( structured_logging (), saved_output ) call build_model ( model , settings , package , err ) call end_raw_output ( saved_output ) call system_clock ( t1 ) secs_model = real ( t1 - t0 ) / real ( rate ) if ( allocated ( err )) then call handle_graph_error ( err , error , \"model\" ) return end if call collect_dep_dirs ( model % deps , dep_dirs ) if ( w % watch_deps . and . w % verbosity >= 1 ) then call log_event ( \"info\" , \"graph.dependencies\" , \"Watching \" // str ( size ( dep_dirs )) // \" dependencies\" , & [ log_int ( \"dependency_count\" , size ( dep_dirs ))], verbosity = 1 ) end if call system_clock ( t0 ) call begin_raw_output ( structured_logging (), saved_output ) whole_libraries = . not . settings % prune if ( allocated ( package % library )) whole_libraries = whole_libraries . or . . not . package % library % monolithic () call build_watch_targets ( model , whole_libraries , targets , err ) call end_raw_output ( saved_output ) call system_clock ( t1 ) secs_targets = real ( t1 - t0 ) / real ( rate ) if ( allocated ( err )) then call release_targets ( targets ) call handle_graph_error ( err , error , \"targets\" ) return end if call system_clock ( tw0 ) allocate ( keep ( size ( targets ))) keep = . false . select type ( s => settings ) type is ( fpm_test_settings ) call select_names_or_all ( targets , FPM_SCOPE_TEST , s % name , keep ) type is ( fpm_run_settings ) if ( s % example ) then call select_names_or_all ( targets , FPM_SCOPE_EXAMPLE , s % name , keep ) else call select_names_or_all ( targets , FPM_SCOPE_APP , s % name , keep ) end if class default keep = . true . end select nroots = count ( keep ) allocate ( visited ( size ( targets ))) visited = . false . if ( is_run_or_test ( settings ) . and . nroots > 0 . and . nroots <= bit_size ( 0_int64 )) then allocate ( roots ( nroots )) allocate ( target_mask ( size ( targets ))) target_mask = 0_int64 r = 0 do i = 1 , size ( targets ) if (. not . keep ( i )) cycle r = r + 1 roots ( r )% name = basename ( targets ( i )% ptr % output_file , suffix = . false .) roots ( r )% mask = shiftl ( 1_int64 , r - 1 ) call dfs_mark_mask ( targets ( i )% ptr , targets , target_mask , roots ( r )% mask ) end do visited = ( target_mask /= 0_int64 ) else if ( allocated ( roots )) deallocate ( roots ) allocate ( roots ( 0 )) if ( allocated ( target_mask )) deallocate ( target_mask ) if ( all ( keep )) then visited = . true . else do i = 1 , size ( targets ) if ( keep ( i )) call dfs_mark_bool ( targets ( i )% ptr , targets , visited ) end do end if end if call gather_files_with_mask ( targets , visited , target_mask , collected , & trim_or_empty ( settings % build_dir ), model , w % watch_deps , dep_dirs ) call collect_manifest_metadata ( collected , \"fpm.toml\" , trim_or_empty ( settings % build_dir ), dep_dirs ) if ( w % watch_deps ) then do i = 1 , size ( dep_dirs ) if ( len_trim ( dep_dirs ( i )% s ) == 0 ) cycle call collect_manifest_metadata ( collected , join_path ( dep_dirs ( i )% s , \"fpm.toml\" ), & trim_or_empty ( settings % build_dir ), dep_dirs ) end do end if if ( present ( metadata_files )) then if ( allocated ( metadata_files )) then do i = 1 , size ( metadata_files ) call collected % add ( metadata_files ( i )% s , trim_or_empty ( settings % build_dir ), 0_int64 , & dep_dirs , preserve = . true ., allow_missing = . true .) end do end if end if call collected % finish ( files , file_mask , metadata ) n_before = 0 if ( allocated ( files )) n_before = size ( files ) call filter_watch_files ( files , w % include , w % ignore , file_mask , preserve = metadata ) n_after = 0 if ( allocated ( files )) n_after = size ( files ) if ( w % debug ) then call log_event ( \"debug\" , \"graph.filtered\" , \"Filtered watch list\" , & [ log_int ( \"files_before\" , n_before ), log_int ( \"files_after\" , n_after )]) end if call system_clock ( tw1 ) secs_watch = real ( tw1 - tw0 ) / real ( rate ) build_secs = secs_model + secs_targets + secs_watch if ( w % verbosity >= 1 ) then call log_event ( \"info\" , \"graph.ready\" , \"Computed watch graph in \" // ftoa ( build_secs ) // \"s\" , & [ log_real ( \"model_ms\" , secs_model * 100 0.0 ), log_real ( \"targets_ms\" , secs_targets * 100 0.0 ), & log_real ( \"watch_list_ms\" , secs_watch * 100 0.0 ), log_int ( \"target_count\" , size ( targets )), & log_int ( \"closure_count\" , count ( visited ))], verbosity = 1 ) end if deallocate ( package , model ) call release_targets ( targets ) if ( allocated ( keep )) deallocate ( keep ) if ( allocated ( visited )) deallocate ( visited ) if ( allocated ( target_mask )) deallocate ( target_mask ) if ( allocated ( dep_dirs )) deallocate ( dep_dirs ) contains !> Return canonicalized dependency project directories, excluding the main-project node. subroutine collect_dep_dirs ( tree , dep_dirs ) type ( dependency_tree_t ), intent ( in ) :: tree type ( string_t ), allocatable , intent ( out ) :: dep_dirs (:) integer :: i if ( tree % ndep <= 1 ) then allocate ( dep_dirs ( 0 )) return end if ! The first node belongs to the main project, not a dependency. allocate ( dep_dirs ( tree % ndep - 1 )) do i = 2 , tree % ndep if ( allocated ( tree % dep ( i )% proj_dir )) then dep_dirs ( i - 1 )% s = normalize_path ( canon_path ( tree % dep ( i )% proj_dir )) else dep_dirs ( i - 1 )% s = \"\" end if end do end subroutine collect_dep_dirs end subroutine compute_watch_files_from_settings !> Transfer `err` to an optional error output, or log its stage and exit with status 1. subroutine handle_graph_error ( err , error , stage ) type ( error_t ), allocatable , intent ( inout ) :: err type ( error_t ), allocatable , intent ( out ), optional :: error character ( len =* ), intent ( in ) :: stage if ( present ( error )) then call move_alloc ( err , error ) else call log_event ( \"error\" , \"graph.failed\" , stage // \" error: \" // err % message ) stop 1 end if end subroutine handle_graph_error !> Own one fpm target per model source and delegate USE resolution to fpm. !! !! No fpm pruning routine is called: its discarded pointer allocations cannot !! be recovered by callers. These nodes serve watch membership only. Every !! allocation stays in `targets`, including on dependency-resolution errors. subroutine build_watch_targets ( model , whole_libraries , targets , error ) type ( fpm_model_t ), intent ( in ) :: model logical , intent ( in ) :: whole_libraries type ( build_target_ptr ), allocatable , intent ( out ) :: targets (:) type ( error_t ), allocatable , intent ( out ) :: error integer :: i , j , k , n character ( len = :), allocatable :: output n = 0 do i = 1 , size ( model % packages ) n = n + size ( model % packages ( i )% sources ) end do allocate ( targets ( n )) k = 0 do i = 1 , size ( model % packages ) do j = 1 , size ( model % packages ( i )% sources ) k = k + 1 output = model % packages ( i )% sources ( j )% file_name if ( model % packages ( i )% sources ( j )% unit_type == FPM_UNIT_PROGRAM ) then output = get_exe_name_with_suffix ( model % packages ( i )% sources ( j )) end if targets ( k ) = new_target ( model % packages ( i )% name , FPM_TARGET_OBJECT , & output_name = output , source = model % packages ( i )% sources ( j )) targets ( k )% ptr % schedule = k end do end do call resolve_module_dependencies ( targets , model % external_modules , error ) if ( allocated ( error )) return ! Implementations and sources without module symbols cannot be narrowed by ! USE resolution. Retain library link inputs and inputs beside each program. do i = 1 , size ( targets ) associate ( source => targets ( i )% ptr % source ) if ( whole_libraries . and . any ( source % unit_scope == [ FPM_SCOPE_LIB , FPM_SCOPE_DEP ])) then do j = 1 , size ( targets ) if ( targets ( j )% ptr % source % unit_type == FPM_UNIT_PROGRAM ) then call add_dependency ( targets ( j )% ptr , targets ( i )% ptr ) end if end do end if if ( source % unit_type == FPM_UNIT_SUBMODULE ) then do j = 1 , size ( targets ) do k = 1 , size ( source % parent_modules ) if ( source % parent_modules ( k )% s . in . targets ( j )% ptr % source % modules_provided ) then call add_dependency ( targets ( j )% ptr , targets ( i )% ptr ) end if end do end do else if ( any ( source % unit_type == [ FPM_UNIT_SUBPROGRAM , FPM_UNIT_CSOURCE , FPM_UNIT_CPPSOURCE ])) then do j = 1 , size ( targets ) if ( targets ( j )% ptr % source % unit_type /= FPM_UNIT_PROGRAM ) cycle if ( any ( source % unit_scope == [ FPM_SCOPE_LIB , FPM_SCOPE_DEP ]) . or . & ( source % unit_scope == targets ( j )% ptr % source % unit_scope . and . & starts_with ( dirname ( source % file_name ), dirname ( targets ( j )% ptr % source % file_name )))) then call add_dependency ( targets ( j )% ptr , targets ( i )% ptr ) end if end do end if end associate end do end subroutine build_watch_targets !> Release every owned source node once, independent of shared dependency edges. subroutine release_targets ( targets ) type ( build_target_ptr ), allocatable , intent ( inout ) :: targets (:) integer :: i if (. not . allocated ( targets )) return do i = 1 , size ( targets ) if ( associated ( targets ( i )% ptr )) deallocate ( targets ( i )% ptr ) end do deallocate ( targets ) end subroutine release_targets !> Check program membership directly on fpm's source metadata. pure logical function is_program_in_scope ( target , scope ) result ( is_program ) type ( build_target_ptr ), intent ( in ) :: target integer , intent ( in ) :: scope is_program = . false . if (. not . allocated ( target % ptr % source )) return is_program = target % ptr % source % unit_type == FPM_UNIT_PROGRAM . and . target % ptr % source % unit_scope == scope end function is_program_in_scope !> Return whether the settings correspond to `fpm run` or `fpm test`. logical function is_run_or_test ( settings ) class ( fpm_build_settings ), intent ( in ) :: settings is_run_or_test = . false . select type ( settings ) type is ( fpm_test_settings ) is_run_or_test = . true . type is ( fpm_run_settings ) is_run_or_test = . true . end select end function is_run_or_test !> Collect selected source/include closures into the shared path/mask collection. subroutine gather_files_with_mask ( targets , visited , target_mask , collected , build_dir , model , watch_deps , dep_dirs ) type ( build_target_ptr ), intent ( in ) :: targets (:) logical , intent ( in ) :: visited (:) integer ( int64 ), allocatable , intent ( in ) :: target_mask (:) type ( file_collection_t ), intent ( inout ) :: collected character ( len =* ), intent ( in ) :: build_dir type ( fpm_model_t ), intent ( in ) :: model logical , intent ( in ) :: watch_deps type ( string_t ), allocatable , intent ( in ) :: dep_dirs (:) integer :: i integer ( int64 ) :: mask do i = 1 , size ( targets ) if (. not . visited ( i )) cycle if (. not . watch_deps ) then if ( targets ( i )% ptr % package_name /= model % package_name ) cycle end if mask = 0_int64 if ( allocated ( target_mask )) mask = target_mask ( i ) call gather_include_closure ( targets ( i )% ptr % source % file_name , mask , collected , & build_dir , model % include_dirs , watch_deps , dep_dirs ) end do end subroutine gather_files_with_mask !> Recover original and nested includes through fpm's public source parsers. !! !! The Fortran parser is deliberately called without preprocessing: fpm's !! CPP-enabled model parser expands and discards the original include paths. !! The C parser supplies quoted CPP directives, including in Fortran sources. !! Parse both languages once per path so mixed include trees remain complete. !! Later roots propagate their bits through cached edges without rereading files. !! Merging bits before recursion terminates cycles and shared subtrees. recursive subroutine gather_include_closure ( path , mask , collected , build_dir , include_dirs , watch_deps , dep_dirs , path_index ) character ( len =* ), intent ( in ) :: path , build_dir integer ( int64 ), intent ( in ) :: mask type ( file_collection_t ), intent ( inout ) :: collected type ( string_t ), allocatable , intent ( in ) :: include_dirs (:), dep_dirs (:) logical , intent ( in ) :: watch_deps integer , intent ( out ), optional :: path_index type ( srcfile_t ) :: parsed type ( error_t ), allocatable :: parse_error logical :: changed integer :: language , i , io_status , index integer ( int64 ) :: file_size if ( present ( path_index )) path_index = 0 if (. not . watch_deps ) then if ( is_in_dep_dirs ( normalize_path ( path ), dep_dirs )) return end if call collected % add ( path , build_dir , mask , dep_dirs , changed , allow_missing = . true ., path_index = index ) if ( present ( path_index )) path_index = index if (. not . changed ) return if ( collected % includes ( index )% parsed ) then do i = 1 , collected % includes ( index )% count call propagate_include_mask ( collected % includes ( index )% children ( i ), mask , collected ) end do return end if collected % includes ( index )% parsed = . true . ! fpm's text reader leaves its unit open for an empty file. Empty files ! have no includes, so retain them in the watch set without parsing them. inquire ( file = path , size = file_size , iostat = io_status ) if ( io_status /= 0 ) return if ( file_size <= 0_int64 ) return do language = 1 , 2 if ( language == 1 ) then parsed = parse_f_source ( path , parse_error ) else parsed = parse_c_source ( path , parse_error ) end if if (. not . allocated ( parsed % include_dependencies )) cycle do i = 1 , size ( parsed % include_dependencies ) call gather_include_candidates ( index , path , parsed % include_dependencies ( i )% s , mask , collected , & build_dir , include_dirs , watch_deps , dep_dirs ) end do end do end subroutine gather_include_closure !> Propagate new root bits over cached edges without path lookup or file I/O. recursive subroutine propagate_include_mask ( index , mask , collected ) integer , intent ( in ) :: index integer ( int64 ), intent ( in ) :: mask type ( file_collection_t ), intent ( inout ) :: collected integer :: i if ( ior ( collected % masks ( index ), mask ) == collected % masks ( index )) return collected % masks ( index ) = ior ( collected % masks ( index ), mask ) do i = 1 , collected % includes ( index )% count call propagate_include_mask ( collected % includes ( index )% children ( i ), mask , collected ) end do end subroutine propagate_include_mask !> Append one resolved candidate edge with amortized linear storage growth. subroutine append_include_edge ( edges , child ) type ( include_edges_t ), intent ( inout ) :: edges integer , intent ( in ) :: child integer , allocatable :: grown (:) integer :: capacity if ( child == 0 ) return if (. not . allocated ( edges % children )) allocate ( edges % children ( 4 )) if ( edges % count == size ( edges % children )) then capacity = 2 * size ( edges % children ) allocate ( grown ( capacity )) grown (: edges % count ) = edges % children (: edges % count ) call move_alloc ( grown , edges % children ) end if edges % count = edges % count + 1 edges % children ( edges % count ) = child end subroutine append_include_edge !> Retain searched include candidates through the first existing match. !! !! Missing search locations remain watched so creation, deletion, and !! recreation preserve the same path and root mask. Search beside the source, !! then fpm include directories, then the invocation directory. Candidates !! following an existing match cannot currently affect resolution and are omitted. recursive subroutine gather_include_candidates ( source_index , source_file , include_name , mask , collected , & build_dir , include_dirs , watch_deps , dep_dirs ) integer , intent ( in ) :: source_index character ( len =* ), intent ( in ) :: source_file , include_name , build_dir integer ( int64 ), intent ( in ) :: mask type ( file_collection_t ), intent ( inout ) :: collected type ( string_t ), allocatable , intent ( in ) :: include_dirs (:), dep_dirs (:) logical , intent ( in ) :: watch_deps character ( len = :), allocatable :: candidate integer :: i , child if ( len_trim ( include_name ) == 0 ) return if ( is_absolute_path ( include_name )) then call gather_include_closure ( normalize_path ( canon_path ( include_name )), mask , collected , & build_dir , include_dirs , watch_deps , dep_dirs , child ) call append_include_edge ( collected % includes ( source_index ), child ) return end if candidate = normalize_path ( canon_path ( join_path ( dirname ( source_file ), include_name ))) call gather_include_closure ( candidate , mask , collected , build_dir , include_dirs , watch_deps , dep_dirs , child ) call append_include_edge ( collected % includes ( source_index ), child ) if ( exists ( candidate )) return if ( allocated ( include_dirs )) then do i = 1 , size ( include_dirs ) candidate = normalize_path ( canon_path ( join_path ( include_dirs ( i )% s , include_name ))) call gather_include_closure ( candidate , mask , collected , build_dir , include_dirs , watch_deps , dep_dirs , child ) call append_include_edge ( collected % includes ( source_index ), child ) if ( exists ( candidate )) return end do end if call gather_include_closure ( normalize_path ( canon_path ( include_name )), mask , collected , & build_dir , include_dirs , watch_deps , dep_dirs , child ) call append_include_edge ( collected % includes ( source_index ), child ) end subroutine gather_include_candidates !> Watch each manifest and its fpm-supported version file as protected metadata. !! !! Let fpm parse both TOML and version strings. A version entry names a file !! only if fpm rejects it as a literal version and the relative file exists. subroutine collect_manifest_metadata ( collected , manifest , build_dir , dep_dirs ) type ( file_collection_t ), intent ( inout ) :: collected character ( len =* ), intent ( in ) :: manifest , build_dir type ( string_t ), allocatable , intent ( in ) :: dep_dirs (:) type ( toml_table ), allocatable :: table type ( version_t ) :: version type ( error_t ), allocatable :: error character ( len = :), allocatable :: value , version_file call collected % add ( manifest , build_dir , 0_int64 , dep_dirs , preserve = . true .) call read_package_file ( table , manifest , error ) if ( allocated ( error )) return call get_value ( table , \"version\" , value , \"0\" ) call new_version ( version , value , error ) if (. not . allocated ( error )) return version_file = join_path ( dirname ( manifest ), value ) if ( exists ( version_file )) call collected % add ( version_file , build_dir , 0_int64 , dep_dirs , preserve = . true .) end subroutine collect_manifest_metadata !> Insert an eligible path and merge root bits; include candidates may be missing. subroutine collection_add ( self , path , build_dir , mask , dep_dirs , changed , preserve , allow_missing , path_index ) class ( file_collection_t ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: path , build_dir integer ( int64 ), intent ( in ) :: mask type ( string_t ), allocatable , intent ( in ) :: dep_dirs (:) logical , intent ( out ), optional :: changed logical , intent ( in ), optional :: preserve , allow_missing integer , intent ( out ), optional :: path_index logical :: protected , keep_missing character ( len = :), allocatable :: normalized integer :: slot , index if ( present ( changed )) changed = . false . if ( present ( path_index )) path_index = 0 protected = . false . if ( present ( preserve )) protected = preserve keep_missing = . false . if ( present ( allow_missing )) keep_missing = allow_missing normalized = normalize_path ( canon_path ( path )) if ( len_trim ( normalized ) == 0 ) return if (. not . protected . and . is_ignored_path ( normalized , build_dir )) then if (. not . is_in_dep_dirs ( normalized , dep_dirs )) return end if if (. not . keep_missing ) then if (. not . exists ( normalized )) return end if if (. not . allocated ( self % paths )) call collection_grow ( self ) if ( self % count * 2 >= size ( self % slots )) call collection_grow ( self ) slot = collection_slot ( self , normalized ) index = self % slots ( slot ) if ( index > 0 ) then if ( present ( path_index )) path_index = index if ( present ( changed )) changed = ior ( self % masks ( index ), mask ) /= self % masks ( index ) self % masks ( index ) = ior ( self % masks ( index ), mask ) self % protected ( index ) = self % protected ( index ) . or . protected return end if self % count = self % count + 1 self % slots ( slot ) = self % count self % paths ( self % count )% s = normalized self % masks ( self % count ) = mask self % protected ( self % count ) = protected if ( present ( path_index )) path_index = self % count if ( present ( changed )) changed = . true . end subroutine collection_add !> Find a path's matching or empty open-addressed slot. integer function collection_slot ( self , path ) result ( slot ) class ( file_collection_t ), intent ( in ) :: self character ( len =* ), intent ( in ) :: path slot = int ( iand ( fnv_1a ( path ), int ( size ( self % slots ) - 1 , int64 ))) + 1 do while ( self % slots ( slot ) /= 0 ) if ( self % paths ( self % slots ( slot ))% s == path ) return slot = modulo ( slot , size ( self % slots )) + 1 end do end function collection_slot !> Double collection storage and rebuild the path index at a load below one half. subroutine collection_grow ( self ) class ( file_collection_t ), intent ( inout ) :: self type ( string_t ), allocatable :: paths (:) integer ( int64 ), allocatable :: masks (:) logical , allocatable :: protected (:) type ( include_edges_t ), allocatable :: includes (:) integer :: capacity , i , slot capacity = 128 if ( allocated ( self % paths )) capacity = 2 * size ( self % paths ) allocate ( paths ( capacity ), masks ( capacity ), protected ( capacity ), includes ( capacity )) do i = 1 , self % count call move_alloc ( self % paths ( i )% s , paths ( i )% s ) masks ( i ) = self % masks ( i ) protected ( i ) = self % protected ( i ) includes ( i )% count = self % includes ( i )% count includes ( i )% parsed = self % includes ( i )% parsed call move_alloc ( self % includes ( i )% children , includes ( i )% children ) end do call move_alloc ( protected , self % protected ) call move_alloc ( paths , self % paths ) call move_alloc ( masks , self % masks ) call move_alloc ( includes , self % includes ) if ( allocated ( self % slots )) deallocate ( self % slots ) allocate ( self % slots ( 2 * capacity ), source = 0 ) do i = 1 , self % count slot = collection_slot ( self , self % paths ( i )% s ) self % slots ( slot ) = i end do end subroutine collection_grow !> Transfer aligned arrays, exporting global metadata independently of include membership. !! !! Keep internal root bits until traversal is complete so metadata can also !! propagate include dependencies and terminate cycles. Its exported zero mask !! makes any metadata change select the full command, even after later propagation. subroutine collection_finish ( self , files , masks , protected ) class ( file_collection_t ), intent ( inout ) :: self type ( string_t ), allocatable , intent ( out ) :: files (:) integer ( int64 ), allocatable , intent ( out ) :: masks (:) logical , allocatable , intent ( out ) :: protected (:) integer :: i allocate ( files ( self % count ), masks ( self % count ), protected ( self % count )) do i = 1 , self % count call move_alloc ( self % paths ( i )% s , files ( i )% s ) masks ( i ) = self % masks ( i ) if ( self % protected ( i )) masks ( i ) = 0_int64 protected ( i ) = self % protected ( i ) end do if ( allocated ( self % paths )) deallocate ( self % paths , self % masks , self % slots , self % protected , self % includes ) self % count = 0 end subroutine collection_finish !> Test a normalized path against nonempty normalized dependency-directory prefixes. pure logical function is_in_dep_dirs ( p , dep_dirs ) result ( ok ) character ( len =* ), intent ( in ) :: p type ( string_t ), allocatable , intent ( in ) :: dep_dirs (:) integer :: j character ( len = :), allocatable :: d ok = . false . if (. not . allocated ( dep_dirs )) return if ( size ( dep_dirs ) == 0 ) return do j = 1 , size ( dep_dirs ) if ( len_trim ( dep_dirs ( j )% s ) == 0 ) cycle d = normalize_path ( trim ( dep_dirs ( j )% s )) if ( len_trim ( d ) == 0 ) cycle if ( p == d ) then ok = . true . return end if if ( starts_with ( p , d // \"/\" )) then ok = . true . return end if end do end function is_in_dep_dirs !> Mark executable targets in `scope` matching names without clearing existing marks. !! !! Absent/empty name patterns select all executables in scope. Otherwise match !! fpm globs against each output basename with and without its suffix. subroutine select_names_or_all ( targets , scope , names , keep ) type ( build_target_ptr ), intent ( in ) :: targets (:) integer , intent ( in ) :: scope character ( len =* ), intent ( in ), optional :: names (:) logical , intent ( inout ) :: keep (:) integer :: i , j character ( len = :), allocatable :: outbase_full , outbase_stem logical :: any_name any_name = . false . if ( present ( names )) then if ( size ( names ) > 0 ) then do j = 1 , size ( names ) if ( len_trim ( names ( j )) > 0 ) then any_name = . true . exit end if end do end if end if if (. not . any_name ) then do i = 1 , size ( targets ) if ( is_program_in_scope ( targets ( i ), scope )) keep ( i ) = . true . end do return end if do i = 1 , size ( targets ) if (. not . is_program_in_scope ( targets ( i ), scope )) cycle outbase_full = basename ( targets ( i )% ptr % output_file ) outbase_stem = basename ( targets ( i )% ptr % output_file , suffix = . false .) do j = 1 , size ( names ) if ( len_trim ( names ( j )) == 0 ) cycle if ( glob ( outbase_full , trim ( names ( j ))) . or . glob ( outbase_stem , trim ( names ( j )))) then keep ( i ) = . true . exit end if end do end do end subroutine select_names_or_all !> Recursively OR one root bit into reachable target masks, skipping already marked nodes. recursive subroutine dfs_mark_mask ( node , all , tmask , mask ) use fpm_targets , only : build_target_t type ( build_target_t ), pointer , intent ( in ) :: node type ( build_target_ptr ), intent ( in ) :: all (:) integer ( int64 ), intent ( inout ) :: tmask (:) integer ( int64 ), intent ( in ) :: mask integer :: idx , i idx = find_ptr_index ( node , all ) if ( idx <= 0 ) return if ( iand ( tmask ( idx ), mask ) /= 0_int64 ) return tmask ( idx ) = ior ( tmask ( idx ), mask ) if ( allocated ( node % dependencies )) then do i = 1 , size ( node % dependencies ) if ( associated ( node % dependencies ( i )% ptr )) call dfs_mark_mask ( node % dependencies ( i )% ptr , all , tmask , mask ) end do end if end subroutine dfs_mark_mask !> Recursively mark reachable targets in `visited`, skipping already visited nodes. recursive subroutine dfs_mark_bool ( node , all , visited ) use fpm_targets , only : build_target_t type ( build_target_t ), pointer , intent ( in ) :: node type ( build_target_ptr ), intent ( in ) :: all (:) logical , intent ( inout ) :: visited (:) integer :: idx , i idx = find_ptr_index ( node , all ) if ( idx <= 0 ) return if ( visited ( idx )) return visited ( idx ) = . true . if ( allocated ( node % dependencies )) then do i = 1 , size ( node % dependencies ) if ( associated ( node % dependencies ( i )% ptr )) call dfs_mark_bool ( node % dependencies ( i )% ptr , all , visited ) end do end if end subroutine dfs_mark_bool !> Recover a watcher-owned node index from its stable ID in constant time. integer function find_ptr_index ( p , all ) result ( idx ) use fpm_targets , only : build_target_t type ( build_target_t ), pointer , intent ( in ) :: p type ( build_target_ptr ), intent ( in ) :: all (:) idx = p % schedule if ( idx < 1 . or . idx > size ( all )) then idx = 0 else if (. not . associated ( all ( idx )% ptr , p )) then idx = 0 end if end function find_ptr_index end module watch_fpm_graph","tags":"","url":"sourcefile/watch_fpm_graph.f90.html"},{"title":"watch_restart.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_restart.f90~~EfferentGraph sourcefile~watch_restart.f90 watch_restart.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_restart.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_restart.f90->sourcefile~watch_log.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_restart.f90->sourcefile~watch_platform.f90 sourcefile~watch_time.f90 watch_time.f90 sourcefile~watch_restart.f90->sourcefile~watch_time.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_restart.f90->sourcefile~watch_types.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_restart.f90->sourcefile~watch_util.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_util.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Supervise watcher children and restart them on nonzero exit. !! !! Leading CLI flags override manifest supervisor defaults. A zero child exit !! or user interruption ends supervision; other exits restart after the delay, !! subject to the restart limit. Command failures only reach the supervisor !! if the watcher itself exits nonzero, as in one-shot mode. Child generations !! share the parent's selected log format and use distinct cycle-ID prefixes. module watch_restart use watch_time , only : sleep_seconds use watch_cmdline , only : get_arg , quote_arg , starts_with , & watch_option_takes_value use watch_types , only : watch_config_t use watch_platform , only : execute_command , create_temp_directory , remove_temp_directory , set_workspace_root use watch_log , only : log_event , log_int , log_real , log_string use fpm_strings , only : str use fpm_environment , only : get_env use fpm_error , only : error_t use watch_util , only : ftoa implicit none private public maybe_supervise contains !> Enter supervisor mode when requested, otherwise return immediately. !! !! If auto-restart is enabled and the current process is not marked as a !! child (`--watch-child`), this routine runs a supervisor loop and does not !! return. subroutine maybe_supervise ( cfg ) type ( watch_config_t ), intent ( in ) :: cfg if ( cfg % w % auto_restart . and . (. not . cfg % w % is_child )) then call supervisor_loop ( cfg % w % restart_delay , cfg % w % restart_max , cfg % w % self_exe , cfg % w % log_format ) stop 0 end if end subroutine maybe_supervise !> Launch watcher children until success, user interruption, or restart exhaustion. !! !! `max0` counts restarts after the initial launch; nonpositive values are !! unlimited. Clamp `delay0` to zero or greater. Each restart increments the !! child generation. A user interruption or exhausted limit exits with the !! child execution status; a zero child status exits successfully. !! Status propagation is quiet so runtime diagnostics cannot fail on a !! disconnected terminal and replace the child's exit status. subroutine supervisor_loop ( delay0 , max0 , exe0 , log_format ) real , intent ( in ) :: delay0 integer , intent ( in ) :: max0 character ( len =* ), intent ( in ) :: exe0 character ( len =* ), intent ( in ) :: log_format character ( len = :), allocatable :: child_cmd integer :: code , attempt real :: delay logical :: interrupted attempt = 0 delay = max ( 0.0 , delay0 ) do code = 0 child_cmd = build_child_command ( exe0 , log_format , attempt ) call execute_supervised_child ( child_cmd , code , interrupted ) if ( interrupted ) then call log_event ( \"info\" , \"supervisor.stopped\" , \"Supervisor interrupted\" , [ log_string ( \"reason\" , \"interrupt\" )]) stop code , quiet = . true . end if if ( code == 0 ) exit if ( max0 > 0 . and . attempt >= max0 ) then call log_event ( \"error\" , \"supervisor.limit_reached\" , \"Child failed; restart limit reached\" , & [ log_int ( \"exit_code\" , code ), log_int ( \"restart_count\" , attempt )]) stop code , quiet = . true . end if attempt = attempt + 1 call log_event ( \"warn\" , \"supervisor.restart\" , & \"Child failed (exit \" // str ( code ) // \"); restart #\" // str ( attempt ) // \" in \" // ftoa ( delay ) // \"s\" , & [ log_int ( \"exit_code\" , code ), log_int ( \"restart_count\" , attempt ), log_real ( \"delay_ms\" , delay * 100 0.0 )]) call sleep_seconds ( delay ) end do stop 0 end subroutine supervisor_loop !> Own all descendant graph workspaces until the complete child execution ends. !! !! A forced group/job termination can prevent child cleanup. The surviving !! supervisor removes the entire private tree, including nested supervisors' !! workspaces, after execution and restores its inherited workspace selection. subroutine execute_supervised_child ( command , code , interrupted ) character ( len =* ), intent ( in ) :: command integer , intent ( out ) :: code logical , intent ( out ) :: interrupted character ( len = :), allocatable :: workspace , inherited_root logical :: root_defined integer :: environment_status type ( error_t ), allocatable :: error code = 127 interrupted = . false . inherited_root = get_env ( \"FPM_WATCH_WORKSPACE_ROOT\" ) call get_environment_variable ( \"FPM_WATCH_WORKSPACE_ROOT\" , status = environment_status ) root_defined = environment_status == 0 call create_temp_directory ( workspace , error ) if (. not . allocated ( error )) call set_workspace_root ( workspace , error ) if ( allocated ( error )) then call log_event ( \"error\" , \"supervisor.workspace_failed\" , error % message ) call remove_temp_directory ( workspace ) stop 127 end if call execute_command ( command , code , interrupted ) call set_workspace_root ( inherited_root , error , defined = root_defined ) call remove_temp_directory ( workspace ) if ( allocated ( error )) then call log_event ( \"error\" , \"supervisor.workspace_failed\" , error % message ) stop 127 end if end subroutine execute_supervised_child !> Serialize child argv with a generation counter and the parent's log format. !! !! Remove supervisor flags and prior log-format/child markers from the leading !! watcher options. Preserve other leading values and every forwarded token !! after the subcommand, quoting each original argv token independently. function build_child_command ( exe0 , log_format , restart_count ) result ( cmd ) character ( len =* ), intent ( in ) :: exe0 character ( len =* ), intent ( in ) :: log_format integer , intent ( in ) :: restart_count character ( len = :), allocatable :: cmd character ( len = :), allocatable :: exe , a integer :: narg , i logical :: skip_next , copy_next , in_prefix exe = choose_self_exe ( exe0 ) cmd = quote_arg ( exe ) // \" --watch-child=\" // str ( restart_count ) // \" --watch-log-format \" // log_format narg = command_argument_count () skip_next = . false . copy_next = . false . in_prefix = . true . do i = 1 , narg a = get_arg ( i ) if (. not . in_prefix ) then cmd = cmd // \" \" // quote_arg ( a ) cycle end if if ( skip_next ) then skip_next = . false . cycle end if if ( copy_next ) then copy_next = . false . cmd = cmd // \" \" // quote_arg ( a ) cycle end if if (. not . starts_with ( a , \"--watch-\" ) . and . a /= \"-q\" . and . a /= \"-v\" . and . a /= \"-vv\" ) then in_prefix = . false . cmd = cmd // \" \" // quote_arg ( a ) cycle end if if ( a == \"--watch-auto-restart\" . or . starts_with ( a , \"--watch-auto-restart=\" )) cycle if ( a == \"--watch-child\" ) cycle if ( starts_with ( a , \"--watch-child=\" )) cycle select case ( a ) case ( \"--watch-restart-delay\" , \"--watch-restart-max\" , \"--watch-self\" , \"--watch-log-format\" ) skip_next = . true . cycle case default continue end select if ( starts_with ( a , \"--watch-restart-delay=\" )) cycle if ( starts_with ( a , \"--watch-restart-max=\" )) cycle if ( starts_with ( a , \"--watch-self=\" )) cycle if ( starts_with ( a , \"--watch-log-format=\" )) cycle copy_next = watch_option_takes_value ( a ) cmd = cmd // \" \" // quote_arg ( a ) end do end function build_child_command !> Determine the executable to use when spawning the child watcher. !! !! Precedence: !! 1. Explicit `exe0` argument !! 2. Environment `FPM_WATCH_SELF` !! 3. `argv[0]` !! 4. Fallback `\"fpm-watch\"` function choose_self_exe ( exe0 ) result ( exe ) character ( len =* ), intent ( in ) :: exe0 character ( len = :), allocatable :: exe character ( len = 2048 ) :: buf integer :: n , stat character ( len = :), allocatable :: a0 if ( len_trim ( exe0 ) > 0 ) then exe = trim ( exe0 ) return end if buf = \"\" n = 0 stat = 0 call get_environment_variable ( \"FPM_WATCH_SELF\" , buf , length = n , status = stat ) if ( stat == 0 . and . n > 0 ) then exe = trim ( buf ( 1 : n )) return end if a0 = get_arg ( 0 ) if ( len_trim ( a0 ) > 0 ) then exe = trim ( a0 ) return end if exe = \"fpm-watch\" end function choose_self_exe end module watch_restart","tags":"","url":"sourcefile/watch_restart.f90.html"},{"title":"watch_engine.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_engine.f90~~EfferentGraph sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_banner.f90 watch_banner.f90 sourcefile~watch_engine.f90->sourcefile~watch_banner.f90 sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_engine.f90->sourcefile~watch_cli.f90 sourcefile~watch_exec.f90 watch_exec.f90 sourcefile~watch_engine.f90->sourcefile~watch_exec.f90 sourcefile~watch_fingerprint.f90 watch_fingerprint.f90 sourcefile~watch_engine.f90->sourcefile~watch_fingerprint.f90 sourcefile~watch_graph_worker.f90 watch_graph_worker.f90 sourcefile~watch_engine.f90->sourcefile~watch_graph_worker.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_engine.f90->sourcefile~watch_log.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_engine.f90->sourcefile~watch_platform.f90 sourcefile~watch_time.f90 watch_time.f90 sourcefile~watch_engine.f90->sourcefile~watch_time.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_engine.f90->sourcefile~watch_types.f90 sourcefile~watch_banner.f90->sourcefile~watch_log.f90 sourcefile~watch_banner.f90->sourcefile~watch_types.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_banner.f90->sourcefile~watch_util.f90 sourcefile~watch_cli.f90->sourcefile~watch_log.f90 sourcefile~watch_cli.f90->sourcefile~watch_platform.f90 sourcefile~watch_cli.f90->sourcefile~watch_types.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_config.f90 watch_config.f90 sourcefile~watch_cli.f90->sourcefile~watch_config.f90 sourcefile~watch_exec.f90->sourcefile~watch_log.f90 sourcefile~watch_exec.f90->sourcefile~watch_platform.f90 sourcefile~watch_exec.f90->sourcefile~watch_types.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_exec.f90->sourcefile~watch_util.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_log.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_platform.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_types.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_fpm_graph.f90 watch_fpm_graph.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_fpm_graph.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_util.f90 sourcefile~watch_cmdsplice.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_config.f90->sourcefile~watch_types.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_log.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_platform.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_types.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_util.f90 sourcefile~watch_filter.f90 watch_filter.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_filter.f90 sourcefile~watch_filter.f90->sourcefile~watch_util.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Portable polling, watch-list refreshes, and synchronous command execution. !! !! The engine debounces changes, maps source edits to run/test targets, and !! refreshes the graph after watched configuration edits or optional periodic rescans. !! Failed refreshes preserve the accepted watch list. Commands block polling; !! ordinary command failures do not terminate continuous watching. module watch_engine use , intrinsic :: iso_fortran_env , only : int64 use watch_types , only : watch_config_t , root_info_t , watch_snapshot_t use watch_log , only : log_event , log_int , log_real , log_string , configure_logging use fpm_error , only : error_t use watch_graph_worker , only : compute_watch_snapshot use watch_fingerprint , only : init_fingerprints , scan_changes , accept_changes , manifest_key_from_files , watch_state_changed , preserve_fingerprints use watch_cli , only : parse_cli_config use watch_platform , only : termination_requested use watch_time , only : sleep_seconds use watch_exec , only : report_changes , build_run_command , run_command_and_report use watch_banner , only : print_banner , print_file_list , print_configuration use fpm_strings , only : string_t , str use fpm_filesystem , only : basename , exists , join_path , canon_path , is_absolute_path use fpm_os , only : get_current_directory implicit none private public watcher_t !> Accepted configuration and one aligned watch-state snapshot. !! !! File masks and roots describe affected-target membership. `man_prev` stores the !! last manifest/settings key for debug diagnostics. A failed manifest refresh !! leaves a retry flag while accepted configuration and watch-list state are retained. type watcher_t !> Accepted watcher settings and serialized fpm command. type ( watch_config_t ) :: cfg !> Aligned accepted paths, root membership, and fingerprint baselines. type ( watch_snapshot_t ) :: snapshot !> Manifest/settings key from the last successful refresh, used for diagnostics. integer ( int64 ) :: man_prev = 0_int64 !> Most recent command exit status; zero before a run, propagated by one-shot mode. integer :: last_exit = 0 !> Last graph-refresh error text, retained to suppress repeated diagnostics. character ( len = :), allocatable :: last_refresh_error !> Retry manifest settings/graph refresh on a later edit or periodic rescan. logical :: manifest_refresh_pending = . false . contains procedure :: init => watcher_init procedure :: run => watcher_run end type watcher_t contains !> Initialize logging, the watch list, and fingerprints. !! !! A failed initial graph terminates with status 1. Run the full configured command if !! `run_on_start` is enabled, including in one-shot mode. subroutine watcher_init ( self , cfg ) class ( watcher_t ), intent ( inout ) :: self type ( watch_config_t ), intent ( in ) :: cfg !! Parsed configuration with allocated model settings and normalized watcher options. type ( error_t ), allocatable :: error self % cfg = cfg call configure_logging ( cfg % w ) if (. not . allocated ( self % cfg % project_dir )) then call get_current_directory ( self % cfg % project_dir , error ) if ( allocated ( error )) then call log_event ( \"error\" , \"watch.directory_failed\" , error % message ) stop 1 end if end if self % last_exit = 0 self % manifest_refresh_pending = . false . if ( allocated ( self % last_refresh_error )) deallocate ( self % last_refresh_error ) call rebuild_watch_list ( self , print_header = . true .) if ( self % cfg % w % run_on_start ) then call run_once ( self , trim ( self % cfg % fpm_cmdline )) end if end subroutine watcher_init !> Poll until a stop file or termination request is detected. !! !! Return immediately in one-shot mode. Otherwise sleep, fingerprint files, !! debounce detected changes, and resample before acting. A watched manifest !! change or pending manifest refresh reparses settings and refreshes the graph. !! Other edits select an affected-target command, accept sampled fingerprints, !! and refresh dependency membership before running. A changed target mapping !! or failed refresh falls back to the original command. Existing baselines survive !! the refresh so edits during synchronous commands are detected on the next poll. !! !! Optional rescans refresh the graph and run the full command if paths or !! fingerprints changed. A pending manifest refresh is retried on later edits !! or rescans. Stop-file checks occur between commands and around waits. subroutine watcher_run ( self ) class ( watcher_t ), intent ( inout ) :: self integer :: changed_count character ( len = :), allocatable :: cmd logical :: rescan_changed , refreshed , selection_changed integer ( int64 ) :: rate , t_last_rescan , t_now real :: dt if ( self % cfg % w % once ) return call system_clock ( count_rate = rate ) if ( rate <= 0_int64 ) rate = 1000_int64 call system_clock ( t_last_rescan ) do if ( termination_requested ()) exit if ( exists ( join_path ( self % cfg % project_dir , \".fpm-watch.stop\" ))) exit call sleep_seconds ( self % cfg % w % poll ) if ( termination_requested ()) exit if ( exists ( join_path ( self % cfg % project_dir , \".fpm-watch.stop\" ))) exit call scan_changes ( self % snapshot % files , self % snapshot % fp_prev , self % snapshot % fp_now , self % snapshot % changed_idx , changed_count ) if ( changed_count > 0 ) then call sleep_seconds ( self % cfg % w % debounce ) if ( termination_requested ()) exit if ( exists ( join_path ( self % cfg % project_dir , \".fpm-watch.stop\" ))) exit call scan_changes ( self % snapshot % files , self % snapshot % fp_prev , self % snapshot % fp_now , self % snapshot % changed_idx , changed_count ) end if if ( changed_count > 0 ) then if ( self % manifest_refresh_pending . or . & any_configuration_changed ( self % snapshot % files , self % snapshot % changed_idx , changed_count , & self % cfg % response_files )) then call accept_changes ( self % snapshot % fp_prev , self % snapshot % fp_now , self % snapshot % changed_idx , changed_count ) call handle_manifest_change ( self , refreshed ) cycle end if call report_changes ( self % snapshot % files , self % snapshot % changed_idx , changed_count , self % cfg % w ) cmd = build_run_command ( & settings = self % cfg % settings , & full_cmdline = self % cfg % fpm_cmdline , & cmd_prefix = self % cfg % cmd_prefix , & cmd_rest = self % cfg % cmd_rest , & roots = self % snapshot % roots , & file_mask = self % snapshot % file_mask , & changed_idx = self % snapshot % changed_idx , & changed_count = changed_count ) call accept_changes ( self % snapshot % fp_prev , self % snapshot % fp_now , self % snapshot % changed_idx , changed_count ) call rebuild_watch_list ( self , print_header = . false ., refreshed = refreshed , & preserve_baseline = . true ., selection_changed = selection_changed ) if (. not . refreshed . or . selection_changed ) cmd = self % cfg % fpm_cmdline call run_once ( self , cmd ) if ( termination_requested ()) exit end if if ( self % cfg % w % rescan > 0.0 ) then call system_clock ( t_now ) if ( t_now < t_last_rescan ) then t_last_rescan = t_now else dt = real ( t_now - t_last_rescan ) / real ( rate ) if ( dt >= self % cfg % w % rescan ) then call log_event ( \"info\" , \"watch.rescan\" , \"Rescanning watch list\" , verbosity = 1 ) if ( self % manifest_refresh_pending ) then call handle_manifest_change ( self , refreshed ) else call rebuild_watch_list ( self , print_header = . false ., watch_changed = rescan_changed , preserve_baseline = . true .) if ( rescan_changed ) call run_once ( self , self % cfg % fpm_cmdline ) end if call system_clock ( t_last_rescan ) end if end if end if end do if ( termination_requested ()) then call log_event ( \"info\" , \"watch.stopped\" , \"Stopped watching\" , [ log_string ( \"reason\" , \"interrupt\" )]) else call log_event ( \"info\" , \"watch.stopped\" , \"Stopped watching\" , [ log_string ( \"reason\" , \"stop_file\" )]) end if end subroutine watcher_run !> Reparse settings, refresh the graph, and run after a configuration change. !! !! Pin the current log format. On refresh failure restore the accepted !! configuration and leave a retry pending. On success accept the new settings, !! update the manifest/settings key and run the full !! command. `refreshed` reports graph-refresh success, not command success. subroutine handle_manifest_change ( self , refreshed ) class ( watcher_t ), intent ( inout ) :: self logical , intent ( out ) :: refreshed type ( watch_config_t ) :: old_cfg type ( error_t ), allocatable :: error refreshed = . false . old_cfg = self % cfg if (. not . self % manifest_refresh_pending ) then call log_event ( \"info\" , \"watch.manifest_changed\" , \"Configuration changed; refreshing watch list\" ) end if self % manifest_refresh_pending = . true . call parse_cli_config ( self % cfg , log_format = old_cfg % w % log_format , error = error ) if ( allocated ( error )) then self % cfg = old_cfg call configure_logging ( self % cfg % w ) call report_refresh_error ( self , error % message ) return end if call rebuild_watch_list ( self , print_header = . false ., refreshed = refreshed , preserve_baseline = . true .) if (. not . refreshed ) then self % cfg = old_cfg call configure_logging ( self % cfg % w ) return end if self % manifest_refresh_pending = . false . call run_once ( self , self % cfg % fpm_cmdline ) end subroutine handle_manifest_change !> Return whether changed manifests or response candidates require reparsing settings. !! !! Manifest detection uses the basename and therefore triggers if any !! watched `fpm.toml` changes (main or dependency manifests). !! Response paths are absolute candidates supplied by the CLI adapter. logical function any_configuration_changed ( files , changed_idx , changed_count , response_files ) result ( hit ) type ( string_t ), allocatable , intent ( in ) :: files (:) integer , intent ( in ) :: changed_idx (:) integer , intent ( in ) :: changed_count type ( string_t ), allocatable , intent ( in ) :: response_files (:) integer :: j , idx , k character ( len = :), allocatable :: b hit = . false . if (. not . allocated ( files )) return do j = 1 , changed_count idx = changed_idx ( j ) if ( idx < 1 . or . idx > size ( files )) cycle b = basename ( files ( idx )% s ) if ( b == \"fpm.toml\" ) then hit = . true . return end if if (. not . allocated ( response_files )) cycle do k = 1 , size ( response_files ) if ( files ( idx )% s /= response_files ( k )% s ) cycle hit = . true . return end do end do end function any_configuration_changed !> Keep one actionable refresh diagnostic while retaining the accepted snapshot. subroutine report_refresh_error ( self , message ) class ( watcher_t ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: message if ( allocated ( self % last_refresh_error )) then if ( self % last_refresh_error == message ) return end if self % last_refresh_error = message call log_event ( \"error\" , \"watch.refresh_failed\" , \"Watch list refresh failed: \" // message // \"; waiting for edits\" ) end subroutine report_refresh_error !> Execute one command cycle and retain its status. !! !! Store the resulting exit status in `self%last_exit`; command failure does not stop !! the engine. Used for startup, edits, manifest refreshes, and rescans. subroutine run_once ( self , cmd0 ) class ( watcher_t ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: cmd0 character ( len = :), allocatable :: cmd integer :: exitstat real :: secs if ( termination_requested ()) then self % last_exit = 130 return end if cmd = trim ( cmd0 ) call run_command_and_report ( cmd , self % cfg % w , exitstat , secs ) self % last_exit = exitstat end subroutine run_once !> Build a candidate graph and replace the accepted watch-list snapshot. !! !! `print_header` selects initialization: failures exit with status 1, and !! success prints startup details. Later failures preserve files, masks, roots, !! fingerprints, and accepted model settings; identical diagnostics are suppressed. !! `refreshed` is true only after success. If requested, `watch_changed` compares !! paths and fingerprints with the old snapshot before resetting the baseline. !! A source-triggered refresh preserves baselines so concurrent edits remain pending. subroutine rebuild_watch_list ( self , print_header , watch_changed , refreshed , preserve_baseline , selection_changed ) class ( watcher_t ), intent ( inout ) :: self logical , intent ( in ) :: print_header !! True for initial setup (fatal errors and startup logging); false for recoverable refreshes. logical , intent ( out ), optional :: watch_changed !! True on a successful refresh if paths or fingerprints differ from the previous snapshot. logical , intent ( out ), optional :: refreshed !! True only after the candidate graph and new fingerprint baseline are accepted. logical , intent ( in ), optional :: preserve_baseline !! Preserve accepted baselines for existing paths while initializing new paths. logical , intent ( out ), optional :: selection_changed !! True unless paths, root bits, and root names match the accepted selection mapping. integer ( int64 ) :: rate , t0 , t1 , candidate_manifest_key real :: build_secs_total real :: secs_model , secs_targets , secs_watch integer :: nfiles , nroots , i logical :: preserve character ( len = :), allocatable :: original_directory real :: dummy_build type ( string_t ), allocatable :: new_files (:) integer ( int64 ), allocatable :: new_mask (:) type ( root_info_t ), allocatable :: new_roots (:) type ( string_t ), allocatable :: old_files (:) integer ( int64 ), allocatable :: old_fp (:) type ( watch_config_t ) :: candidate_cfg type ( error_t ), allocatable :: error if ( present ( watch_changed )) watch_changed = . false . if ( present ( refreshed )) refreshed = . false . if ( present ( selection_changed )) selection_changed = . true . candidate_cfg = self % cfg preserve = . false . if ( present ( preserve_baseline )) preserve = preserve_baseline if ( present ( watch_changed ) . or . preserve ) then if ( allocated ( self % snapshot % files )) old_files = self % snapshot % files if ( allocated ( self % snapshot % fp_prev )) old_fp = self % snapshot % fp_prev end if call system_clock ( count_rate = rate ) if ( rate <= 0_int64 ) rate = 1000_int64 call system_clock ( t0 ) call get_current_directory ( original_directory , error ) if (. not . allocated ( error )) then call compute_watch_snapshot ( & cfg = candidate_cfg , & files = new_files , & file_mask = new_mask , & roots = new_roots , & manifest_key = candidate_manifest_key , & build_secs = dummy_build , & secs_model = secs_model , & secs_targets = secs_targets , & secs_watch = secs_watch , & error = error ) end if if ( termination_requested ()) return if (. not . allocated ( error )) then if ( canon_path ( original_directory ) /= canon_path ( self % cfg % project_dir )) then do i = 1 , size ( new_files ) if ( is_absolute_path ( new_files ( i )% s )) cycle new_files ( i )% s = canon_path ( join_path ( self % cfg % project_dir , new_files ( i )% s )) end do end if end if if ( allocated ( error )) then if ( print_header ) then call log_event ( \"error\" , \"watch.init_failed\" , \"Cannot initialize watch list: \" // error % message ) stop 1 end if call report_refresh_error ( self , error % message ) return end if if ( allocated ( self % last_refresh_error )) deallocate ( self % last_refresh_error ) if ( present ( selection_changed )) then selection_changed = watch_state_changed ( self % snapshot % files , self % snapshot % file_mask , new_files , new_mask ) if (. not . selection_changed ) selection_changed = root_mapping_changed ( self % snapshot % roots , new_roots ) end if call move_alloc ( candidate_cfg % settings , self % cfg % settings ) call move_alloc ( new_files , self % snapshot % files ) call move_alloc ( new_mask , self % snapshot % file_mask ) call move_alloc ( new_roots , self % snapshot % roots ) self % man_prev = manifest_key_from_files ( self % cfg % settings , self % snapshot % files ) call init_fingerprints ( self % snapshot % files , self % snapshot % fp_prev , self % snapshot % fp_now , self % snapshot % changed_idx ) if ( preserve ) call preserve_fingerprints ( old_files , old_fp , self % snapshot % files , self % snapshot % fp_prev ) if ( present ( watch_changed )) then watch_changed = watch_state_changed ( old_files , old_fp , self % snapshot % files , self % snapshot % fp_prev ) end if if ( present ( refreshed )) refreshed = . true . call system_clock ( t1 ) build_secs_total = real ( t1 - t0 ) / real ( rate ) nfiles = 0 if ( allocated ( self % snapshot % files )) nfiles = size ( self % snapshot % files ) nroots = 0 if ( allocated ( self % snapshot % roots )) nroots = size ( self % snapshot % roots ) if ( self % cfg % w % debug ) then call log_event ( \"debug\" , \"watch.fingerprint\" , \"Watch graph fingerprint updated\" , & [ log_int ( \"manifest_key\" , self % man_prev ), log_int ( \"root_count\" , nroots ), log_int ( \"file_count\" , nfiles )]) end if if ( print_header ) then call print_banner ( & full_cmdline = self % cfg % fpm_cmdline , & settings = self % cfg % settings , & w = self % cfg % w , & files = self % snapshot % files , & build_secs = build_secs_total , & roots_count = nroots , & secs_model = secs_model , & secs_targets = secs_targets , & secs_watch = secs_watch ) if ( self % cfg % w % print_files_once ) call print_file_list ( self % snapshot % files , self % cfg % w ) else call print_configuration ( self % cfg % settings , self % cfg % w ) call log_event ( \"info\" , \"watch.refreshed\" , \"Watch list updated; \" // str ( nfiles ) // \" files\" , & [ log_int ( \"file_count\" , nfiles ), log_real ( \"duration_ms\" , build_secs_total * 100 0.0 )], verbosity = 1 ) if ( self % cfg % w % verbosity >= 2 ) call print_file_list ( self % snapshot % files , self % cfg % w ) end if end subroutine rebuild_watch_list !> Return whether root names or their bits changed during a dependency refresh. pure logical function root_mapping_changed ( old_roots , new_roots ) result ( changed ) type ( root_info_t ), allocatable , intent ( in ) :: old_roots (:), new_roots (:) integer :: i changed = . true . if (. not . allocated ( old_roots ) . or . . not . allocated ( new_roots )) return if ( size ( old_roots ) /= size ( new_roots )) return do i = 1 , size ( old_roots ) if ( old_roots ( i )% mask /= new_roots ( i )% mask ) return if (. not . allocated ( old_roots ( i )% name ) . or . . not . allocated ( new_roots ( i )% name )) return if ( old_roots ( i )% name /= new_roots ( i )% name ) return end do changed = . false . end function root_mapping_changed end module watch_engine","tags":"","url":"sourcefile/watch_engine.f90.html"},{"title":"watch_util.f90 – fpm-watch","text":"Files dependent on this one sourcefile~~watch_util.f90~~AfferentGraph sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_banner.f90 watch_banner.f90 sourcefile~watch_banner.f90->sourcefile~watch_util.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_banner.f90->sourcefile~watch_log.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_util.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platf