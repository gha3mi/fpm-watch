imiters = \" \" // achar ( 9 ) // achar ( 13 )) if ( size ( words ) == 0 ) cycle record = lower ( trim ( words ( 1 ))) if ( starts_with ( record , \"#\" ) . or . starts_with ( record , \"@\" ) . or . record == \"comment\" ) cycle has_records = . true . if ( after_os_header ) has_os_records = . true . end do close ( unit ) if ( status > 0 ) call fatal_error ( error , \"Cannot read response file \" // path ) end subroutine inspect_response_candidate","tags":"","url":"proc/inspect_response_candidate.html"},{"title":"parse_cli – fpm-watch","text":"private  subroutine parse_cli(w, settings, fpm_cmdline, subcmd, project_dir, first_arg, response_mode, response_subcmd, log_format) Apply watcher defaults and leading flags, then collect fpm model settings. Watcher flags stop at the subcommand. Recognized fpm options accept either --key=value or a following token; model parsing stops at -- , while all\nforwarded tokens remain in the command. Toolchain defaults come from get_fpm_env ; CLI values replace them. Include/ignore flags append\nunique manifest entries, and verbose flags raise the current level.\nInvalid commands, log formats, or missing required values exit with status 2. Arguments Type Intent Optional Attributes Name type( watch_opts_t ), intent(out) :: w class(fpm_build_settings), intent(out), allocatable :: settings character(len=:), intent(out), allocatable :: fpm_cmdline character(len=:), intent(out), allocatable :: subcmd character(len=*), intent(in) :: project_dir integer, intent(in) :: first_arg logical, intent(in) :: response_mode character(len=*), intent(in) :: response_subcmd character(len=*), intent(in), optional :: log_format Calls proc~~parse_cli~~CallsGraph proc~parse_cli parse_cli get_fpm_env get_fpm_env proc~parse_cli->get_fpm_env join_path join_path proc~parse_cli->join_path proc~add_features_csv add_features_csv proc~parse_cli->proc~add_features_csv proc~add_target_names add_target_names proc~parse_cli->proc~add_target_names proc~apply_watch_argumen