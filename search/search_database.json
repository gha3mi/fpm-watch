 before resetting the baseline.\nRecompute the manifest/settings key after the watch-list plugin callback. Arguments Type Intent Optional Attributes Name class( watcher_t ), intent(inout) :: self logical, intent(in) :: print_header True for initial setup (fatal errors and startup logging); false for recoverable refreshes. logical, intent(out), optional :: watch_changed True on a successful refresh if paths or fingerprints differ from the previous snapshot. logical, intent(out), optional :: refreshed True only after the candidate graph and new fingerprint baseline are accepted. Calls proc~~rebuild_watch_list~~CallsGraph proc~rebuild_watch_list rebuild_watch_list interface~log_int log_int proc~rebuild_watch_list->interface~log_int proc~compute_watch_files_from_settings compute_watch_files_from_settings proc~rebuild_watch_list->proc~compute_watch_files_from_settings proc~init_fingerprints init_fingerprints proc~rebuild_watch_list->proc~init_fingerprints proc~log_event log_event proc~rebuild_watch_list->proc~log_event proc~log_real log_real proc~rebuild_watch_list->proc~log_real proc~manifest_key_from_files manifest_key_from_files proc~rebuild_watch_list->proc~manifest_key_from_files proc~on_watch_list_built_all feature_manager_t%on_watch_list_built_all proc~rebuild_watch_list->proc~on_watch_list_built_all proc~print_banner print_banner proc~rebuild_watch_list->proc~print_banner proc~print_configuration print_configuration proc~rebuild_watch_list->proc~print_configuration proc~print_file_list print_file_list proc~rebuild_watch_list->proc~print_file_list proc~watch_state_changed watch_state_changed proc~rebuild_watch_list->proc~watch_state_changed str str proc~rebuild_watch_list->str proc~log_default_int log_default_int interface~log_int->proc~log_default_int proc~log_int64 log_int64 interface~log_int->proc~log_int64 proc~compute_watch_files_from_settings->interface~log_int proc~compute_watch_files_from_settings->proc~log_event proc~compute_watch_files_from_settings->pro