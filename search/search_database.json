.false. Enable debug-level records; quiet mode still suppresses them. character(len=:), public, allocatable :: fpm_executable Executable used for build/test/run; defaults to fpm on PATH. type(string_t), public, allocatable :: ignore (:) Ignore globs, applied after include rules; manifest/version metadata bypass filtering. type(string_t), public, allocatable :: include (:) Include globs; empty means all eligible files. Manifest/version metadata always remain. logical, public :: is_child = .false. Internal child marker preventing recursive supervision. character(len=:), public, allocatable :: log_format Output format: text (default), json (JSON Lines), or logfmt. logical, public :: once = .false. Run once (init + optional run-on-start) and exit (CI-friendly). logical, public :: output_markers = .false. Bracket command stderr and force cycle events in structured logging only. real, public :: poll = 0.5 Seconds between polling scans; normalized to at least 0.05. logical, public :: print_files_once = .false. Request a startup file list; the logger additionally requires verbosity 2. real, public :: rescan = 0.0 Optional periodic rescan interval (seconds). 0 disables periodic rescans. integer, public :: restart_count = 0 Internal supervisor generation, retained during manifest refresh. real, public :: restart_delay = 1.0 Seconds between failed child exits and the next launch. integer, public :: restart_max = 0 Maximum restarts after initial launch; zero means unlimited. logical, public :: run_on_start = .true. Run the command once immediately on startup. character(len=:), public, allocatable :: self_exe Explicit supervisor child executable, otherwise resolved from argv/environment. logical, public :: silent_fpm = .false. Suppress both command output streams; watcher and model records remain separate. integer, public :: verbosity = 0 Verbosity level: Read more… logical, public :: watch_deps = .false. Also watch dependency project sources (can include paths under build dir).