 (flag) Set the process-wide waiting backend: true selects OS sleep, false selects busy waiting. Arguments Type Intent Optional Attributes Name logical, intent(in) :: flag public  subroutine sleep_seconds (s) Wait approximately s seconds using the currently selected backend. Read more… Arguments Type Intent Optional Attributes Name real, intent(in) :: s private  subroutine sleep_os (s) Convert seconds to C double and invoke the OS-sleep shim; nonpositive durations are ignored there. Arguments Type Intent Optional Attributes Name real, intent(in) :: s private  subroutine sleep_spin (s) Busy-wait for the truncated number of system-clock ticks in s seconds. Read more… Arguments Type Intent Optional Attributes Name real, intent(in) :: s","tags":"","url":"module/watch_time.html"},{"title":"watch_feature_api.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_feature_api.f90~~EfferentGraph sourcefile~watch_feature_api.f90 watch_feature_api.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_feature_api.f90->sourcefile~watch_types.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_feature_api.f90~~AfferentGraph sourcefile~watch_feature_api.f90 watch_feature_api.f90 sourcefile~watch_feat_stats.f90 watch_feat_stats.f90 sourcefile~watch_feat_stats.f90->sourcefile~watch_feature_api.f90 sourcefile~watch_feature_factory.f90 watch_feature_factory.f90 sourcefile~watch_feature_factory.f90->sourcefile~watch_feature_api.f90 sourcefile~watch_feature_factory.f90->sourcefile~watch_feat_stats.f90 sourcefile~watch_feature_manager.f90 watch_feature_manager.f90 sourcefile~watch_feature_factory.f90->sourcefile~watch_feature_manager.f90 sourcefile~watch_feature_manager.f90->sourcefile~watch_feature_api.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_feature_factory.f90 sourcefile~watch_engine.f90->sourcefile~watch_feature_manager.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Synchronous watcher-plugin callbacks with overridable no-op defaults. !! !! Initialization calls `init`, then `on_start`, then `on_watch_list_built`. !! Successful refreshes call `on_watch_list_built` again. Manifest refreshes !! additionally call `on_manifest_changed` only if the manifest/settings key !! differs. Ordinary source changes call `on_change_detected` before execution; !! every command calls `on_before_run`, then `on_after_run`, including failures. !! !! Watch-list and command callbacks receive mutable arguments. Callbacks must !! preserve file/root ordering and membership because per-file masks are managed !! separately by the engine. Plugins are enabled at initialization, not refreshed !! when manifest plugin settings change. module watch_feature_api use , intrinsic :: iso_fortran_env , only : int64 use watch_types , only : watch_config_t , root_info_t use fpm_strings , only : string_t implicit none private public watch_feature_t !> Base feature type (override callbacks to implement behavior). type watch_feature_t contains procedure :: init => feat_init_noop procedure :: on_start => feat_noop procedure :: on_watch_list_built => feat_list_noop procedure :: on_manifest_changed => feat_manifest_noop procedure :: on_change_detected => feat_change_noop procedure :: on_before_run => feat_before_noop procedure :: on_after_run => feat_after_noop end type watch_feature_t contains !> No-op init callback. subroutine feat_init_noop ( self , cfg ) class ( watch_feature_t ), intent ( inout ) :: self type ( watch_config_t ), intent ( in ) :: cfg if (. false .) then if ( cfg % w % verbosity < - 1 ) continue end if end subroutine feat_init_noop !> No-op start callback. subroutine feat_noop ( self ) class ( watch_feature_t ), intent ( inout ) :: self end subroutine feat_noop !> No-op watch-list callback; overrides must preserve file/root alignment with engine masks. subroutine feat_list_noop ( self , files , roots ) class ( watch_feature_t ), intent ( inout ) :: self type ( string_t ), allocatable , intent ( inout ) :: files (:) !! Accepted path list; overrides must preserve alignment with the engine-owned per-file masks. type ( root_info_t ), allocatable , intent ( inout ) :: roots (:) !! Root names/bits; overrides must preserve membership represented in file masks. if (. false .) then if ( allocated ( files )) continue if ( allocated ( roots )) continue end if end subroutine feat_list_noop !> No-op callback for manifest key change. subroutine feat_manifest_noop ( self , old_key , new_key ) class ( watch_feature_t ), intent ( inout ) :: self integer ( int64 ), intent ( in ) :: old_key , new_key if (. false .) then if ( old_key == new_key ) continue end if end subroutine feat_manifest_noop !> No-op callback for detected file changes. subroutine feat_change_noop ( self , changed ) class ( watch_feature_t ), intent ( inout ) :: self type ( string_t ), allocatable , intent ( in ) :: changed (:) if (. false .) then if ( allocated ( changed )) continue end if end subroutine feat_change_noop !> No-op command callback; overrides may replace the allocated command before execution. subroutine feat_before_noop ( self , cmd ) class ( watch_feature_t ), intent ( inout ) :: self character ( len = :), allocatable , intent ( inout ) :: cmd !! Allocated command string that an override may modify before it is executed. if (. false .) then if ( allocated ( cmd )) continue end if end subroutine feat_before_noop !> No-op completion callback receiving the command status and elapsed seconds, including failures. subroutine feat_after_noop ( self , exitstat , seconds ) class ( watch_feature_t ), intent ( inout ) :: self integer , intent ( in ) :: exitstat !! Command exit status, including failures and interruptions. real , intent ( in ) :: seconds !! Measured duration of the command in seconds. if (. false .) then if ( exitstat /= 0 ) continue if ( seconds < 0.0 ) continue end if end subroutine feat_after_noop end module watch_feature_api","tags":"","url":"sourcefile/watch_feature_api.f90.html"},{"title":"watch_fingerprint.f90 – fpm-watch","text":"Files dependent on this one sourcefile~~watch_fingerprint.f90~~AfferentGraph sourcefile~watch_fingerprint.f90 watch_fingerprint.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_fingerprint.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Sample file contents and compare watch-list snapshots. !! !! Fingerprints mix file size with FNV-style samples of at most three 4096-byte !! blocks: head, middle, and tail. Same-size edits outside the sampled regions !! can be missed. Fingerprints are change-detection heuristics, not content IDs. !! File reads share a reusable module buffer and are intended for serial use. module watch_fingerprint use , intrinsic :: iso_fortran_env , only : int64 use fpm_strings , only : string_t use fpm_filesystem , only : basename use fpm_command_line , only : fpm_build_settings implicit none private public init_fingerprints , scan_changes , accept_changes , manifest_key_from_files , file_fingerprint , watch_state_changed integer ( int64 ), parameter :: FNV_OFFSET = 1469598103934665603_int64 integer ( int64 ), parameter :: FNV_PRIME = 1099511628211_int64 integer , parameter :: BLOCK_SIZE = 4096 !> Shared 4096-byte scratch buffer; file fingerprinting is not reentrant. character ( len = 1 ), allocatable , save :: io_buf (:) contains !> Compare unique path/fingerprint snapshots independently of file ordering. !! !! Unallocated path lists count as empty. Added/removed paths, changed !! fingerprints, or missing/mismatched fingerprint arrays for nonempty lists !! report a change. Two empty snapshots compare equal. pure logical function watch_state_changed ( old_files , old_fp , new_files , new_fp ) result ( changed ) type ( string_t ), allocatable , intent ( in ) :: old_files (:), new_files (:) integer ( int64 ), allocatable , intent ( in ) :: old_fp (:), new_fp (:) integer :: nold , nnew , i , j logical :: found nold = 0 nnew = 0 if ( allocated ( old_files )) nold = size ( old_files ) if ( allocated ( new_files )) nnew = size ( new_files ) changed = ( nold /= nnew ) if ( changed . or . nnew == 0 ) return changed = . true . if (. not . allocated ( old_fp )) return if (. not . allocated ( new_fp )) return if ( size ( old_fp ) /= nold . or . size ( new_fp ) /= nnew ) return do i = 1 , nnew found = . false . do j = 1 , nold if ( new_files ( i )% s /= old_files ( j )% s ) cycle if ( new_fp ( i ) /= old_fp ( j )) return found = . true . exit end do if (. not . found ) return end do changed = . false . end function watch_state_changed !> Initialize fingerprint arrays for a watch list. !! !! Allocates `fp_prev`, `fp_now`, and `changed_idx` to match the size of !! `files`. Initial fingerprints are computed once and copied into `fp_now`. subroutine init_fingerprints ( files , fp_prev , fp_now , changed_idx ) type ( string_t ), allocatable , intent ( in ) :: files (:) integer ( int64 ), allocatable , intent ( inout ) :: fp_prev (:) integer ( int64 ), allocatable , intent ( inout ) :: fp_now (:) integer , allocatable , intent ( inout ) :: changed_idx (:) integer :: n , i if (. not . allocated ( files )) then if ( allocated ( fp_prev )) deallocate ( fp_prev ) if ( allocated ( fp_now )) deallocate ( fp_now ) if ( allocated ( changed_idx )) deallocate ( changed_idx ) allocate ( fp_prev ( 0 ), fp_now ( 0 ), changed_idx ( 0 )) return end if n = size ( files ) if ( allocated ( fp_prev )) deallocate ( fp_prev ) if ( allocated ( fp_now )) deallocate ( fp_now ) if ( allocated ( changed_idx )) deallocate ( changed_idx ) allocate ( fp_prev ( n ), fp_now ( n ), changed_idx ( n )) do i = 1 , n fp_prev ( i ) = file_fingerprint ( files ( i )% s ) end do fp_now = fp_prev end subroutine init_fingerprints !> Resample files and return 1-based indices differing from the accepted baseline. !! !! `fp_prev`, `fp_now`, and `changed_idx` must have space for every file. !! Only `changed_idx(:changed_count)` is defined by this scan; `fp_prev` !! remains unchanged. An empty/unallocated file list reports no changes. subroutine scan_changes ( files , fp_prev , fp_now , changed_idx , changed_count ) type ( string_t ), allocatable , intent ( in ) :: files (:) integer ( int64 ), intent ( in ) :: fp_prev (:) integer ( int64 ), intent ( inout ) :: fp_now (:) integer , intent ( inout ) :: changed_idx (:) integer , intent ( out ) :: changed_count integer :: i , n changed_count = 0 if (. not . allocated ( files )) return n = size ( files ) if ( n == 0 ) return do i = 1 , n fp_now ( i ) = file_fingerprint ( files ( i )% s ) if ( fp_now ( i ) /= fp_prev ( i )) then changed_count = changed_count + 1 changed_idx ( changed_count ) = i end if end do end subroutine scan_changes !> Copy sampled fingerprints into the baseline for valid changed indices. !! !! The engine accepts ordinary edits after command completion even if fpm !! failed, and accepts failed manifest-refresh samples while retaining a retry !! flag. Invalid indices are skipped; both fingerprint arrays must be aligned. subroutine accept_changes ( fp_prev , fp_now , changed_idx , changed_count ) integer ( int64 ), intent ( inout ) :: fp_prev (:) integer ( int64 ), intent ( in ) :: fp_now (:) integer , intent ( in ) :: changed_idx (:) integer , intent ( in ) :: changed_count integer :: j , i do j = 1 , changed_count i = changed_idx ( j ) if ( i >= 1 . and . i <= size ( fp_prev )) fp_prev ( i ) = fp_now ( i ) end do end subroutine accept_changes !> Mix selected fpm settings and watched manifest paths/fingerprints into a key. !! !! Includes build directory, toolchain, profile, compile/link flags, pruning, !! build-tests, and fpm features. File and feature ordering affects the key. !! The engine compares keys for plugin notifications after successful manifest !! refreshes; this key does not trigger the refresh itself. integer ( int64 ) function manifest_key_from_files ( settings , files ) result ( k ) class ( fpm_build_settings ), intent ( in ) :: settings type ( string_t ), allocatable , intent ( in ) :: files (:) integer :: i character ( len = :), allocatable :: b k = FNV_OFFSET call mix_alloc ( k , settings % build_dir ) call mix_alloc ( k , settings % compiler ) call mix_alloc ( k , settings % c_compiler ) call mix_alloc ( k , settings % cxx_compiler ) call mix_alloc ( k , settings % archiver ) call mix_alloc ( k , settings % profile ) call mix_alloc ( k , settings % flag ) call mix_alloc ( k , settings % cflag ) call mix_alloc ( k , settings % cxxflag ) call mix_alloc ( k , settings % ldflag ) if ( settings % prune ) then call fnv1a_mix_str ( k , \"prune=1\" ) else call fnv1a_mix_str ( k , \"prune=0\" ) end if if ( settings % build_tests ) then call fnv1a_mix_str ( k , \"build_tests=1\" ) else call fnv1a_mix_str ( k , \"build_tests=0\" ) end if if ( allocated ( settings % features )) then do i = 1 , size ( settings % features ) call fnv1a_mix_str ( k , trim ( settings % features ( i )% s )) end do end if if (. not . allocated ( files )) return do i = 1 , size ( files ) b = basename ( files ( i )% s ) if ( b == \"fpm.toml\" ) then call fnv1a_mix_str ( k , files ( i )% s ) call fnv1a_mix_i64 ( k , file_fingerprint ( files ( i )% s )) end if end do contains !> Mix a right-trimmed, allocated, nonempty string into the current hash state. subroutine mix_alloc ( h , s ) integer ( int64 ), intent ( inout ) :: h character ( len = :), allocatable , intent ( in ) :: s if (. not . allocated ( s )) return if ( len_trim ( s ) == 0 ) return call fnv1a_mix_str ( h , trim ( s )) end subroutine mix_alloc end function manifest_key_from_files !> Mix file size with up to three sampled blocks of at most 4096 bytes each. !! !! Missing files, failed size inquiries, and nonpositive sizes return zero. !! If opening fails, return a size-only value mixed with the initial hash; !! failed block reads contribute nothing. Larger files sample head, middle, !! and tail, which may overlap. Uses the shared module scratch buffer. integer ( int64 ) function file_fingerprint ( path ) result ( fp ) character ( len =* ), intent ( in ) :: path !! File path to sample; trailing blanks are removed before inquiry/open. logical :: ex integer ( int64 ) :: sz , h , n64 , pos_mid , pos_end , pos_max integer :: u , ios , n inquire ( file = trim ( path ), exist = ex , size = sz , iostat = ios ) if ( ios /= 0 . or . . not . ex ) then fp = 0_int64 return end if if ( sz <= 0_int64 ) then fp = 0_int64 return end if n64 = min ( sz , int ( BLOCK_SIZE , int64 )) n = int ( n64 ) open ( newunit = u , file = trim ( path ), access = \"stream\" , form = \"unformatted\" , action = \"read\" , status = \"old\" , iostat = ios ) if ( ios /= 0 ) then fp = ieor ( ishft ( sz , 1 ), FNV_OFFSET ) return end if if (. not . allocated ( io_buf )) allocate ( io_buf ( BLOCK_SIZE )) h = FNV_OFFSET call hash_block ( u , 1_int64 , n , h ) if ( sz > n64 ) then pos_max = max ( 1_int64 , sz - n64 + 1_int64 ) pos_mid = sz / 2_int64 - n64 / 2_int64 if ( pos_mid < 1_int64 ) pos_mid = 1_int64 if ( pos_mid > pos_max ) pos_mid = pos_max pos_end = pos_max call hash_block ( u , pos_mid , n , h ) call hash_block ( u , pos_end , n , h ) end if close ( u ) fp = ieor ( ishft ( sz , 1 ), h ) end function file_fingerprint !> Mix bytes from a 1-based stream position; skip the block if its read fails. subroutine hash_block ( u , pos , n , h ) integer , intent ( in ) :: u integer ( int64 ), intent ( in ) :: pos integer , intent ( in ) :: n integer ( int64 ), intent ( inout ) :: h integer :: ios , i if ( n <= 0 ) return read ( u , pos = pos , iostat = ios ) io_buf ( 1 : n ) if ( ios == 0 ) then do i = 1 , n call fnv1a_mix_i64 ( h , int ( iachar ( io_buf ( i )), int64 )) end do end if end subroutine hash_block !> Mix each byte of a right-trimmed string using XOR and the FNV prime. subroutine fnv1a_mix_str ( h , s ) integer ( int64 ), intent ( inout ) :: h character ( len =* ), intent ( in ) :: s integer :: i do i = 1 , len_trim ( s ) call fnv1a_mix_i64 ( h , int ( iachar ( s ( i : i )), int64 )) end do end subroutine fnv1a_mix_str !> XOR one integer into the hash state, then multiply by the FNV prime. subroutine fnv1a_mix_i64 ( h , x ) integer ( int64 ), intent ( inout ) :: h integer ( int64 ), intent ( in ) :: x h = ieor ( h , x ) h = h * FNV_PRIME end subroutine fnv1a_mix_i64 end module watch_fingerprint","tags":"","url":"sourcefile/watch_fingerprint.f90.html"},{"title":"watch_log.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_log.f90~~EfferentGraph sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_log.f90~~AfferentGraph sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_banner.f90 watch_banner.f90 sourcefile~watch_banner.f90->sourcefile~watch_log.f90 sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_cli.f90->sourcefile~watch_log.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_log.f90 sourcefile~watch_engine.f90->sourcefile~watch_banner.f90 sourcefile~watch_engine.f90->sourcefile~watch_cli.f90 sourcefile~watch_exec.f90 watch_exec.f90 sourcefile~watch_engine.f90->sourcefile~watch_exec.f90 sourcefile~watch_feature_factory.f90 watch_feature_factory.f90 sourcefile~watch_engine.f90->sourcefile~watch_feature_factory.f90 sourcefile~watch_fpm_graph.f90 watch_fpm_graph.f90 sourcefile~watch_engine.f90->sourcefile~watch_fpm_graph.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_engine.f90->sourcefile~watch_platform.f90 sourcefile~watch_exec.f90->sourcefile~watch_log.f90 sourcefile~watch_exec.f90->sourcefile~watch_platform.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_feat_stats.f90 watch_feat_stats.f90 sourcefile~watch_feat_stats.f90->sourcefile~watch_log.f90 sourcefile~watch_feature_factory.f90->sourcefile~watch_log.f90 sourcefile~watch_feature_factory.f90->sourcefile~watch_feat_stats.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_log.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_platform.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 sourcefile~watch_restart.f90 watch_restart.f90 sourcefile~watch_restart.f90->sourcefile~watch_log.f90 sourcefile~watch_restart.f90->sourcefile~watch_platform.f90 sourcefile~watch_restart.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_cmdsplice.f90->sourcefile~watch_cmdline.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Emit terminal text, JSON Lines, and logfmt using process-wide settings. !! !! Structured records, including errors, use stdout; text errors use stderr. !! Each emitted record is flushed immediately and occupies one physical line. !! Field constructors serialize typed values as JSON; logfmt quotes array values. !! Structured strings escape controls and replace invalid UTF-8 bytes with U+FFFD. module watch_log use , intrinsic :: iso_fortran_env , only : int64 , output_unit , error_unit use watch_types , only : watch_opts_t use watch_util , only : ftoa use fpm_strings , only : string_t implicit none private public configure_logging , log_event public log_field_t , log_string , log_strings , log_int , log_real , log_bool public format_log_record , json_quote , valid_log_format , structured_logging !> A typed event attribute, stored as its JSON representation. type log_field_t !> Attribute name (`key`) and its complete serialized JSON representation (`value`). character ( len = :), allocatable :: key , value end type log_field_t interface log_int module procedure log_default_int , log_int64 end interface log_int !> Selected process format; unallocated state is treated as text. character ( len = :), allocatable , save :: active_format !> Minimum-detail filter: -1 quiet, 0 normal, 1..2 additional detail. integer , save :: active_verbosity = 0 !> Allow debug-level records when verbosity also permits them. logical , save :: active_debug = . false . contains !> Copy format, verbosity, and debug options into process-wide logger state. !! !! An unallocated format selects text. Callers must validate format names; !! this routine neither normalizes nor validates the configuration. subroutine configure_logging ( w ) type ( watch_opts_t ), intent ( in ) :: w active_format = \"text\" if ( allocated ( w % log_format )) active_format = w % log_format active_verbosity = w % verbosity active_debug = w % debug end subroutine configure_logging !> Accept exactly the case-sensitive format names `text`, `json`, and `logfmt`. pure logical function valid_log_format ( name ) result ( valid ) character ( len =* ), intent ( in ) :: name valid = name == \"text\" . or . name == \"json\" . or . name == \"logfmt\" end function valid_log_format !> Return whether the process currently emits a machine-readable stream. logical function structured_logging () result ( structured ) structured = . false . if ( allocated ( active_format )) structured = active_format /= \"text\" end function structured_logging !> Format, write, and flush one timestamped event with optional typed attributes. !! !! `verbosity` is the minimum detail level, defaulting to zero. Quiet mode !! suppresses non-error records; debug records additionally require debug mode. !! `force=true` and errors bypass both filters. Structured output always uses !! stdout; only text errors use stderr. `fields` should use the typed constructors. subroutine log_event ( level , event , message , fields , verbosity , force ) character ( len =* ), intent ( in ) :: level , event , message !! Severity, stable event identifier, and human-readable message, respectively. type ( log_field_t ), intent ( in ), optional :: fields (:) !! Typed attributes constructed with log_string/log_strings/log_int/log_real/log_bool. integer , intent ( in ), optional :: verbosity !! Minimum active verbosity for this non-error event; defaults to zero. logical , intent ( in ), optional :: force !! Bypass verbosity/debug filters for required protocol events; defaults to false. integer :: unit , detail logical :: required character ( len = :), allocatable :: line , timestamp if (. not . allocated ( active_format )) active_format = \"text\" required = . false . if ( present ( force )) required = force if ( level /= \"error\" . and . . not . required ) then if ( active_verbosity < 0 ) return detail = 0 if ( present ( verbosity )) detail = verbosity if ( active_verbosity < detail ) return if ( level == \"debug\" . and . . not . active_debug ) return end if timestamp = log_timestamp () line = format_log_record ( active_format , timestamp , level , event , message , fields ) unit = output_unit if ( active_format == \"text\" . and . level == \"error\" ) unit = error_unit write ( unit , \"(a)\" ) line flush ( unit ) end subroutine log_event !> Render text, JSON, or logfmt without logging I/O or reading the clock. !! !! `timestamp` must provide RFC 3339 text (at least 19 characters for text mode). !! Structured fields require allocated keys and nonempty serialized JSON values. !! Text uses HH:MM:SS, level, and message; it omits event/attribute fields. !! Unrecognized formats use text. This routine does not apply verbosity filters. pure function format_log_record ( format , timestamp , level , event , message , fields ) result ( line ) character ( len =* ), intent ( in ) :: format , timestamp , level , event , message type ( log_field_t ), intent ( in ), optional :: fields (:) character ( len = :), allocatable :: line , label integer :: i select case ( format ) case ( \"json\" ) line = '{\"timestamp\":' // json_quote ( timestamp ) // ',\"level\":' // json_quote ( level ) // & ',\"event\":' // json_quote ( event ) // ',\"message\":' // json_quote ( message ) if ( present ( fields )) then do i = 1 , size ( fields ) line = line // \",\" // json_quote ( fields ( i )% key ) // \":\" // fields ( i )% value end do end if line = line // \"}\" case ( \"logfmt\" ) line = \"timestamp=\" // timestamp // \" level=\" // level // \" event=\" // event // & \" msg=\" // json_quote ( message ) if ( present ( fields )) then do i = 1 , size ( fields ) if ( fields ( i )% value ( 1 : 1 ) == \"[\" ) then line = line // \" \" // fields ( i )% key // \"=\" // json_quote ( fields ( i )% value ) else line = line // \" \" // fields ( i )% key // \"=\" // fields ( i )% value end if end do end if case default select case ( level ) case ( \"error\" ) label = \"ERROR\" case ( \"warn\" ) label = \"WARN \" case ( \"debug\" ) label = \"DEBUG\" case default label = \"INFO \" end select line = timestamp ( 12 : 19 ) // \" \" // label // \" \" // escape_text ( message , . false .) end select end function format_log_record !> Quote a byte string as JSON, escaping controls and replacing invalid UTF-8 bytes with U+FFFD. pure function json_quote ( value ) result ( quoted ) character ( len =* ), intent ( in ) :: value character ( len = :), allocatable :: quoted quoted = '\"' // escape_text ( value , . true .) // '\"' end function json_quote !> Escape control bytes so a message stays on one physical line. !! !! When `delimiters` is true, also escape quotes/backslashes and replace invalid !! UTF-8 bytes with JSON U+FFFD escapes. Text mode preserves non-ASCII bytes. pure function escape_text ( value , delimiters ) result ( escaped ) character ( len =* ), intent ( in ) :: value logical , intent ( in ) :: delimiters character ( len = :), allocatable :: escaped character ( len = 4 ) :: hex integer :: i , code , width escaped = \"\" i = 1 do while ( i <= len ( value )) code = iachar ( value ( i : i )) select case ( code ) case ( 34 , 92 ) if ( delimiters ) escaped = escaped // achar ( 92 ) escaped = escaped // value ( i : i ) case ( 8 ) escaped = escaped // achar ( 92 ) // \"b\" case ( 9 ) escaped = escaped // achar ( 92 ) // \"t\" case ( 10 ) escaped = escaped // achar ( 92 ) // \"n\" case ( 12 ) escaped = escaped // achar ( 92 ) // \"f\" case ( 13 ) escaped = escaped // achar ( 92 ) // \"r\" case ( 0 : 7 , 11 , 14 : 31 ) write ( hex , \"(z4.4)\" ) code escaped = escaped // achar ( 92 ) // \"u\" // hex case ( 128 : 255 ) if ( delimiters ) then width = utf8_width ( value , i ) if ( width == 0 ) then escaped = escaped // achar ( 92 ) // \"uFFFD\" else escaped = escaped // value ( i : i + width - 1 ) i = i + width - 1 end if else escaped = escaped // value ( i : i ) end if case default escaped = escaped // value ( i : i ) end select i = i + 1 end do end function escape_text !> Validate a multibyte UTF-8 sequence at a valid 1-based byte position. !! !! Return 2..4 for a valid sequence, or zero for invalid/truncated input, !! ASCII bytes, surrogate encodings, or out-of-range Unicode values. pure integer function utf8_width ( value , position ) result ( width ) character ( len =* ), intent ( in ) :: value integer , intent ( in ) :: position integer :: first , second , i , expected width = 0 first = iachar ( value ( position : position )) select case ( first ) case ( 194 : 223 ) expected = 2 case ( 224 : 239 ) expected = 3 case ( 240 : 244 ) expected = 4 case default return end select if ( position + expected - 1 > len ( value )) return do i = position + 1 , position + expected - 1 second = iachar ( value ( i : i )) if ( second < 128 . or . second > 191 ) return end do second = iachar ( value ( position + 1 : position + 1 )) if ( first == 224 . and . second < 160 ) return if ( first == 237 . and . second > 159 ) return if ( first == 240 . and . second < 144 ) return if ( first == 244 . and . second > 143 ) return width = expected end function utf8_width !> Construct a string attribute without trimming meaningful whitespace. pure function log_string ( key , value ) result ( field ) character ( len =* ), intent ( in ) :: key , value type ( log_field_t ) :: field field % key = key field % value = json_quote ( value ) end function log_string !> Construct a JSON string array; logfmt represents it as a quoted JSON value. pure function log_strings ( key , values ) result ( field ) character ( len =* ), intent ( in ) :: key type ( string_t ), intent ( in ) :: values (:) type ( log_field_t ) :: field integer :: i field % key = key field % value = \"[\" do i = 1 , size ( values ) if ( i > 1 ) field % value = field % value // \",\" field % value = field % value // json_quote ( values ( i )% s ) end do field % value = field % value // \"]\" end function log_strings !> Construct a default-integer attribute. pure function log_default_int ( key , value ) result ( field ) character ( len =* ), intent ( in ) :: key integer , intent ( in ) :: value type ( log_field_t ) :: field field = log_int64 ( key , int ( value , int64 )) end function log_default_int !> Construct an integer attribute, including long-running counters. pure function log_int64 ( key , value ) result ( field ) character ( len =* ), intent ( in ) :: key integer ( int64 ), intent ( in ) :: value type ( log_field_t ) :: field character ( len = 32 ) :: buffer write ( buffer , \"(i0)\" ) value field % key = key field % value = trim ( buffer ) end function log_int64 !> Serialize a real with three decimal places (scientific fallback); nonfinite values become JSON null. pure function log_real ( key , value ) result ( field ) use , intrinsic :: ieee_arithmetic , only : ieee_is_finite character ( len =* ), intent ( in ) :: key real , intent ( in ) :: value type ( log_field_t ) :: field field % key = key field % value = \"null\" if (. not . ieee_is_finite ( value )) return field % value = ftoa ( value , precision = 3 ) end function log_real !> Construct a boolean attribute. pure function log_bool ( key , value ) result ( field ) character ( len =* ), intent ( in ) :: key logical , intent ( in ) :: value type ( log_field_t ) :: field field % key = key field % value = \"false\" if ( value ) field % value = \"true\" end function log_bool !> Read local wall time with milliseconds and its explicit UTC offset. function log_timestamp () result ( timestamp ) character ( len = :), allocatable :: timestamp character ( len = 29 ) :: buffer character ( len = 5 ) :: zone integer :: values ( 8 ) call date_and_time ( zone = zone , values = values ) write ( buffer , \"(i4.4,a,i2.2,a,i2.2,a,i2.2,a,i2.2,a,i2.2,a,i3.3,a,a,a)\" ) & values ( 1 ), \"-\" , values ( 2 ), \"-\" , values ( 3 ), \"T\" , values ( 5 ), \":\" , values ( 6 ), \":\" , & values ( 7 ), \".\" , values ( 8 ), zone ( 1 : 3 ), \":\" , zone ( 4 : 5 ) timestamp = buffer end function log_timestamp end module watch_log","tags":"","url":"sourcefile/watch_log.f90.html"},{"title":"watch_banner.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_banner.f90~~EfferentGraph sourcefile~watch_banner.f90 watch_banner.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_banner.f90->sourcefile~watch_log.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_banner.f90->sourcefile~watch_types.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_banner.f90->sourcefile~watch_util.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_banner.f90~~AfferentGraph sourcefile~watch_banner.f90 watch_banner.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_banner.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Present watcher startup and file-list events through the shared logger. module watch_banner use watch_types , only : watch_opts_t use watch_util , only : ftoa , trim_or_default , join_csv use watch_log , only : log_event , log_int , log_real , log_string , log_strings , log_bool use fpm_strings , only : string_t , str use fpm_command_line , only : fpm_build_settings , fpm_test_settings , fpm_run_settings implicit none private public print_banner , print_file_list , print_configuration contains !> Emit a startup summary and optional configuration/timing records. !! !! `watch.ready` uses normal verbosity; configuration/timings require level 1. !! Read `mode` from typed settings. Unallocated files count as zero; time !! inputs are seconds and event timing fields are milliseconds. Quiet mode !! suppresses these records. File-list output is handled separately by the engine. subroutine print_banner ( full_cmdline , settings , w , files , build_secs , roots_count , secs_model , secs_targets , secs_watch ) character ( len =* ), intent ( in ) :: full_cmdline class ( fpm_build_settings ), intent ( in ) :: settings type ( watch_opts_t ), intent ( in ) :: w type ( string_t ), allocatable , intent ( in ) :: files (:) real , intent ( in ) :: build_secs , secs_model , secs_targets , secs_watch integer , intent ( in ) :: roots_count integer :: nfiles character ( len = :), allocatable :: mode , message nfiles = 0 if ( allocated ( files )) nfiles = size ( files ) mode = command_mode ( settings ) message = \"Watching \" // str ( nfiles ) // \" files (\" // mode // \")\" if ( w % once ) then message = message // \"; one-shot\" else message = message // \"; Ctrl+C or touch .fpm-watch.stop to stop\" end if call log_event ( \"info\" , \"watch.ready\" , message , & [ log_int ( \"file_count\" , nfiles ), log_int ( \"root_count\" , roots_count ), & log_string ( \"mode\" , mode ), log_string ( \"command\" , full_cmdline ), log_bool ( \"once\" , w % once )]) call print_configuration ( settings , w ) call log_event ( \"info\" , \"watch.initialized\" , \"Watch list initialized in \" // ftoa ( build_secs ) // \"s\" , & [ log_real ( \"duration_ms\" , build_secs * 100 0.0 ), log_real ( \"model_ms\" , secs_model * 100 0.0 ), & log_real ( \"targets_ms\" , secs_targets * 100 0.0 ), log_real ( \"watch_list_ms\" , secs_watch * 100 0.0 )], verbosity = 1 ) end subroutine print_banner !> Report effective model/watch settings at verbosity 1 after startup or refresh. !! !! Features are a comma-separated fpm feature string; include/ignore attributes !! are arrays. Poll/debounce fields are milliseconds and rescan is seconds. subroutine print_configuration ( settings , w ) class ( fpm_build_settings ), intent ( in ) :: settings type ( watch_opts_t ), intent ( in ) :: w character ( len = :), allocatable :: features , profile , compiler , build_dir profile = trim_or_default ( settings % profile , \"default\" ) compiler = trim_or_default ( settings % compiler , \"(auto)\" ) build_dir = trim_or_default ( settings % build_dir , \"build\" ) features = \"(none)\" if ( allocated ( settings % features )) features = join_csv ( settings % features , \"(none)\" ) call log_event ( \"info\" , \"watch.configuration\" , & \"Compiler \" // compiler // \"; profile \" // profile // \"; build directory \" // build_dir // & \"; features \" // features , & [ log_string ( \"compiler\" , compiler ), log_string ( \"profile\" , profile ), log_string ( \"build_dir\" , build_dir ), & log_string ( \"features\" , features ), log_bool ( \"prune\" , settings % prune ), log_bool ( \"deps\" , w % watch_deps ), & log_bool ( \"low_cpu\" , w % low_cpu ), log_bool ( \"silent_fpm\" , w % silent_fpm ), & log_bool ( \"run_on_start\" , w % run_on_start ), log_real ( \"poll_ms\" , w % poll * 100 0.0 ), & log_real ( \"debounce_ms\" , w % debounce * 100 0.0 ), log_real ( \"rescan_s\" , w % rescan ), & log_strings ( \"ignore\" , w % ignore ), log_strings ( \"include\" , w % include )], verbosity = 1 ) end subroutine print_configuration !> Emit up to 200 `watch.file` records when verbosity is at least 2. !! !! Larger lists produce an omitted-count record. Unallocated lists are ignored. !! The engine calls this at startup only when `print_files_once` is enabled, !! and after successful refreshes whenever verbosity is at least 2. subroutine print_file_list ( files , w ) type ( string_t ), allocatable , intent ( in ) :: files (:) type ( watch_opts_t ), intent ( in ) :: w integer :: i integer , parameter :: cap = 200 if ( w % verbosity < 2 ) return if (. not . allocated ( files )) return do i = 1 , min ( size ( files ), cap ) call log_event ( \"info\" , \"watch.file\" , files ( i )% s , [ log_string ( \"path\" , files ( i )% s )], verbosity = 2 ) end do if ( size ( files ) > cap ) then call log_event ( \"info\" , \"watch.files_truncated\" , str ( size ( files ) - cap ) // \" more watched files\" , & [ log_int ( \"omitted_count\" , size ( files ) - cap )], verbosity = 2 ) end if end subroutine print_file_list !> Describe the selected fpm command. pure function command_mode ( settings ) result ( mode ) class ( fpm_build_settings ), intent ( in ) :: settings character ( len = :), allocatable :: mode select type ( s => settings ) type is ( fpm_test_settings ) mode = \"test\" type is ( fpm_run_settings ) mode = \"run\" if ( s % example ) mode = \"run --example\" class default mode = \"build\" end select end function command_mode end module watch_banner","tags":"","url":"sourcefile/watch_banner.f90.html"},{"title":"watch_restart.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_restart.f90~~EfferentGraph sourcefile~watch_restart.f90 watch_restart.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_restart.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_config.f90 watch_config.f90 sourcefile~watch_restart.f90->sourcefile~watch_config.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_restart.f90->sourcefile~watch_log.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_restart.f90->sourcefile~watch_platform.f90 sourcefile~watch_time.f90 watch_time.f90 sourcefile~watch_restart.f90->sourcefile~watch_time.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_restart.f90->sourcefile~watch_util.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_util.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_config.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Supervise watcher children and restart them on nonzero exit. !! !! Leading CLI flags override manifest supervisor defaults. A zero child exit !! or user interruption ends supervision; other exits restart after the delay, !! subject to the restart limit. Command failures only reach the supervisor !! if the watcher itself exits nonzero, as in one-shot mode. Child generations !! share the parent's selected log format and use distinct cycle-ID prefixes. module watch_restart use watch_time , only : sleep_seconds , set_low_cpu use watch_cmdline , only : get_arg , parse_int , parse_real , quote_arg , starts_with , parse_bool , & watch_option_takes_value use watch_config , only : get_restart_defaults use watch_platform , only : execute_command use watch_log , only : log_event , log_int , log_real , log_string use fpm_strings , only : str use watch_util , only : ftoa implicit none private public maybe_supervise contains !> Enter supervisor mode when requested, otherwise return immediately. !! !! If auto-restart is enabled and the current process is not marked as a !! child (`--watch-child`), this routine runs a supervisor loop and does not !! return. subroutine maybe_supervise ( log_format ) character ( len =* ), intent ( in ) :: log_format logical :: auto_restart , is_child real :: restart_delay integer :: restart_max character ( len = :), allocatable :: self_exe call parse_restart_flags ( auto_restart , restart_delay , restart_max , is_child , self_exe ) if ( auto_restart . and . (. not . is_child )) then call supervisor_loop ( max ( 0.0 , restart_delay ), restart_max , self_exe , log_format ) stop 0 end if end subroutine maybe_supervise !> Launch watcher children until success, user interruption, or restart exhaustion. !! !! `max0` counts restarts after the initial launch; nonpositive values are !! unlimited. Clamp `delay0` to zero or greater. Each restart increments the !! child generation. A user interruption or exhausted limit exits with the !! child execution status; a zero child status exits successfully. subroutine supervisor_loop ( delay0 , max0 , exe0 , log_format ) real , intent ( in ) :: delay0 integer , intent ( in ) :: max0 character ( len =* ), intent ( in ) :: exe0 character ( len =* ), intent ( in ) :: log_format character ( len = :), allocatable :: child_cmd integer :: code , attempt real :: delay logical :: interrupted attempt = 0 delay = max ( 0.0 , delay0 ) do code = 0 child_cmd = build_child_command ( exe0 , log_format , attempt ) call execute_command ( child_cmd , code , interrupted ) if ( interrupted ) then call log_event ( \"info\" , \"supervisor.stopped\" , \"Supervisor interrupted\" , [ log_string ( \"reason\" , \"interrupt\" )]) stop code end if if ( code == 0 ) exit if ( max0 > 0 . and . attempt >= max0 ) then call log_event ( \"error\" , \"supervisor.limit_reached\" , \"Child failed; restart limit reached\" , & [ log_int ( \"exit_code\" , code ), log_int ( \"restart_count\" , attempt )]) stop code end if attempt = attempt + 1 call log_event ( \"warn\" , \"supervisor.restart\" , & \"Child failed (exit \" // str ( code ) // \"); restart #\" // str ( attempt ) // \" in \" // ftoa ( delay ) // \"s\" , & [ log_int ( \"exit_code\" , code ), log_int ( \"restart_count\" , attempt ), log_real ( \"delay_ms\" , delay * 100 0.0 )]) call sleep_seconds ( delay ) end do stop 0 end subroutine supervisor_loop !> Serialize child argv with a generation counter and the parent's log format. !! !! Remove supervisor flags and prior log-format/child markers from the leading !! watcher options. Preserve other leading values and every forwarded token !! after the subcommand, quoting each original argv token independently. function build_child_command ( exe0 , log_format , restart_count ) result ( cmd ) character ( len =* ), intent ( in ) :: exe0 character ( len =* ), intent ( in ) :: log_format integer , intent ( in ) :: restart_count character ( len = :), allocatable :: cmd character ( len = :), allocatable :: exe , a integer :: narg , i logical :: skip_next , copy_next , in_prefix exe = choose_self_exe ( exe0 ) cmd = quote_arg ( exe ) // \" --watch-child=\" // str ( restart_count ) // \" --watch-log-format \" // log_format narg = command_argument_count () skip_next = . false . copy_next = . false . in_prefix = . true . do i = 1 , narg a = get_arg ( i ) if (. not . in_prefix ) then cmd = cmd // \" \" // quote_arg ( a ) cycle end if if ( skip_next ) then skip_next = . false . cycle end if if ( copy_next ) then copy_next = . false . cmd = cmd // \" \" // quote_arg ( a ) cycle end if if (. not . starts_with ( a , \"--watch-\" ) . and . a /= \"-q\" . and . a /= \"-v\" . and . a /= \"-vv\" ) then in_prefix = . false . cmd = cmd // \" \" // quote_arg ( a ) cycle end if if ( a == \"--watch-auto-restart\" . or . starts_with ( a , \"--watch-auto-restart=\" )) cycle if ( a == \"--watch-child\" ) cycle if ( starts_with ( a , \"--watch-child=\" )) cycle select case ( a ) case ( \"--watch-restart-delay\" , \"--watch-restart-max\" , \"--watch-self\" , \"--watch-log-format\" ) skip_next = . true . cycle case default continue end select if ( starts_with ( a , \"--watch-restart-delay=\" )) cycle if ( starts_with ( a , \"--watch-restart-max=\" )) cycle if ( starts_with ( a , \"--watch-self=\" )) cycle if ( starts_with ( a , \"--watch-log-format=\" )) cycle copy_next = watch_option_takes_value ( a ) cmd = cmd // \" \" // quote_arg ( a ) end do end function build_child_command !> Determine the executable to use when spawning the child watcher. !! !! Precedence: !! 1. Explicit `exe0` argument !! 2. Environment `FPM_WATCH_SELF` !! 3. `argv[0]` !! 4. Fallback `\"fpm-watch\"` function choose_self_exe ( exe0 ) result ( exe ) character ( len =* ), intent ( in ) :: exe0 character ( len = :), allocatable :: exe character ( len = 2048 ) :: buf integer :: n , stat character ( len = :), allocatable :: a0 if ( len_trim ( exe0 ) > 0 ) then exe = trim ( exe0 ) return end if buf = \"\" n = 0 stat = 0 call get_environment_variable ( \"FPM_WATCH_SELF\" , buf , length = n , status = stat ) if ( stat == 0 . and . n > 0 ) then exe = trim ( buf ( 1 : n )) return end if a0 = get_arg ( 0 ) if ( len_trim ( a0 ) > 0 ) then exe = trim ( a0 ) return end if exe = \"fpm-watch\" end function choose_self_exe !> Apply leading restart flags over manifest supervisor defaults. !! !! Stop scanning at the subcommand and skip other value-option arguments. !! Leading low-CPU CLI flags also select the supervisor's waiting backend; !! this routine does not read the manifest's low-cpu setting. A child marker !! prevents recursive supervision. Numeric parse errors retain fallback values. subroutine parse_restart_flags ( auto_restart , restart_delay , restart_max , is_child , self_exe ) logical , intent ( out ) :: auto_restart , is_child real , intent ( out ) :: restart_delay integer , intent ( out ) :: restart_max character ( len = :), allocatable , intent ( out ) :: self_exe integer :: narg , i character ( len = :), allocatable :: a , v call get_restart_defaults ( auto_restart , restart_delay , restart_max , self_exe ) is_child = . false . narg = command_argument_count () i = 1 do while ( i <= narg ) a = get_arg ( i ) if (. not . starts_with ( a , \"--watch-\" ) . and . a /= \"-q\" . and . a /= \"-v\" . and . a /= \"-vv\" ) exit if ( a == \"--watch-low-cpu\" ) then call set_low_cpu (. true .) i = i + 1 cycle end if if ( a == \"--watch-no-low-cpu\" ) then call set_low_cpu (. false .) i = i + 1 cycle end if if ( starts_with ( a , \"--watch-low-cpu=\" )) then v = a ( len ( \"--watch-low-cpu=\" ) + 1 :) call set_low_cpu ( parse_bool ( v , . true .)) i = i + 1 cycle end if if ( a == \"--watch-auto-restart\" ) then auto_restart = . true . i = i + 1 cycle end if if ( starts_with ( a , \"--watch-auto-restart=\" )) then v = a ( len ( \"--watch-auto-restart=\" ) + 1 :) auto_restart = parse_bool ( v , . true .) i = i + 1 cycle end if if ( a == \"--watch-child\" . or . starts_with ( a , \"--watch-child=\" )) then is_child = . true . i = i + 1 cycle end if if ( starts_with ( a , \"--watch-restart-delay=\" )) then v = a ( len ( \"--watch-restart-delay=\" ) + 1 :) restart_delay = parse_real ( v , restart_delay ) i = i + 1 cycle end if if ( starts_with ( a , \"--watch-restart-max=\" )) then v = a ( len ( \"--watch-restart-max=\" ) + 1 :) restart_max = parse_int ( v , restart_max ) i = i + 1 cycle end if if ( starts_with ( a , \"--watch-self=\" )) then self_exe = trim ( a ( len ( \"--watch-self=\" ) + 1 :)) i = i + 1 cycle end if if ( a == \"--watch-restart-delay\" ) then if ( i + 1 <= narg ) then v = get_arg ( i + 1 ) restart_delay = parse_real ( v , restart_delay ) i = i + 2 else i = i + 1 end if cycle end if if ( a == \"--watch-restart-max\" ) then if ( i + 1 <= narg ) then v = get_arg ( i + 1 ) restart_max = parse_int ( v , restart_max ) i = i + 2 else i = i + 1 end if cycle end if if ( a == \"--watch-self\" ) then if ( i + 1 <= narg ) then self_exe = trim ( get_arg ( i + 1 )) i = i + 2 else i = i + 1 end if cycle end if if ( watch_option_takes_value ( a )) then i = i + 2 else i = i + 1 end if end do end subroutine parse_restart_flags end module watch_restart","tags":"","url":"sourcefile/watch_restart.f90.html"},{"title":"watch_fpm_graph.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_fpm_graph.f90~~EfferentGraph sourcefile~watch_fpm_graph.f90 watch_fpm_graph.f90 sourcefile~watch_filter.f90 watch_filter.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_filter.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_log.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_platform.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_types.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_util.f90 sourcefile~watch_filter.f90->sourcefile~watch_util.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_fpm_graph.f90~~AfferentGraph sourcefile~watch_fpm_graph.f90 watch_fpm_graph.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_fpm_graph.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Build watch lists from fpm's manifest, model, and target graph. !! !! Build mode visits all returned targets. Run mode selects application or !! example closures by name; test mode visits all test executable closures. !! Sources, resolved includes, and manifests form a unique normalized path list. !! Optional dependency watching includes dependency paths under the build tree. !! Up to 64 run/test roots receive bitmasks for later affected-target selection. module watch_fpm_graph use , intrinsic :: iso_fortran_env , only : int64 use , intrinsic :: iso_c_binding , only : c_int use watch_types , only : watch_opts_t , root_info_t use watch_log , only : log_event , log_int , log_real , structured_logging use watch_platform , only : begin_raw_output , end_raw_output use watch_filter , only : normalize_path , is_ignored_path , filter_watch_files , starts_with use watch_util , only : ftoa , trim_or_empty use fpm , only : build_model use fpm_manifest , only : package_config_t , get_package_data use fpm_model , only : fpm_model_t , FPM_SCOPE_APP , FPM_SCOPE_TEST , FPM_SCOPE_EXAMPLE use fpm_targets , only : build_target_ptr , targets_from_sources , add_target_ptr use fpm_filesystem , only : basename , exists , join_path , dirname , canon_path , is_absolute_path use fpm_strings , only : string_t , glob , str use fpm_error , only : error_t use fpm_dependency , only : dependency_tree_t use fpm_command_line , only : fpm_build_settings , fpm_run_settings , fpm_test_settings implicit none private public compute_watch_files_from_settings contains !> Build fpm's model and return the filtered source/include/manifest closure. !! !! `settings` may be updated by fpm model construction. `files` contains !! unique normalized paths; aligned `file_mask` entries map files to `roots`. !! Run selects named applications/examples; test collects all test roots. !! Mapping is disabled when there are no roots or more than 64, yielding !! empty `roots` and zero file masks while retaining the selected closure. !! !! `manifest_key` is always zero here; the engine computes it after refresh. !! Timing outputs are seconds: `build_secs` sums model, target, and collection !! time, excluding manifest reading. On manifest/model/target failure, return !! allocated `error` if supplied, otherwise log the stage and exit with status 1. !! Watch-list outputs are only usable after a successful return. subroutine compute_watch_files_from_settings ( settings , w , files , file_mask , roots , & manifest_key , build_secs , secs_model , secs_targets , secs_watch , error ) class ( fpm_build_settings ), intent ( inout ) :: settings !! Typed build/run/test settings; fpm may update these while constructing its model. type ( watch_opts_t ), intent ( in ) :: w !! Watcher dependency/filter/logging options; unallocated filters impose no restriction. type ( string_t ), allocatable , intent ( out ) :: files (:) !! Unique normalized watched paths, allocated on success (possibly empty). integer ( int64 ), allocatable , intent ( out ) :: file_mask (:) !! Root-membership bits aligned with files; zero when root mapping is disabled. type ( root_info_t ), allocatable , intent ( out ) :: roots (:) !! Executable names and distinct mask bits; empty for build mode or unsupported root counts. integer ( int64 ), intent ( out ) :: manifest_key !! Reserved output, always zero; computed from accepted files by the engine. real , intent ( out ) :: build_secs !! Sum of model, target-construction, and watch-list collection times in seconds. real , intent ( out ) :: secs_model , secs_targets , secs_watch !! Separate stage durations in seconds, respectively model, targets, and file collection. type ( error_t ), allocatable , intent ( out ), optional :: error !! Allocated for manifest/model/target failure; omitted error output makes those failures fatal. type ( package_config_t ), allocatable :: package type ( fpm_model_t ), allocatable :: model type ( build_target_ptr ), allocatable :: targets (:) type ( error_t ), allocatable :: err logical , allocatable :: keep (:) logical , allocatable :: visited (:) integer ( int64 ), allocatable :: target_mask (:) type ( string_t ), allocatable :: dep_dirs (:) integer :: i , r , nroots integer ( int64 ) :: rate , t0 , t1 , tw0 , tw1 integer :: n_before , n_after integer ( c_int ) :: saved_output secs_model = 0.0 secs_targets = 0.0 secs_watch = 0.0 build_secs = 0.0 manifest_key = 0_int64 call system_clock ( count_rate = rate ) if ( rate <= 0_int64 ) rate = 1000_int64 allocate ( package , model ) call begin_raw_output ( structured_logging (), saved_output ) call get_package_data ( package , \"fpm.toml\" , err , apply_defaults = . true .) call end_raw_output ( saved_output ) if ( allocated ( err )) then call handle_graph_error ( err , error , \"manifest\" ) return end if call system_clock ( t0 ) call begin_raw_output ( structured_logging (), saved_output ) call build_model ( model , settings , package , err ) call end_raw_output ( saved_output ) call system_clock ( t1 ) secs_model = real ( t1 - t0 ) / real ( rate ) if ( allocated ( err )) then call handle_graph_error ( err , error , \"model\" ) return end if call collect_dep_dirs ( model % deps , dep_dirs ) if ( w % watch_deps . and . w % verbosity >= 1 ) then call log_event ( \"info\" , \"graph.dependencies\" , \"Watching \" // str ( size ( dep_dirs )) // \" dependencies\" , & [ log_int ( \"dependency_count\" , size ( dep_dirs ))], verbosity = 1 ) end if call system_clock ( t0 ) call begin_raw_output ( structured_logging (), saved_output ) call targets_from_sources ( targets , model , settings % prune , package % library , err ) call end_raw_output ( saved_output ) call system_clock ( t1 ) secs_targets = real ( t1 - t0 ) / real ( rate ) if ( allocated ( err )) then call release_targets ( targets ) call handle_graph_error ( err , error , \"targets\" ) return end if call system_clock ( tw0 ) allocate ( keep ( size ( targets ))) keep = . false . select type ( s => settings ) type is ( fpm_test_settings ) do i = 1 , size ( targets ) if ( targets ( i )% ptr % is_executable_target ( FPM_SCOPE_TEST )) keep ( i ) = . true . end do type is ( fpm_run_settings ) if ( s % example ) then call select_names_or_all ( targets , FPM_SCOPE_EXAMPLE , s % name , keep ) else call select_names_or_all ( targets , FPM_SCOPE_APP , s % name , keep ) end if class default keep = . true . end select nroots = count ( keep ) allocate ( visited ( size ( targets ))) visited = . false . if ( is_run_or_test ( settings ) . and . nroots > 0 . and . nroots <= bit_size ( 0_int64 )) then allocate ( roots ( nroots )) allocate ( target_mask ( size ( targets ))) target_mask = 0_int64 r = 0 do i = 1 , size ( targets ) if (. not . keep ( i )) cycle r = r + 1 roots ( r )% name = basename ( targets ( i )% ptr % output_file , suffix = . false .) roots ( r )% mask = shiftl ( 1_int64 , r - 1 ) call dfs_mark_mask ( targets ( i )% ptr , targets , target_mask , roots ( r )% mask ) end do visited = ( target_mask /= 0_int64 ) else if ( allocated ( roots )) deallocate ( roots ) allocate ( roots ( 0 )) if ( allocated ( target_mask )) deallocate ( target_mask ) if ( all ( keep )) then visited = . true . else do i = 1 , size ( targets ) if ( keep ( i )) call dfs_mark_bool ( targets ( i )% ptr , targets , visited ) end do end if end if call gather_files_with_mask ( targets , visited , target_mask , files , file_mask , & trim_or_empty ( settings % build_dir ), model , w % watch_deps , dep_dirs ) call push_file_with_mask ( files , file_mask , \"fpm.toml\" , trim_or_empty ( settings % build_dir ), 0_int64 , dep_dirs ) if ( w % watch_deps ) then do i = 1 , size ( dep_dirs ) if ( len_trim ( dep_dirs ( i )% s ) == 0 ) cycle call push_file_with_mask ( files , file_mask , join_path ( dep_dirs ( i )% s , \"fpm.toml\" ), & trim_or_empty ( settings % build_dir ), 0_int64 , dep_dirs ) end do end if n_before = 0 if ( allocated ( files )) n_before = size ( files ) call filter_watch_files ( files , w % include , w % ignore , file_mask ) n_after = 0 if ( allocated ( files )) n_after = size ( files ) if ( w % debug ) then call log_event ( \"debug\" , \"graph.filtered\" , \"Filtered watch list\" , & [ log_int ( \"files_before\" , n_before ), log_int ( \"files_after\" , n_after )]) end if call system_clock ( tw1 ) secs_watch = real ( tw1 - tw0 ) / real ( rate ) build_secs = secs_model + secs_targets + secs_watch if ( w % verbosity >= 1 ) then call log_event ( \"info\" , \"graph.ready\" , \"Computed watch graph in \" // ftoa ( build_secs ) // \"s\" , & [ log_real ( \"model_ms\" , secs_model * 100 0.0 ), log_real ( \"targets_ms\" , secs_targets * 100 0.0 ), & log_real ( \"watch_list_ms\" , secs_watch * 100 0.0 ), log_int ( \"target_count\" , size ( targets )), & log_int ( \"closure_count\" , count ( visited ))], verbosity = 1 ) end if deallocate ( package , model ) call release_targets ( targets ) if ( allocated ( keep )) deallocate ( keep ) if ( allocated ( visited )) deallocate ( visited ) if ( allocated ( target_mask )) deallocate ( target_mask ) if ( allocated ( dep_dirs )) deallocate ( dep_dirs ) contains !> Return canonicalized dependency project directories, excluding the main-project node. subroutine collect_dep_dirs ( tree , dep_dirs ) type ( dependency_tree_t ), intent ( in ) :: tree type ( string_t ), allocatable , intent ( out ) :: dep_dirs (:) integer :: i if ( tree % ndep <= 1 ) then allocate ( dep_dirs ( 0 )) return end if ! The first node belongs to the main project, not a dependency. allocate ( dep_dirs ( tree % ndep - 1 )) do i = 2 , tree % ndep if ( allocated ( tree % dep ( i )% proj_dir )) then dep_dirs ( i - 1 )% s = normalize_path ( canon_path ( tree % dep ( i )% proj_dir )) else dep_dirs ( i - 1 )% s = \"\" end if end do end subroutine collect_dep_dirs end subroutine compute_watch_files_from_settings !> Transfer `err` to an optional error output, or log its stage and exit with status 1. subroutine handle_graph_error ( err , error , stage ) type ( error_t ), allocatable , intent ( inout ) :: err type ( error_t ), allocatable , intent ( out ), optional :: error character ( len =* ), intent ( in ) :: stage if ( present ( error )) then call move_alloc ( err , error ) else call log_event ( \"error\" , \"graph.failed\" , stage // \" error: \" // err % message ) stop 1 end if end subroutine handle_graph_error !> Release the uniquely owned target objects and their shared dependency references. !! !! fpm returns pointer wrappers without finalizers. Collect every reachable node !! while all pointers remain valid, then remove the dependency references before !! deallocating each target and its allocatable source/command data exactly once. !! Nodes already discarded without remaining references by fpm's pruning routine !! cannot be recovered through the returned target graph. subroutine release_targets ( targets ) type ( build_target_ptr ), allocatable , intent ( inout ) :: targets (:) type ( build_target_ptr ), allocatable :: owned (:) integer :: i , j if (. not . allocated ( targets )) return allocate ( owned ( 0 )) do i = 1 , size ( targets ) if (. not . associated ( targets ( i )% ptr )) cycle if ( find_ptr_index ( targets ( i )% ptr , owned ) > 0 ) cycle call add_target_ptr ( owned , targets ( i )) end do i = 1 do while ( i <= size ( owned )) if ( allocated ( owned ( i )% ptr % dependencies )) then do j = 1 , size ( owned ( i )% ptr % dependencies ) if (. not . associated ( owned ( i )% ptr % dependencies ( j )% ptr )) cycle if ( find_ptr_index ( owned ( i )% ptr % dependencies ( j )% ptr , owned ) > 0 ) cycle call add_target_ptr ( owned , owned ( i )% ptr % dependencies ( j )) end do end if i = i + 1 end do deallocate ( targets ) do i = 1 , size ( owned ) if ( allocated ( owned ( i )% ptr % dependencies )) deallocate ( owned ( i )% ptr % dependencies ) end do do i = 1 , size ( owned ) deallocate ( owned ( i )% ptr ) end do end subroutine release_targets !> Return whether the settings correspond to `fpm run` or `fpm test`. logical function is_run_or_test ( settings ) class ( fpm_build_settings ), intent ( in ) :: settings is_run_or_test = . false . select type ( settings ) type is ( fpm_test_settings ) is_run_or_test = . true . type is ( fpm_run_settings ) is_run_or_test = . true . end select end function is_run_or_test !> Collect visited source targets and resolved includes with aligned root masks. !! !! `visited` aligns with `targets`; an absent/unallocated `target_mask` yields !! zero masks. When dependency watching is disabled, skip foreign-package !! sources and includes inside dependency directories. Duplicate paths merge !! masks; only existing paths passing build-directory checks are retained. subroutine gather_files_with_mask ( targets , visited , target_mask , files , file_mask , build_dir , model , watch_deps , dep_dirs ) type ( build_target_ptr ), intent ( in ) :: targets (:) logical , intent ( in ) :: visited (:) integer ( int64 ), allocatable , intent ( in ), optional :: target_mask (:) type ( string_t ), allocatable , intent ( out ) :: files (:) integer ( int64 ), allocatable , intent ( out ) :: file_mask (:) character ( len =* ), intent ( in ) :: build_dir type ( fpm_model_t ), intent ( in ) :: model logical , intent ( in ) :: watch_deps type ( string_t ), allocatable , intent ( in ) :: dep_dirs (:) type ( string_t ), allocatable :: buf (:) integer ( int64 ), allocatable :: mbuf (:) integer :: n , cap integer :: i , j integer ( int64 ) :: m character ( len = :), allocatable :: include_file n = 0 cap = 256 allocate ( buf ( cap ), mbuf ( cap )) do i = 1 , size ( targets ) if (. not . visited ( i )) cycle if (. not . allocated ( targets ( i )% ptr % source )) cycle if (. not . watch_deps ) then if ( allocated ( targets ( i )% ptr % package_name )) then if ( targets ( i )% ptr % package_name /= model % package_name ) cycle end if end if m = 0_int64 if ( present ( target_mask )) then if ( allocated ( target_mask )) m = target_mask ( i ) end if call vec_push_unique ( buf , mbuf , n , cap , targets ( i )% ptr % source % file_name , build_dir , m , dep_dirs ) if ( allocated ( targets ( i )% ptr % source % include_dependencies )) then do j = 1 , size ( targets ( i )% ptr % source % include_dependencies ) include_file = resolve_include_file ( targets ( i )% ptr % source % file_name , & targets ( i )% ptr % source % include_dependencies ( j )% s , model % include_dirs ) if ( len_trim ( include_file ) == 0 ) cycle if (. not . watch_deps ) then if ( is_in_dep_dirs ( include_file , dep_dirs )) cycle end if call vec_push_unique ( buf , mbuf , n , cap , include_file , build_dir , m , dep_dirs ) end do end if end do call finalize_vec ( buf , mbuf , n , files , file_mask ) contains !> Transfer the populated buffer prefix into exact-size aligned file/mask arrays and release buffers. subroutine finalize_vec ( buf , mbuf , n , files , file_mask ) type ( string_t ), allocatable , intent ( inout ) :: buf (:) integer ( int64 ), allocatable , intent ( inout ) :: mbuf (:) integer , intent ( in ) :: n type ( string_t ), allocatable , intent ( out ) :: files (:) integer ( int64 ), allocatable , intent ( out ) :: file_mask (:) integer :: k if ( n <= 0 ) then allocate ( files ( 0 ), file_mask ( 0 )) deallocate ( buf , mbuf ) return end if allocate ( files ( n ), file_mask ( n )) do k = 1 , n call move_alloc ( buf ( k )% s , files ( k )% s ) file_mask ( k ) = mbuf ( k ) end do deallocate ( buf , mbuf ) end subroutine finalize_vec end subroutine gather_files_with_mask !> Resolve an include path, returning a normalized canonical path or an empty string. !! !! Existing absolute paths are accepted directly. Relative names are searched !! beside the source, then in fpm include directories in order, then relative !! to the current working directory. The first existing candidate wins. function resolve_include_file ( source_file , include_name , include_dirs ) result ( path ) character ( len =* ), intent ( in ) :: source_file , include_name type ( string_t ), allocatable , intent ( in ) :: include_dirs (:) character ( len = :), allocatable :: path , candidate integer :: i path = \"\" if ( len_trim ( include_name ) == 0 ) return if ( is_absolute_path ( include_name )) then if ( exists ( include_name )) path = normalize_path ( canon_path ( include_name )) return end if candidate = normalize_path ( canon_path ( join_path ( dirname ( source_file ), include_name ))) if ( exists ( candidate )) then path = candidate return end if if ( allocated ( include_dirs )) then do i = 1 , size ( include_dirs ) candidate = normalize_path ( canon_path ( join_path ( include_dirs ( i )% s , include_name ))) if (. not . exists ( candidate )) cycle path = candidate return end do end if ! Some compilers also search the invocation directory for Fortran INCLUDE. if ( exists ( include_name )) path = normalize_path ( canon_path ( include_name )) end function resolve_include_file !> Append an existing eligible path to aligned arrays, merging mask bits for duplicates. subroutine push_file_with_mask ( files , file_mask , path , build_dir , mask , dep_dirs ) type ( string_t ), allocatable , intent ( inout ) :: files (:) integer ( int64 ), allocatable , intent ( inout ) :: file_mask (:) character ( len =* ), intent ( in ) :: path character ( len =* ), intent ( in ) :: build_dir integer ( int64 ), intent ( in ) :: mask type ( string_t ), allocatable , intent ( in ), optional :: dep_dirs (:) type ( string_t ), allocatable :: buf (:) integer ( int64 ), allocatable :: mbuf (:) integer :: n , cap , i if (. not . allocated ( files )) then n = 0 cap = 8 allocate ( buf ( cap ), mbuf ( cap )) else n = size ( files ) cap = max ( 8 , n ) allocate ( buf ( cap ), mbuf ( cap )) do i = 1 , n buf ( i )% s = files ( i )% s mbuf ( i ) = file_mask ( i ) end do end if if ( present ( dep_dirs )) then call vec_push_unique ( buf , mbuf , n , cap , path , build_dir , mask , dep_dirs ) else call vec_push_unique ( buf , mbuf , n , cap , path , build_dir , mask ) end if call finalize_vec ( buf , mbuf , n , files , file_mask ) contains !> Transfer the populated buffer prefix into exact-size aligned file/mask arrays and release buffers. subroutine finalize_vec ( buf , mbuf , n , files , file_mask ) type ( string_t ), allocatable , intent ( inout ) :: buf (:) integer ( int64 ), allocatable , intent ( inout ) :: mbuf (:) integer , intent ( in ) :: n type ( string_t ), allocatable , intent ( inout ) :: files (:) integer ( int64 ), allocatable , intent ( inout ) :: file_mask (:) type ( string_t ), allocatable :: out (:) integer ( int64 ), allocatable :: outm (:) integer :: k if ( allocated ( files )) deallocate ( files ) if ( allocated ( file_mask )) deallocate ( file_mask ) if ( n <= 0 ) then allocate ( files ( 0 ), file_mask ( 0 )) deallocate ( buf , mbuf ) return end if allocate ( out ( n ), outm ( n )) do k = 1 , n call move_alloc ( buf ( k )% s , out ( k )% s ) outm ( k ) = mbuf ( k ) end do deallocate ( buf , mbuf ) call move_alloc ( out , files ) call move_alloc ( outm , file_mask ) end subroutine finalize_vec end subroutine push_file_with_mask !> Add a normalized existing path to a growable buffer, merging duplicate masks. !! !! Exclude build-directory paths unless supplied dependency directories contain !! the path. `n` counts populated entries; `cap` and both buffers grow together. subroutine vec_push_unique ( buf , mbuf , n , cap , path , build_dir , mask , dep_dirs ) type ( string_t ), allocatable , intent ( inout ) :: buf (:) integer ( int64 ), allocatable , intent ( inout ) :: mbuf (:) integer , intent ( inout ) :: n , cap character ( len =* ), intent ( in ) :: path character ( len =* ), intent ( in ) :: build_dir integer ( int64 ), intent ( in ) :: mask type ( string_t ), allocatable , intent ( in ), optional :: dep_dirs (:) character ( len = :), allocatable :: p integer :: i p = normalize_path ( path ) if ( len_trim ( p ) == 0 ) return if ( is_ignored_path ( p , build_dir )) then if (. not . present ( dep_dirs )) return if (. not . is_in_dep_dirs ( p , dep_dirs )) return end if if (. not . exists ( p )) return do i = 1 , n if ( buf ( i )% s == p ) then mbuf ( i ) = ior ( mbuf ( i ), mask ) return end if end do if ( n >= cap ) call vec_grow ( buf , mbuf , cap ) n = n + 1 buf ( n )% s = p mbuf ( n ) = mask end subroutine vec_push_unique !> Test a normalized path against nonempty normalized dependency-directory prefixes. pure logical function is_in_dep_dirs ( p , dep_dirs ) result ( ok ) character ( len =* ), intent ( in ) :: p type ( string_t ), allocatable , intent ( in ) :: dep_dirs (:) integer :: j character ( len = :), allocatable :: d ok = . false . if (. not . allocated ( dep_dirs )) return if ( size ( dep_dirs ) == 0 ) return do j = 1 , size ( dep_dirs ) if ( len_trim ( dep_dirs ( j )% s ) == 0 ) cycle d = normalize_path ( trim ( dep_dirs ( j )% s )) if ( len_trim ( d ) == 0 ) cycle if ( p == d ) then ok = . true . return end if if ( starts_with ( p , d // \"/\" )) then ok = . true . return end if end do end function is_in_dep_dirs !> Grow both file/mask buffers to at least 16 or 1.5 times the current capacity. subroutine vec_grow ( buf , mbuf , cap ) type ( string_t ), allocatable , intent ( inout ) :: buf (:) integer ( int64 ), allocatable , intent ( inout ) :: mbuf (:) integer , intent ( inout ) :: cap type ( string_t ), allocatable :: nb (:) integer ( int64 ), allocatable :: nm (:) integer :: newcap , i newcap = max ( 16 , cap + cap / 2 ) allocate ( nb ( newcap ), nm ( newcap )) do i = 1 , cap nb ( i )% s = buf ( i )% s nm ( i ) = mbuf ( i ) end do call move_alloc ( nb , buf ) call move_alloc ( nm , mbuf ) cap = newcap end subroutine vec_grow !> Mark executable targets in `scope` matching names without clearing existing marks. !! !! Absent/empty name patterns select all executables in scope. Otherwise match !! fpm globs against each output basename with and without its suffix. subroutine select_names_or_all ( targets , scope , names , keep ) type ( build_target_ptr ), intent ( in ) :: targets (:) integer , intent ( in ) :: scope character ( len =* ), intent ( in ), optional :: names (:) logical , intent ( inout ) :: keep (:) integer :: i , j character ( len = :), allocatable :: outbase_full , outbase_stem logical :: any_name any_name = . false . if ( present ( names )) then if ( size ( names ) > 0 ) then do j = 1 , size ( names ) if ( len_trim ( names ( j )) > 0 ) then any_name = . true . exit end if end do end if end if if (. not . any_name ) then do i = 1 , size ( targets ) if ( targets ( i )% ptr % is_executable_target ( scope )) keep ( i ) = . true . end do return end if do i = 1 , size ( targets ) if (. not . targets ( i )% ptr % is_executable_target ( scope )) cycle outbase_full = basename ( targets ( i )% ptr % output_file ) outbase_stem = basename ( targets ( i )% ptr % output_file , suffix = . false .) do j = 1 , size ( names ) if ( len_trim ( names ( j )) == 0 ) cycle if ( glob ( outbase_full , trim ( names ( j ))) . or . glob ( outbase_stem , trim ( names ( j )))) then keep ( i ) = . true . exit end if end do end do end subroutine select_names_or_all !> Recursively OR one root bit into reachable target masks, skipping already marked nodes. recursive subroutine dfs_mark_mask ( node , all , tmask , mask ) use fpm_targets , only : build_target_t type ( build_target_t ), pointer , intent ( in ) :: node type ( build_target_ptr ), intent ( in ) :: all (:) integer ( int64 ), intent ( inout ) :: tmask (:) integer ( int64 ), intent ( in ) :: mask integer :: idx , i idx = find_ptr_index ( node , all ) if ( idx <= 0 ) return if ( iand ( tmask ( idx ), mask ) /= 0_int64 ) return tmask ( idx ) = ior ( tmask ( idx ), mask ) if ( allocated ( node % dependencies )) then do i = 1 , size ( node % dependencies ) if ( associated ( node % dependencies ( i )% ptr )) call dfs_mark_mask ( node % dependencies ( i )% ptr , all , tmask , mask ) end do end if end subroutine dfs_mark_mask !> Recursively mark reachable targets in `visited`, skipping already visited nodes. recursive subroutine dfs_mark_bool ( node , all , visited ) use fpm_targets , only : build_target_t type ( build_target_t ), pointer , intent ( in ) :: node type ( build_target_ptr ), intent ( in ) :: all (:) logical , intent ( inout ) :: visited (:) integer :: idx , i idx = find_ptr_index ( node , all ) if ( idx <= 0 ) return if ( visited ( idx )) return visited ( idx ) = . true . if ( allocated ( node % dependencies )) then do i = 1 , size ( node % dependencies ) if ( associated ( node % dependencies ( i )% ptr )) call dfs_mark_bool ( node % dependencies ( i )% ptr , all , visited ) end do end if end subroutine dfs_mark_bool !> Return the first 1-based index associated with target pointer `p`, or zero if absent. integer function find_ptr_index ( p , all ) result ( idx ) use fpm_targets , only : build_target_t type ( build_target_t ), pointer , intent ( in ) :: p type ( build_target_ptr ), intent ( in ) :: all (:) integer :: i idx = 0 do i = 1 , size ( all ) if ( associated ( all ( i )% ptr , p )) then idx = i return end if end do end function find_ptr_index end module watch_fpm_graph","tags":"","url":"sourcefile/watch_fpm_graph.f90.html"},{"title":"watch_types.f90 – fpm-watch","text":"Files dependent on this one sourcefile~~watch_typ