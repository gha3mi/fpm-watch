proc~escape_text->proc~escaped_length proc~put_escaped put_escaped proc~escape_text->proc~put_escaped proc~escape_piece escape_piece proc~escaped_length->proc~escape_piece proc~put_json_string->proc~put_text proc~put_json_string->proc~put_escaped proc~utf8_width utf8_width proc~escape_piece->proc~utf8_width proc~put_escaped->proc~put_text proc~put_escaped->proc~escape_piece Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~run_command_and_report~~CalledByGraph proc~run_command_and_report run_command_and_report proc~run_once run_once proc~run_once->proc~run_command_and_report proc~handle_manifest_change handle_manifest_change proc~handle_manifest_change->proc~run_once proc~watcher_init watcher_t%watcher_init proc~watcher_init->proc~run_once proc~watcher_run watcher_t%watcher_run proc~watcher_run->proc~run_once proc~watcher_run->proc~handle_manifest_change Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine run_command_and_report ( cmd , w , exitstat , secs ) character ( len =* ), intent ( in ) :: cmd !! Complete serialized command to execute synchronously. type ( watch_opts_t ), intent ( in ) :: w !! Output suppression, cycle generation, and optional output-marker settings. integer , intent ( out ) :: exitstat !! Command status, including 127 when the platform wrapper cannot launch or wait. real , intent ( out ) :: secs !! Elapsed command time in seconds, excluding event formatting and boundary writes. integer ( int64 ) :: rate , t0 , t1 character ( len = :), allocatable :: action , message , level , cycle_id logical :: interrupted , protocol action = \"Command\" if ( index ( cmd , \"fpm build\" ) == 1 ) action = \"Build\" if ( index ( cmd , \"fpm test\" ) == 1 ) action = \"Tests\" if ( index ( cmd , \"fpm run\" ) == 1 ) action = \"Application\" cycle_number = cycle_number + 1_int64 cycle_id = str ( w % restart_count ) // \":\" // str ( cycle_number ) protocol = w % output_markers . and . structured_logging () call log_event ( \"info\" , \"command.started\" , \"Running \" // trim ( cmd ), & [ log_string ( \"command\" , trim ( cmd )), log_bool ( \"silent_fpm\" , w % silent_fpm ), & log_string ( \"cycle_id\" , cycle_id )], force = protocol ) call output_boundary ( \"started\" , cycle_id , protocol ) call system_clock ( count_rate = rate ) if ( rate <= 0_int64 ) rate = 1000_int64 call system_clock ( t0 ) call execute_command ( trim ( cmd ), exitstat , silent = w % silent_fpm , stderr = structured_logging (), & inherit_workspace = . false .) call system_clock ( t1 ) secs = real ( t1 - t0 ) / real ( rate ) interrupted = termination_requested () level = \"info\" message = action // \" succeeded in \" // ftoa ( secs ) // \"s\" if ( exitstat /= 0 ) then level = \"error\" message = action // \" failed (exit \" // str ( exitstat ) // \") after \" // ftoa ( secs ) // \"s\" end if if ( interrupted ) then level = \"info\" message = action // \" interrupted\" end if call log_event ( level , \"command.finished\" , message , & [ log_string ( \"command\" , trim ( cmd )), log_int ( \"exit_code\" , exitstat ), & log_int ( \"duration_ms\" , nint ( secs * 100 0.0 , int64 )), log_bool ( \"interrupted\" , interrupted ), & log_string ( \"cycle_id\" , cycle_id )], force = protocol ) call output_boundary ( \"finished\" , cycle_id , protocol ) end subroutine run_command_and_report","tags":"","url":"proc/run_command_and_report.html"},{"title":"output_boundary – fpm-watch","text":"private  subroutine output_boundary(state, cycle_id, enabled) Flush a stderr boundary marker when the structured output protocol is enabled. The marker follows a blank line and contains the same opaque cycle_id as the command events; stdout and stderr delivery order need not match. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: state character(len=*), intent(in) :: cycle_id logical, intent(in) :: enabled Called by proc~~output_boundary~~CalledByGraph proc~output_boundary output_boundary proc~run_command_and_report run_command_and_report proc~run_command_and_report->proc~output_boundary proc~run_once run_once proc~run_once->proc~run_command_and_report proc~handle_manifest_change handle_manifest_change proc~handle_manifest_change->proc~run_once proc~watcher_init watcher_t%watcher_init proc~watcher_init->proc~run_once proc~watcher_run watcher_t%watcher_run proc~watcher_run->proc~run_once proc~watcher_run->proc~handle_manifest_change Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine output_boundary ( state , cycle_id , enabled ) character ( len =* ), intent ( in ) :: state , cycle_id logical , intent ( in ) :: enabled if (. not . enabled ) return write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"@@fpm-watch:\" // state // \":\" // cycle_id // \"@@\" flush ( error_unit ) end subroutine output_boundary","tags":"","url":"proc/output_boundary.html"},{"title":"apply_watch_from_manifest – fpm-watch","text":"public  subroutine apply_watch_from_manifest(w, manifest) Replace recognized options from [extra.fpm-watch] and normalize them. Missing keys or values that TOML getters cannot read leave existing options\nunchanged. Successfully read lists replace existing arrays. Log-format validation\nbelongs to CLI configuration assembly. Arguments Type Intent Optional Attributes Name type( watch_opts_t ), intent(inout) :: w character(len=*), intent(in) :: manifest Calls proc~~apply_watch_from_manifest~~CallsGraph proc~apply_watch_from_manifest apply_watch_from_manifest proc~load_watch_table load_watch_table proc~apply_watch_from_manifest->proc~load_watch_table proc~normalize_watch_opts normalize_watch_opts proc~apply_watch_from_manifest->proc~normalize_watch_opts proc~toml_get_int toml_get_int proc~apply_watch_from_manifest->proc~toml_get_int proc~toml_get_list_strings toml_get_list_strings proc~apply_watch_from_manifest->proc~toml_get_list_strings proc~toml_get_logical toml_get_logical proc~apply_watch_from_manifest->proc~toml_get_logical proc~toml_get_real toml_get_real proc~apply_watch_from_manifest->proc~toml_get_real proc~toml_get_string toml