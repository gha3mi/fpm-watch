tched paths, allocated on success (possibly empty). integer(kind=int64), intent(out), allocatable :: file_mask (:) Root-membership bits aligned with files; zero when root mapping is disabled. type( root_info_t ), intent(out), allocatable :: roots (:) Executable names and distinct mask bits; empty for build mode or unsupported root counts. integer(kind=int64), intent(out) :: manifest_key Reserved output, always zero; computed from accepted files by the engine. real, intent(out) :: build_secs Sum of model, target-construction, and watch-list collection times in seconds. real, intent(out) :: secs_model Separate stage durations in seconds, respectively model, targets, and file collection. real, intent(out) :: secs_targets Separate stage durations in seconds, respectively model, targets, and file collection. real, intent(out) :: secs_watch Separate stage durations in seconds, respectively model, targets, and file collection. type(error_t), intent(out), optional, allocatable :: error Allocated for manifest/model/target failure; omitted error output makes those failures fatal. Calls proc~~compute_watch_files_from_settings~~CallsGraph proc~compute_watch_files_from_settings compute_watch_files_from_settings basename basename proc~compute_watch_files_from_settings->basename build_model build_model proc~compute_watch_files_from_settings->build_model canon_path canon_path proc~compute_watch_files_from_settings->canon_path dep dep proc~compute_watch_files_from_settings->dep get_package_data get_package_data proc~compute_watch_files_from_settings->get_package_data interface~log_int log_int proc~compute_watch_files_from_settings->interface~log_int is_executable_target is_executable_target proc~compute_watch_files_from_settings->is_executable_target join_path join_path proc~compute_watch_files_from_settings->join_path proc~begin_raw_output begin_raw_output proc~compute_watch_files_from_settings->proc~begin_raw_output proc~dfs_mark_bool dfs_mark_bool proc~compute_watch_files_from_se