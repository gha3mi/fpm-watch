s ( p )) return do i = 1 , n if ( buf ( i )% s == p ) then mbuf ( i ) = ior ( mbuf ( i ), mask ) return end if end do if ( n >= cap ) call vec_grow ( buf , mbuf , cap ) n = n + 1 buf ( n )% s = p mbuf ( n ) = mask end subroutine vec_push_unique","tags":"","url":"proc/vec_push_unique.html"},{"title":"enable_features – fpm-watch","text":"public  subroutine enable_features(fm, w) Enable features requested in watch options. Unknown feature names are ignored with a warning. Arguments Type Intent Optional Attributes Name type( feature_manager_t ), intent(inout) :: fm type( watch_opts_t ), intent(in) :: w Calls proc~~enable_features~~CallsGraph proc~enable_features enable_features proc~add_stats add_stats proc~enable_features->proc~add_stats proc~log_event log_event proc~enable_features->proc~log_event proc~fm_add feature_manager_t%fm_add proc~add_stats->proc~fm_add proc~new_stats_feature new_stats_feature proc~add_stats->proc~new_stats_feature proc~format_log_record format_log_record proc~log_event->proc~format_log_record proc~log_timestamp log_timestamp proc~log_event->proc~log_timestamp proc~escape_text escape_text proc~format_log_record->proc~escape_text proc~json_quote json_quote proc~format_log_record->proc~json_quote proc~utf8_width utf8_width proc~escape_text->proc~utf8_width proc~json_quote->proc~escape_text Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~enable_features~~CalledByGraph proc~enable_features enable_features proc~watcher_init watcher_t%watcher_init proc~watcher_init->proc~enable_features Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine enable_features ( fm , w ) type ( feature_manager_t ), intent ( inout ) :: fm type ( watch_opts_t ), intent ( in ) :: w integer :: i character ( len = :), allocatable :: name if (. not . allocated ( w % enabled_features )) return do i = 1 , size ( w % enabled_features ) name = trim ( w % enabled_features ( i )% s ) if ( len_trim ( name ) == 0 ) cycle select case ( name ) case ( \"stats\" ) call add_stats ( fm ) case default call log_event ( \"warn\" , \"feature.unknown\" , \"Unknown feature '\" // name // \"' (ignored)\" ) end select end do end subroutine enable_features","tags":"","url":"proc/enable_features.html"},{"title":"add_stats – fpm-watch","text":"private  subroutine add_stats(fm) Factory helper: add the built-in stats feature. Arguments Type Intent Optional Attributes Name type( feature_manager_t ), intent(inout) :: fm Calls proc~~add_stats~~CallsGraph proc~add_stats add_stats proc~fm_add feature_manager_t%fm_add proc~add_stats->proc~fm_add proc~new_stats_feature new_stats_feature proc~add_stats->proc~new_stats_feature Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~add_stats~~CalledByGraph proc~add_stats add_stats proc~enable_features enable_features proc~enable_features->proc~add_stats proc~watcher_init watcher_t%watcher_init proc~watcher_init->proc~enable_features Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine add_stats ( fm ) type ( feature_manager_t ), intent ( inout ) :: fm class ( watch_feature_t ), allocatable :: f call new_stats_feature ( f ) call fm % add ( f ) end subroutine add_stats","tags":"","url":"proc/add_stats.html"},{"title":"build_run_command – fpm-watch","text":"public  function build_run_command(settings, full_cmdline, cmd_prefix, cmd_rest, roots, file_mask, changed_idx, changed_count) result(cmd) Uses watch_cmdsplice proc~~build_run_command~~UsesGraph proc~build_run_command build_run_command module~watch_cmdsplice watch_cmdsplice proc~build_run_command->module~watch_cmdsplice module~watch_cmdline watch_cmdline module~watch_cmdsplice->module~watch_cmdline module~watch_platform watch_platform module~watch_cmdline->module~watch_platform module~watch_util watch_util module~watch_cmdline->module~watch_util fpm_environment fpm_environment module~watch_platform->fpm_environment iso_c_binding iso_c_binding module~watch_platform->iso_c_binding iso_fortran_env iso_fortran_env module~watch_platform->iso_fortran_env module~watch_log watch_log module~watch_platform->module~watch_log fpm_strings fpm_strings module~watch_util->fpm_strings module~watch_log->module~watch_util module~watch_log->fpm_strings module~watch_log->iso_fortran_env module~watch_types watch_types module~watch_log->module~watch_types module~watch_types->fpm_strings module~watch_types->iso_fortran_env fpm_command_line fpm_command_line module~watch_types->fpm_command_line Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Inject affected root names into an unpinned run/test command. changed_idx(:changed_count) indexes file_mask , whose bits correspond\nto roots . Combine those bits and quote the matching root names before\nthe program-argument -- delimiter. Return full_cmdline unchanged for\nbuild mode, explicit target patterns, unavailable masks/roots, no matched\nnames, or an empty command prefix. Arguments Type Intent Optional Attributes Name class(fpm_build_settings), intent(in) :: settings Run/test type and explicit target patterns used to decide whether injection is allowed. character(len=*), intent(in) :: full_cmdline Complete serialized command, returned when no target injection is possible. character(len=*), intent(in) :: cmd_prefix Serialized executable/subcommand prefix for the replacement command. character(len=*), intent(in) :: cmd_rest Serialized forwarded fpm/program arguments after the subcommand. type( root_info_t ), intent(in), allocatable :: roots (:) Root executable names and their single-bit membership masks. integer(kind=int64), intent(in), allocatable :: file_mask (:) Root bits per watched file, indexed by changed_idx. integer, intent(in) :: changed_idx (:) 1-based file indices; only the first changed_count entries are read. integer, intent(in) :: changed_count Number of changed indices in the active buffer prefix. Return Value character(len=:), allocatable Calls proc~~build_run_command~~CallsGraph proc~build_run_command build_run_command proc~inject_names_into_cmd inject_names_into_cmd proc~build_run_command->proc~inject_names_into_cmd proc~quote_arg quote_arg proc~build_run_command->proc~quote_arg proc~is_windows is_windows proc~inject_names_into_cmd->proc~is_windows proc~quote_arg->proc~is_windows get_os_type get_os_type proc~is_windows->get_os_type Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~build_run_command~~CalledByGraph proc~build_run_command build_run_command proc~watcher_run watcher_t%watcher_run proc~watcher_run->proc~build_run_command Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code function build_run_command ( settings , full_cmdline , cmd_prefix , cmd_rest , roots , file_mask , changed_idx , changed_count ) result ( cmd ) use watch_cmdsplice , only : inject_names_into_cmd class ( fpm_build_settings ), intent ( in ) :: settings !! Run/test type and explicit target patterns used to decide whether injection is allowed. character ( len =* ), intent ( in ) :: full_cmdline !! Complete serialized command, returned when no target injection is possible. character ( len =* ), intent ( in ) :: cmd_prefix !! Serialized executable/subcommand prefix for the replacement command. character ( len =* ), intent ( in ) :: cmd_rest !! Serialized forwarded fpm/program arguments after the subcommand. type ( root_info_t ), allocatable , intent ( in ) :: roots (:) !! Root executable names and their single-bit membership masks. integer ( int64 ), allocatable , intent ( in ) :: file_mask (:) !! Root bits per watched file, indexed by changed_idx. integer , intent ( in ) :: changed_idx (:) !! 1-based file indices; only the first changed_count entries are read. integer , intent ( in ) :: changed_count !! Number of changed indices in the active buffer prefix. character ( len = :), allocatable :: cmd logical :: is_test , is_run integer ( int64 ) :: hitmask character ( len = :), allocatable :: names_str integer :: j , idx logical :: user_pinned_names is_test = . false . is_run = . false . user_pinned_names = . false . select type ( s => settings ) type is ( fpm_test_settings ) is_test = . true . if ( allocated ( s % name )) user_pinned_names = ( size ( s % name ) > 0 ) type is ( fpm_run_settings ) is_run = . true . if ( allocated ( s % name )) user_pinned_names = ( size ( s % name ) > 0 ) class default continue end select if ( user_pinned_names ) then cmd = trim ( full_cmdline ) return end if if (. not . is_test . and . . not . is_run ) then cmd = trim ( full_cmdline ) return end if if (. not . allocated ( roots )) then cmd = trim ( full_cmdline ) return end if if ( size ( roots ) == 0 ) then cmd = trim ( full_cmdline ) return end if if (. not . allocated ( file_mask )) then cmd = trim ( full_cmdline ) return end if hitmask = 0_int64 do j = 1 , changed_count idx = changed_idx ( j ) if ( idx < 1 . or . idx > size ( file_mask )) cycle hitmask = ior ( hitmask , file_mask ( idx )) end do if ( hitmask == 0_int64 ) then cmd = trim ( full_cmdline ) return end if names_str = join_names_from_mask ( roots , hitmask ) if ( len_trim ( names_str ) == 0 ) then cmd = trim ( full_cmdline ) return end if if ( len_trim ( cmd_prefix ) == 0 ) then cmd = trim ( full_cmdline ) return end if cmd = inject_names_into_cmd ( cmd_prefix , cmd_rest , names_str ) contains !> Join quoted, nonempty root names whose bits intersect `mask`, in root order. function join_names_from_mask ( roots , mask ) result ( s ) type ( root_info_t ), intent ( in ) :: roots (:) integer ( int64 ), intent ( in ) :: mask character ( len = :), allocatable :: s integer :: rr character ( len = :), allocatable :: nm s = \"\" do rr = 1 , size ( roots ) if ( iand ( mask , roots ( rr )% mask ) == 0_int64 ) cycle if (. not . allocated ( roots ( rr )% name )) cycle nm = trim ( roots ( rr )% name ) if ( len_trim ( nm ) == 0 ) cycle if ( len ( s ) > 0 ) s = s // \" \" s = s // quote_arg ( nm ) end do end function join_names_from_mask end function build_run_command","tags":"","url":"proc/build_run_command.html"},{"title":"report_changes – fpm-watch","text":"public  subroutine report_changes(files, changed_idx, changed_count, w) Emit changed paths and a summary unless quiet mode suppresses them. changed_idx(:changed_count) contains 1-based indices into files .\nThe summary includes every valid path; verbosity 1 emits individual records\nfor at most the first eight changed indices. Arguments Type Intent Optional Attributes Name type(string_t), intent(in), allocatable :: files (:) integer, intent(in) :: changed_idx (:) integer, intent(in) :: changed_count type( watch_opts_t ), intent(in) :: w Calls proc~~report_changes~~CallsGraph proc~report_changes report_changes interface~log_int log_int proc~report_changes->interface~log_int proc~log_event log_event proc~report_changes->proc~log_event proc~log_real log_real proc~report_changes->proc~log_real proc~log_string log_string proc~report_changes->proc~log_string proc~log_strings log_strings proc~report_changes->proc~log_strings str str proc~report_changes->str proc~log_default_int log_default_int interface~log_int->proc~log_default_int proc~log_int64 log_int64 interface~log_int->proc~log_int64 proc~format_log_record format_log_record proc~log_event->proc~format_log_record proc~log_timestamp log_timestamp proc~log_event->proc~log_timestamp proc~ftoa ftoa proc~log_real->proc~ftoa proc~json_quote json_quote proc~log_string->proc~json_quote proc~log_strings->proc~json_quote proc~format_log_record->proc~json_quote proc~escape_text escape_text proc~format_log_record->proc~escape_text proc~json_quote->proc~escape_text proc~log_default_int->proc~log_int64 proc~utf8_width utf8_width proc~escape_text->proc~utf8_width Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~report_changes~~CalledByGraph proc~report_changes report_changes proc~watcher_run watcher_t%watcher_run proc~watcher_run->proc~report_changes Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine report_changes ( files , changed_idx , changed_count , w ) type ( string_t ), allocatable , intent ( in ) :: files (:) integer , intent ( in ) :: changed_idx (:) integer , intent ( in ) :: changed_count type ( watch_opts_t ), intent ( in ) :: w integer :: i , idx , n type ( string_t ), allocatable :: paths (:) character ( len = :), allocatable :: message if ( w % verbosity < 0 . or . changed_count == 0 ) return if (. not . allocated ( files )) return allocate ( paths ( changed_count )) n = 0 do i = 1 , changed_count idx = changed_idx ( i ) if ( idx < 1 . or . idx > size ( files )) cycle n = n + 1 paths ( n ) = files ( idx ) end do idx = changed_idx ( 1 ) message = str ( changed_count ) // \" files changed\" if ( idx >= 1 . and . idx <= size ( files )) then if ( changed_count == 1 ) message = \"Changed \" // files ( idx )% s end if call log_event ( \"info\" , \"watch.changed\" , message , & [ log_int ( \"file_count\" , changed_count ), log_strings ( \"paths\" , paths (: n )), & log_real ( \"debounce_ms\" , w % debounce * 100 0.0 )]) do i = 1 , min ( changed_count , 8 ) idx = changed_idx ( i ) if ( idx < 1 . or . idx > size ( files )) cycle call log_event ( \"info\" , \"watch.changed_file\" , \"Changed \" // files ( idx )% s , & [ log_string ( \"path\" , files ( idx )% s )], verbosity = 1 ) end do end subroutine report_changes","tags":"","url":"proc/report_changes.html"},{"title":"run_command_and_report – fpm-watch","text":"public  subroutine run_command_and_report(cmd, w, exitstat, secs) Execute synchronously and report start, completion, exit status, and seconds. cycle_id combines the supervisor generation and a process-local counter.\nStructured mode sends raw command stdout to stderr; silent mode suppresses\nboth child streams. In structured mode only, output markers bracket stderr\nand force both command events through quiet filtering. Failures are errors;\na latched user interruption is reported as an interrupted completion. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: cmd Complete serialized command to execute synchronously. type( watch_opts_t ), intent(in) :: w Output suppression, cycle generation, and optional output-marker settings. integer, intent(out) :: exitstat Command status, including 127 when the platform wrapper cannot launch or wait. real, intent(out) :: secs Elapsed command time in seconds, excluding event formatting and boundary writes. Calls proc~~run_command_and_report~~CallsGraph proc~run_command_and_report run_command_and_report interface~log_i