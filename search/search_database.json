t/log_real/log_bool. integer , intent ( in ), optional :: verbosity !! Minimum active verbosity for this non-error event; defaults to zero. logical , intent ( in ), optional :: force !! Bypass verbosity/debug filters for required protocol events; defaults to false. integer :: unit , detail logical :: required character ( len = :), allocatable :: line , timestamp if (. not . allocated ( active_format )) active_format = \"text\" required = . false . if ( present ( force )) required = force if ( level /= \"error\" . and . . not . required ) then if ( active_verbosity < 0 ) return detail = 0 if ( present ( verbosity )) detail = verbosity if ( active_verbosity < detail ) return if ( level == \"debug\" . and . . not . active_debug ) return end if timestamp = log_timestamp () line = format_log_record ( active_format , timestamp , level , event , message , fields ) unit = output_unit if ( active_format == \"text\" . and . level == \"error\" ) unit = error_unit write ( unit , \"(a)\" ) line flush ( unit ) end subroutine log_event","tags":"","url":"proc/log_event.html"},{"title":"log_int – fpm-watch","text":"public interface log_int Calls interface~~log_int~~CallsGraph interface~log_int log_int proc~log_default_int log_default_int interface~log_int->proc~log_default_int proc~log_int64 log_int64 interface~log_int->proc~log_int64 proc~log_default_int->proc~log_int64 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different 