e collection. type ( error_t ), allocatable , intent ( out ), optional :: error !! Allocated for manifest/model/target failure; omitted error output makes those failures fatal. type ( string_t ), allocatable , intent ( in ), optional :: metadata_files (:) !! Additional protected metadata paths, including missing lookup candidates. type ( package_config_t ), allocatable :: package type ( fpm_model_t ), allocatable :: model type ( build_target_ptr ), allocatable :: targets (:) type ( error_t ), allocatable :: err logical , allocatable :: keep (:) logical , allocatable :: visited (:), metadata (:) integer ( int64 ), allocatable :: target_mask (:) type ( string_t ), allocatable :: dep_dirs (:) type ( file_collection_t ) :: collected integer :: i , r , nroots logical :: whole_libraries integer ( int64 ) :: rate , t0 , t1 , tw0 , tw1 integer :: n_before , n_after integer ( c_int ) :: saved_output secs_model = 0.0 secs_targets = 0.0 secs_watch = 0.0 build_secs = 0.0 manifest_key = 0_int64 call system_clock ( count_rate = rate ) if ( rate <= 0_int64 ) rate = 1000_int64 allocate ( package , model ) call begin_raw_output ( structured_logging (), saved_output ) call get_package_data ( package , \"fpm.toml\" , err , apply_defaults = . true .) call end_raw_output ( saved_output ) if ( allocated ( err )) then call handle_graph_error ( err , error , \"manifest\" ) return end if call system_clock ( t0 ) call begin_raw_output ( structured_logging (), saved_output ) call build_model ( model , settings , package , err ) call end_raw_output ( saved_output ) call system_clock ( t1 ) secs_model = real ( t1 - t0 ) / real ( rate ) if ( allocated ( err )) then call handle_graph_error ( err , error , \"model\" ) return end if call collect_dep_dirs ( model % deps , dep_dirs ) if ( w % watch_deps . and . w % verbosity >= 1 ) then call log_event ( \"info\" , \"graph.dependencies\" , \"Watching \" // str ( size ( dep_dirs )) // \" dependencies\" , & [ log_int ( \"dependency_count\" , size ( dep_dirs ))], verbosity = 1 ) end if call system_clock ( t0 ) call begin_raw_output ( structured_logging (), saved_output ) whole_libraries = . not . settings % prune if ( allocated ( package % library )) whole_libraries = whole_libraries . or . . not . package % library % monolithic () call build_watch_targets ( model , whole_libraries , targets , err ) call end_raw_output ( saved_output ) call system_clock ( t1 ) secs_targets = real ( t1 - t0 ) / real ( rate ) if ( allocated ( err )) then call release_targets ( targets ) call handle_graph_error ( err , error , \"targets\" ) return end if call system_clock ( tw0 ) allocate ( keep ( size ( targets ))) keep = . false . select type ( s => settings ) type is ( fpm_test_settings ) call select_names_or_all ( targets , FPM_SCOPE_TEST , s % name , keep ) type is ( fpm_run_settings ) if ( s % example ) then call select_names_or_all ( targets , FPM_SCOPE_EXAMPLE , s % name , keep ) else call select_names_or_all ( targets , FPM_SCOPE_APP , s % name , keep ) end if class default keep = . true . end select nroots = count ( keep ) allocate ( visited ( size ( targets ))) visited = . false . if ( is_run_or_test ( settings ) . and . nroots > 0 . and . nroots <= bit_size ( 0_int64 )) then allocate ( roots ( nroots )) allocate ( target_mask ( size ( targets ))) target_mask = 0_int64 r = 0 do i = 1 , size ( targets ) if (. not . keep ( i )) cycle r = r + 1 roots ( r )% name = basename ( targets ( i )% ptr % output_file , suffix = . false .) roots ( r )% mask = shiftl ( 1_int64 , r - 1 ) call dfs_mark_mask ( targets ( i )% ptr , targets , target_mask , roots ( r )% mask ) end do visited = ( target_mask /= 0_int64 ) else if ( allocated ( roots )) deallocate ( roots ) allocate ( roots ( 0 )) if ( allocated ( target_mask )) deallocate ( target_mask ) if ( all ( keep )) then visited = . true . else do i = 1 , size ( targets ) if ( keep ( i )) call dfs_mark_bool ( targets ( i )% ptr , targets , visited ) end do end if end if call gather_files_with_mask ( targets , visited , target_mask , collected , & trim_or_empty ( settings % build_dir ), model , w % watch_deps , dep_dirs ) call collect_manifest_metadata ( collected , \"fpm.toml\" , trim_or_empty ( settings % build_dir ), dep_dirs ) if ( w % watch_deps ) then do i = 1 , size ( dep_dirs ) if ( len_trim ( dep_dirs ( i )% s ) == 0 ) cycle call collect_manifest_metadata ( collected , join_path ( dep_dirs ( i )% s , \"fpm.toml\" ), & trim_or_empty ( settings % build_dir ), dep_dirs ) end do end if if ( present ( metadata_files )) then if ( allocated ( metadata_files )) then do i = 1 , size ( metadata_files ) call collected % add ( metadata_files ( i )% s , trim_or_empty ( settings % build_dir ), 0_int64 , & dep_dirs , preserve = . true ., allow_missing = . true .) end do end if end if call collected % finish ( files , file_mask , metadata ) n_before = 0 if ( allocated ( files )) n_before = size ( files ) call filter_watch_files ( files , w % include , w % ignore , file_mask , preserve = metadata ) n_after = 0 if ( allocated ( files )) n_after = size ( files ) if ( w % debug ) then call log_event ( \"debug\" , \"graph.filtered\" , \"Filtered watch list\" , & [ log_int ( \"files_before\" , n_before ), log_int ( \"files_after\" , n_after )]) end if call system_clock ( tw1 ) secs_watch = real ( tw1 - tw0 ) / real ( rate ) build_secs = secs_model + secs_targets + secs_watch if ( w % verbosity >= 1 ) then call log_event ( \"info\" , \"graph.ready\" , \"Computed watch graph in \" // ftoa ( build_secs ) // \"s\" , & [ log_real ( \"model_ms\" , secs_model * 100 0.0 ), log_real ( \"targets_ms\" , secs_targets * 100 0.0 ), & log_real ( \"watch_list_ms\" , secs_watch * 100 0.0 ), log_int ( \"target_count\" , size ( targets )), & log_int ( \"closure_count\" , count ( visited ))], verbosity = 1 ) end if deallocate ( package , model ) call release_targets ( targets ) if ( allocated ( keep )) deallocate ( keep ) if ( allocated ( visited )) deallocate ( visited ) if ( allocated ( target_mask )) deallocate ( target_mask ) if ( allocated ( dep_dirs )) deallocate ( dep_dirs ) contains !> Return canonicalized dependency project directories, excluding the main-project node. subroutine collect_dep_dirs ( tree , dep_dirs ) type ( dependency_tree_t ), intent ( in ) :: tree type ( string_t ), allocatable , intent ( out ) :: dep_dirs (:) integer :: i if ( tree % ndep <= 1 ) then allocate ( dep_dirs ( 0 )) return end if ! The first node belongs to the main project, not a dependency. allocate ( dep_dirs ( tree % ndep - 1 )) do i = 2 , tree % ndep if ( allocated ( tree % dep ( i )% proj_dir )) then dep_dirs ( i - 1 )% s = normalize_path ( canon_path ( tree % dep ( i )% proj_dir )) else dep_dirs ( i - 1 )% s = \"\" end if end do end subroutine collect_dep_dirs end subroutine compute_watch_files_from_settings","tags":"","url":"proc/compute_watch_files_from_settings.html"},{"title":"append_include_edge – fpm-watch","text":"private  subroutine append_include_edge(edges, child) Append one resolved candidate edge with amortized linear storage growth. Arguments Type Intent Optional Attributes Name type( include_edges_t ), intent(inout) :: edges integer, intent(in) :: child Called by proc~~append_include_edge~~CalledByGraph proc~append_include_edge append_include_edge proc~gather_include_candidates gather_include_candidates proc~gather_include_candidates->proc~append_include_edge proc~gather_include_closure gather_include_closure proc~gather_include_candidates->proc~gather_include_closure proc~gather_include_closure->proc~gather_include_candidates proc~gather_files_with_mask gather_files_with_mask proc~gather_files_with_mask->proc~gather_include_closure proc~compute_watch_files_from_settings compute_watch_files_from_settings proc~compute_watch_files_from_settings->proc~gather_files_with_mask proc~run_graph_worker run_graph_worker proc~run_graph_worker->proc~compute_watch_files_from_settings Help Graph Key Nodes of different colours represent the following: