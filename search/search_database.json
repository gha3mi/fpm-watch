ch_graph_worker.f90->sourcefile~watch_log.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_platform.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Miscellaneous string utilities. !! !! Provides small helpers for formatting and manipulating allocatable strings !! and string arrays. module watch_util use fpm_strings , only : string_t implicit none private public ftoa , trim_or_default , trim_or_empty , join_csv , starts_with contains !> Compare a case-sensitive, right-trimmed prefix; an empty prefix matches every string. pure logical function starts_with ( s , prefix ) result ( ok ) character ( len =* ), intent ( in ) :: s , prefix integer :: n n = len_trim ( prefix ) if ( n <= 0 ) then ok = . true . else if ( len_trim ( s ) < n ) then ok = . false . else ok = ( s ( 1 : n ) == prefix ( 1 : n )) end if end function starts_with !> Format a real using two decimal places by default and a leading zero. !! !! Optional `precision` is clamped to 0..16. Fixed output that overflows the !! 64-character buffer falls back to scientific notation. Nonfinite values !! are not rejected here; typed real logging handles them separately. pure function ftoa ( x , precision ) result ( s ) real , intent ( in ) :: x integer , intent ( in ), optional :: precision character ( len = :), allocatable :: s character ( len = 64 ) :: buf character ( len = 16 ) :: format integer :: digits digits = 2 if ( present ( precision )) digits = max ( 0 , min ( precision , 16 )) write ( format , \"(a,i0,a)\" ) \"(f0.\" , digits , \")\" write ( buf , format ) x if ( index ( buf , \"*\" ) > 0 ) write ( buf , \"(es24.16e3)\" ) x s = trim ( adjustl ( buf )) if ( s ( 1 : 1 ) == \".\" ) s = \"0\" // s if ( s ( 1 : 2 ) == \"-.\" ) s = \"-0\" // s ( 2 :) end function ftoa !> Trim an allocatable string or return a default if empty/unallocated. pure function trim_or_default ( s , default ) result ( r ) character ( len = :), allocatable , intent ( in ) :: s character ( len =* ), intent ( in ) :: default character ( len = :), allocatable :: r if ( allocated ( s )) then if ( len_trim ( s ) > 0 ) then r = trim ( s ) else r = default end if else r = default end if end function trim_or_default !> Trim an allocatable string or return an empty string if unallocated. pure function trim_or_empty ( s ) result ( r ) character ( len = :), allocatable , intent ( in ) :: s character ( len = :), allocatable :: r if ( allocated ( s )) then r = trim ( s ) else r = \"\" end if end function trim_or_empty !> Join a list of strings into a comma-separated value string. !! !! Empty entries are skipped. If all entries are empty (or the array is not !! allocated), returns the provided `empty` placeholder string. pure function join_csv ( a , empty ) result ( s ) type ( string_t ), allocatable , intent ( in ) :: a (:) character ( len =* ), intent ( in ) :: empty character ( len = :), allocatable :: s character ( len = :), allocatable :: tmp integer :: i tmp = \"\" if ( allocated ( a )) then do i = 1 , size ( a ) if ( len_trim ( a ( i )% s ) == 0 ) cycle if ( len ( tmp ) > 0 ) tmp = tmp // \",\" tmp = tmp // trim ( a ( i )% s ) end do end if if ( len ( tmp ) == 0 ) then s = empty else s = tmp end if end function join_csv end module watch_util","tags":"","url":"sourcefile/watch_util.f90.html"},{"title":"watch_cli.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_cli.f90~~EfferentGraph sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_config.f90 watch_config.f90 sourcefile~watch_cli.f90->sourcefile~watch_config.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_cli.f90->sourcefile~watch_log.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_cli.f90->sourcefile~watch_platform.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_cli.f90->sourcefile~watch_types.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_util.f90 sourcefile~watch_cmdsplice.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_config.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_cli.f90~~AfferentGraph sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_cli.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Assemble watcher options, typed fpm settings, and a serialized command. !! !! Built-in defaults are followed by `[extra.fpm-watch]` and leading watcher !! flags. All tokens after `build`, `test`, or `run` are retained for execution; !! recognized fpm options also populate the settings used for graph construction. !! Model-option scanning stops at `--`. Parsing uses argv tokens, not shell text. module watch_cli use , intrinsic :: iso_fortran_env , only : error_unit use , intrinsic :: iso_c_binding , only : c_int use watch_types , only : watch_config_t , watch_opts_t use watch_config , only : set_watch_defaults , apply_watch_from_manifest , normalize_watch_opts , push_feature use watch_cmdline , only : get_arg , join_argv , quote_arg , parse_int , parse_real , parse_bool , starts_with , & watch_option_takes_value use fpm_strings , only : string_t , split , lower use fpm_command_line , only : fpm_build_settings , fpm_run_settings , fpm_test_settings , get_fpm_env use fpm_os , only : get_current_directory use fpm_filesystem , only : canon_path , join_path , is_absolute_path , exists , getline use fpm_environment , only : get_env use fpm_error , only : error_t , fatal_error use M_CLI2 , only : set_args , sget , lget , specified , unnamed , CLI_RESPONSE_FILE , get_subcommand use watch_platform , only : begin_raw_output , end_raw_output use watch_log , only : configure_logging , valid_log_format , log_event , structured_logging implicit none private public parse_cli_config contains !> Resolve fpm's directory option without changing or rewriting forwarded argv. function project_directory ( first_arg , response_mode ) result ( directory ) integer , intent ( in ) :: first_arg logical , intent ( in ) :: response_mode character ( len = :), allocatable :: directory , base , arg , key , selected type ( error_t ), allocatable :: error integer :: i , narg , eq call get_current_directory ( base , error ) if ( allocated ( error )) call usage_and_stop ( error % message ) directory = base selected = \"\" if ( response_mode ) then selected = sget ( \"directory\" ) else narg = command_argument_count () i = subcommand_position ( first_arg ) + 1 do while ( i <= narg ) arg = get_arg ( i ) if ( arg == \"--\" ) exit key = arg eq = index ( arg , \"=\" ) if ( eq > 0 ) key = arg (: eq - 1 ) if ( key == \"--directory\" . or . key == \"-C\" ) then if ( eq > 0 ) then selected = arg ( eq + 1 :) else if ( i == narg ) exit i = i + 1 selected = get_arg ( i ) end if else if ( fpm_option_takes_value ( key ) . and . eq == 0 ) then i = i + 1 end if i = i + 1 end do end if if ( len_trim ( selected ) == 0 ) return if ( is_absolute_path ( selected )) then directory = canon_path ( selected ) else directory = canon_path ( join_path ( base , selected )) end if end function project_directory !> Identify fpm options whose following token is a value rather than another option. pure logical function fpm_option_takes_value ( key ) result ( takes_value ) character ( len =* ), intent ( in ) :: key select case ( key ) case ( \"--profile\" , \"--features\" , \"--build-dir\" , \"--compiler\" , \"--c-compiler\" , & \"--cxx-compiler\" , \"--archiver\" , \"--flag\" , \"--c-flag\" , \"--cxx-flag\" , & \"--link-flag\" , \"--runner\" , \"--runner-args\" , \"--config-file\" , \"--target\" , & \"--directory\" , \"-C\" ) takes_value = . true . case default takes_value = . false . end select end function fpm_option_takes_value !> Locate the original subcommand after leading watcher flags. integer function subcommand_position ( first_arg ) result ( position ) integer , intent ( in ) :: first_arg character ( len = :), allocatable :: arg position = first_arg do while ( position <= command_argument_count ()) arg = get_arg ( position ) if (. not . starts_with ( arg , \"--watch-\" ) . and . arg /= \"-q\" . and . arg /= \"-v\" . and . arg /= \"-vv\" ) exit if ( watch_option_takes_value ( arg )) position = position + 1 position = position + 1 end do end function subcommand_position !> Preflight named response files before delegating response semantics to M_CLI2. !! !! Only options, comments, and OS section headers are accepted. Procedural records !! are rejected before the upstream parser can execute them. Missing named files !! never fall through to executable-specific compound files. Candidate paths are !! absolute and include missing higher-priority search locations for watching. subroutine prepare_response_options ( first_arg , response_files , enabled , subcmd , error ) integer , intent ( in ) :: first_arg type ( string_t ), allocatable , intent ( out ) :: response_files (:) logical , intent ( out ) :: enabled character ( len = :), allocatable , intent ( out ) :: subcmd type ( error_t ), allocatable , intent ( out ) :: error character ( len = :), allocatable :: arg , key , prototype , message integer :: i , j , eq , position , status , key_count , selected integer ( c_int ) :: saved_output logical :: available , has_options , has_os_options type ( string_t ), allocatable :: candidates (:), watcher_keys (:) allocate ( response_files ( 0 )) enabled = . false . subcmd = \"\" position = subcommand_position ( first_arg ) i = position + 1 do while ( i <= command_argument_count ()) arg = get_arg ( i ) if ( arg == \"--\" ) exit eq = index ( arg , \"=\" ) key = arg if ( eq > 0 ) key = arg (: eq - 1 ) if ( starts_with ( arg , \"@\" )) then enabled = . true . else if ( fpm_option_takes_value ( key ) . and . eq == 0 ) then i = i + 1 end if i = i + 1 end do if (. not . enabled ) return ! get_subcommand inspects raw argv, including leading watcher values and ! tokens after --. Preflight every response it can see, not just fpm inputs. do i = 1 , command_argument_count () arg = get_arg ( i ) eq = index ( arg , \"=\" ) if (. not . starts_with ( arg , \"@\" ) . and . eq > 0 ) then key = arg (: eq - 1 ) if ( fpm_option_takes_value ( key ) . or . watch_option_takes_value ( key )) cycle arg = arg ( eq + 1 :) end if if (. not . starts_with ( arg , \"@\" )) cycle call response_candidates ( arg , candidates , error ) if ( allocated ( error )) return selected = 0 available = . false . do j = 1 , size ( candidates ) call push_feature ( response_files , candidates ( j )% s ) end do ! Upstream searches all directories for the current OS section first, ! then searches for the first ordinary file. Inspect record kinds only; ! M_CLI2 remains responsible for selecting and parsing the actual options. do j = 1 , size ( candidates ) if (. not . exists ( candidates ( j )% s )) cycle call inspect_response_candidate ( candidates ( j )% s , has_options , has_os_options , error ) if ( allocated ( error )) return if ( has_os_options ) then selected = j exit end if if (. not . available . and . has_options ) selected = j available = available . or . has_options end do if ( selected == 0 ) then call fatal_error ( error , \"Response \" // arg // \" needs a named options-only file; \" // & \"use NAME.rsp or @./path/file.rsp. Executable compound response files are unsupported.\" ) return end if call validate_response_records ( candidates ( selected )% s , has_options , error ) if ( allocated ( error )) return end do prototype = ' --directory:C \" \" --verbose F --profile \" \" --features \" \" --target \" \"' // & ' --build-dir \" \" --compiler \" \" --c-compiler \" \" --cxx-compiler \" \" --archiver \" \"' // & ' --flag:: \" \" --c-flag:: \" \" --cxx-flag:: \" \" --link-flag:: \" \"' // & ' --runner \" \" --runner-args \" \" --config-file \" \" --no-prune F --prune F' // & ' --tests F --example F --all F --list F --show-model F --dump \" \" -q F -v F -vv F' ! M_CLI2 reads process argv. Describe leading watcher/internal flags only so ! it consumes them without treating their values as fpm target patterns. allocate ( watcher_keys ( 0 )) do i = 1 , position - 1 arg = get_arg ( i ) if (. not . starts_with ( arg , \"--watch-\" )) cycle eq = index ( arg , \"=\" ) key = arg if ( eq > 0 ) key = arg (: eq - 1 ) key_count = size ( watcher_keys ) call push_feature ( watcher_keys , key ) if ( size ( watcher_keys ) == key_count ) cycle if ( watch_option_takes_value ( key ) . or . key == \"--watch-graph-worker\" ) then prototype = prototype // \" \" // key // ':: \" \"' else prototype = prototype // \" \" // key // \" F\" end if end do CLI_RESPONSE_FILE = . true . call begin_raw_output (. true ., saved_output ) subcmd = get_subcommand () if (. not . is_supported_subcmd ( subcmd )) then call end_raw_output ( saved_output ) call fatal_error ( error , \"Response options must declare a supported subcommand with options build, options test, or options run\" ) return end if call set_args ( prototype // \" --\" , ierr = status , errmsg = message ) call end_raw_output ( saved_output ) if ( status /= 0 ) call fatal_error ( error , \"Cannot parse fpm response options: \" // message ) end subroutine prepare_response_options !> Enumerate documented named-file locations without interpreting option values. subroutine response_candidates ( argument , candidates , error ) character ( len =* ), intent ( in ) :: argument type ( string_t ), allocatable , intent ( out ) :: candidates (:) type ( error_t ), allocatable , intent ( out ) :: error character ( len = :), allocatable :: name , base , paths (:), candidate integer :: i allocate ( candidates ( 0 )) if ( len ( argument ) <= 1 ) then call fatal_error ( error , \"Response @ requires a file name\" ) return end if call get_current_directory ( base , error ) if ( allocated ( error )) return name = trim ( argument ( 2 :)) if ( index ( name , \"/\" ) > 0 . or . index ( name , achar ( 92 )) > 0 ) then candidate = name if (. not . is_absolute_path ( candidate )) candidate = join_path ( base , candidate ) call push_feature ( candidates , canon_path ( candidate )) return end if name = name // \".rsp\" call push_feature ( candidates , canon_path ( join_path ( base , name ))) ! These are M_CLI2's documented search paths and its default split delimiters. call split ( get_env ( \"CLI_RESPONSE_PATH\" ), paths , & delimiters = \" \" // achar ( 9 ) // achar ( 10 ) // achar ( 11 ) // achar ( 12 ) // achar ( 13 ) // achar ( 0 ) // \",:\" ) do i = 1 , size ( paths ) candidate = paths ( i ) if (. not . is_absolute_path ( candidate )) candidate = join_path ( base , candidate ) call push_feature ( candidates , canon_path ( join_path ( candidate , name ))) end do end subroutine response_candidates !> Identify named-file search matches without interpreting their option values. subroutine inspect_response_candidate ( path , has_records , has_os_records , error ) character ( len =* ), intent ( in ) :: path logical , intent ( out ) :: has_records , has_os_records type ( error_t ), allocatable , intent ( out ) :: error character ( len = :), allocatable :: line , words (:), record , os_header logical :: after_os_header integer :: unit , status has_records = . false . has_os_records = . false . after_os_header = . false . os_header = \"@\" // get_env ( \"OSTYPE\" , get_env ( \"OS\" )) open ( newunit = unit , file = path , status = \"old\" , action = \"read\" , iostat = status ) if ( status /= 0 ) return do call getline ( unit , line , iostat = status ) if ( status /= 0 ) exit line = trim ( adjustl ( line )) if ( os_header /= \"@\" . and . line == os_header ) after_os_header = . true . call split ( line , words , delimiters = \" \" // achar ( 9 ) // achar ( 13 )) if ( size ( words ) == 0 ) cycle record = lower ( trim ( words ( 1 ))) if ( starts_with ( record , \"#\" ) . or . starts_with ( record , \"@\" ) . or . record == \"comment\" ) cycle has_records = . true . if ( after_os_header ) has_os_records = . true . end do close ( unit ) if ( status > 0 ) call fatal_error ( error , \"Cannot read response file \" // path ) end subroutine inspect_response_candidate !> Reject procedural response records before any M_CLI2 expansion occurs. subroutine validate_response_records ( path , has_options , error ) character ( len =* ), intent ( in ) :: path logical , intent ( out ) :: has_options type ( error_t ), allocatable , intent ( out ) :: error character ( len = :), allocatable :: line , words (:), record integer :: unit , status has_options = . false . open ( newunit = unit , file = path , status = \"old\" , action = \"read\" , iostat = status ) if ( status /= 0 ) then call fatal_error ( error , \"Cannot read response file \" // path ) return end if do call getline ( unit , line , iostat = status ) if ( status /= 0 ) exit if ( len_trim ( line ) > 4096 ) then call fatal_error ( error , \"Response record exceeds M_CLI2's 4096-byte limit: \" // path ) exit end if call split ( line , words , delimiters = \" \" // achar ( 9 ) // achar ( 13 )) if ( size ( words ) == 0 ) cycle record = lower ( trim ( words ( 1 ))) if ( starts_with ( record , \"#\" ) . or . starts_with ( record , \"@\" )) cycle select case ( record ) case ( \"options\" , \"option\" , \"-\" ) has_options = . true . case ( \"comment\" ) cycle case default call fatal_error ( error , \"Response file \" // path // \" contains unsupported record \" // record // & \"; fpm-watch accepts options/comments/OS sections, without system, print, or stop directives.\" ) exit end select end do close ( unit ) if ( status > 0 . and . . not . allocated ( error )) call fatal_error ( error , \"Cannot read response file \" // path ) end subroutine validate_response_records !> Normalize upstream response getters into the ordinary typed-settings assembly. subroutine read_response_options ( profile , build_dir , compiler , c_compiler , cxx_compiler , archiver , & flag , cflag , cxxflag , ldflag , runner , runner_args , config_file , features , names , prune , example , build_tests , & subcmd , original_subcmd ) character ( len = :), allocatable , intent ( inout ) :: profile , build_dir , compiler , c_compiler , cxx_compiler , archiver character ( len = :), allocatable , intent ( inout ) :: flag , cflag , cxxflag , ldflag , runner , runner_args , config_file type ( string_t ), allocatable , intent ( inout ) :: features (:), names (:) logical , intent ( inout ) :: prune , example , build_tests character ( len =* ), intent ( in ) :: subcmd , original_subcmd integer :: i , first_name if ( specified ( \"profile\" )) profile = sget ( \"profile\" ) if ( specified ( \"features\" )) call add_features_csv ( features , sget ( \"features\" )) if ( specified ( \"build-dir\" )) build_dir = sget ( \"build-dir\" ) if ( specified ( \"compiler\" )) compiler = sget ( \"compiler\" ) if ( specified ( \"c-compiler\" )) c_compiler = sget ( \"c-compiler\" ) if ( specified ( \"cxx-compiler\" )) cxx_compiler = sget ( \"cxx-compiler\" ) if ( specified ( \"archiver\" )) archiver = sget ( \"archiver\" ) if ( specified ( \"flag\" )) flag = sget ( \"flag\" ) if ( specified ( \"c-flag\" )) cflag = sget ( \"c-flag\" ) if ( specified ( \"cxx-flag\" )) cxxflag = sget ( \"cxx-flag\" ) if ( specified ( \"link-flag\" )) ldflag = sget ( \"link-flag\" ) if ( specified ( \"runner\" )) runner = sget ( \"runner\" ) if ( specified ( \"runner-args\" )) runner_args = sget ( \"runner-args\" ) if ( specified ( \"config-file\" )) config_file = sget ( \"config-file\" ) if ( specified ( \"no-prune\" )) prune = . not . lget ( \"no-prune\" ) if ( specified ( \"prune\" )) prune = lget ( \"prune\" ) example = lget ( \"example\" ) build_tests = lget ( \"tests\" ) if ( specified ( \"target\" )) call add_target_names ( names , sget ( \"target\" )) if ( lget ( \"all\" )) call push_feature ( names , \"*\" ) first_name = 1 do i = 1 , size ( unnamed ) if ( trim ( unnamed ( i )) /= original_subcmd ) cycle first_name = i + 1 exit end do if ( subcmd /= \"run\" . and . subcmd /= \"test\" ) return do i = first_name , size ( unnamed ) call push_feature ( names , target_pattern ( trim ( unnamed ( i )))) end do end subroutine read_response_options !> Parse argv and manifest options into an executable watcher configuration. !! !! `cfg%settings` describes the graph; `cfg%fpm_cmdline` retains forwarded argv !! with platform quoting. `cmd_prefix` and `cmd_rest` support target injection. !! A custom fpm executable replaces the command prefix after splitting it. !! Optional `log_format` pins the existing format during manifest refreshes. subroutine parse_cli_config ( cfg , log_format , start_arg , error ) use watch_cmdsplice , only : split_cmd_after_subcmd type ( watch_config_t ), intent ( out ) :: cfg !! Assembled watcher options, model settings, and serialized command/prefix/rest. character ( len =* ), intent ( in ), optional :: log_format !! Pinned process format for a manifest refresh; overrides manifest and CLI format changes. integer , intent ( in ), optional :: start_arg !! First original argv token when invoked by an internal graph worker. type ( error_t ), allocatable , intent ( out ), optional :: error !! Recoverable response-file validation or parsing error; absent callers exit with status 2. character ( len = :), allocatable :: fpm_cmdline class ( fpm_build_settings ), allocatable :: settings character ( len = :), allocatable :: subcmd character ( len = :), allocatable :: response_subcmd type ( error_t ), allocatable :: response_error logical :: response_mode integer :: first_arg , subcmd_pos first_arg = 1 if ( present ( start_arg )) first_arg = start_arg call set_watch_defaults ( cfg % w ) call apply_watch_arguments ( cfg % w , first_arg , subcmd_pos , log_format ) call prepare_response_options ( subcmd_pos , cfg % response_files , response_mode , response_subcmd , response_error ) if ( allocated ( response_error )) then if ( present ( error )) then call move_alloc ( response_error , error ) else call usage_and_stop ( response_error % message ) end if return end if cfg % project_dir = project_directory ( subcmd_pos , response_mode ) call parse_cli ( cfg % w , settings , fpm_cmdline , subcmd , cfg % project_dir , first_arg , & response_mode , response_subcmd , log_format ) cfg % fpm_cmdline = fpm_cmdline cfg % subcmd = subcmd call move_alloc ( settings , cfg % settings ) call split_cmd_after_subcmd ( cfg % fpm_cmdline , cfg % cmd_prefix , cfg % cmd_rest ) if ( cfg % w % fpm_executable /= \"fpm\" ) then cfg % cmd_prefix = quote_arg ( cfg % w % fpm_executable ) // \" \" // cfg % subcmd cfg % fpm_cmdline = cfg % cmd_prefix if ( len_trim ( cfg % cmd_rest ) > 0 ) cfg % fpm_cmdline = cfg % fpm_cmdline // \" \" // cfg % cmd_rest end if end subroutine parse_cli_config !> Apply leading watcher flags and configure logging before fpm argument parsing. !! !! Called first with built-in defaults so response errors honor explicit log !! formats, then with project manifest defaults to retain normal precedence. !! Optional `log_format` pins the accepted format during a configuration refresh. subroutine apply_watch_arguments ( w , first_arg , subcmd_pos , log_format ) type ( watch_opts_t ), intent ( inout ) :: w integer , intent ( in ) :: first_arg integer , intent ( out ) :: subcmd_pos character ( len =* ), intent ( in ), optional :: log_format character ( len = :), allocatable :: arg integer :: narg , i if ( present ( log_format )) w % log_format = log_format if ( valid_log_format ( w % log_format )) call configure_logging ( w ) narg = command_argument_count () if ( narg < first_arg ) call usage_and_stop ( \"missing fpm subcommand (build/test/run)\" ) i = first_arg do while ( i <= narg ) arg = get_arg ( i ) if ( is_watch_flag ( arg )) then call apply_watch_flag ( arg , i , narg , w ) else if ( arg == \"-q\" ) then w % verbosity = - 1 else if ( arg == \"-v\" ) then w % verbosity = max ( w % verbosity , 1 ) else if ( arg == \"-vv\" ) then w % verbosity = max ( w % verbosity , 2 ) else exit end if i = i + 1 end do if ( present ( log_format )) w % log_format = log_format if (. not . valid_log_format ( w % log_format )) then call usage_and_stop ( \"invalid log-format: \" // w % log_format // \"; use text, json, or logfmt\" ) end if call configure_logging ( w ) if ( i > narg ) call usage_and_stop ( \"missing fpm subcommand (build/test/run)\" ) arg = get_arg ( i ) if ( arg == \"--help\" . or . arg == \"-h\" ) call usage_and_stop_ok () subcmd_pos = i end subroutine apply_watch_arguments !> Apply watcher defaults and leading flags, then collect fpm model settings. !! !! Watcher flags stop at the subcommand. Recognized fpm options accept either !! `--key=value` or a following token; model parsing stops at `--`, while all !! forwarded tokens remain in the command. Toolchain defaults come from !! `get_fpm_env`; CLI values replace them. Include/ignore flags append !! unique manifest entries, and verbose flags raise the current level. !! Invalid commands, log formats, or missing required values exit with status 2. subroutine parse_cli ( w , settings , fpm_cmdline , subcmd , project_dir , first_arg , response_mode , response_subcmd , log_format ) type ( watch_opts_t ), intent ( out ) :: w class ( fpm_build_settings ), allocatable , intent ( out ) :: settings character ( len = :), allocatable , intent ( out ) :: fpm_cmdline character ( len = :), allocatable , intent ( out ) :: subcmd character ( len =* ), intent ( in ) :: project_dir integer , intent ( in ) :: first_arg logical , intent ( in ) :: response_mode character ( len =* ), intent ( in ) :: response_subcmd character ( len =* ), intent ( in ), optional :: log_format integer :: narg , i , subcmd_pos , eq character ( len = :), allocatable :: a character ( len = :), allocatable :: profile , build_dir character ( len = :), allocatable :: compiler , c_compiler , cxx_compiler , archiver character ( len = :), allocatable :: flag , cflag , cxxflag , ldflag character ( len = :), allocatable :: runner , runner_args , config_file character ( len = :), allocatable :: model_subcmd type ( string_t ), allocatable :: features (:) type ( string_t ), allocatable :: names (:) logical :: prune , example , build_tests integer ( c_int ) :: saved_output call set_watch_defaults ( w ) call apply_watch_from_manifest ( w , join_path ( project_dir , \"fpm.toml\" )) call apply_watch_arguments ( w , first_arg , subcmd_pos , log_format ) prune = . true . example = . false . build_tests = . false . profile = \"\" build_dir = get_fpm_env ( \"BUILD_DIR\" , default_build_dir ()) compiler = get_fpm_env ( \"FC\" , \"gfortran\" ) c_compiler = get_fpm_env ( \"CC\" , \" \" ) cxx_compiler = get_fpm_env ( \"CXX\" , \" \" ) archiver = get_fpm_env ( \"AR\" , \" \" ) flag = get_fpm_env ( \"FFLAGS\" , \" \" ) cflag = get_fpm_env ( \"CFLAGS\" , \" \" ) cxxflag = get_fpm_env ( \"CXXFLAGS\" , \" \" ) ldflag = get_fpm_env ( \"LDFLAGS\" , \" \" ) runner = \"\" runner_args = \"\" config_file = \"\" allocate ( features ( 0 )) allocate ( names ( 0 )) narg = command_argument_count () subcmd = get_arg ( subcmd_pos ) if (. not . is_supported_subcmd ( subcmd )) then call usage_and_stop ( \"unsupported subcommand: \" // trim ( subcmd ) // \" (supported: build,test,run)\" ) end if if ( subcmd_pos < narg ) then fpm_cmdline = \"fpm \" // trim ( subcmd ) // \" \" // join_argv ( subcmd_pos + 1 , narg ) else fpm_cmdline = \"fpm \" // trim ( subcmd ) end if model_subcmd = subcmd if ( response_mode ) then if ( is_supported_subcmd ( response_subcmd )) model_subcmd = response_subcmd call begin_raw_output (. true ., saved_output ) call read_response_options ( profile , build_dir , compiler , c_compiler , cxx_compiler , archiver , & flag , cflag , cxxflag , ldflag , runner , runner_args , config_file , features , names , & prune , example , build_tests , model_subcmd , subcmd ) call end_raw_output ( saved_output ) else i = subcmd_pos + 1 do while ( i <= narg ) a = get_arg ( i ) if ( a == \"--\" ) exit if ( starts_with ( a , \"--\" ) . or . starts_with ( a , \"-C=\" )) then eq = index ( a , \"=\" ) if ( eq > 0 ) a = a (: eq - 1 ) end if select case ( a ) case ( \"--profile\" ) profile = fpm_option_value ( i , narg ) case ( \"--features\" ) call add_features_csv ( features , fpm_option_value ( i , narg )) case ( \"--build-dir\" ) build_dir = fpm_option_value ( i , narg ) case ( \"--compiler\" ) compiler = fpm_option_value ( i , narg ) case ( \"--c-compiler\" ) c_compiler = fpm_option_value ( i , narg ) case ( \"--cxx-compiler\" ) cxx_compiler = fpm_option_value ( i , narg ) case ( \"--archiver\" ) archiver = fpm_option_value ( i , narg ) case ( \"--flag\" ) flag = fpm_option_value ( i , narg ) case ( \"--c-flag\" ) cflag = fpm_option_value ( i , narg ) case ( \"--cxx-flag\" ) cxxflag = fpm_option_value ( i , narg ) case ( \"--link-flag\" ) ldflag = fpm_option_value ( i , narg ) case ( \"--runner\" ) runner = fpm_option_value ( i , narg ) case ( \"--runner-args\" ) runner_args = fpm_option_value ( i , narg ) case ( \"--config-file\" ) config_file = fpm_option_value ( i , narg ) case ( \"--directory\" , \"-C\" ) a = fpm_option_value ( i , narg ) case ( \"--target\" ) call add_target_names ( names , fpm_option_value ( i , narg )) case ( \"--all\" ) call push_feature ( names , \"*\" ) case ( \"--tests\" ) build_tests = . true . case ( \"--prune\" ) prune = . true . case ( \"--no-prune\" ) prune = . false . case ( \"--example\" ) example = . true . case default if ( trim ( subcmd ) == \"run\" . or . trim ( subcmd ) == \"test\" ) then if ( len ( a ) > 0 ) then if ( a ( 1 : 1 ) /= \"-\" ) call push_feature ( names , target_pattern ( a )) end if end if end select i = i + 1 end do end if select case ( trim ( model_subcmd )) case ( \"build\" ) allocate ( fpm_build_settings :: settings ) call init_build_settings ( settings , build_dir , prune , profile , features , compiler , c_compiler , cxx_compiler , archiver , flag , cflag , cxxflag , ldflag ) case ( \"test\" ) allocate ( fpm_test_settings :: settings ) call init_build_settings ( settings , build_dir , prune , profile , features , compiler , c_compiler , cxx_compiler , archiver , flag , cflag , cxxflag , ldflag ) select type ( s => settings ) type is ( fpm_test_settings ) s % build_tests = . true . if ( len ( runner ) > 0 ) s % runner = runner if ( len ( runner_args ) > 0 ) s % runner_args = runner_args call set_names ( s , names ) end select case ( \"run\" ) allocate ( fpm_run_settings :: settings ) call init_build_settings ( settings , build_dir , prune , profile , features , compiler , c_compiler , cxx_compiler , archiver , flag , cflag , cxxflag , ldflag ) select type ( s => settings ) type is ( fpm_run_settings ) s % example = example if ( len ( runner ) > 0 ) s % runner = runner if ( len ( runner_args ) > 0 ) s % runner_args = runner_args call set_names ( s , names ) end select case default call usage_and_stop ( \"unsupported subcommand: \" // trim ( subcmd ) // \" (supported: build,test,run)\" ) end select settings % path_to_config = config_file if ( trim ( model_subcmd ) == \"build\" ) settings % build_tests = build_tests call normalize_watch_opts ( w ) end subroutine parse_cli !> Read `--key=value`, or advance `i` to the next argv token for an option value. !! !! An absent following token exits with status 2. Empty `=value` strings are !! returned unchanged; this helper does not validate the selected fpm value. function fpm_option_value ( i , narg ) result ( value ) integer , intent ( inout ) :: i integer , intent ( in ) :: narg character ( len = :), allocatable :: value , option integer :: eq option = get_arg ( i ) eq = index ( option , \"=\" ) if ( eq > 0 ) then value = option ( eq + 1 :) else if ( i >= narg ) call usage_and_stop ( option // \" requires a value\" ) i = i + 1 value = get_arg ( i ) end if end function fpm_option_value !> Expand fpm's target-list delimiters using the dependency's string utility. subroutine add_target_names ( names , value ) type ( string_t ), allocatable , intent ( inout ) :: names (:) character ( len =* ), intent ( in ) :: value character ( len = :), allocatable :: targets (:) integer :: j call split ( value , targets , delimiters = \" ,:\" ) do j = 1 , size ( targets ) call push_feature ( names , target_pattern ( trim ( targets ( j )))) end do end subroutine add_target_names !> Match fpm's portable `..` spelling of the wildcard target pattern. pure function target_pattern ( value ) result ( pattern ) character ( len =* ), intent ( in ) :: value character ( len = :), allocatable :: pattern pattern = value if ( value == \"..\" ) pattern = \"*\" end function target_pattern !> Return whether a given subcommand token is supported by `fpm-watch`. pure logical function is_supported_subcmd ( s ) result ( ok ) character ( len =* ), intent ( in ) :: s ok = ( trim ( s ) == \"build\" ) . or . ( trim ( s ) == \"test\" ) . or . ( trim ( s ) == \"run\" ) end function is_supported_subcmd !> Test for the `--watch-` prefix; supported flag names are validated separately. pure logical function is_watch_flag ( a ) result ( ok ) character ( len =* ), intent ( in ) :: a ok = starts_with ( a , \"--watch-\" ) end function is_watch_flag !> Consume one leading watcher flag and normalize its options. !! !! Required value options accept `=value` or advance `i` to the next token. !! Boolean and verbosity values use `=value`; bare boolean flags enable the !! setting. Numeric parse failures retain a fallback value. Supervisor flags !! are consumed here but applied separately by `watch_restart`. Unknown flags !! or invalid log formats exit with status 2. subroutine apply_watch_flag ( a , i , narg , w ) character ( len =* ), intent ( in ) :: a integer , intent ( inout ) :: i integer , intent ( in ) :: narg type ( watch_opts_t ), intent ( inout ) :: w character ( len = :), allocatable :: key , val integer :: eq key = trim ( a ) val = \"\" eq = index ( key , \"=\" ) if ( eq > 0 ) then val = key ( eq + 1 :) key = key ( 1 : eq - 1 ) else if ( watch_option_takes_value ( a )) then if ( i >= narg ) call usage_and_stop ( key // \" requires a value\" ) i = i + 1 val = get_arg ( i ) end if select case ( key ) case ( \"--watch-child\" ) w % is_child = . true . w % restart_count = max ( 0 , parse_int ( val , 0 )) case ( \"--watch-auto-restart\" ) w % auto_restart = parse_bool ( val , . true .) case ( \"--watch-restart-delay\" ) w % restart_delay = parse_real ( val , w % restart_delay ) case ( \"--watch-restart-max\" ) w % restart_max = parse_int ( val , w % restart_max ) case ( \"--watch-self\" ) w % self_exe = val case ( \"--watch-fpm\" ) if ( len_trim ( val ) == 0 ) call usage_and_stop ( \"--watch-fpm requires an executable path or name\" ) w % fpm_executable = val case ( \"--watch-deps\" ) if ( len_trim ( val ) > 0 ) then w % watch_deps = parse_bool ( val , . true .) else w % watch_deps = . true . end if case ( \"--watch-no-deps\" ) w % watch_deps = . false . case ( \"--watch-quiet\" ) w % verbosity = - 1 case ( \"--watch-log-format\" ) if (. not . valid_log_format ( val )) call usage_and_stop ( \"--watch-log-format requires text, json, or logfmt\" ) w % log_format = val call configure_logging ( w ) case ( \"--watch-verbose\" ) if ( len_trim ( val ) > 0 ) then w % verbosity = max ( w % verbosity , parse_int ( val , 1 )) else w % verbosity = max ( w % verbosity , 1 ) end if case ( \"--watch-very-verbose\" ) w % verbosity = max ( w % verbosity , 2 ) case ( \"--watch-debug\" ) w % debug = parse_bool ( val , . true .) case ( \"--watch-print-files\" ) w % print_files_once = parse_bool ( val , . true .) if ( w % print_files_once ) w % verbosity = max ( w % verbosity , 2 ) case ( \"--watch-silent-fpm\" ) w % silent_fpm = parse_bool ( val , . true .) case ( \"--watch-output-markers\" ) w % output_markers = parse_bool ( val , . true .) case ( \"--watch-run-on-start\" ) w % run_on_start = . true . case ( \"--watch-no-run-on-start\" ) w % run_on_start = . false . case ( \"--watch-rescan\" ) w % rescan = parse_real ( val , w % rescan ) case ( \"--watch-no-rescan\" ) w % rescan = 0.0 case ( \"--watch-ignore\" ) call push_feature ( w % ignore , trim ( val )) case ( \"--watch-include\" ) call push_feature ( w % include , trim ( val )) case ( \"--watch-poll\" ) w % poll = parse_real ( val , w % poll ) case ( \"--watch-debounce\" ) w % debounce = parse_real ( val , w % debounce ) case ( \"--watch-once\" ) if ( len_trim ( val ) > 0 ) then w % once = parse_bool ( val , . true .) else w % once = . true . end if case ( \"--watch-help\" ) call usage_and_stop_ok () case default call usage_and_stop ( \"unknown watch flag: \" // trim ( a )) end select call normalize_watch_opts ( w ) end subroutine apply_watch_flag !> Print a usage message and terminate with a non-zero exit status. subroutine usage_and_stop ( msg ) character ( len =* ), intent ( in ) :: msg call log_event ( \"error\" , \"cli.error\" , msg ) if (. not . structured_logging ()) write ( error_unit , \"(a)\" ) \"Use fpm-watch --watch-help for usage.\" stop 2 end subroutine usage_and_stop !> Print a usage message and terminate successfully. subroutine usage_and_stop_ok () call usage_print_only () stop 0 end subroutine usage_and_stop_ok !> Print the `fpm-watch` help text. !! !! The help includes: !! - Watcher options (`--watch-*`), !! - Project configuration (`[extra.fpm-watch]`), !! - Examples and behavioral notes. subroutine usage_print_only () write ( error_unit , \"(a)\" ) \"fpm-watch — Smart file watcher plugin for fpm projects\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"USAGE\" write ( error_unit , \"(a)\" ) \"  fpm-watch [watch options] <build|test|run> [fpm options]\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  Everything after <build|test|run> is passed to fpm unchanged.\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"WATCH OPTIONS\" write ( error_unit , \"(a)\" ) \"  --watch-help\" write ( error_unit , \"(a)\" ) \"      Show this help and exit.\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-quiet | -q\" write ( error_unit , \"(a)\" ) \"      Quiet mode (errors only).\" write ( error_unit , \"(a)\" ) \"  --watch-log-format <text|json|logfmt>\" write ( error_unit , \"(a)\" ) \"      Log format (default: text). Structured logs use stdout; fpm output uses stderr.\" write ( error_unit , \"(a)\" ) \"  --watch-verbose[=N] | -v\" write ( error_unit , \"(a)\" ) \"      Increase verbosity. N: 0..2 (default: 1).\" write ( error_unit , \"(a)\" ) \"  --watch-very-verbose | -vv\" write ( error_unit , \"(a)\" ) \"      Same as verbosity=2 (prints watch list, more details).\" write ( error_unit , \"(a)\" ) \"  --watch-debug\" write ( error_unit , \"(a)\" ) \"      Extra debug logs. Use --watch-debug=false to disable a manifest setting.\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-deps\" write ( error_unit , \"(a)\" ) \"      Also watch dependency source trees (including deps under build/).\" write ( error_unit , \"(a)\" ) \"  --watch-no-deps\" write ( error_unit , \"(a)\" ) \"      Disable dependency watching (default).\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-poll <sec>\" write ( error_unit , \"(a)\" ) \"      Poll interval for file checks. Default: 0.5\" write ( error_unit , \"(a)\" ) \"  --watch-debounce <sec>\" write ( error_unit , \"(a)\" ) \"      Wait after first change to coalesce edits. Default: 0.2\" write ( error_unit , \"(a)\" ) \"  --watch-rescan <sec>\" write ( error_unit , \"(a)\" ) \"      Rebuild the fpm model periodically (slow on big projects). Default: 0 (off).\" write ( error_unit , \"(a)\" ) \"  --watch-no-rescan\" write ( error_unit , \"(a)\" ) \"      Disable periodic rebuild (recommended).\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-run-on-start\" write ( error_unit , \"(a)\" ) \"      Run the command once immediately on startup. Default: on.\" write ( error_unit , \"(a)\" ) \"  --watch-no-run-on-start\" write ( error_unit , \"(a)\" ) \"      Only run after a change is detected.\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-silent-fpm\" write ( error_unit , \"(a)\" ) \"      Suppress fpm output; keep only fpm-watch status lines.\" write ( error_unit , \"(a)\" ) \"      Use --watch-silent-fpm=false to override manifest suppression.\" write ( error_unit , \"(a)\" ) \"  --watch-fpm <path>\" write ( error_unit , \"(a)\" ) \"      fpm executable to invoke (default: fpm on PATH).\" write ( error_unit , \"(a)\" ) \"  --watch-output-markers\" write ( error_unit , \"(a)\" ) \"      Frame raw stderr with cycle markers in structured logging mode (GUI integrations).\" write ( error_unit , \"(a)\" ) \"      Keep matching command events visible even in quiet mode.\" write ( error_unit , \"(a)\" ) \"  --watch-print-files\" write ( error_unit , \"(a)\" ) \"      Print the watched file list at startup; --watch-print-files=false disables it.\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-ignore <glob>\" write ( error_unit , \"(a)\" ) \"      Ignore files matching glob (repeatable).\" write ( error_unit , \"(a)\" ) \"  --watch-include <glob>\" write ( error_unit , \"(a)\" ) \"      Only watch files matching glob (repeatable). Empty means include all.\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-auto-restart\" write ( error_unit , \"(a)\" ) \"      Restart on crashes; --watch-auto-restart=false disables a manifest setting.\" write ( error_unit , \"(a)\" ) \"  --watch-restart-delay <sec>\" write ( error_unit , \"(a)\" ) \"      Delay before restart. Default: 1.0\" write ( error_unit , \"(a)\" ) \"  --watch-restart-max <N>\" write ( error_unit , \"(a)\" ) \"      Maximum restart attempts (0 = unlimited). Default: 0\" write ( error_unit , \"(a)\" ) \"  --watch-self <path>\" write ( error_unit , \"(a)\" ) \"      Explicit path to fpm-watch executable (advanced).\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-once\" write ( error_unit , \"(a)\" ) \"      Initialize (and optionally run once) then exit. Good for CI.\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"CONFIGURATION (fpm.toml)\" write ( error_unit , \"(a)\" ) \"  [extra.fpm-watch]  (same names as flags, without the --watch- prefix)\" write ( error_unit , \"(a)\" ) \"  poll         = 0.5\" write ( error_unit , \"(a)\" ) \"  debounce     = 0.2\" write ( error_unit , \"(a)\" ) \"  rescan       = 0.0\" write ( error_unit , \"(a)\" ) \"  run-on-start = true\" write ( error_unit , \"(a)\" ) \"  silent-fpm   = false\" write ( error_unit , \"(a)\" ) \"  print-files  = false\" write ( error_unit , \"(a)\" ) \"  deps         = false\" write ( error_unit , \"(a)\" ) \"  auto-restart = false\" write ( error_unit , \"(a)\" ) \"  restart-delay= 1.0\" write ( error_unit , \"(a)\" ) \"  restart-max  = 0\" write ( error_unit , \"(a)\" ) \"  self         = \"\"\"\"\" write ( error_unit , \"(a)\" ) \"  debug        = false\" write ( error_unit , \"(a)\" ) \"  verbosity    = 0\" write ( error_unit , \"(a)\" ) '  log-format   = \"text\"' write ( error_unit , \"(a)\" ) '  fpm-executable = \"fpm\"' write ( error_unit , \"(a)\" ) \"  output-markers = false\" write ( error_unit , \"(a)\" ) \"  ignore       = []\" write ( error_unit , \"(a)\" ) \"  include      = []\" write ( error_unit , \"(a)\" ) \"  once         = false\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"EXAMPLES\" write ( error_unit , \"(a)\" ) \"  fpm-watch build\" write ( error_unit , \"(a)\" ) \"  fpm-watch test\" write ( error_unit , \"(a)\" ) \"  fpm-watch --watch-deps test -- --list\" write ( error_unit , \"(a)\" ) \"  fpm-watch --watch-auto-restart test\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"NOTES\" write ( error_unit , \"(a)\" ) \"  fpm-watch ignores build/ to avoid infinite rebuild loops.\" write ( error_unit , \"(a)\" ) \"  Enable deps only if you want dependency source changes to trigger runs.\" write ( error_unit , \"(a)\" ) \"  Polling, debounce, and restart delays always use OS sleep to minimize idle CPU usage.\" write ( error_unit , \"(a)\" ) \"  To quit, press Ctrl+C (or create an empty file named .fpm-watch.stop).\" write ( error_unit , \"(a)\" ) \"\" end subroutine usage_print_only !> Copy parsed build and toolchain values into a typed fpm settings object. !! !! `parse_cli` resolves environment defaults and CLI overrides beforehand. !! This routine disables model verbosity, replaces the feature array, and !! assigns toolchain/flag strings. An empty profile retains the type default. subroutine init_build_settings ( settings , build_dir , prune , profile , features , compiler_in , c_compiler_in , cxx_compiler_in , archiver_in , flag_in , cflag_in , cxxflag_in , ldflag_in ) class ( fpm_build_settings ), intent ( inout ) :: settings character ( len =* ), intent ( in ) :: build_dir logical , intent ( in ) :: prune character ( len =* ), intent ( in ) :: profile type ( string_t ), allocatable , intent ( in ) :: features (:) character ( len =* ), intent ( in ) :: compiler_in , c_compiler_in , cxx_compiler_in , archiver_in character ( len =* ), intent ( in ) :: flag_in , cflag_in , cxxflag_in , ldflag_in settings % verbose = . false . settings % prune = prune settings % build_dir = build_dir if ( len_trim ( profile ) > 0 ) settings % profile = trim ( profile ) if ( allocated ( settings % features )) deallocate ( settings % features ) if ( allocated ( features )) then if ( size ( features ) > 0 ) then allocate ( settings % features ( size ( features ))) settings % features = features end if end if settings % compiler = compiler_in settings % c_compiler = c_compiler_in settings % cxx_compiler = cxx_compiler_in settings % archiver = archiver_in settings % flag = flag_in settings % cflag = cflag_in settings % cxxflag = cxxflag_in settings % ldflag = ldflag_in end subroutine init_build_settings !> Return the default build directory used by `fpm-watch`. pure function default_build_dir () result ( dir ) character ( len = :), allocatable :: dir dir = \"build\" end function default_build_dir !> Copy nonempty target patterns into an initially unallocated `s%name`. !! !! Patterns come from positional names, `--target`, or `--all`. Empty or !! unallocated input leaves `s%name` unchanged; copied names are right-trimmed. pure subroutine set_names ( s , names ) class ( fpm_run_settings ), intent ( inout ) :: s type ( string_t ), allocatable , intent ( in ) :: names (:) integer :: i , k , n if (. not . allocated ( names )) return n = 0 do i = 1 , size ( names ) if ( len_trim ( names ( i )% s ) > 0 ) n = n + 1 end do if ( n == 0 ) return allocate ( s % name ( n )) k = 0 do i = 1 , size ( names ) if ( len_trim ( names ( i )% s ) == 0 ) cycle k = k + 1 s % name ( k ) = trim ( names ( i )% s ) end do end subroutine set_names !> Parse a comma-separated `--features` value into the features array. !! !! Empty tokens are ignored; whitespace around tokens is stripped. subroutine add_features_csv ( features , csv ) type ( string_t ), allocatable , intent ( inout ) :: features (:) character ( len =* ), intent ( in ) :: csv character ( len = :), allocatable :: tokens (:) integer :: j call split ( csv , tokens , delimiters = \",\" ) do j = 1 , size ( tokens ) call push_feature ( features , trim ( adjustl ( tokens ( j )))) end do end subroutine add_features_csv end module watch_cli","tags":"","url":"sourcefile/watch_cli.f90.html"},{"title":"watch_filter.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_filter.f90~~EfferentGraph sourcefile~watch_filter.f90 watch_filter.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_filter.f90->sourcefile~watch_util.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_filter.f90~~AfferentGraph sourcefile~watch_filter.f90 watch_filter.f90 sourcefile~watch_fpm_graph.f90 watch_fpm_graph.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_filter.f90 sourcefile~watch_graph_worker.f90 watch_graph_worker.f90 sourcefile~watch_graph_worker.f90->sourcefile~watch_fpm_graph.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_graph_worker.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Normalize paths and filter the computed watch list with fpm globs. !! !! Normalization changes backslashes to `/` and removes leading `./` segments; !! it does not canonicalize paths. Build-directory exclusion is applied by the !! graph collector. Include/ignore filters retain watched manifests and version metadata. module watch_filter use watch_util , only : starts_with use , intrinsic :: iso_fortran_env , only : int64 use fpm_strings , only : string_t , glob use fpm_filesystem , only : basename implicit none private public normalize_path , starts_with , filter_watch_files , is_ignored_path contains !> Right-trim a path, replace backslashes, and remove repeated leading `./`. !! !! Preserve case, interior separators, and `..` segments; no filesystem lookup !! or canonicalization is performed. pure function normalize_path ( path ) result ( p ) character ( len =* ), intent ( in ) :: path character ( len = :), allocatable :: p integer :: i p = trim ( path ) do i = 1 , len ( p ) if ( p ( i : i ) == char ( 92 )) p ( i : i ) = \"/\" end do do while ( len ( p ) >= 2 ) if ( p ( 1 : 2 ) == \"./\" ) then p = p ( 3 :) else exit end if end do end function normalize_path !> Compare right-trimmed suffixes; an empty suffix matches every string. pure logical function ends_with ( s , suffix ) result ( ok ) character ( len =* ), intent ( in ) :: s , suffix integer :: ns , n ns = len_trim ( suffix ) n = len_trim ( s ) if ( ns <= 0 ) then ok = . true . else if ( n < ns ) then ok = . false . else ok = ( s ( n - ns + 1 : n ) == suffix ( 1 : ns )) end if end function ends_with !> Test for a slash-delimited interior or trailing path fragment. pure logical function contains_path_fragment ( p , frag ) result ( ok ) character ( len =* ), intent ( in ) :: p , frag character ( len = :), allocatable :: needle ok = . false . if ( len_trim ( frag ) == 0 ) return needle = \"/\" // trim ( frag ) // \"/\" if ( index ( p , needle ) /= 0 ) then ok = . true . return end if if ( ends_with ( p , \"/\" // trim ( frag ))) then ok = . true . return end if end function contains_path_fragment !> Test normalized paths against a build directory or its slash-delimited fragments. !! !! Matches the directory itself, its descendants, and interior/trailing path !! fragments. An empty build directory matches nothing; dependency exceptions !! are applied by the graph collector. pure logical function is_ignored_path ( path , build_dir ) result ( ignored ) character ( len =* ), intent ( in ) :: path , build_dir character ( len = :), allocatable :: p , b p = normalize_path ( path ) b = normalize_path ( build_dir ) ignored = . false . if ( len_trim ( b ) == 0 ) return if ( p == b ) then ignored = . true . return end if if ( starts_with ( p , b // \"/\" )) then ignored = . true . return end if if ( contains_path_fragment ( p , b )) then ignored = . true . return end if end function is_ignored_path !> Filter normalized paths and optional aligned masks, preserving order. !! !! Empty/unallocated include lists admit all files; matching ignore globs !! remove included paths. Manifests and optional marked metadata bypass both filters. !! An unallocated file list is left unchanged. If masks are supplied but !! unallocated, create zero masks before filtering them with the files. subroutine filter_watch_files ( files , include , ignore , masks , preserve ) type ( string_t ), allocatable , intent ( inout ) :: files (:) !! Normalized input paths, replaced with the retained subset in the same order. type ( string_t ), allocatable , intent ( in ) :: include (:), ignore (:) !! Include and ignore glob lists, respectively; empty/unallocated lists impose no restriction. integer ( int64 ), allocatable , intent ( inout ), optional :: masks (:) !! Aligned file masks; created as zeros if supplied but unallocated, then filtered with files. logical , intent ( in ), optional :: preserve (:) !! Aligned metadata markers; true entries bypass include/ignore filters. logical , allocatable :: keep (:) type ( string_t ), allocatable :: out (:) integer ( int64 ), allocatable :: outm (:) integer :: i , k , n , m if (. not . allocated ( files )) return n = size ( files ) allocate ( keep ( n )) do i = 1 , n keep ( i ) = should_keep ( files ( i )% s , include , ignore ) if ( present ( preserve )) keep ( i ) = keep ( i ) . or . preserve ( i ) end do m = count ( keep ) allocate ( out ( m )) if ( present ( masks )) then if (. not . allocated ( masks )) then allocate ( masks ( n )) masks = 0_int64 end if allocate ( outm ( m )) end if k = 0 do i = 1 , n if (. not . keep ( i )) cycle k = k + 1 out ( k )% s = files ( i )% s if ( present ( masks )) outm ( k ) = masks ( i ) end do call move_alloc ( out , files ) if ( present ( masks )) call move_alloc ( outm , masks ) deallocate ( keep ) contains !> Retain manifests unconditionally; otherwise require inclusion and no ignore match. logical function should_keep ( path , include_pats , ignore_pats ) result ( ok ) character ( len =* ), intent ( in ) :: path type ( string_t ), allocatable , intent ( in ) :: include_pats (:), ignore_pats (:) character ( len = :), allocatable :: b b = basename ( trim ( path )) if ( b == \"fpm.toml\" ) then ok = . true . return end if ok = match_include ( path , include_pats ) . and . (. not . match_any ( path , ignore_pats )) end function should_keep !> Test fpm globs after normalizing each nonempty pattern; an absent list matches nothing. logical function match_any ( path , pats ) result ( ok ) character ( len =* ), intent ( in ) :: path type ( string_t ), allocatable , intent ( in ) :: pats (:) integer :: j character ( len = :), allocatable :: pat ok = . false . if (. not . allocated ( pats )) return do j = 1 , size ( pats ) if ( len_trim ( pats ( j )% s ) == 0 ) cycle pat = normalize_path ( trim ( pats ( j )% s )) if ( glob ( trim ( path ), pat )) then ok = . true . return end if end do end function match_any !> Admit every path for an empty/unallocated include list; otherwise require a glob match. logical function match_include ( path , pats ) result ( ok ) character ( len =* ), intent ( in ) :: path type ( string_t ), allocatable , intent ( in ) :: pats (:) if (. not . allocated ( pats )) then ok = . true . return end if if ( size ( pats ) == 0 ) then ok = . true . return end if ok = match_any ( path , pats ) end function match_include end subroutine filter_watch_files end module watch_filter","tags":"","url":"sourcefile/watch_filter.f90.html"},{"title":"watch_cmdsplice.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_cmdsplice.f90~~EfferentGraph sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_cmdsplice.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_util.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_cmdsplice.f90~~AfferentGraph sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_exec.f90 watch_exec.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_cli.f90 sourcefile~watch_engine.f90->sourcefile~watch_exec.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Helpers for manipulating `fpm` command lines. !! !! Provides utilities to split an `fpm <subcmd> ...` command into a prefix and !! remainder, and to inject target names into the correct position while !! preserving a `--` delimiter for arguments passed to the executed program. !! !! These utilities operate on command strings serialized by `quote_arg()`. !! Delimiter detection respects quoted argv tokens and their escaped quotes. module watch_cmdsplice use watch_cmdline , only : is_windows_os implicit none private public split_cmd_after_subcmd , inject_names_into_cmd contains !> Split a literal `fpm SUBCOMMAND` prefix from the remaining serialized arguments. !! !! Only the first two unquoted, whitespace-delimited tokens are scanned; !! custom executable substitution happens later in `watch_cli`. Empty input, !! a non-`fpm` first token, or a missing subcommand returns empty outputs. subroutine split_cmd_after_subcmd ( full , prefix , rest ) character ( len =* ), intent ( in ) :: full !! Full command string. character ( len = :), allocatable , intent ( out ) :: prefix !! Prefix up to and including the subcommand token. character ( len = :), allocatable , intent ( out ) :: rest !! Remaining arguments after the subcommand. character ( len = :), allocatable :: s integer :: p_fpm_end , p_sub_start , p_sub_end s = adjustl ( trim ( full )) prefix = \"\" rest = \"\" if ( len_trim ( s ) == 0 ) return if (. not . starts_with_token ( s , \"fpm\" )) return p_fpm_end = token_end ( s , 1 ) p_sub_start = next_token_start ( s , p_fpm_end + 1 ) if ( p_sub_start == 0 ) return p_sub_end = token_end ( s , p_sub_start ) prefix = trim ( s ( 1 : p_sub_end )) if ( p_sub_end < len_trim ( s )) then rest = adjustl ( s ( p_sub_end + 1 :)) else rest = \"\" end if contains !> Test the first whitespace-delimited token against a nonempty right-trimmed token. pure logical function starts_with_token ( str , tok ) result ( ok ) character ( len =* ), intent ( in ) :: str , tok integer :: e , n ok = . false . n = len_trim ( tok ) if ( n == 0 ) return if ( len_trim ( str ) < n ) return if ( str ( 1 : n ) /= tok ( 1 : n )) return e = token_end ( str , 1 ) ok = ( e == n ) end function starts_with_token !> Return the next non-space/tab position at or after `i`, or zero if absent. pure integer function next_token_start ( str , i ) result ( pos ) character ( len =* ), intent ( in ) :: str integer , intent ( in ) :: i integer :: k , n pos = 0 n = len_trim ( str ) k = max ( 1 , i ) do while ( k <= n ) if ( str ( k : k ) /= \" \" . and . str ( k : k ) /= char ( 9 )) then pos = k return end if k = k + 1 end do end function next_token_start !> Return the end of an unquoted space/tab-delimited token, or zero for an invalid start. pure integer function token_end ( str , i ) result ( pos ) character ( len =* ), intent ( in ) :: str integer , intent ( in ) :: i integer :: k , n pos = 0 n = len_trim ( str ) if ( i < 1 . or . i > n ) return k = i do while ( k <= n ) if ( str ( k : k ) == \" \" . or . str ( k : k ) == char ( 9 )) then pos = k - 1 return end if k = k + 1 end do pos = n end function token_end end subroutine split_cmd_after_subcmd !> Insert already serialized names after fpm options and before a `--` token. !! !! `prefix` includes the executable/subcommand; `rest` retains forwarded args. !! `names` must already contain quoted argv tokens. Optional `windows` selects !! delimiter parsing rules. An empty prefix returns an empty string; empty !! names simply rejoin prefix and rest. function inject_names_into_cmd ( prefix , rest , names , windows ) result ( out ) character ( len =* ), intent ( in ) :: prefix !! Prefix up to and including the subcommand. character ( len =* ), intent ( in ) :: rest !! Remaining arguments after the subcommand. character ( len =* ), intent ( in ) :: names !! Space-separated names to inject. logical , intent ( in ), optional :: windows !! Explicit platform selection supports portable serialization checks. character ( len = :), allocatable :: out character ( len = :), allocatable :: p , r , n , before , after integer :: dd logical :: use_windows p = trim ( prefix ) r = adjustl ( trim ( rest )) n = trim ( names ) if ( len_trim ( p ) == 0 ) then out = \"\" return end if if ( len_trim ( n ) == 0 ) then if ( len_trim ( r ) == 0 ) then out = p else out = p // \" \" // r end if return end if if ( present ( windows )) then use_windows = windows else use_windows = is_windows_os () end if dd = find_double_dash_delim ( r , use_windows ) if ( dd > 0 ) then if ( dd > 1 ) then before = trim ( r ( 1 : dd - 1 )) else before = \"\" end if after = trim ( adjustl ( r ( dd :))) else before = trim ( r ) after = \"\" end if out = p if ( len_trim ( before ) > 0 ) out = out // \" \" // before out = out // \" \" // n if ( len_trim ( after ) > 0 ) out = out // \" \" // after contains !> Locate a complete `-