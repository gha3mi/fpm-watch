easier to distinguish in\nlarge graphs. Source Code subroutine supervisor_loop ( delay0 , max0 , exe0 , log_format ) real , intent ( in ) :: delay0 integer , intent ( in ) :: max0 character ( len =* ), intent ( in ) :: exe0 character ( len =* ), intent ( in ) :: log_format character ( len = :), allocatable :: child_cmd integer :: code , attempt real :: delay logical :: interrupted attempt = 0 delay = max ( 0.0 , delay0 ) do code = 0 child_cmd = build_child_command ( exe0 , log_format , attempt ) call execute_command ( child_cmd , code , interrupted ) if ( interrupted ) then call log_event ( \"info\" , \"supervisor.stopped\" , \"Supervisor interrupted\" , [ log_string ( \"reason\" , \"interrupt\" )]) stop code end if if ( code == 0 ) exit if ( max0 > 0 . and . attempt >= max0 ) then call log_event ( \"error\" , \"supervisor.limit_reached\" , \"Child failed; restart limit reached\" , & [ log_int ( \"exit_code\" , code ), log_int ( \"restart_count\" , attempt )]) stop code end if attempt = attempt + 1 call log_event ( \"warn\" , \"supervisor.restart\" , & \"Child failed (exit \" // str ( code ) // \"); restart #\" // str ( attempt ) // \" in \" // ftoa ( delay ) // \"s\" , & [ log_int ( \"exit_code\" , code ), log_int ( \"restart_count\" , attempt ), log_real ( \"delay_ms\" , delay * 100 0.0 )]) call sleep_seconds ( delay ) end do stop 0 end subroutine supervisor_loop","tags":"","url":"proc/supervisor_loop.html"},{"title":"find_ptr_index – fpm-watch","text":"private  function find_ptr_index(p, all) result(idx) Uses fpm_targets proc~~find_ptr_index~~UsesGraph proc~find_ptr_index find_ptr_index fpm_targets fpm_targets proc~find_ptr_index->fpm_targets Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or 