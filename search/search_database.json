li ( w , settings , fpm_cmdline , subcmd , project_dir , first_arg , response_mode , response_subcmd , log_format ) type ( watch_opts_t ), intent ( out ) :: w class ( fpm_build_settings ), allocatable , intent ( out ) :: settings character ( len = :), allocatable , intent ( out ) :: fpm_cmdline character ( len = :), allocatable , intent ( out ) :: subcmd character ( len =* ), intent ( in ) :: project_dir integer , intent ( in ) :: first_arg logical , intent ( in ) :: response_mode character ( len =* ), intent ( in ) :: response_subcmd character ( len =* ), intent ( in ), optional :: log_format integer :: narg , i , subcmd_pos , eq character ( len = :), allocatable :: a character ( len = :), allocatable :: profile , build_dir character ( len = :), allocatable :: compiler , c_compiler , cxx_compiler , archiver character ( len = :), allocatable :: flag , cflag , cxxflag , ldflag character ( len = :), allocatable :: runner , runner_args , config_file character ( len = :), allocatable :: model_subcmd type ( string_t ), allocatable :: features (:) type ( string_t ), allocatable :: names (:) logical :: prune , example , build_tests integer ( c_int ) :: saved_output call set_watch_defaults ( w ) call apply_watch_from_manifest ( w , join_path ( project_dir , \"fpm.toml\" )) call apply_watch_arguments ( w , first_arg , subcmd_pos , log_format ) prune = . true . example = . false . build_tests = . false . profile = \"\" build_dir = get_fpm_env ( \"BUILD_DIR\" , default_build_dir ()) compiler = get_fpm_env ( \"FC\" , \"gfortran\" ) c_compiler = get_fpm_env ( \"CC\" , \" \" ) cxx_compiler = get_fpm_env ( \"CXX\" , \" \" ) archiver = get_fpm_env ( \"AR\" , \" \" ) flag = get_fpm_env ( \"FFLAGS\" , \" \" ) cflag = get_fpm_env ( \"CFLAGS\" , \" \" ) cxxflag = get_fpm_env ( \"CXXFLAGS\" , \" \" ) ldflag = get_fpm_env ( \"LDFLAGS\" , \" \" ) runner = \"\" runner_args = \"\" config_file = \"\" allocate ( features ( 0 )) allocate ( names ( 0 )) narg = command_argument_count () subcmd = get_arg ( subcmd_pos ) if (. not . is_supported_subcmd ( subcmd )) then call usage_and_stop ( \"unsupported subcommand: \" // trim ( subcmd ) // \" (supported: build,test,run)\" ) end if if ( subcmd_pos < narg ) then fpm_cmdline = \"fpm \" // trim ( subcmd ) // \" \" // join_argv ( subcmd_pos + 1 , narg ) else fpm_cmdline = \"fpm \" // trim ( subcmd ) end if model_subcmd = subcmd if ( response_mode ) then if ( is_supported_subcmd ( response_subcmd )) model_subcmd = response_subcmd call begin_raw_output (. true ., saved_output ) call read_response_options ( profile , build_dir , compiler , c_compiler , cxx_compiler , archiver , & flag , cflag , cxxflag , ldflag , runner , runner_args , config_file , features , names , & prune , example , build_tests , model_subcmd , subcmd ) call end_raw_output ( saved_output ) else i = subcmd_pos + 1 do while ( i <= narg ) a = get_arg ( i ) if ( a == \"--\" ) exit if ( starts_with ( a , \"--\" ) . or . starts_with ( a , \"-C=\" )) then eq = index ( a , \"=\" ) if ( eq > 0 ) a = a (: eq - 1 ) end if select case ( a ) case ( \"--profile\" ) profile = fpm_option_value ( i , narg ) case ( \"--features\" ) call add_features_csv ( features , fpm_option_value ( i , narg )) case ( \"--build-dir\" ) build_dir = fpm_option_value ( i , narg ) case ( \"--compiler\" ) compiler = fpm_option_value ( i , narg ) case ( \"--c-compiler\" ) c_compiler = fpm_option_value ( i , narg ) case ( \"--cxx-compiler\" ) cxx_compiler = fpm_option_value ( i , narg ) case ( \"--archiver\" ) archiver = fpm_option_value ( i , narg ) case ( \"--flag\" ) flag = fpm_option_value ( i , narg ) case ( \"--c-flag\" ) cflag = fpm_option_value ( i , narg ) case ( \"--cxx-flag\" ) cxxflag = fpm_option_value ( i , narg ) case ( \"--link-flag\" ) ldflag = fpm_option_value ( i , narg ) case ( \"--runner\" ) runner = fpm_option_value ( i , narg ) case ( \"--runner-args\" ) runner_args = fpm_option_value ( i , narg ) case ( \"--config-file\" ) config_file = fpm_option_value ( i , narg ) case ( \"--directory\" , \"-C\" ) a = fpm_option_value ( i , narg ) case ( \"--target\" ) call add_target_names ( names , fpm_option_value ( i , narg )) case ( \"--all\" ) call push_feature ( names , \"*\" ) case ( \"--tests\" ) build_tests = . true . case ( \"--prune\" ) prune = . true . case ( \"--no-prune\" ) prune = . false . case ( \"--example\" ) example = . true . case default if ( trim ( subcmd ) == \"run\" . or . trim ( subcmd ) == \"test\" ) then if ( len ( a ) > 0 ) then if ( a ( 1 : 1 ) /= \"-\" ) call push_feature ( names , target_pattern ( a )) end if end if end select i = i + 1 end do end if select case ( trim ( model_subcmd )) case ( \"build\" ) allocate ( fpm_build_settings :: settings ) call init_build_settings ( settings , build_dir , prune , profile , features , compiler , c_compiler , cxx_compiler , archiver , flag , cflag , cxxflag , ldflag ) case ( \"test\" ) allocate ( fpm_test_settings :: settings ) call init_build_settings ( settings , build_dir , prune , profile , features , compiler , c_compiler , cxx_compiler , archiver , flag , cflag , cxxflag , ldflag ) select type ( s => settings ) type is ( fpm_test_settings ) s % build_tests = . true . if ( len ( runner ) > 0 ) s % runner = runner if ( len ( runner_args ) > 0 ) s % runner_args = runner_args call set_names ( s , names ) end select case ( \"run\" ) allocate ( fpm_run_settings :: settings ) call init_build_settings ( settings , build_dir , prune , profile , features , compiler , c_compiler , cxx_compiler , archiver , flag , cflag , cxxflag , ldflag ) select type ( s => settings ) type is ( fpm_run_settings ) s % example = example if ( len ( runner ) > 0 ) s % runner = runner if ( len ( runner_args ) > 0 ) s % runner_args = runner_args call set_names ( s , names ) end select case default call usage_and_stop ( \"unsupported subcommand: \" // trim ( subcmd ) // \" (supported: build,test,run)\" ) end select settings % path_to_config = config_file if ( trim ( model_subcmd ) == \"build\" ) settings % build_tests = build_tests call normalize_watch_opts ( w ) end subroutine parse_cli","tags":"","url":"proc/parse_cli.html"},{"title":"prepare_response_options – fpm-watch","text":"private  subroutine prepare_response_options(first_arg, response_files, enabled, subcmd, error) Preflight named response files before delegating response semantics to M_CLI2. Only options, comments, and OS section headers are accepted. Procedural records\nare rejected before the upstream parser can execute them. Missing named files\nnever fall through to executable-specific compound files. Candidate paths are\nabsolute and include missing higher-priority search locations for watching. Arguments Type Intent Optional Attributes Name integer, intent(in) :: first_arg type(string_t), intent(out), allocatable :: response_files (:) logical, intent(out) :: enabled character(len=:), intent(out), allocatable :: subcmd type(error_t), intent(out), allocatable :: error Calls proc~~prepare_response_options~~CallsGraph proc~prepare_response_options prepare_response_options exists exists proc~prepare_response_options->exists fatal_error fatal_error proc~prepare_response_options->fatal_error get_subcommand get_subcommand proc~prepare_response_options->get_subcommand proc~begin_raw_output begin_raw_output proc~prepare_response_options->proc~begin_raw_output proc~end_raw_output end_raw_output proc~prepare_response_options->proc~end_raw_output proc~fpm_option_takes_value fpm_option_takes_value proc~prepare_response_options->proc~fpm_option_takes_value proc~get_arg get_arg proc~prepare_response_options->proc~get_arg proc~inspect_response_candidate inspect_response_candidate proc~prepare_response_options->proc~inspect_response_candidate proc~is_supported_subcmd is_supported_subcmd proc~prepare_response_options->proc~is_supported_subcmd proc~push_feature push_feature proc~prepare_response_options->proc~push_feature proc~response_candidates response_candidates proc~prepare_response_options->proc~r