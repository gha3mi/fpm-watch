dren ( i ), mask , collected ) end do return end if collected % includes ( index )% parsed = . true . ! fpm's text reader leaves its unit open for an empty file. Empty files ! have no includes, so retain them in the watch set without parsing them. inquire ( file = path , size = file_size , iostat = io_status ) if ( io_status /= 0 ) return if ( file_size <= 0_int64 ) return do language = 1 , 2 if ( language == 1 ) then parsed = parse_f_source ( path , parse_error ) else parsed = parse_c_source ( path , parse_error ) end if if (. not . allocated ( parsed % include_dependencies )) cycle do i = 1 , size ( parsed % include_dependencies ) call gather_include_candidates ( index , path , parsed % include_dependencies ( i )% s , mask , collected , & build_dir , include_dirs , watch_deps , dep_dirs ) end do end do end subroutine gather_include_closure","tags":"","url":"proc/gather_include_closure.html"},{"title":"handle_graph_error – fpm-watch","text":"private  subroutine handle_graph_error(err, error, stage) Transfer err to an optional error output, or log its stage and exit with status 1. Arguments Type Intent Optional Attributes Name type(error_t), intent(inout), allocatable :: err type(error_t), intent(out), optional, allocatable :: error character(len=*), intent(in) :: stage Calls proc~~handle_graph_error~~CallsGraph proc~handle_graph_error handle_graph_error proc~log_event log_event proc~handle_graph_error->proc~log_event proc~format_log_record format_log_record proc~log_event->proc~format_log_record proc~log_timestamp log_timestamp proc~log_event->proc~log_timestamp proc~escape_text escape_text proc~format_log_record->proc~escape_text proc~escaped_length escaped_length proc~format_log_record->proc~escaped_length proc~json_quote json_quote proc~format_log_record->proc~json_quote proc~put_json_string put_json_string proc~format_log_record->proc~put_json_string proc~put_text put_text proc~format_log_record->proc~put_text proc~escape_text->proc~escaped_length proc~put_esca