 error_t ), allocatable :: response_error logical :: response_mode integer :: first_arg , subcmd_pos first_arg = 1 if ( present ( start_arg )) first_arg = start_arg call set_watch_defaults ( cfg % w ) call apply_watch_arguments ( cfg % w , first_arg , subcmd_pos , log_format ) call prepare_response_options ( subcmd_pos , cfg % response_files , response_mode , response_subcmd , response_error ) if ( allocated ( response_error )) then if ( present ( error )) then call move_alloc ( response_error , error ) else call usage_and_stop ( response_error % message ) end if return end if cfg % project_dir = project_directory ( subcmd_pos , response_mode ) call parse_cli ( cfg % w , settings , fpm_cmdline , subcmd , cfg % project_dir , first_arg , & response_mode , response_subcmd , log_format ) cfg % fpm_cmdline = fpm_cmdline cfg % subcmd = subcmd call move_alloc ( settings , cfg % settings ) call split_cmd_after_subcmd ( cfg % fpm_cmdline , cfg % cmd_prefix , cfg % cmd_rest ) if ( cfg % w % fpm_executable /= \"fpm\" ) then cfg % cmd_prefix = quote_arg ( cfg % w % fpm_executable ) // \" \" // cfg % subcmd cfg % fpm_cmdline = cfg % cmd_prefix if ( len_trim ( cfg % cmd_rest ) > 0 ) cfg % fpm_cmdline = cfg % fpm_cmdline // \" \" // cfg % cmd_rest end if end subroutine parse_cli_config","tags":"","url":"proc/parse_cli_config.html"},{"title":"add_features_csv – fpm-watch","text":"private  subroutine add_features_csv(features, csv) Parse a comma-separated --features value into the features array. Empty tokens are ignored; whitespace around tokens is stripped. Arguments Type Intent Optional Attributes Name type(string_t), intent(inout), allocatable :: features (:) character(len=*), intent(in) :: csv Calls proc~~add_features_csv~~CallsGraph proc~add_features_csv add_features_csv proc~push_feature push_feature proc~add_features_csv->proc~push_feature split split proc~add_features_csv->split Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subrouti