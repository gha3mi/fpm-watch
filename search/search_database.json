 it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Enable built-in watcher plugins from `watch_opts_t%enabled_features`. !! !! Currently only `stats` is supported; it counts completed commands internally. !! Plugin names come from `[extra.fpm-watch].features` and `--watch-feature`, !! independently of fpm's build features. Unknown names produce a warning. module watch_feature_factory use watch_feature_manager , only : feature_manager_t use watch_types , only : watch_opts_t use watch_log , only : log_event use watch_feat_stats , only : new_stats_feature use watch_feature_api , only : watch_feature_t implicit none private public enable_features contains !> Enable features requested in watch options. !! !! Unknown feature names are ignored with a warning. subroutine enable_features ( fm , w ) type ( feature_manager_t ), intent ( inout ) :: fm type ( watch_opts_t ), intent ( in ) :: w integer :: i character ( len = :), allocatable :: name if (. not . allocated ( w % enabled_features )) return do i = 1 , size ( w % enabled_features ) name = trim ( w % enabled_features ( i )% s ) if ( len_trim ( name ) == 0 ) cycle select case ( name ) case ( \"stats\" ) call add_stats ( fm ) case default call log_event ( \"warn\" , \"feature.unknown\" , \"Unknown feature '\" // name // \"' (ignored)\" ) end select end do end subroutine enable_features !> Factory helper: add the built-in `stats` feature. subroutine add_stats ( fm ) type ( feature_manager_t ), intent ( inout ) :: fm class ( watch_feature_t ), allocatable :: f call new_stats_feature ( f ) call fm % add ( f ) end subroutine add_stats end module watch_feature_factory","tags":"","url":"sourcefile/watch_feature_factory.f90.html"},{"title":"watch_exec.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_exec.f90~~EfferentGraph sourcefile~watch_exec.f90 watch_exec.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_exec.f90->sourcefile~watch_log.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_exec.f90->sourcefile~watch_platform.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_exec.f90->sourcefile~watch_types.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_exec.f90->sourcefile~watch_util.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_util.f90 sourcefile~watch_cmdsplice.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_exec.f90~~AfferentGraph sourcefile~watch_exec.f90 watch_exec.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_exec.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Select affected targets, execute fpm, and emit command-cycle events. !! !! Commands run synchronously through `watch_platform`. Structured logging !! sends raw command stdout to stderr; optional boundary markers correlate !! that stream with command events. Target injection preserves explicit names. module watch_exec use , intrinsic :: iso_fortran_env , only : int64 , error_unit use watch_types , only : watch_opts_t , root_info_t use watch_util , only : ftoa use watch_cmdline , only : quote_arg use watch_platform , only : execute_command , termination_requested use fpm_strings , only : string_t , str use fpm_command_line , only : fpm_build_settings , fpm_test_settings , fpm_run_settings use watch_log , only : log_event , log_int , log_real , log_string , log_strings , log_bool , structured_logging implicit none private public report_changes , run_command_and_report , build_run_command !> Process-local command counter, incremented before each start event. integer ( int64 ), save :: cycle_number = 0_int64 contains !> Emit changed paths and a summary unless quiet mode suppresses them. !! !! `changed_idx(:changed_count)` contains 1-based indices into `files`. !! The summary includes every valid path; verbosity 1 emits individual records !! for at most the first eight changed indices. subroutine report_changes ( files , changed_idx , changed_count , w ) type ( string_t ), allocatable , intent ( in ) :: files (:) integer , intent ( in ) :: changed_idx (:) integer , intent ( in ) :: changed_count type ( watch_opts_t ), intent ( in ) :: w integer :: i , idx , n type ( string_t ), allocatable :: paths (:) character ( len = :), allocatable :: message if ( w % verbosity < 0 . or . changed_count == 0 ) return if (. not . allocated ( files )) return allocate ( paths ( changed_count )) n = 0 do i = 1 , changed_count idx = changed_idx ( i ) if ( idx < 1 . or . idx > size ( files )) cycle n = n + 1 paths ( n ) = files ( idx ) end do idx = changed_idx ( 1 ) message = str ( changed_count ) // \" files changed\" if ( idx >= 1 . and . idx <= size ( files )) then if ( changed_count == 1 ) message = \"Changed \" // files ( idx )% s end if call log_event ( \"info\" , \"watch.changed\" , message , & [ log_int ( \"file_count\" , changed_count ), log_strings ( \"paths\" , paths (: n )), & log_real ( \"debounce_ms\" , w % debounce * 100 0.0 )]) do i = 1 , min ( changed_count , 8 ) idx = changed_idx ( i ) if ( idx < 1 . or . idx > size ( files )) cycle call log_event ( \"info\" , \"watch.changed_file\" , \"Changed \" // files ( idx )% s , & [ log_string ( \"path\" , files ( idx )% s )], verbosity = 1 ) end do end subroutine report_changes !> Execute synchronously and report start, completion, exit status, and seconds. !! !! `cycle_id` combines the supervisor generation and a process-local counter. !! Structured mode sends raw command stdout to stderr; silent mode suppresses !! both child streams. In structured mode only, output markers bracket stderr !! and force both command events through quiet filtering. Failures are errors; !! a latched user interruption is reported as an interrupted completion. subroutine run_command_and_report ( cmd , w , exitstat , secs ) character ( len =* ), intent ( in ) :: cmd !! Complete serialized command to execute synchronously. type ( watch_opts_t ), intent ( in ) :: w !! Output suppression, cycle generation, and optional output-marker settings. integer , intent ( out ) :: exitstat !! Command status, including 127 when the platform wrapper cannot launch or wait. real , intent ( out ) :: secs !! Elapsed command time in seconds, excluding event formatting and boundary writes. integer ( int64 ) :: rate , t0 , t1 character ( len = :), allocatable :: action , message , level , cycle_id logical :: interrupted , protocol action = \"Command\" if ( index ( cmd , \"fpm build\" ) == 1 ) action = \"Build\" if ( index ( cmd , \"fpm test\" ) == 1 ) action = \"Tests\" if ( index ( cmd , \"fpm run\" ) == 1 ) action = \"Application\" cycle_number = cycle_number + 1_int64 cycle_id = str ( w % restart_count ) // \":\" // str ( cycle_number ) protocol = w % output_markers . and . structured_logging () call log_event ( \"info\" , \"command.started\" , \"Running \" // trim ( cmd ), & [ log_string ( \"command\" , trim ( cmd )), log_bool ( \"silent_fpm\" , w % silent_fpm ), & log_string ( \"cycle_id\" , cycle_id )], force = protocol ) call output_boundary ( \"started\" , cycle_id , protocol ) call system_clock ( count_rate = rate ) if ( rate <= 0_int64 ) rate = 1000_int64 call system_clock ( t0 ) call execute_command ( trim ( cmd ), exitstat , silent = w % silent_fpm , stderr = structured_logging ()) call system_clock ( t1 ) secs = real ( t1 - t0 ) / real ( rate ) interrupted = termination_requested () level = \"info\" message = action // \" succeeded in \" // ftoa ( secs ) // \"s\" if ( exitstat /= 0 ) then level = \"error\" message = action // \" failed (exit \" // str ( exitstat ) // \") after \" // ftoa ( secs ) // \"s\" end if if ( interrupted ) then level = \"info\" message = action // \" interrupted\" end if call log_event ( level , \"command.finished\" , message , & [ log_string ( \"command\" , trim ( cmd )), log_int ( \"exit_code\" , exitstat ), & log_int ( \"duration_ms\" , nint ( secs * 100 0.0 , int64 )), log_bool ( \"interrupted\" , interrupted ), & log_string ( \"cycle_id\" , cycle_id )], force = protocol ) call output_boundary ( \"finished\" , cycle_id , protocol ) end subroutine run_command_and_report !> Flush a stderr boundary marker when the structured output protocol is enabled. !! !! The marker follows a blank line and contains the same opaque `cycle_id` !! as the command events; stdout and stderr delivery order need not match. subroutine output_boundary ( state , cycle_id , enabled ) character ( len =* ), intent ( in ) :: state , cycle_id logical , intent ( in ) :: enabled if (. not . enabled ) return write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"@@fpm-watch:\" // state // \":\" // cycle_id // \"@@\" flush ( error_unit ) end subroutine output_boundary !> Inject affected root names into an unpinned run/test command. !! !! `changed_idx(:changed_count)` indexes `file_mask`, whose bits correspond !! to `roots`. Combine those bits and quote the matching root names before !! the program-argument `--` delimiter. Return `full_cmdline` unchanged for !! build mode, explicit target patterns, unavailable masks/roots, no matched !! names, or an empty command prefix. function build_run_command ( settings , full_cmdline , cmd_prefix , cmd_rest , roots , file_mask , changed_idx , changed_count ) result ( cmd ) use watch_cmdsplice , only : inject_names_into_cmd class ( fpm_build_settings ), intent ( in ) :: settings !! Run/test type and explicit target patterns used to decide whether injection is allowed. character ( len =* ), intent ( in ) :: full_cmdline !! Complete serialized command, returned when no target injection is possible. character ( len =* ), intent ( in ) :: cmd_prefix !! Serialized executable/subcommand prefix for the replacement command. character ( len =* ), intent ( in ) :: cmd_rest !! Serialized forwarded fpm/program arguments after the subcommand. type ( root_info_t ), allocatable , intent ( in ) :: roots (:) !! Root executable names and their single-bit membership masks. integer ( int64 ), allocatable , intent ( in ) :: file_mask (:) !! Root bits per watched file, indexed by changed_idx. integer , intent ( in ) :: changed_idx (:) !! 1-based file indices; only the first changed_count entries are read. integer , intent ( in ) :: changed_count !! Number of changed indices in the active buffer prefix. character ( len = :), allocatable :: cmd logical :: is_test , is_run integer ( int64 ) :: hitmask character ( len = :), allocatable :: names_str integer :: j , idx logical :: user_pinned_names is_test = . false . is_run = . false . user_pinned_names = . false . select type ( s => settings ) type is ( fpm_test_settings ) is_test = . true . if ( allocated ( s % name )) user_pinned_names = ( size ( s % name ) > 0 ) type is ( fpm_run_settings ) is_run = . true . if ( allocated ( s % name )) user_pinned_names = ( size ( s % name ) > 0 ) class default continue end select if ( user_pinned_names ) then cmd = trim ( full_cmdline ) return end if if (. not . is_test . and . . not . is_run ) then cmd = trim ( full_cmdline ) return end if if (. not . allocated ( roots )) then cmd = trim ( full_cmdline ) return end if if ( size ( roots ) == 0 ) then cmd = trim ( full_cmdline ) return end if if (. not . allocated ( file_mask )) then cmd = trim ( full_cmdline ) return end if hitmask = 0_int64 do j = 1 , changed_count idx = changed_idx ( j ) if ( idx < 1 . or . idx > size ( file_mask )) cycle hitmask = ior ( hitmask , file_mask ( idx )) end do if ( hitmask == 0_int64 ) then cmd = trim ( full_cmdline ) return end if names_str = join_names_from_mask ( roots , hitmask ) if ( len_trim ( names_str ) == 0 ) then cmd = trim ( full_cmdline ) return end if if ( len_trim ( cmd_prefix ) == 0 ) then cmd = trim ( full_cmdline ) return end if cmd = inject_names_into_cmd ( cmd_prefix , cmd_rest , names_str ) contains !> Join quoted, nonempty root names whose bits intersect `mask`, in root order. function join_names_from_mask ( roots , mask ) result ( s ) type ( root_info_t ), intent ( in ) :: roots (:) integer ( int64 ), intent ( in ) :: mask character ( len = :), allocatable :: s integer :: rr character ( len = :), allocatable :: nm s = \"\" do rr = 1 , size ( roots ) if ( iand ( mask , roots ( rr )% mask ) == 0_int64 ) cycle if (. not . allocated ( roots ( rr )% name )) cycle nm = trim ( roots ( rr )% name ) if ( len_trim ( nm ) == 0 ) cycle if ( len ( s ) > 0 ) s = s // \" \" s = s // quote_arg ( nm ) end do end function join_names_from_mask end function build_run_command end module watch_exec","tags":"","url":"sourcefile/watch_exec.f90.html"},{"title":"watch_platform.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_platform.f90~~EfferentGraph sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_platform.f90~~AfferentGraph sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_platform.f90 sourcefile~watch_exec.f90 watch_exec.f90 sourcefile~watch_engine.f90->sourcefile~watch_exec.f90 sourcefile~watch_fpm_graph.f90 watch_fpm_graph.f90 sourcefile~watch_engine.f90->sourcefile~watch_fpm_graph.f90 sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_engine.f90->sourcefile~watch_cli.f90 sourcefile~watch_exec.f90->sourcefile~watch_platform.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_platform.f90 sourcefile~watch_restart.f90 watch_restart.f90 sourcefile~watch_restart.f90->sourcefile~watch_platform.f90 sourcefile~watch_restart.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_cmdsplice.f90->sourcefile~watch_cmdline.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Portable synchronous process execution and stdout redirection. !! !! C wrappers launch commands, forward user interrupts, and redirect raw fpm !! library output. An interrupt received while waiting for a command latches !! `stop_requested`; ordinary nonzero child exits do not. OS detection uses !! `fpm_environment:get_os_type`. module watch_platform use , intrinsic :: iso_c_binding , only : c_char , c_int , c_null_char use , intrinsic :: iso_fortran_env , only : output_unit use watch_log , only : log_event , log_int , log_string use fpm_environment , only : get_os_type , OS_WINDOWS implicit none private public is_windows , execute_command , termination_requested public begin_raw_output , end_raw_output !> Latched cancellation request; ordinary child exit codes do not set it. logical , save :: stop_requested = . false . interface !> C process wrapper returning child status or 127 for a launch/wait error. !! !! `command` is NUL-terminated. On Windows, `silent` selects inherited streams: !! 0 normal, 1 discard both outputs, 2 redirect stdout to stderr. POSIX ignores !! this mode because the Fortran wrapper appends shell redirections. !! `interrupted` reports handled user interrupts; `launch_error` holds the OS !! error code separately from ordinary child failure. function fpm_watch_execute ( command , silent , interrupted , launch_error ) bind ( C , name = \"fpm_watch_execute\" ) result ( status ) import c_char , c_int implicit none !> NUL-terminated command bytes interoperating with a C string. ! allow(C071) character ( kind = c_char ), intent ( in ) :: command ( * ) integer ( c_int ), value :: silent integer ( c_int ), intent ( out ) :: interrupted integer ( c_int ), intent ( out ) :: launch_error integer ( c_int ) :: status end function fpm_watch_execute !> Redirect descriptor 1 to stderr; return a saved stdout descriptor or a negative OS error. function fpm_watch_redirect_stdout () bind ( C , name = \"fpm_watch_redirect_stdout\" ) result ( saved ) import c_int implicit none integer ( c_int ) :: saved end function fpm_watch_redirect_stdout !> Restore and close a saved stdout descriptor; return zero on success or an OS error. function fpm_watch_restore_stdout ( saved ) bind ( C , name = \"fpm_watch_restore_stdout\" ) result ( error ) import c_int implicit none integer ( c_int ), value :: saved integer ( c_int ) :: error end function fpm_watch_restore_stdout end interface contains !> Wait for a command and return its status while latching handled user interrupts. !! !! `silent` suppresses both output streams and takes precedence over `stderr`, !! which redirects command stdout to stderr. Both options default to false. !! Launch/wait errors log `command.launch_failed` and return 127; ordinary !! failures preserve the child status. Optional `interrupted` reports this !! command's handled interruption, while `termination_requested` remains latched. !! !! POSIX uses `/bin/sh -c` and temporarily forwards SIGINT/SIGQUIT/SIGTERM to !! the immediate child in the foreground process group. Windows launches !! executables directly, with a cmd fallback for scripts, and terminates the !! child's job on console interruption. Normal exits retain background children. subroutine execute_command ( cmd , exitstat , interrupted , silent , stderr ) character ( len =* ), intent ( in ) :: cmd !! Serialized command; caller is responsible for quoting individual argv tokens. integer , intent ( out ) :: exitstat !! Child/interrupt status, or 127 with a launch-failure event for OS execution errors. logical , intent ( out ), optional :: interrupted !! True if the wrapper handled a user interrupt during this command. logical , intent ( in ), optional :: silent !! Suppress both command output streams (default false); takes precedence over stderr. logical , intent ( in ), optional :: stderr !! Redirect command stdout to stderr (default false). integer ( c_int ) :: status , was_interrupted , launch_error , silent_mode character ( len = :), allocatable :: effective_cmd silent_mode = 0_c_int if ( present ( stderr )) then if ( stderr ) silent_mode = 2_c_int end if if ( present ( silent )) then if ( silent ) silent_mode = 1_c_int end if effective_cmd = trim ( cmd ) if (. not . is_windows ()) then if ( silent_mode == 1_c_int ) effective_cmd = effective_cmd // \" >/dev/null 2>&1\" if ( silent_mode == 2_c_int ) effective_cmd = effective_cmd // \" 1>&2\" end if status = fpm_watch_execute ( effective_cmd // c_null_char , silent_mode , was_interrupted , launch_error ) stop_requested = stop_requested . or . was_interrupted /= 0_c_int if ( present ( interrupted )) interrupted = was_interrupted /= 0_c_int if ( launch_error /= 0_c_int ) then call log_event ( \"error\" , \"command.launch_failed\" , \"Cannot execute command: \" // trim ( cmd ), & [ log_int ( \"os_error\" , int ( launch_error )), log_string ( \"command\" , trim ( cmd ))]) exitstat = 127 else exitstat = int ( status ) end if end subroutine execute_command !> Optionally redirect process stdout to stderr, flushing Fortran output first. !! !! Return a saved C descriptor in `saved`, or -1 when redirection is disabled. !! Pair successful redirection with `end_raw_output`. Redirection failure logs !! an error and exits with status 127; this is process-wide, not thread-local. subroutine begin_raw_output ( redirect , saved ) logical , intent ( in ) :: redirect integer ( c_int ), intent ( out ) :: saved saved = - 1_c_int if (. not . redirect ) return flush ( output_unit ) saved = fpm_watch_redirect_stdout () if ( saved < 0_c_int ) then call log_event ( \"error\" , \"log.redirect_failed\" , \"Cannot redirect fpm output to stderr\" , & [ log_int ( \"os_error\" , int ( - saved ))]) stop 127 end if end subroutine begin_raw_output !> Flush raw library output, restore stdout, and close the saved C descriptor. !! !! Negative `saved` values are no-ops. Restoration failure logs an error and !! exits with status 127; a saved descriptor must only be restored once. subroutine end_raw_output ( saved ) integer ( c_int ), intent ( in ) :: saved integer ( c_int ) :: error if ( saved < 0_c_int ) return flush ( output_unit ) error = fpm_watch_restore_stdout ( saved ) if ( error /= 0_c_int ) then call log_event ( \"error\" , \"log.redirect_failed\" , \"Cannot restore stdout after fpm model operation\" , & [ log_int ( \"os_error\" , int ( error ))]) stop 127 end if end subroutine end_raw_output !> Return the process-wide interruption flag latched by prior command executions. logical function termination_requested () result ( requested ) requested = stop_requested end function termination_requested !> Return whether the current OS is Windows. logical function is_windows () is_windows = ( get_os_type () == OS_WINDOWS ) end function is_windows end module watch_platform","tags":"","url":"sourcefile/watch_platform.f90.html"},{"title":"watch_feature_manager.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_feature_manager.f90~~EfferentGraph sourcefile~watch_feature_manager.f90 watch_feature_manager.f90 sourcefile~watch_feature_api.f90 watch_feature_api.f90 sourcefile~watch_feature_manager.f90->sourcefile~watch_feature_api.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_feature_manager.f90->sourcefile~watch_types.f90 sourcefile~watch_feature_api.f90->sourcefile~watch_types.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_feature_manager.f90~~AfferentGraph sourcefile~watch_feature_manager.f90 watch_feature_manager.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_feature_manager.f90 sourcefile~watch_feature_factory.f90 watch_feature_factory.f90 sourcefile~watch_engine.f90->sourcefile~watch_feature_factory.f90 sourcefile~watch_feature_factory.f90->sourcefile~watch_feature_manager.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Feature plugin manager. !! !! Provides storage and fan-out calls to a set of enabled feature plugins. !! !! The manager owns a growable array of feature objects. Calls are forwarded !! to each feature in insertion order. module watch_feature_manager use , intrinsic :: iso_fortran_env , only : int64 use watch_feature_api , only : watch_feature_t use watch_types , only : watch_config_t , root_info_t use fpm_strings , only : string_t implicit none private public feature_manager_t !> A thin wrapper to store an allocatable polymorphic feature instance. type feature_box_t !> Owned polymorphic plugin instance, moved into this wrapper. class ( watch_feature_t ), allocatable :: p end type feature_box_t !> Container for multiple feature instances and their callback fan-out. type feature_manager_t !> Owned plugins in callback invocation order. type ( feature_box_t ), allocatable :: feat (:) contains procedure :: add => fm_add procedure :: init_all procedure :: on_start_all procedure :: on_watch_list_built_all procedure :: on_manifest_changed_all procedure :: on_change_detected_all procedure :: on_before_run_all procedure :: on_after_run_all end type feature_manager_t contains !> Add a feature instance to the manager, transferring ownership. !! !! The `f` argument is moved into internal storage using `move_alloc`. subroutine fm_add ( self , f ) class ( feature_manager_t ), intent ( inout ) :: self class ( watch_feature_t ), allocatable , intent ( inout ) :: f !! Plugin to move into owned storage; unallocated afterward. Unallocated input is skipped by callbacks. type ( feature_box_t ), allocatable :: tmp (:) integer :: n , i if (. not . allocated ( self % feat )) then allocate ( self % feat ( 1 )) call move_alloc ( f , self % feat ( 1 )% p ) return end if n = size ( self % feat ) allocate ( tmp ( n + 1 )) do i = 1 , n call move_alloc ( self % feat ( i )% p , tmp ( i )% p ) end do call move_alloc ( f , tmp ( n + 1 )% p ) call move_alloc ( tmp , self % feat ) end subroutine fm_add !> Call `init(cfg)` on all registered features. subroutine init_all ( self , cfg ) class ( feature_manager_t ), intent ( inout ) :: self type ( watch_config_t ), intent ( in ) :: cfg integer :: i if (. not . allocated ( self % feat )) return do i = 1 , size ( self % feat ) if ( allocated ( self % feat ( i )% p )) call self % feat ( i )% p % init ( cfg ) end do end subroutine init_all !> Call `on_start()` on all registered features. subroutine on_start_all ( self ) class ( feature_manager_t ), intent ( inout ) :: self integer :: i if (. not . allocated ( self % feat )) return do i = 1 , size ( self % feat ) if ( allocated ( self % feat ( i )% p )) call self % feat ( i )% p % on_start () end do end subroutine on_start_all !> Pass mutable files/roots to each allocated feature in insertion order, preserving engine alignment. subroutine on_watch_list_built_all ( self , files , roots ) class ( feature_manager_t ), intent ( inout ) :: self type ( string_t ), allocatable , intent ( inout ) :: files (:) type ( root_info_t ), allocatable , intent ( inout ) :: roots (:) integer :: i if (. not . allocated ( self % feat )) return do i = 1 , size ( self % feat ) if ( allocated ( self % feat ( i )% p )) call self % feat ( i )% p % on_watch_list_built ( files , roots ) end do end subroutine on_watch_list_built_all !> Call `on_manifest_changed(old_key, new_key)` on all registered features. subroutine on_manifest_changed_all ( self , old_key , new_key ) class ( feature_manager_t ), intent ( inout ) :: self integer ( int64 ), intent ( in ) :: old_key , new_key integer :: i if (. not . allocated ( self % feat )) return do i = 1 , size ( self % feat ) if ( allocated ( self % feat ( i )% p )) call self % feat ( i )% p % on_manifest_changed ( old_key , new_key ) end do end subroutine on_manifest_changed_all !> Call `on_change_detected(changed)` on all registered features. subroutine on_change_detected_all ( self , changed ) class ( feature_manager_t ), intent ( inout ) :: self type ( string_t ), allocatable , intent ( in ) :: changed (:) integer :: i if (. not . allocated ( self % feat )) return do i = 1 , size ( self % feat ) if ( allocated ( self % feat ( i )% p )) call self % feat ( i )% p % on_change_detected ( changed ) end do end subroutine on_change_detected_all !> Pass the mutable command through features in insertion order; later features see earlier edits. subroutine on_before_run_all ( self , cmd ) class ( feature_manager_t ), intent ( inout ) :: self character ( len = :), allocatable , intent ( inout ) :: cmd integer :: i if (. not . allocated ( self % feat )) return do i = 1 , size ( self % feat ) if ( allocated ( self % feat ( i )% p )) call self % feat ( i )% p % on_before_run ( cmd ) end do end subroutine on_before_run_all !> Pass the command status and elapsed seconds to all features after completion, including failures. subroutine on_after_run_all ( self , exitstat , seconds ) class ( feature_manager_t ), intent ( inout ) :: self integer , intent ( in ) :: exitstat real , intent ( in ) :: seconds integer :: i if (. not . allocated ( self % feat )) return do i = 1 , size ( self % feat ) if ( allocated ( self % feat ( i )% p )) call self % feat ( i )% p % on_after_run ( exitstat , seconds ) end do end subroutine on_after_run_all end module watch_feature_manager","tags":"","url":"sourcefile/watch_feature_manager.f90.html"},{"title":"watch_cli.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_cli.f90~~EfferentGraph sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_config.f90 watch_config.f90 sourcefile~watch_cli.f90->sourcefile~watch_config.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_cli.f90->sourcefile~watch_log.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_cli.f90->sourcefile~watch_types.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_util.f90 sourcefile~watch_cmdsplice.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_config.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_cli.f90~~AfferentGraph sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_cli.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Assemble watcher options, typed fpm settings, and a serialized command. !! !! Built-in defaults are followed by `[extra.fpm-watch]` and leading watcher !! flags. All tokens after `build`, `test`, or `run` are retained for execution; !! recognized fpm options also populate the settings used for graph construction. !! Model-option scanning stops at `--`. Parsing uses argv tokens, not shell text. module watch_cli use , intrinsic :: iso_fortran_env , only : error_unit use watch_types , only : watch_config_t , watch_opts_t use watch_config , only : set_watch_defaults , apply_watch_from_manifest , normalize_watch_opts , push_feature use watch_cmdline , only : get_arg , join_argv , quote_arg , parse_int , parse_real , parse_bool , starts_with , & watch_option_takes_value use fpm_strings , only : string_t , split use fpm_command_line , only : fpm_build_settings , fpm_run_settings , fpm_test_settings , get_fpm_env use watch_log , only : configure_logging , valid_log_format , log_event , structured_logging implicit none private public parse_cli_config contains !> Parse argv and manifest options into an executable watcher configuration. !! !! `cfg%settings` describes the graph; `cfg%fpm_cmdline` retains forwarded argv !! with platform quoting. `cmd_prefix` and `cmd_rest` support target injection. !! A custom fpm executable replaces the command prefix after splitting it. !! Optional `log_format` pins the existing format during manifest refreshes. subroutine parse_cli_config ( cfg , log_format ) use watch_cmdsplice , only : split_cmd_after_subcmd type ( watch_config_t ), intent ( out ) :: cfg !! Assembled watcher options, model settings, and serialized command/prefix/rest. character ( len =* ), intent ( in ), optional :: log_format !! Pinned process format for a manifest refresh; overrides manifest and CLI format changes. character ( len = :), allocatable :: fpm_cmdline class ( fpm_build_settings ), allocatable :: settings character ( len = :), allocatable :: subcmd call parse_cli ( cfg % w , settings , fpm_cmdline , subcmd , log_format ) cfg % fpm_cmdline = fpm_cmdline cfg % subcmd = subcmd call move_alloc ( settings , cfg % settings ) call split_cmd_after_subcmd ( cfg % fpm_cmdline , cfg % cmd_prefix , cfg % cmd_rest ) if ( cfg % w % fpm_executable /= \"fpm\" ) then cfg % cmd_prefix = quote_arg ( cfg % w % fpm_executable ) // \" \" // cfg % subcmd cfg % fpm_cmdline = cfg % cmd_prefix if ( len_trim ( cfg % cmd_rest ) > 0 ) cfg % fpm_cmdline = cfg % fpm_cmdline // \" \" // cfg % cmd_rest end if end subroutine parse_cli_config !> Apply watcher defaults and leading flags, then collect fpm model settings. !! !! Watcher flags stop at the subcommand. Recognized fpm options accept either !! `--key=value` or a following token; model parsing stops at `--`, while all !! forwarded tokens remain in the command. Toolchain defaults come from !! `get_fpm_env`; CLI values replace them. Include/ignore/plugin flags append !! unique manifest entries, and verbose flags raise the current level. !! Invalid commands, log formats, or missing required values exit with status 2. subroutine parse_cli ( w , settings , fpm_cmdline , subcmd , log_format ) type ( watch_opts_t ), intent ( out ) :: w class ( fpm_build_settings ), allocatable , intent ( out ) :: settings character ( len = :), allocatable , intent ( out ) :: fpm_cmdline character ( len = :), allocatable , intent ( out ) :: subcmd character ( len =* ), intent ( in ), optional :: log_format integer :: narg , i , subcmd_pos , eq character ( len = :), allocatable :: a character ( len = :), allocatable :: profile , build_dir character ( len = :), allocatable :: compiler , c_compiler , cxx_compiler , archiver character ( len = :), allocatable :: flag , cflag , cxxflag , ldflag character ( len = :), allocatable :: runner , runner_args , config_file type ( string_t ), allocatable :: features (:) type ( string_t ), allocatable :: names (:) logical :: prune , example , build_tests call set_watch_defaults ( w ) call apply_watch_from_manifest ( w ) if ( present ( log_format )) w % log_format = log_format if ( valid_log_format ( w % log_format )) call configure_logging ( w ) prune = . true . example = . false . build_tests = . false . profile = \"\" build_dir = get_fpm_env ( \"BUILD_DIR\" , default_build_dir ()) compiler = get_fpm_env ( \"FC\" , \"gfortran\" ) c_compiler = get_fpm_env ( \"CC\" , \" \" ) cxx_compiler = get_fpm_env ( \"CXX\" , \" \" ) archiver = get_fpm_env ( \"AR\" , \" \" ) flag = get_fpm_env ( \"FFLAGS\" , \" \" ) cflag = get_fpm_env ( \"CFLAGS\" , \" \" ) cxxflag = get_fpm_env ( \"CXXFLAGS\" , \" \" ) ldflag = get_fpm_env ( \"LDFLAGS\" , \" \" ) runner = \"\" runner_args = \"\" config_file = \"\" allocate ( features ( 0 )) allocate ( names ( 0 )) narg = command_argument_count () if ( narg < 1 ) then call usage_and_stop ( \"missing fpm subcommand (build/test/run)\" ) end if a = get_arg ( 1 ) if ( a == \"--help\" . or . a == \"-h\" ) then call usage_and_stop_ok () end if i = 1 do while ( i <= narg ) a = get_arg ( i ) if ( is_watch_flag ( a )) then call apply_watch_flag ( a , i , narg , w ) i = i + 1 cycle end if if ( a == \"-q\" ) then w % verbosity = - 1 i = i + 1 cycle end if if ( a == \"-v\" ) then w % verbosity = max ( w % verbosity , 1 ) i = i + 1 cycle end if if ( a == \"-vv\" ) then w % verbosity = max ( w % verbosity , 2 ) i = i + 1 cycle end if exit end do if ( present ( log_format )) w % log_format = log_format if (. not . valid_log_format ( w % log_format )) then call usage_and_stop ( \"invalid log-format: \" // w % log_format // \"; use text, json, or logfmt\" ) end if call configure_logging ( w ) if ( i > narg ) call usage_and_stop ( \"missing fpm subcommand (build/test/run)\" ) a = get_arg ( i ) if ( a == \"--help\" . or . a == \"-h\" ) then call usage_and_stop_ok () end if subcmd_pos = i subcmd = get_arg ( subcmd_pos ) if (. not . is_supported_subcmd ( subcmd )) then call usage_and_stop ( \"unsupported subcommand: \" // trim ( subcmd ) // \" (supported: build,test,run)\" ) end if if ( subcmd_pos < narg ) then fpm_cmdline = \"fpm \" // trim ( subcmd ) // \" \" // join_argv ( subcmd_pos + 1 , narg ) else fpm_cmdline = \"fpm \" // trim ( subcmd ) end if i = subcmd_pos + 1 do while ( i <= narg ) a = get_arg ( i ) if ( a == \"--\" ) exit if ( starts_with ( a , \"--\" )) then eq = index ( a , \"=\" ) if ( eq > 0 ) a = a (: eq - 1 ) end if select case ( a ) case ( \"--profile\" ) profile = fpm_option_value ( i , narg ) case ( \"--features\" ) call add_features_csv ( features , fpm_option_value ( i , narg )) case ( \"--build-dir\" ) build_dir = fpm_option_value ( i , narg ) case ( \"--compiler\" ) compiler = fpm_option_value ( i , narg ) case ( \"--c-compiler\" ) c_compiler = fpm_option_value ( i , narg ) case ( \"--cxx-compiler\" ) cxx_compiler = fpm_option_value ( i , narg ) case ( \"--archiver\" ) archiver = fpm_option_value ( i , narg ) case ( \"--flag\" ) flag = fpm_option_value ( i , narg ) case ( \"--c-flag\" ) cflag = fpm_option_value ( i , narg ) case ( \"--cxx-flag\" ) cxxflag = fpm_option_value ( i , narg ) case ( \"--link-flag\" ) ldflag = fpm_option_value ( i , narg ) case ( \"--runner\" ) runner = fpm_option_value ( i , narg ) case ( \"--runner-args\" ) runner_args = fpm_option_value ( i , narg ) case ( \"--config-file\" ) config_file = fpm_option_value ( i , narg ) case ( \"--target\" ) call add_target_names ( names , fpm_option_value ( i , narg )) case ( \"--all\" ) call push_feature ( names , \"*\" ) case ( \"--tests\" ) build_tests = . true . case ( \"--prune\" ) prune = . true . case ( \"--no-prune\" ) prune = . false . case ( \"--example\" ) example = . true . case default if ( trim ( subcmd ) == \"run\" . or . trim ( subcmd ) == \"test\" ) then if ( len ( a ) > 0 ) then if ( a ( 1 : 1 ) /= \"-\" ) call push_feature ( names , target_pattern ( a )) end if end if end select i = i + 1 end do select case ( trim ( subcmd )) case ( \"build\" ) allocate ( fpm_build_settings :: settings ) call init_build_settings ( settings , build_dir , prune , profile , features , compiler , c_compiler , cxx_compiler , archiver , flag , cflag , cxxflag , ldflag ) case ( \"test\" ) allocate ( fpm_test_settings :: settings ) call init_build_settings ( settings , build_dir , prune , profile , features , compiler , c_compiler , cxx_compiler , archiver , flag , cflag , cxxflag , ldflag ) select type ( s => settings ) type is ( fpm_test_settings ) s % build_tests = . true . if ( len ( runner ) > 0 ) s % runner = runner if ( len ( runner_args ) > 0 ) s % runner_args = runner_args call set_names ( s , names ) end select case ( \"run\" ) allocate ( fpm_run_settings :: settings ) call init_build_settings ( settings , build_dir , prune , profile , features , compiler , c_compiler , cxx_compiler , archiver , flag , cflag , cxxflag , ldflag ) select type ( s => settings ) type is ( fpm_run_settings ) s % example = example if ( len ( runner ) > 0 ) s % runner = runner if ( len ( runner_args ) > 0 ) s % runner_args = runner_args call set_names ( s , names ) end select case default call usage_and_stop ( \"unsupported subcommand: \" // trim ( subcmd ) // \" (supported: build,test,run)\" ) end select settings % path_to_config = config_file if ( trim ( subcmd ) == \"build\" ) settings % build_tests = build_tests call normalize_watch_opts ( w ) end subroutine parse_cli !> Read `--key=value`, or advance `i` to the next argv token for an option value. !! !! An absent following token exits with status 2. Empty `=value` strings are !! returned unchanged; this helper does not validate the selected fpm value. function fpm_option_value ( i , narg ) result ( value ) integer , intent ( inout ) :: i integer , intent ( in ) :: narg character ( len = :), allocatable :: value , option integer :: eq option = get_arg ( i ) eq = index ( option , \"=\" ) if ( eq > 0 ) then value = option ( eq + 1 :) else if ( i >= narg ) call usage_and_stop ( option // \" requires a value\" ) i = i + 1 value = get_arg ( i ) end if end function fpm_option_value !> Expand fpm's target-list delimiters using the dependency's string utility. subroutine add_target_names ( names , value ) type ( string_t ), allocatable , intent ( inout ) :: names (:) character ( len =* ), intent ( in ) :: value character ( len = :), allocatable :: targets (:) integer :: j call split ( value , targets , delimiters = \" ,:\" ) do j = 1 , size ( targets ) call push_feature ( names , target_pattern ( trim ( targets ( j )))) end do end subroutine add_target_names !> Match fpm's portable `..` spelling of the wildcard target pattern. pure function target_pattern ( value ) result ( pattern ) character ( len =* ), intent ( in ) :: value character ( len = :), allocatable :: pattern pattern = value if ( value == \"..\" ) pattern = \"*\" end function target_pattern !> Return whether a given subcommand token is supported by `fpm-watch`. pure logical function is_supported_subcmd ( s ) result ( ok ) character ( len =* ), intent ( in ) :: s ok = ( trim ( s ) == \"build\" ) . or . ( trim ( s ) == \"test\" ) . or . ( trim ( s ) == \"run\" ) end function is_supported_subcmd !> Test for the `--watch-` prefix; supported flag names are validated separately. pure logical function is_watch_flag ( a ) result ( ok ) character ( len =* ), intent ( in ) :: a ok = starts_with ( a , \"--watch-\" ) end function is_watch_flag !> Consume one leading watcher flag and normalize its options. !! !! Required value options accept `=value` or advance `i` to the next token. !! Boolean and verbosity values use `=value`; bare boolean flags enable the !! setting. Numeric parse failures retain a fallback value. Supervisor flags !! are consumed here but applied separately by `watch_restart`. Unknown flags !! or invalid log formats exit with status 2. subroutine apply_watch_flag ( a , i , narg , w ) character ( len =* ), intent ( in ) :: a integer , intent ( inout ) :: i integer , intent ( in ) :: narg type ( watch_opts_t ), intent ( inout ) :: w character ( len = :), allocatable :: key , val integer :: eq key = trim ( a ) val = \"\" eq = index ( key , \"=\" ) if ( eq > 0 ) then val = key ( eq + 1 :) key = key ( 1 : eq - 1 ) else if ( watch_option_takes_value ( a )) then if ( i >= narg ) call usage_and_stop ( key // \" requires a value\" ) i = i + 1 val = get_arg ( i ) end if select case ( key ) case ( \"--watch-child\" ) w % restart_count = max ( 0 , parse_int ( val , 0 )) case ( \"--watch-auto-restart\" ) continue case ( \"--watch-restart-delay\" ) continue case ( \"--watch-restart-max\" ) continue case ( \"--watch-self\" ) continue case ( \"--watch-fpm\" ) if ( len_trim ( val ) == 0 ) call usage_and_stop ( \"--watch-fpm requires an executable path or name\" ) w % fpm_executable = val case ( \"--watch-deps\" ) if ( len_trim ( val ) > 0 ) then w % watch_deps = parse_bool ( val , . true .) else w % watch_deps = . true . end if case ( \"--watch-no-deps\" ) w % watch_deps = . false . case ( \"--watch-low-cpu\" ) if ( len_trim ( val ) > 0 ) then w % low_cpu = parse_bool ( val , . true .) else w % low_cpu = . true . end if case ( \"--watch-no-low-cpu\" ) w % low_cpu = . false . case ( \"--watch-quiet\" ) w % verbosity = - 1 case ( \"--watch-log-format\" ) if (. not . valid_log_format ( val )) call usage_and_stop ( \"--watch-log-format requires text, json, or logfmt\" ) w % log_format = val call configure_logging ( w ) case ( \"--watch-verbose\" ) if ( len_trim ( val ) > 0 ) then w % verbosity = max ( w % verbosity , parse_int ( val , 1 )) else w % verbosity = max ( w % verbosity , 1 ) end if case ( \"--watch-very-verbose\" ) w % verbosity = max ( w % verbosity , 2 ) case ( \"--watch-debug\" ) w % debug = parse_bool ( val , . true .) case ( \"--watch-print-files\" ) w % print_files_once = parse_bool ( val , . true .) if ( w % print_files_once ) w % verbosity = max ( w % verbosity , 2 ) case ( \"--watch-silent-fpm\" ) w % silent_fpm = parse_bool ( val , . true .) case ( \"--watch-output-markers\" ) w % output_markers = parse_bool ( val , . true .) case ( \"--watch-run-on-start\" ) w % run_on_start = . true . case ( \"--watch-no-run-on-start\" ) w % run_on_start = . false . case ( \"--watch-rescan\" ) w % rescan = parse_real ( val , w % rescan ) case ( \"--watch-no-rescan\" ) w % rescan = 0.0 case ( \"--watch-ignore\" ) call push_feature ( w % ignore , trim ( val )) case ( \"--watch-include\" ) call push_feature ( w % include , trim ( val )) case ( \"--watch-feature\" ) call push_feature ( w % enabled_features , trim ( val )) case ( \"--watch-poll\" ) w % poll = parse_real ( val , w % poll ) case ( \"--watch-debounce\" ) w % debounce = parse_real ( val , w % debounce ) case ( \"--watch-once\" ) if ( len_trim ( val ) > 0 ) then w % once = parse_bool ( val , . true .) else w % once = . true . end if case ( \"--watch-help\" ) call usage_and_stop_ok () case default call usage_and_stop ( \"unknown watch flag: \" // trim ( a )) end select call normalize_watch_opts ( w ) end subroutine apply_watch_flag !> Print a usage message and terminate with a non-zero exit status. subroutine usage_and_stop ( msg ) character ( len =* ), intent ( in ) :: msg call log_event ( \"error\" , \"cli.error\" , msg ) if (. not . structured_logging ()) write ( error_unit , \"(a)\" ) \"Use fpm-watch --watch-help for usage.\" stop 2 end subroutine usage_and_stop !> Print a usage message and terminate successfully. subroutine usage_and_stop_ok () call usage_print_only () stop 0 end subroutine usage_and_stop_ok !> Print the `fpm-watch` help text. !! !! The help includes: !! - Watcher options (`--watch-*`), !! - Project configuration (`[extra.fpm-watch]`), !! - Examples and behavioral notes. subroutine usage_print_only () write ( error_unit , \"(a)\" ) \"fpm-watch — Smart file watcher plugin for fpm projects\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"USAGE\" write ( error_unit , \"(a)\" ) \"  fpm-watch [watch options] <build|test|run> [fpm options]\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  Everything after <build|test|run> is passed to fpm unchanged.\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"WATCH OPTIONS\" write ( error_unit , \"(a)\" ) \"  --watch-help\" write ( error_unit , \"(a)\" ) \"      Show this help and exit.\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-quiet | -q\" write ( error_unit , \"(a)\" ) \"      Quiet mode (errors only).\" write ( error_unit , \"(a)\" ) \"  --watch-log-format <text|json|logfmt>\" write ( error_unit , \"(a)\" ) \"      Log format (default: text). Structured logs use stdout; fpm output uses stderr.\" write ( error_unit , \"(a)\" ) \"  --watch-verbose[=N] | -v\" write ( error_unit , \"(a)\" ) \"      Increase verbosity. N: 0..2 (default: 1).\" write ( error_unit , \"(a)\" ) \"  --watch-very-verbose | -vv\" write ( error_unit , \"(a)\" ) \"      Same as verbosity=2 (prints watch list, more details).\" write ( error_unit , \"(a)\" ) \"  --watch-debug\" write ( error_unit , \"(a)\" ) \"      Extra debug logs. Use --watch-debug=false to disable a manifest setting.\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-deps\" write ( error_unit , \"(a)\" ) \"      Also watch dependency source trees (including deps under build/).\" write ( error_unit , \"(a)\" ) \"  --watch-no-deps\" write ( error_unit , \"(a)\" ) \"      Disable dependency watching (default).\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-low-cpu\" write ( error_unit , \"(a)\" ) \"      Use OS sleep instead of busy-waiting (near 0% idle CPU).\" write ( error_unit , \"(a)\" ) \"  --watch-no-low-cpu\" write ( error_unit , \"(a)\" ) \"      Disable low CPU mode (default).\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-poll <sec>\" write ( error_unit , \"(a)\" ) \"      Poll interval for file checks. Default: 0.5\" write ( error_unit , \"(a)\" ) \"  --watch-debounce <sec>\" write ( error_unit , \"(a)\" ) \"      Wait after first change to coalesce edits. Default: 0.2\" write ( error_unit , \"(a)\" ) \"  --watch-rescan <sec>\" write ( error_unit , \"(a)\" ) \"      Rebuild the fpm model periodically (slow on big projects). Default: 0 (off).\" write ( error_unit , \"(a)\" ) \"  --watch-no-rescan\" write ( error_unit , \"(a)\" ) \"      Disable periodic rebuild (recommended).\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-run-on-start\" write ( error_unit , \"(a)\" ) \"      Run the command once immediately on startup. Default: on.\" write ( error_unit , \"(a)\" ) \"  --watch-no-run-on-start\" write ( error_unit , \"(a)\" ) \"      Only run after a change is detected.\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-silent-fpm\" write ( error_unit , \"(a)\" ) \"      Suppress fpm output; keep only fpm-watch status lines.\" write ( error_unit , \"(a)\" ) \"      Use --watch-silent-fpm=false to override manifest suppression.\" write ( error_unit , \"(a)\" ) \"  --watch-fpm <path>\" write ( error_unit , \"(a)\" ) \"      fpm executable to invoke (default: fpm on PATH).\" write ( error_unit , \"(a)\" ) \"  --watch-output-markers\" write ( error_unit , \"(a)\" ) \"      Frame raw stderr with cycle markers in structured logging mode (GUI integrations).\" write ( error_unit , \"(a)\" ) \"      Keep matching command events visible even in quiet mode.\" write ( error_unit , \"(a)\" ) \"  --watch-print-files\" write ( error_unit , \"(a)\" ) \"      Print the watched file list at startup; --watch-print-files=false disables it.\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-ignore <glob>\" write ( error_unit , \"(a)\" ) \"      Ignore files matching glob (repeatable).\" write ( error_unit , \"(a)\" ) \"  --watch-include <glob>\" write ( error_unit , \"(a)\" ) \"      Only watch files matching glob (repeatable). Empty means include all.\" write ( error_unit , \"(a)\" ) \"  --watch-feature <name>\" write ( error_unit , \"(a)\" ) \"      Enable optional feature plugin (repeatable).\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-auto-restart\" write ( error_unit , \"(a)\" ) \"      Restart on crashes; --watch-auto-restart=false disables a manifest setting.\" write ( error_unit , \"(a)\" ) \"  --watch-restart-delay <sec>\" write ( error_unit , \"(a)\" ) \"      Delay before restart. Default: 1.0\" write ( error_unit , \"(a)\" ) \"  --watch-restart-max <N>\" write ( error_unit , \"(a)\" ) \"      Maximum restart attempts (0 = unlimited). Default: 0\" write ( error_unit , \"(a)\" ) \"  --watch-self <path>\" write ( error_unit , \"(a)\" ) \"      Explicit path to fpm-watch executable (advanced).\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"  --watch-once\" write ( error_unit , \"(a)\" ) \"      Initialize (and optionally run once) then exit. Good for CI.\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"CONFIGURATION (fpm.toml)\" write ( error_unit , \"(a)\" ) \"  [extra.fpm-watch]  (same names as flags, without the --watch- prefix)\" write ( error_unit , \"(a)\" ) \"  poll         = 0.5\" write ( error_unit , \"(a)\" ) \"  debounce     = 0.2\" write ( error_unit , \"(a)\" ) \"  rescan       = 0.0\" write ( error_unit , \"(a)\" ) \"  run-on-start = true\" write ( error_unit , \"(a)\" ) \"  silent-fpm   = false\" write ( error_unit , \"(a)\" ) \"  print-files  = false\" write ( error_unit , \"(a)\" ) \"  deps         = false\" write ( error_unit , \"(a)\" ) \"  low-cpu      = false\" write ( error_unit , \"(a)\" ) \"  auto-restart = false\" write ( error_unit , \"(a)\" ) \"  restart-delay= 1.0\" write ( error_unit , \"(a)\" ) \"  restart-max  = 0\" write ( error_unit , \"(a)\" ) \"  self         = \"\"\"\"\" write ( error_unit , \"(a)\" ) \"  debug        = false\" write ( error_unit , \"(a)\" ) \"  verbosity    = 0\" write ( error_unit , \"(a)\" ) '  log-format   = \"text\"' write ( error_unit , \"(a)\" ) '  fpm-executable = \"fpm\"' write ( error_unit , \"(a)\" ) \"  output-markers = false\" write ( error_unit , \"(a)\" ) \"  ignore       = []\" write ( error_unit , \"(a)\" ) \"  include      = []\" write ( error_unit , \"(a)\" ) \"  features     = []\" write ( error_unit , \"(a)\" ) \"  once         = false\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"EXAMPLES\" write ( error_unit , \"(a)\" ) \"  fpm-watch build\" write ( error_unit , \"(a)\" ) \"  fpm-watch --watch-low-cpu test\" write ( error_unit , \"(a)\" ) \"  fpm-watch --watch-deps test -- --list\" write ( error_unit , \"(a)\" ) \"  fpm-watch --watch-auto-restart test\" write ( error_unit , \"(a)\" ) \"\" write ( error_unit , \"(a)\" ) \"NOTES\" write ( error_unit , \"(a)\" ) \"  fpm-watch ignores build/ to avoid infinite rebuild loops.\" write ( error_unit , \"(a)\" ) \"  Enable deps only if you want dependency source changes to trigger runs.\" write ( error_unit , \"(a)\" ) \"  Enable low-cpu to avoid busy-waiting and reduce idle CPU usage.\" write ( error_unit , \"(a)\" ) \"  To quit, press Ctrl+C (or create an empty file named .fpm-watch.stop).\" write ( error_unit , \"(a)\" ) \"\" end subroutine usage_print_only !> Copy parsed build and toolchain values into a typed fpm settings object. !! !! `parse_cli` resolves environment defaults and CLI overrides beforehand. !! This routine disables model verbosity, replaces the feature array, and !! assigns toolchain/flag strings. An empty profile retains the type default. subroutine init_build_settings ( settings , build_dir , prune , profile , features , compiler_in , c_compiler_in , cxx_compiler_in , archiver_in , flag_in , cflag_in , cxxflag_in , ldflag_in ) class ( fpm_build_settings ), intent ( inout ) :: settings character ( len =* ), intent ( in ) :: build_dir logical , intent ( in ) :: prune character ( len =* ), intent ( in ) :: profile type ( string_t ), allocatable , intent ( in ) :: features (:) character ( len =* ), intent ( in ) :: compiler_in , c_compiler_in , cxx_compiler_in , archiver_in character ( len =* ), intent ( in ) :: flag_in , cflag_in , cxxflag_in , ldflag_in settings % verbose = . false . settings % prune = prune settings % build_dir = build_dir if ( len_trim ( profile ) > 0 ) settings % profile = trim ( profile ) if ( allocated ( settings % features )) deallocate ( settings % features ) if ( allocated ( features )) then if ( size ( features ) > 0 ) then allocate ( settings % features ( size ( features ))) settings % features = features end if end if settings % compiler = compiler_in settings % c_compiler = c_compiler_in settings % cxx_compiler = cxx_compiler_in settings % archiver = archiver_in settings % flag = flag_in settings % cflag = cflag_in settings % cxxflag = cxxflag_in settings % ldflag = ldflag_in end subroutine init_build_settings !> Return the default build directory used by `fpm-watch`. pure function default_build_dir () result ( dir ) character ( len = :), allocatable :: dir dir = \"build\" end function default_build_dir !> Copy nonempty target patterns into an initially unallocated `s%name`. !! !! Patterns come from positional names, `--target`, or `--all`. Empty or !! unallocated input leaves `s%name` unchanged; copied names are right-trimmed. pure subroutine set_names ( s , names ) class ( fpm_run_settings ), intent ( inout ) :: s type ( string_t ), allocatable , intent ( in ) :: names (:) integer :: i , k , n if (. not . allocated ( names )) return n = 0 do i = 1 , size ( names ) if ( len_trim ( names ( i )% s ) > 0 ) n = n + 1 end do if ( n == 0 ) return allocate ( s % name ( n )) k = 0 do i = 1 , size ( names ) if ( len_trim ( names ( i )% s ) == 0 ) cycle k = k + 1 s % name ( k ) = trim ( names ( i )% s ) end do end subroutine set_names !> Parse a comma-separated `--features` value into the features array. !! !! Empty tokens are ignored; whitespace around tokens is stripped. subroutine add_features_csv ( features , csv ) type ( string_t ), allocatable , intent ( inout ) :: features (:) character ( len =* ), intent ( in ) :: csv character ( len = :), allocatable :: tokens (:) integer :: j call split ( csv , tokens , delimiters = \",\" ) do j = 1 , size ( tokens ) call push_feature ( features , trim ( adjustl ( tokens ( j )))) end do end subroutine add_features_csv end module watch_cli","tags":"","url":"sourcefile/watch_cli.f90.html"},{"title":"watch_cmdline.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_cmdline.f90~~EfferentGraph sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_util.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_cmdline.f90~~AfferentGraph sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_cmdsplice.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_exec.f90 watch_exec.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_restart.f90 watch_restart.f90 sourcefile~watch_restart.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_cli.f90 sourcefile~watch_engine.f90->sourcefile~watch_exec.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Read argv tokens, parse option values, and serialize command arguments. !! !! `quote_arg` always quotes the full token, including empty arguments. POSIX !! serialization uses single quotes; Windows uses double quotes and C-runtime !! backslash rules. Platform selection comes from `watch_platform:is_windows` !! unless a quoting caller supplies an explicit override. module watch_cmdline use watch_util , only : starts_with use watch_platform , only : is_windows_os => is_windows implicit none private public get_arg , join_argv , parse_int , parse_real , needs_quotes , quote_arg , is_windows_os , starts_with public watch_option_takes_value , parse_bool contains !> Parse trimmed, case-insensitive boolean spellings or return `default`. !! !! True accepts `1`, `true`, `on`, `yes`, `y`, `t`; false accepts `0`, `false`, !! `off`, `no`, `n`, `f`. Empty and unrecognized values use the fallback. pure logical function parse_bool ( s , default ) result ( v ) character ( len =* ), intent ( in ) :: s logical , intent ( in ) :: default character ( len = :), allocatable :: t t = trim ( adjustl ( lower_ascii ( s ))) select case ( t ) case ( \"1\" , \"true\" , \"on\" , \"yes\" , \"y\" , \"t\" ) v = . true . case ( \"0\" , \"false\" , \"off\" , \"no\" , \"n\" , \"f\" ) v = . false . case default v = default end select end function parse_bool !> Normalize ASCII letters for case-insensitive option values. pure function lower_ascii ( s ) result ( r ) character ( len =* ), intent ( in ) :: s character ( len = len ( s )) :: r integer :: k , c , da da = iachar ( \"a\" ) - iachar ( \"A\" ) do k = 1 , len ( s ) c = iachar ( s ( k : k )) if ( c >= iachar ( \"A\" ) . and . c <= iachar ( \"Z\" )) then r ( k : k ) = achar ( c + da ) else r ( k : k ) = s ( k : k ) end if end do end function lower_ascii !> Return whether a bare watcher option consumes the following argv token. pure logical function watch_option_takes_value ( a ) result ( takes_value ) character ( len =* ), intent ( in ) :: a select case ( a ) case ( \"--watch-restart-delay\" , \"--watch-restart-max\" , \"--watch-self\" , & \"--watch-rescan\" , \"--watch-ignore\" , \"--watch-include\" , \"--watch-feature\" , & \"--watch-poll\" , \"--watch-debounce\" , \"--watch-log-format\" , \"--watch-fpm\" ) takes_value = . true . case default takes_value = . false . end select end function watch_option_takes_value !> Return argv entry `i`, or an empty string for a missing, empty, or unreadable argument. function get_arg ( i ) result ( a ) integer , intent ( in ) :: i !! Argument index: 0 is the executable name; actual arguments start at 1. character ( len = :), allocatable :: a integer :: n , istat n = 0 call get_command_argument ( i , length = n , status = istat ) if ( istat /= 0 . or . n <= 0 ) then a = \"\" return end if allocate ( character ( len = n ) :: a ) call get_command_argument ( i , value = a , status = istat ) if ( istat /= 0 ) a = \"\" end function get_arg !> Serialize argv entries from `i1` through `i2` with spaces and platform quoting. !! !! Every token, including an empty one, passes through `quote_arg`. A reversed !! range returns an empty command string. function join_argv ( i1 , i2 ) result ( s ) integer , intent ( in ) :: i1 , i2 !! Inclusive range of argv indices to join. character ( len = :), allocatable :: s character ( len = :), allocatable :: a integer :: i s = \"\" do i = i1 , i2 a = get_arg ( i ) if ( i > i1 ) s = s // \" \" s = s // quote_arg ( a ) end do end function join_argv !> Test whether a token is empty or contains bytes outside the shell-safe set. !! !! Retained as a query helper; `quote_arg` quotes tokens regardless of this result. pure logical function needs_quotes ( a ) result ( q ) character ( len =* ), intent ( in ) :: a character ( len =* ), parameter :: safe = & \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_@+=:,./-\" q = len ( a ) == 0 . or . verify ( a , safe ) /= 0 end function needs_quotes !> Serialize one complete argv token, preserving whitespace and empty arguments. !! !! Optional `windows` overrides host detection. Windows doubles trailing !! backslashes and escapes embedded double quotes for the C-runtime parser. !! POSIX uses single quotes, breaking out of them to represent embedded quotes. function quote_arg ( a , windows ) result ( q ) character ( len =* ), intent ( in ) :: a logical , intent ( in ), optional :: windows !! Explicit platform selection supports portable serialization checks. character ( len = :), allocatable :: q logical :: use_windows if ( present ( windows )) then use_windows = windows else use_windows = is_windows_os () end if if ( use_windows ) then q = '\"' // escape_quotes_win ( a ) // '\"' else q = \"'\" // escape_quotes_sh ( a ) // \"'\" end if contains !> Escape embedded quotes and trailing backslashes for a double-quoted Windows argv token. pure function escape_quotes_win ( s ) result ( r ) character ( len =* ), intent ( in ) :: s character ( len = :), allocatable :: r integer :: j , backslashes r = \"\" backslashes = 0 do j = 1 , len ( s ) if ( s ( j : j ) == achar ( 92 )) then backslashes = backslashes + 1 cycle end if if ( s ( j : j ) == '\"' ) then r = r // repeat ( achar ( 92 ), 2 * backslashes + 1 ) // '\"' else r = r // repeat ( achar ( 92 ), backslashes ) // s ( j : j ) end if backslashes = 0 end do r = r // repeat ( achar ( 92 ), 2 * backslashes ) end function escape_quotes_win !> Replace embedded single quotes with quoted fragments suitable for a POSIX shell. pure function escape_quotes_sh ( s ) result ( r ) character ( len =* ), intent ( in ) :: s character ( len = :), allocatable :: r integer :: j r = \"\" do j = 1 , len ( s ) if ( s ( j : j ) == \"'\" ) then r = r // \"'\"\"'\"\"'\" else r = r // s ( j : j ) end if end do end function escape_quotes_sh end function quote_arg !> Read an integer with list-directed input; return `default` if the read fails. pure integer function parse_int ( s , default ) result ( v ) character ( len =* ), intent ( in ) :: s integer , intent ( in ) :: default integer :: ios read ( s , * , iostat = ios ) v if ( ios /= 0 ) v = default end function parse_int !> Read a real with list-directed input; return `default` if the read fails. pure real function parse_real ( s , default ) result ( v ) character ( len =* ), intent ( in ) :: s real , intent ( in ) :: default integer :: ios read ( s , * , iostat = ios ) v if ( ios /= 0 ) v = default end function parse_real end module watch_cmdline","tags":"","url":"sourcefile/watch_cmdline.f90.html"},{"title":"watch_config.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_config.f90~~EfferentGraph sourcefile~watch_config.f90 watch_config.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_config.f90->sourcefile~watch_types.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_config.f90~~AfferentGraph sourcefile~watch_config.f90 watch_config.f90 sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_cli.f90->sourcefile~watch_config.f90 sourcefile~watch_restart.f90 watch_restart.f90 sourcefile~watch_restart.f90->sourcefile~watch_config.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_cli.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Read watcher and supervisor defaults through fpm's TOML interface. !! !! Missing or unreadable watcher tables leave existing values unchanged. !! Scalar keys replace defaults; manifest lists replace existing arrays. !! CLI list options subsequently append unique entries through `push_feature`. !! Supervisor defaults are read separately by `get_restart_defaults`. module watch_config use watch_types , only : watch_opts_t use fpm_strings , only : string_t use fpm_filesystem , only : exists use fpm_error , only : error_t use fpm_toml , only : read_package_file , get_list use tomlf , only : toml_table , toml_stat , get_value implicit none private public set_watch_defaults , apply_watch_from_manifest , normalize_watch_opts , push_feature , get_restart_defaults contains !> Reset scalar watcher options and ensure list arrays are allocated. !! !! Existing include/ignore/plugin arrays are retained. Fresh options receive !! empty arrays; supervisor options have separate defaults. subroutine set_watch_defaults ( w ) type ( watch_opts_t ), intent ( inout ) :: w w % verbosity = 0 w % log_format = \"text\" w % fpm_executable = \"fpm\" w % debug = . false . w % poll = 0.5 w % debounce = 0.2 w % rescan = 0.0 w % run_on_start = . true . w % print_files_once = . false . w % silent_fpm = . false . w % output_markers = . false . w % restart_count = 0 w % watch_deps = . false . w % low_cpu = . false . w % once = . false . if (. not . allocated ( w % ignore )) allocate ( w % ignore ( 0 )) if (. not . allocated ( w % include )) allocate ( w % include ( 0 )) if (. not . allocated ( w % enabled_features )) allocate ( w % enabled_features ( 0 )) end subroutine set_watch_defaults !> Normalize timing bounds, verbosity, and the executable name. !! !! Clamp poll to at least 0.05 s, debounce/rescan to nonnegative values, and !! verbosity to -1..2. Restore an empty/unallocated fpm executable to `fpm`. !! Log-format validation and list allocation are handled separately. subroutine normalize_watch_opts ( w ) type ( watch_opts_t ), intent ( inout ) :: w if ( w % poll < 0.05 ) w % poll = 0.05 if ( w % debounce < 0.0 ) w % debounce = 0.0 if ( w % rescan < 0.0 ) w % rescan = 0.0 if ( w % verbosity > 2 ) w % verbosity = 2 if ( w % verbosity < - 1 ) w % verbosity = - 1 if (. not . allocated ( w % fpm_executable )) w % fpm_executable = \"fpm\" if ( len_trim ( w % fpm_executable ) == 0 ) w % fpm_executable = \"fpm\" end subroutine normalize_watch_opts !> Replace recognized options from `[extra.fpm-watch]` and normalize them. !! !! Missing keys or values that TOML getters cannot read leave existing options !! unchanged. Successfully read lists replace existing arrays. Supervisor keys !! are handled by `get_restart_defaults`; log-format validation belongs to CLI !! configuration assembly. subroutine apply_watch_from_manifest ( w ) type ( watch_opts_t ), intent ( inout ) :: w type ( toml_table ), allocatable :: root type ( toml_table ), pointer :: wt logical :: ok call load_watch_table ( root , wt , ok ) if (. not . ok ) return call toml_get_real ( wt , \"poll\" , w % poll ) call toml_get_real ( wt , \"debounce\" , w % debounce ) call toml_get_real ( wt , \"rescan\" , w % rescan ) call toml_get_logical ( wt , \"debug\" , w % debug ) call toml_get_logical ( wt , \"print-files\" , w % print_files_once ) call toml_get_logical ( wt , \"silent-fpm\" , w % silent_fpm ) call toml_get_logical ( wt , \"output-markers\" , w % output_markers ) call toml_get_logical ( wt , \"run-on-start\" , w % run_on_start ) call toml_get_logical ( wt , \"deps\" , w % watch_deps ) call toml_get_logical ( wt , \"low-cpu\" , w % low_cpu ) call toml_get_logical ( wt , \"once\" , w % once ) call toml_get_int ( wt , \"verbosity\" , w % verbosity ) call toml_get_string ( wt , \"log-format\" , w % log_format ) call toml_get_string ( wt , \"fpm-executable\" , w % fpm_executable ) call toml_get_list_strings ( wt , \"ignore\" , w % ignore ) call toml_get_list_strings ( wt , \"include\" , w % include ) call toml_get_list_strings ( wt , \"features\" , w % enabled_features ) call normalize_watch_opts ( w ) end subroutine apply_watch_from_manifest !> Read supervisor defaults from the manifest (when present). !! !! These are used by `watch_restart` and can be configured under !! `[extra.fpm-watch]`. !! !! Keys: !! !! - `auto-restart` (logical) !! - `restart-delay` (real, seconds) !! - `restart-max` (integer, 0 = unlimited) !! - `self` or `self-exe` (string, explicit path to `fpm-watch`) subroutine get_restart_defaults ( auto_restart , restart_delay , restart_max , self_exe ) logical , intent ( out ) :: auto_restart real , intent ( out ) :: restart_delay integer , intent ( out ) :: restart_max character ( len = :), allocatable , intent ( out ) :: self_exe type ( toml_table ), allocatable :: root type ( toml_table ), pointer :: wt logical :: ok character ( len = :), allocatable :: tmp auto_restart = . false . restart_delay = 1.0 restart_max = 0 self_exe = \"\" call load_watch_table ( root , wt , ok ) if (. not . ok ) return call toml_get_logical ( wt , \"auto-restart\" , auto_restart ) call toml_get_real ( wt , \"restart-delay\" , restart_delay ) call toml_get_int ( wt , \"restart-max\" , restart_max ) tmp = \"\" call toml_get_string ( wt , \"self\" , tmp ) if ( len_trim ( tmp ) == 0 ) call toml_get_string ( wt , \"self-exe\" , tmp ) if ( len_trim ( tmp ) > 0 ) self_exe = trim ( tmp ) if ( restart_delay < 0.0 ) restart_delay = 0.0 if ( restart_max < 0 ) restart_max = 0 end subroutine get_restart_defaults !> Locate `[extra.fpm-watch]` in the current directory's `fpm.toml`. !! !! `ok` is false and `wt` is null when the file/table is absent or unreadable. !! On success, `wt` points inside `root` and remains valid only while `root` !! remains allocated. subroutine load_watch_table ( root , wt , ok ) type ( toml_table ), allocatable , intent ( out ) :: root type ( toml_table ), pointer , intent ( out ) :: wt logical , intent ( out ) :: ok type ( toml_table ), pointer :: extra type ( error_t ), allocatable :: err integer :: stat ok = . false . wt => null () extra => null () if (. not . exists ( \"fpm.toml\" )) return call read_package_file ( root , \"fpm.toml\" , err ) if ( allocated ( err )) return call get_value ( root , \"extra\" , extra , requested = . false ., stat = stat ) if ( stat /= toml_stat % success ) return if (. not . associated ( extra )) return call get_value ( extra , \"fpm-watch\" , wt , requested = . false ., stat = stat ) if ( stat /= toml_stat % success ) return if (. not . associated ( wt )) return ok = . true . end subroutine load_watch_table !> Read a TOML real value if present. subroutine toml_get_real ( table , key , v ) type ( toml_table ), intent ( inout ) :: table character ( len =* ), intent ( in ) :: key real , intent ( inout ) :: v real :: tmp integer :: stat tmp = v call get_value ( table , key , tmp , stat = stat ) if ( stat == toml_stat % success ) v = tmp end subroutine toml_get_real !> Read a TOML integer value if present. subroutine toml_get_int ( table , key , v ) type ( toml_table ), intent ( inout ) :: table character ( len =* ), intent ( in ) :: key integer , intent ( inout ) :: v integer :: tmp , stat tmp = v call get_value ( table , key , tmp , stat = stat ) if ( stat == toml_stat % success ) v = tmp end subroutine toml_get_int !> Read a TOML logical value if present. subroutine toml_get_logical ( table , key , v ) type ( toml_table ), intent ( inout ) :: table character ( len =* ), intent ( in ) :: key logical , intent ( inout ) :: v logical :: tmp integer :: stat tmp = v call get_value ( table , key , tmp , stat = stat ) if ( stat == toml_stat % success ) v = tmp end subroutine toml_get_logical !> Read a TOML string value if present. subroutine toml_get_string ( table , key , v ) type ( toml_table ), intent ( inout ) :: table character ( len =* ), intent ( in ) :: key character ( len = :), allocatable , intent ( inout ) :: v character ( len = :), allocatable :: tmp integer :: stat call get_value ( table , key , tmp , stat = stat ) if ( stat == toml_stat % success ) then if ( allocated ( tmp )) then v = tmp else v = \"\" end if end if end subroutine toml_get_string !> Read a TOML string list into an allocatable `string_t` array. subroutine toml_get_list_strings ( table , key , list ) type ( toml_table ), intent ( inout ) :: table character ( len =* ), intent ( in ) :: key type ( string_t ), allocatable , intent ( inout ) :: list (:) type ( error_t ), allocatable :: err type ( string_t ), allocatable :: tmp (:) if (. not . allocated ( list )) allocate ( list ( 0 )) call get_list ( table , key , tmp , err ) if ( allocated ( err )) then if ( allocated ( tmp )) deallocate ( tmp ) return end if if (. not . allocated ( tmp )) return call move_alloc ( tmp , list ) end subroutine toml_get_list_strings !> Append a unique, nonempty, right-trimmed string to an allocatable list. !! !! Used for fpm features, watcher plugins, target patterns, and filters. !! Comparisons are case-sensitive; leading whitespace is retained. subroutine push_feature ( features , name ) type ( string_t ), allocatable , intent ( inout ) :: features (:) character ( len =* ), intent ( in ) :: name integer :: n , i type ( string_t ), allocatable :: tmp (:) if ( len_trim ( name ) == 0 ) return if (. not . allocated ( features )) then allocate ( features ( 1 )) features ( 1 )% s = trim ( name ) return end if do i = 1 , size ( features ) if ( trim ( features ( i )% s ) == trim ( name )) return end do n = size ( features ) allocate ( tmp ( n + 1 )) tmp ( 1 : n ) = features tmp ( n + 1 )% s = trim ( name ) call move_alloc ( tmp , features ) end subroutine push_feature end module watch_config","tags":"","url":"sourcefile/watch_config.f90.html"},{"title":"watch_cmdsplice.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_cmdsplice.f90~~EfferentGraph sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_cmdsplice.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_util.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~watch_cmdsplice.f90~~AfferentGraph sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_exec.f90 watch_exec.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_engine.f90->sourcefile~watch_cli.f90 sourcefile~watch_engine.f90->sourcefile~watch_exec.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Helpers for manipulating `fpm` command lines. !! !! Provides utilities to split an `fpm <subcmd> ...` command into a prefix and !! remainder, and to inject target names into the correct position while !! preserving a `--` delimiter for arguments passed to the executed program. !! !! These utilities operate on command strings serialized by `quote_arg()`. !! Delimiter detection respects quoted argv tokens and their escaped quotes. module watch_cmdsplice use watch_cmdline , only : is_windows_os implicit none private public split_cmd_after_subcmd , inject_names_into_cmd contains !> Split a literal `fpm SUBCOMMAND` prefix from the remaining serialized arguments. !! !! Only the first two unquoted, whitespace-delimited tokens are scanned; !! custom executable substitution happens later in `watch_cli`. Empty input, !! a non-`fpm` first token, or a missing subcommand returns empty outputs. subroutine split_cmd_after_subcmd ( full , prefix , rest ) character ( len =* ), intent ( in ) :: full !! Full command string. character ( len = :), allocatable , intent ( out ) :: prefix !! Prefix up to and including the subcommand token. character ( len = :), allocatable , intent ( out ) :: rest !! Remaining arguments after the subcommand. character ( len = :), allocatable :: s integer :: p_fpm_end , p_sub_start , p_sub_end s = adjustl ( trim ( full )) prefix = \"\" rest = \"\" if ( len_trim ( s ) == 0 ) return if (. not . starts_with_token ( s , \"fpm\" )) return p_fpm_end = token_end ( s , 1 ) p_sub_start = next_token_start ( s , p_fpm_end + 1 ) if ( p_sub_start == 0 ) return p_sub_end = token_end ( s , p_sub_start ) prefix = trim ( s ( 1 : p_sub_end )) if ( p_sub_end < len_trim ( s )) then rest = adjustl ( s ( p_sub_end + 1 :)) else rest = \"\" end if contains !> Test the first whitespace-delimited token against a nonempty right-trimmed token. pure logical function starts_with_token ( str , tok ) result ( ok ) character ( len =* ), intent ( in ) :: str , tok integer :: e , n ok = . false . n = len_trim ( tok ) if ( n == 0 ) return if ( len_trim ( str ) < n ) return if ( str ( 1 : n ) /= tok ( 1 : n )) return e = token_end ( str , 1 ) ok = ( e == n ) end function starts_with_token !> Return the next non-space/tab position at or after `i`, or zero if absent. pure integer function next_token_start ( str , i ) result ( pos ) character ( len =* ), intent ( in ) :: str integer , intent ( in ) :: i integer :: k , n pos = 0 n = len_trim ( str ) k = max ( 1 , i ) do while ( k <= n ) if ( str ( k : k ) /= \" \" . and . str ( k : k ) /= char ( 9 )) then pos = k return end if k = k + 1 end do end function next_token_start !> Return the end of an unquoted space/tab-delimited token, or zero for an invalid start. pure integer function token_end ( str , i ) result ( pos ) character ( len =* ), intent ( in ) :: str integer , intent ( in ) :: i integer :: k , n pos = 0 n = len_trim ( str ) if ( i < 1 . or . i > n ) return k = i do while ( k <= n ) if ( str ( k : k ) == \" \" . or . str ( k : k ) == char ( 9 )) then pos = k - 1 return end if k = k + 1 end do pos = n end function token_end end subroutine split_cmd_after_subcmd !> Insert already serialized names after fpm options and before a `--` token. !! !! `prefix` includes the executable/subcommand; `rest` retains forwarded args. !! `names` must already contain quoted argv tokens. Optional `windows` selects !! delimiter parsing rules. An empty prefix returns an empty string; empty !! names simply rejoin prefix and rest. function inject_names_into_cmd ( prefix , rest , names , windows ) result ( out ) character ( len =* ), intent ( in ) :: prefix !! Prefix up to and including the subcommand. character ( len =* ), intent ( in ) :: rest !! Remaining arguments after the subcommand. character ( len =* ), intent ( in ) :: names !! Space-separated names to inject. logical , intent ( in ), optional :: windows !! Explicit platform selection supports portable serialization checks. character ( len = :), allocatable :: out character ( len = :), allocatable :: p , r , n , before , after integer :: dd logical :: use_windows p = trim ( prefix ) r = adjustl ( trim ( rest )) n = trim ( names ) if ( len_trim ( p ) == 0 ) then out = \"\" return end if if ( len_trim ( n ) == 0 ) then if ( len_trim ( r ) == 0 ) then out = p else out = p // \" \" // r end if return end if if ( present ( windows )) then use_windows = windows else use_windows = is_windows_os () end if dd = find_double_dash_delim ( r , use_windows ) if ( dd > 0 ) then if ( dd > 1 ) then before = trim ( r ( 1 : dd - 1 )) else before = \"\" end if after = trim ( adjustl ( r ( dd :))) else before = trim ( r ) after = \"\" end if out = p if ( len_trim ( before ) > 0 ) out = out // \" \" // before out = out // \" \" // n if ( len_trim ( after ) > 0 ) out = out // \" \" // after contains !> Locate a complete `--` argv token, including its serialized quotes. pure integer function find_double_dash_delim ( str , windows ) result ( pos ) character ( len =* ), intent ( in ) :: str logical , intent ( in ) :: windows integer :: i , n , first character :: quote , ch pos = 0 n = len_trim ( str ) i = 1 do while ( i <= n ) if ( is_space ( str ( i : i ))) then i = i + 1 cycle end if first = i quote = achar ( 0 ) do while ( i <= n ) ch = str ( i : i ) if ( windows . and . ch == achar ( 92 ) . and . i < n ) then if ( str ( i + 1 : i + 1 ) == achar ( 92 ) . or . str ( i + 1 : i + 1 ) == '\"' ) then i = i + 2 cycle end if end if if ( quote == achar ( 0 )) then if ( is_space ( ch )) exit if ( ch == '\"' . or . ( ch == \"'\" . and . . not . windows )) quote = ch else if ( ch == quote ) then if ( windows . and . quote == '\"' . and . i < n ) then if ( str ( i + 1 : i + 1 ) == '\"' ) then i = i + 2 cycle end if end if quote = achar ( 0 ) end if if (. not . windows . and . ch == achar ( 92 ) . and . quote /= \"'\" ) then i = i + 1 end if i = i + 1 end do select case ( str ( first : min ( i - 1 , n ))) case ( \"--\" , \"'--'\" , '\"--\"' ) pos = first return case default continue end select end do end function find_double_dash_delim !> Return whether a character is a space or horizontal tab. pure logical function is_space ( ch ) result ( ok ) character , intent ( in ) :: ch ok = ch == \" \" . or . ch == char ( 9 ) end function is_space end function inject_names_into_cmd end module watch_cmdsplice","tags":"","url":"sourcefile/watch_cmdsplice.f90.html"},{"title":"watch_engine.f90 – fpm-watch","text":"This file depends on sourcefile~~watch_engine.f90~~EfferentGraph sourcefile~watch_engine.f90 watch_engine.f90 sourcefile~watch_banner.f90 watch_banner.f90 sourcefile~watch_engine.f90->sourcefile~watch_banner.f90 sourcefile~watch_cli.f90 watch_cli.f90 sourcefile~watch_engine.f90->sourcefile~watch_cli.f90 sourcefile~watch_exec.f90 watch_exec.f90 sourcefile~watch_engine.f90->sourcefile~watch_exec.f90 sourcefile~watch_feature_factory.f90 watch_feature_factory.f90 sourcefile~watch_engine.f90->sourcefile~watch_feature_factory.f90 sourcefile~watch_feature_manager.f90 watch_feature_manager.f90 sourcefile~watch_engine.f90->sourcefile~watch_feature_manager.f90 sourcefile~watch_fingerprint.f90 watch_fingerprint.f90 sourcefile~watch_engine.f90->sourcefile~watch_fingerprint.f90 sourcefile~watch_fpm_graph.f90 watch_fpm_graph.f90 sourcefile~watch_engine.f90->sourcefile~watch_fpm_graph.f90 sourcefile~watch_log.f90 watch_log.f90 sourcefile~watch_engine.f90->sourcefile~watch_log.f90 sourcefile~watch_platform.f90 watch_platform.f90 sourcefile~watch_engine.f90->sourcefile~watch_platform.f90 sourcefile~watch_time.f90 watch_time.f90 sourcefile~watch_engine.f90->sourcefile~watch_time.f90 sourcefile~watch_types.f90 watch_types.f90 sourcefile~watch_engine.f90->sourcefile~watch_types.f90 sourcefile~watch_banner.f90->sourcefile~watch_log.f90 sourcefile~watch_banner.f90->sourcefile~watch_types.f90 sourcefile~watch_util.f90 watch_util.f90 sourcefile~watch_banner.f90->sourcefile~watch_util.f90 sourcefile~watch_cli.f90->sourcefile~watch_log.f90 sourcefile~watch_cli.f90->sourcefile~watch_types.f90 sourcefile~watch_cmdline.f90 watch_cmdline.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_cmdsplice.f90 watch_cmdsplice.f90 sourcefile~watch_cli.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_config.f90 watch_config.f90 sourcefile~watch_cli.f90->sourcefile~watch_config.f90 sourcefile~watch_exec.f90->sourcefile~watch_log.f90 sourcefile~watch_exec.f90->sourcefile~watch_platform.f90 sourcefile~watch_exec.f90->sourcefile~watch_types.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_exec.f90->sourcefile~watch_cmdsplice.f90 sourcefile~watch_exec.f90->sourcefile~watch_util.f90 sourcefile~watch_feature_factory.f90->sourcefile~watch_feature_manager.f90 sourcefile~watch_feature_factory.f90->sourcefile~watch_log.f90 sourcefile~watch_feature_factory.f90->sourcefile~watch_types.f90 sourcefile~watch_feat_stats.f90 watch_feat_stats.f90 sourcefile~watch_feature_factory.f90->sourcefile~watch_feat_stats.f90 sourcefile~watch_feature_api.f90 watch_feature_api.f90 sourcefile~watch_feature_factory.f90->sourcefile~watch_feature_api.f90 sourcefile~watch_feature_manager.f90->sourcefile~watch_types.f90 sourcefile~watch_feature_manager.f90->sourcefile~watch_feature_api.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_log.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_platform.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_types.f90 sourcefile~watch_filter.f90 watch_filter.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_filter.f90 sourcefile~watch_fpm_graph.f90->sourcefile~watch_util.f90 sourcefile~watch_log.f90->sourcefile~watch_types.f90 sourcefile~watch_log.f90->sourcefile~watch_util.f90 sourcefile~watch_platform.f90->sourcefile~watch_log.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_platform.f90 sourcefile~watch_cmdline.f90->sourcefile~watch_util.f90 sourcefile~watch_cmdsplice.f90->sourcefile~watch_cmdline.f90 sourcefile~watch_config.f90->sourcefile~watch_types.f90 sourcefile~watch_feat_stats.f90->sourcefile~watch_log.f90 sourcefile~watch_feat_stats.f90->sourcefile~watch_types.f90 sourcefile~watch_feat_stats.f90->sourcefile~watch_feature_api.f90 sourcefile~watch_feature_api.f90->sourcefile~watch_types.f90 sourcefile~watch_filter.f90->sourcefile~watch_util.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !> Portable polling, watch-list refreshes, and synchronous command execution. !! !! The engine debounces changes, maps source edits to run/test targets, and !! refreshes the graph after watched manifest edits or optional periodic rescans. !! Failed refreshes preserve the accepted watch list. Commands block polling; !! ordinary command failures do not terminate continuous watching. module watch_engine use , intrinsic :: iso_fortran_env , only : int64 use watch_types , only : watch_config_t , root_info_t use watch_feature_manager , only : feature_manager_t use watch_feature_factory , only : enable_features use watch_log , only : log_event , log_int , log_real , log_string , configure_logging use fpm_error , only : error_t use watch_fpm_graph , only : compute_watch_files_from_settings use watch_fingerprint , only : init_fingerprints , scan_changes , accept_changes , manifest_key_from_files , watch_state_changed use watch_cli , only : parse_cli_config use watch_platform , only : termination_requested use watch_time , only : sleep_seconds , set_low_cpu use watch_exec , only : report_changes , build_run_command , run_command_and_report use watch_banner , only : print_banner , print_file_list , print_configuration use fpm_strings , only : string_t , str use fpm_filesystem , only : basename , exists implicit none private public watcher_t !> Accepted configuration, plugin instances, watch graph, and fingerprint baselines. !! !! File masks and roots describe affected-target membership. `man_prev` stores the !! last manifest/settings key for plugin notifications. A failed manifest refresh !! leaves a retry flag while accepted configuration and watch-list state are retained. type watcher_t !> Accepted watcher settings and serialized fpm command. type ( watch_config_t ) :: cfg !> Plugins enabled during initialization. type ( feature_manager_t ) :: fm !> Unique normalized watched paths, aligned with masks and fingerprints. type ( string_t ), allocatable :: files (:) !> Per-file root-membership bits for affected run/test target selection. integer ( int64 ), allocatable :: file_mask (:) !> Named run/test roots; empty when root-bit mapping is unavailable. type ( root_info_t ), allocatable :: roots (:) !> Accepted file fingerprints used as the change-detection baseline. integer ( int64 ), allocatable :: fp_prev (:) !> Latest sampled fingerprints; aligned with `files`. integer ( int64 ), allocatable :: fp_now (:) !> Reusable 1-based index buffer; only the active changed-count prefix is meaningful. integer , allocatable :: changed_idx (:) !> Manifest/settings key from the last successful refresh, used for plugin notifications. integer ( int64 ) :: man_prev = 0_int64 !> Most recent command exit status; zero before a run, propagated by one-shot mode. integer :: last_exit = 0 !> Last graph-refresh error text, retained to suppress repeated diagnostics. character ( len = :), allocatable :: last_refresh_error !> Retry manifest settings/graph refresh on a later edit or periodic rescan. logical :: manifest_refresh_pending = . false . contains procedure :: init => watcher_init procedure :: run => watcher_run end type watcher_t contains !> Initialize logging, waiting mode, plugins, the watch list, and fingerprints. !! !! Plugin init/start callbacks precede graph construction. A failed initial !! graph terminates with status 1. Run the full configured command if !! `run_on_start` is enabled, including in one-shot mode. subroutine watcher_init ( self , cfg ) class ( watcher_t ), intent ( inout ) :: self !! Intended for fresh state; plugin storage and prior command status are not cleared. type ( watch_config_t ), intent ( in ) :: cfg !! Parsed configuration with allocated model settings and normalized watcher options. self % cfg = cfg call configure_logging ( cfg % w ) call set_low_cpu ( self % cfg % w % low_cpu ) call enable_features ( self % fm , self % cfg % w ) call self % fm % init_all ( self % cfg ) call self % fm % on_start_all () call rebuild_watch_list ( self , print_header = . true .) if ( self % cfg % w % run_on_start ) then call run_once ( self , trim ( self % cfg % fpm_cmdline )) end if end subroutine watcher_init !> Poll until a stop file or termination request is detected. !! !! Return immediately in one-shot mode. Otherwise sleep, fingerprint files, !! debounce detected changes, and resample before acting. A watched manifest !! change or pending manifest refresh reparses settings and refreshes the graph. !! Other edits select an affected-target command and accept sampled fingerprints !! after the command, including failures. Commands run synchronously. !! !! Optional rescans refresh the graph and run the full command if paths or !! fingerprints changed. A pending manifest refresh is retried on later edits !! or rescans. Stop-file checks occur between commands and around waits. subroutine watcher_run ( self ) class ( watcher_t ), intent ( inout ) :: self integer :: changed_count type ( string_t ), allocatable :: changed (:) character ( len = :), allocatable :: cmd integer :: j , idx logical :: rescan_changed , refreshed integer ( int64 ) :: rate , t_last_rescan , t_now real :: dt if ( self % cfg % w % once ) return call system_clock ( count_rate = rate ) if ( rate <= 0_int64 ) rate = 1000_int64 call system_clock ( t_last_rescan ) do if ( termination_requested ()) exit if ( exists ( \".fpm-watch.stop\" )) exit call sleep_seconds ( self % cfg % w % poll ) if ( termination_requested ()) exit if ( exists ( \".fpm-watch.stop\" )) exit call scan_changes ( self % files , self % fp_prev , self % fp_now , self % changed_idx , changed_count ) if ( changed_count > 0 ) then call sleep_seconds ( self % cfg % w % debounce ) if ( termination_requested ()) exit if ( exists ( \".fpm-watch.stop\" )) exit call scan_changes ( self % files , self % fp_prev , self % fp_now , self % changed_idx , changed_count ) end if if ( changed_count > 0 ) then if ( self % manifest_refresh_pending . or . & any_manifest_changed ( self % files , self % changed_idx , changed_count )) then call handle_manifest_change ( self , refreshed ) if (. not . refreshed ) then call accept_changes ( self % fp_prev , self % fp_now , self % changed_idx , changed_count ) end if cycle end if allocate ( changed ( changed_count )) do j = 1 , changed_count idx = self % changed_idx ( j ) if ( idx >= 1 . and . idx <= size ( self % files )) then changed ( j )% s = self % files ( idx )% s else changed ( j )% s = \"\" end if end do call self % fm % on_change_detected_all ( changed ) call report_changes ( self % files , self % changed_idx , changed_count , self % cfg % w ) cmd = build_run_command ( & settings = self % cfg % settings , & full_cmdline = self % cfg % fpm_cmdline , & cmd_prefix = self % cfg % cmd_prefix , & cmd_rest = self % cfg % cmd_rest , & roots = self % roots , & file_mask = self % file_mask , & changed_idx = self % changed_idx , & changed_count = changed_count ) call run_once ( self , cmd ) call accept_changes ( self % fp_prev , self % fp_now , self % changed_idx , changed_count ) deallocate ( changed ) if ( termination_requested ()) exit end if if ( self % cfg % w % rescan > 0.0 ) then call system_clock ( t_now ) if ( t_now < t_last_rescan ) then t_last_rescan = t_now else dt = real ( t_now - t_last_rescan ) / real ( rate ) if ( dt >= self % cfg % w % rescan ) then call log_event ( \"info\" , \"watch.rescan\" , \"Rescanning watch list\" , verbosity = 1 ) if ( self % manifest_refresh_pending ) then call handle_manifest_change ( self , refreshed ) else call rebuild_watch_list ( self , print_header = . false ., watch_changed = rescan_changed ) if ( rescan_changed ) call run_once ( self , self % cfg % fpm_cmdline ) end if call system_clock ( t_last_rescan ) end if end if end if end do if ( termination_requested ()) then call log_event ( \"info\" , \"watch.stopped\" , \"Stopped watching\" , [ log_string ( \"reason\" , \"interrupt\" )]) else call log_event ( \"info\" , \"watch.stopped\" , \"Stopped watching\" , [ log_string ( \"reason\" , \"stop_file\" )]) end if end subroutine watcher_run !> Reparse settings, refresh the graph, and run after a manifest change. !! !! Pin the current log format. On refresh failure restore the accepted !! configuration and leave a retry pending. On success update waiting mode, !! notify plugins if the manifest/settings key changed, and run the full !! command. `refreshed` reports graph-refresh success, not command success. subroutine handle_manifest_change ( self , refreshed ) class ( watcher_t ), intent ( inout ) :: self logical , intent ( out ) :: refreshed integer ( int64 ) :: man_old type ( watch_config_t ) :: old_cfg man_old = self % man_prev old_cfg = self % cfg if (. not . self % manifest_refresh_pending ) then call log_event ( \"info\" , \"watch.manifest_changed\" , \"Manifest changed; refreshing watch list\" ) end if self % manifest_refresh_pending = . true . call parse_cli_config ( self % cfg , log_format = old_cfg % w % log_format ) call rebuild_watch_list ( self , print_header = . false ., refreshed = refreshed ) if (. not . refreshed ) then self % cfg = old_cfg call configure_logging ( self % cfg % w ) return end if if ( self % man_prev /= man_old ) call self % fm % on_manifest_changed_all ( man_old , self % man_prev ) self % manifest_refresh_pending = . false . call set_low_cpu ( self % cfg % w % low_cpu ) call run_once ( self , self % cfg % fpm_cmdline ) end subroutine handle_manifest_change !> Return whether the changed set contains `fpm.toml`. !! !! This detection is based on the basename only and therefore triggers if !! any watched file named `fpm.toml` changes (main or dependency manifests). logical function any_manifest_changed ( files , changed_idx , changed_count ) result ( hit ) type ( string_t ), allocatable , intent ( in ) :: files (:) integer , intent ( in ) :: changed_idx (:) integer , intent ( in ) :: changed_count integer :: j , idx character ( len = :), allocatable :: b hit = . false . if (. not . allocated ( files )) return do j = 1 , changed_count idx = changed_idx ( j ) if ( idx < 1 . or . idx > size ( files )) cycle b = basename ( files ( idx )% s ) if ( b == \"fpm.toml\" ) then hit = . true . return end if end do end function any_manifest_changed !> Execute one command cycle with before/after plugin callbacks. !! !! Plugins may modify the local copy of `cmd0` before execution. Store the !! resulting exit status in `self%last_exit`; command failure does not stop !! the engine. Used for startup, edits, manifest refreshes, and rescans. subroutine run_once ( self , cmd0 ) class ( watcher_t ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: cmd0 character ( len = :), allocatable :: cmd integer :: exitstat real :: secs cmd = trim ( cmd0 ) call self % fm % on_before_run_all ( cmd ) call run_command_and_report ( cmd , self % cfg % w , exitstat , secs ) self % last_exit = exitstat call self % fm % on_after_run_all ( exitstat , secs ) end subroutine run_once !> Build a candidate graph and replace the accepted watch-list snapshot. !! !! `print_header` selects initialization: failures exit with status 1, and !! success prints startup details. Later failures preserve files, masks, roots, !! fingerprints, and accepted model settings; identical diagnostics are suppressed. !! `refreshed` is true only after success. If requested, `watch_changed` compares !! paths and fingerprints with the old snapshot before resetting the baseline. !! Recompute the manifest/settings key after the watch-list plugin callback. subroutine rebuild_watch_list ( self , print_header , watch_changed , refreshed ) class ( watcher_t ), intent ( inout ) :: self logical , intent ( in ) :: print_header !! True for initial setup (fatal errors and startup logging); false for recoverable refreshes. logical , intent ( out ), optional :: watch_changed !! True on a successful refresh if paths or fingerprints differ from the previous snapshot. logical , intent ( out ), optional :: refreshed !! True only after the candidate graph and new fingerprint baseline are accepted. integer ( int64 ) :: rate , t0 , t1 , candidate_manifest_key real :: build_secs_total real :: secs_model , secs_targets , secs_watch integer :: nfiles , nroots real :: dummy_build type ( string_t ), allocatable :: new_files (:) integer ( int64 ), allocatable :: new_mask (:) type ( root_info_t ), allocatable :: new_roots (:) type ( string_t ), allocatable :: old_files (:) integer ( int64 ), allocatable :: old_fp (:) type ( watch_config_t ) :: candidate_cfg type ( error_t ), allocatable :: error if ( present ( watch_changed )) watch_changed = . false . if ( present ( refreshed )) refreshed = . false . candidate_cfg = self % cfg if ( present ( watch_changed )) then if ( allocated ( self % files )) old_files = self % files if ( allocated ( self % fp_prev )) old_fp = self % fp_prev end if call system_clock ( count_rate = rate ) if ( rate <= 0_int64 ) rate = 1000_int64 call system_clock ( t0 ) call compute_watch_files_from_settings ( & settings = candidate_cfg % settings , & w = self % cfg % w , & files = new_files , & file_mask = new_mask , & roots = new_roots , & manifest_key = candidate_manifest_key , & build_secs = dummy_build , & secs_model = secs_model , & secs_targets = secs_targets , & secs_watch = secs_watch , & error = error ) if ( allocated ( error )) then if ( print_header ) then call log_event ( \"error\" , \"watch.init_failed\" , \"Cannot initialize watch list: \" // error % message ) stop 1 end if if ( allocated ( self % last_refresh_error )) then if ( self % last_refresh_error == error % message ) return end if self % last_refresh_error = error % message call log_event ( \"error\" , \"watch.refresh_failed\" , \"Watch list refresh failed: \" // error % message // \"; waiting for edits\" ) return end if if ( allocated ( self % last_refresh_error )) deallocate ( self % last_refresh_error ) call move_alloc ( candidate_cfg % settings , self % cfg % settings ) call move_alloc ( new_files , self % files ) call move_alloc ( new_mask , self % file_mask ) call move_alloc ( new_roots , self % roots ) call self % fm % on_watch_list_built_all ( self % files , self % roots ) self % man_prev = manifest_key_from_files ( self % cfg % settings , self % files ) call init_fingerprints ( self % files , self % fp_prev , self % fp_now , self % changed_idx ) if ( present ( watch_changed )) then watch_changed = watch_state_changed ( old_files , old_fp , self % files , self % fp_prev ) end if if ( present ( refreshed )) refreshed = . true . call system_clock ( t1 ) build_secs_total = real ( t1 - t0 ) / real ( rate ) nfiles = 0 if ( allocated ( self % files )) nfiles = size ( self % files ) nroots = 0 if ( allocated ( self % roots )) nroots = size ( self % roots ) if ( self % cfg % w % debug ) then call log_event ( \"debug\" , \"watch.fingerprint\" , \"Watch graph fingerprint updated\" , & [ log_int ( \"manifest_key\" , self % man_prev ), log_int ( \"root_count\" , nroots ), log_int ( \"file_count\" , nfiles )]) end if if ( print_header ) then call print_banner ( & full_cmdline = self % cfg % fpm_cmdline , & settings = self % cfg % settings , & w = self % cfg % w , & files = self % files , & build_secs = build_secs_total , & roots_count = nroots , & secs_model = secs_model , & secs_targets = secs_targets , & secs_watch = secs_watch ) if ( self % cfg % w % print_files_once ) call print_file_list ( self % files , self % cfg % w ) else call print_configuration ( self % cfg % settings , self % cfg % w ) call log_event ( \"info\" , \"watch.refreshed\" , \"Watch list updated; \" // str ( nfiles ) // \" files\" , & [ log_int ( \"file_count\" , nfiles ), log_real ( \"duration_ms\" , build_secs_total * 100 0.0 )], verbosity = 1 ) if ( self % cfg % w % verbosity >= 2 ) call print_file_list ( self % files , self % cfg % w ) end if end subroutine rebuild_watch_list end module watch_engine","tags":"","url":"sourcefile/watch_engine.f90.html"},{"title":"watch_util.f90 – fpm-watch","text":"Files dependent on this one sourcefile~~watch_util.f90~~AfferentGraph sourcef