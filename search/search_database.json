ic  subroutine run_command_and_report (cmd, w, exitstat, secs) Execute synchronously and report start, completion, exit status, and seconds. Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: cmd Complete serialized command to execute synchronously. type( watch_opts_t ), intent(in) :: w Output suppression, cycle generation, and optional output-marker settings. integer, intent(out) :: exitstat Command status, including 127 when the platform wrapper cannot launch or wait. real, intent(out) :: secs Elapsed command time in seconds, excluding event formatting and boundary writes. private  subroutine output_boundary (state, cycle_id, enabled) Flush a stderr boundary marker when the structured output protocol is enabled. Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: state character(len=*), intent(in) :: cycle_id logical, intent(in) :: enabled","tags":"","url":"module/watch_exec.html"},{"title":"watch_platform – fpm-watch","text":"Portable synchronous process execution and stdout redirection. C wrappers launch commands, forward user interrupts, and redirect raw fpm\nlibrary output. An interrupt received while waiting for a command latches stop_requested ; ordinary nonzero child exits do not. OS detection uses fpm_environment:get_os_type . Uses fpm_environment iso_fortran_env iso_c_binding watch_log module~~watch_platform~~UsesGraph module~watch_platform watch_platform fpm_environment fpm_environment module~watch_platform->fpm_environment iso_c_binding iso_c_binding module~watch_platform->iso_c_binding iso_fortran_env iso_fortran_env module~watch_platform->iso_fortran_env module~watch_log watch_log module~watch_platform->module~watch_log module~watch_log->iso_fortran_env fpm_strings fpm_strings module~watch_log->fpm_strings module~watch_types watch_types module~watch_log->module~watch_types module~watch_util watch_util module~watch_log->module~watch_util module~watch_types->iso_fortran_env mod