4 ), allocatable :: new_mask (:) type ( root_info_t ), allocatable :: new_roots (:) type ( string_t ), allocatable :: old_files (:) integer ( int64 ), allocatable :: old_fp (:) type ( watch_config_t ) :: candidate_cfg type ( error_t ), allocatable :: error if ( present ( watch_changed )) watch_changed = . false . if ( present ( refreshed )) refreshed = . false . if ( present ( selection_changed )) selection_changed = . true . candidate_cfg = self % cfg preserve = . false . if ( present ( preserve_baseline )) preserve = preserve_baseline if ( present ( watch_changed ) . or . preserve ) then if ( allocated ( self % snapshot % files )) old_files = self % snapshot % files if ( allocated ( self % snapshot % fp_prev )) old_fp = self % snapshot % fp_prev end if call system_clock ( count_rate = rate ) if ( rate <= 0_int64 ) rate = 1000_int64 call system_clock ( t0 ) call get_current_directory ( original_directory , error ) if (. not . allocated ( error )) then call compute_watch_snapshot ( & cfg = candidate_cfg , & files = new_files , & file_mask = new_mask , & roots = new_roots , & manifest_key = candidate_manifest_key , & build_secs = dummy_build , & secs_model = secs_model , & secs_targets = secs_targets , & secs_watch = secs_watch , & error = error ) end if if ( termination_requested ()) return if (. not . allocated ( error )) then if ( canon_path ( original_directory ) /= canon_path ( self % cfg % project_dir )) then do i = 1 , size ( new_files ) if ( is_absolute_path ( new_files ( i )% s )) cycle new_files ( i )% s = canon_path ( join_path ( self % cfg % project_dir , new_files ( i )% s )) end do end if end if if ( allocated ( error )) then if ( print_header ) then call log_event ( \"error\" , \"watch.init_failed\" , \"Cannot initialize watch list: \" // error % message ) stop 1 end if call report_refresh_error ( self , error % message ) return end if if ( allocated ( self % last_refresh_error )) deallocate ( self % last_refresh_error ) if ( present ( selection_changed )) then selection_changed = watch_state_changed ( self % snapshot % files , self % snapshot % file_mask , new_files , new_mask ) if (. not . selection_changed ) selection_changed = root_mapping_changed ( self % snapshot % roots , new_roots ) end if call move_alloc ( candidate_cfg % settings , self % cfg % settings ) call move_alloc ( new_files , self % snapshot % files ) call move_alloc ( new_mask , self % snapshot % file_mask ) call move_alloc ( new_roots , self % snapshot % roots ) self % man_prev = manifest_key_from_files ( self % cfg % settings , self % snapshot % files ) call init_fingerprints ( self % snapshot % files , self % snapshot % fp_prev , self % snapshot % fp_now , self % snapshot % changed_idx ) if ( preserve ) call preserve_fingerprints ( old_files , old_fp , self % snapshot % files , self % snapshot % fp_prev ) if ( present ( watch_changed )) then watch_changed = watch_state_changed ( old_files , old_fp , self % snapshot % files , self % snapshot % fp_prev ) end if if ( present ( refreshed )) refreshed = . true . call system_clock ( t1 ) build_secs_total = real ( t1 - t0 ) / real ( rate ) nfiles = 0 if ( allocated ( self % snapshot % files )) nfiles = size ( self % snapshot % files ) nroots = 0 if ( allocated ( self % snapshot % roots )) nroots = size ( self % snapshot % roots ) if ( self % cfg % w % debug ) then call log_event ( \"debug\" , \"watch.fingerprint\" , \"Watch graph fingerprint updated\" , & [ log_int ( \"manifest_key\" , self % man_prev ), log_int ( \"root_count\" , nroots ), log_int ( \"file_count\" , nfiles )]) end if if ( print_header ) then call print_banner ( & full_cmdline = self % cfg % fpm_cmdline , & settings = self % cfg % settings , & w = self % cfg % w , & files = self % snapshot % files , & build_secs = build_secs_total , & roots_count = nroots , & secs_model = secs_model , & secs_targets = secs_targets , & secs_watch = secs_watch ) if ( self % cfg % w % print_files_once ) call print_file_list ( self % snapshot % files , self % cfg % w ) else call print_configuration ( self % cfg % settings , self % cfg % w ) call log_event ( \"info\" , \"watch.refreshed\" , \"Watch list updated; \" // str ( nfiles ) // \" files\" , & [ log_int ( \"file_count\" , nfiles ), log_real ( \"duration_ms\" , build_secs_total * 100 0.0 )], verbosity = 1 ) if ( self % cfg % w % verbosity >= 2 ) call print_file_list ( self % snapshot % files , self % cfg % w ) end if end subroutine rebuild_watch_list","tags":"","url":"proc/rebuild_watch_list.html"},{"title":"report_refresh_error – fpm-watch","text":"private  subroutine report_refresh_error(self, message) Keep one actionable refresh diagnostic while retaining the accepted snapshot. Arguments Type Intent Optional Attributes Name class( watcher_t ), intent(inout) :: self character(len=*), intent(in) :: message Calls proc~~report_refresh_error~~CallsGraph proc~report_refresh_error report_refresh_error proc~log_event log_event proc~report_refresh_error->proc~log_event proc~format_log_record format_log_record proc~log_event->proc~format_log_record proc~log_timestamp log_timestamp proc~log_event->proc~log_timestamp proc~escape_text escape_text proc~format_log_record->proc~escape_text proc~escaped_length escaped_length proc~format_log_record->proc~escaped_length proc~json_quote json_quote proc~format_log_record->proc~json_quote proc~put_json_string put_json_string proc~format_log_record->proc~put_json_string proc~put_text put_text proc~format_log_record->proc~put_text proc~escape_text->proc~escaped_length proc~put_escaped put_escaped proc~escape_text->proc~put_escaped proc~escape_piece escape_piece proc~escaped_length->proc~escape_piece proc~json_quote->proc~escaped_length proc~json_quote->proc~put_json_string proc~put_json_string->proc~put_text proc~put_json_string->proc~put_escaped proc~utf8_width utf8_width proc~escape_piece->proc~utf8_width proc~put_escaped->proc~put_text proc~put_escaped->proc~escape_piece Help Graph Key Nodes of different colours represent th