e Initial real, public :: debounce = 0.2 Seconds to wait after detecting a change before resampling. logical, public :: debug = .false. Enable debug-level records; quiet mode still suppresses them. type(string_t), public, allocatable :: enabled_features (:) Watcher-plugin names, distinct from fpm build features. character(len=:), public, allocatable :: fpm_executable Executable used for build/test/run; defaults to fpm on PATH. type(string_t), public, allocatable :: ignore (:) Ignore globs, applied after include rules; watched manifests bypass filtering. type(string_t), public, allocatable :: include (:) Include globs; empty means all eligible files. Watched manifests always remain. character(len=:), public, allocatable :: log_format Output format: text (default), json (JSON Lines), or logfmt. logical, public :: low_cpu = .false. Use OS sleep for waiting to minimize idle CPU usage. logical, public :: once = .false. Run once (init + optional run-on-start) and exit (CI-friendly). logical, public :: output_markers = .false. Bracket command stderr and force cycle events in structured logging only. real, public :: poll = 0.5 Seconds between polling scans; normalized to at least 0.05. logical, public :: print_files_once = .false. Request a startup file list; the logger additionally requires verbosity 2. real, public :: rescan = 0.0 Optional periodic rescan interval (seconds). 0 disables periodic rescans. integer, public :: restart_count = 0 Internal supervisor generation, retained during manifest refresh. logical, public :: run_on_start = .true. Run the command once immediately on startup. logical, public :: silent_fpm = .false. Suppress both command output streams; watcher and model records remain separate. integer, public :: verbosity = 0 Verbosity level: -1 : quiet (errors and enabled output protocol) 0 : normal 1..2 : more detail logical, public :: watch_deps = .false. Also watch dependency project sources (can include paths under build dir). Source Code type watch_opts_t !> Verbosity level: !! !! - `-1`: quiet (errors and enabled output protocol) !! - `0`: normal !! - `1..2`: more detail integer :: verbosity = 0 !> Output format: text (default), json (JSON Lines), or logfmt. character ( len = :), allocatable :: log_format !> Executable used for build/test/run; defaults to `fpm` on PATH. character ( len = :), allocatable :: fpm_executable !> Enable debug-level records; quiet mode still suppresses them. logical :: debug = . false . !> Seconds between polling scans; normalized to at least 0.05. real :: poll = 0.5 !> Seconds to wait after detecting a change before resampling. real :: debounce = 0.2 !> Optional periodic rescan interval (seconds). `0` disables periodic rescans. real :: rescan = 0.0 !> Run the command once immediately on startup. logical :: run_on_start = . true . !> Request a startup file list; the logger additionally requires verbosity 2. logical :: print_files_once = . false . !> Suppress both command output streams; watcher and model records remain separate. logical :: silent_fpm = . false . !> Bracket command stderr and force cycle events in structured logging only. logical :: output_markers = . false . !> Internal supervisor generation, retained during manifest refresh. integer :: restart_count = 0 !> Also watch dependency project sources (can include paths under build dir). logical :: watch_deps = . false . !> Use OS sleep for waiting to minimize idle CPU usage. logical :: low_cpu = . false . !> Ignore globs, applied after include rules; watched manifests bypass filtering. type ( string_t ), allocatable :: ignore (:) !> Include globs; empty means all eligible files. Watched manifests always remain. type ( string_t ), allocatable :: include (:) !> Watcher-plugin names, distinct from fpm build features. type ( string_t ), allocatable :: enabled_features (:) !> Run once (init + optional run-on-start) and exit (CI-friendly). logical :: once = . false . end type watch_opts_t","tags":"","url":"type/watch_opts_t.html"}