 self % manifest_refresh_pending ) then call log_event ( \"info\" , \"watch.manifest_changed\" , \"Configuration changed; refreshing watch list\" ) end if self % manifest_refresh_pending = . true . call parse_cli_config ( self % cfg , log_format = old_cfg % w % log_format , error = error ) if ( allocated ( error )) then self % cfg = old_cfg call configure_logging ( self % cfg % w ) call report_refresh_error ( self , error % message ) return end if call rebuild_watch_list ( self , print_header = . false ., refreshed = refreshed , preserve_baseline = . true .) if (. not . refreshed ) then self % cfg = old_cfg call configure_logging ( self % cfg % w ) return end if self % manifest_refresh_pending = . false . call run_once ( self , self % cfg % fpm_cmdline ) end subroutine handle_manifest_change","tags":"","url":"proc/handle_manifest_change.html"},{"title":"rebuild_watch_list – fpm-watch","text":"private  subroutine rebuild_watch_list(self, print_header, watch_changed, refreshed, preserve_baseline, selection_changed) Build a candidate graph and replace the accepted watch-list snapshot. print_header selects initialization: failures exit with status 1, and\nsuccess prints startup details. Later failures preserve files, masks, roots,\nfingerprints, and accepted model settings; identical diagnostics are suppressed. refreshed is true only after success. If requested, watch_changed compares\npaths and fingerprints with the old snapshot before resetting the baseline.\nA source-triggered refresh preserves baselines so concurrent edits remain pending. Arguments Type Intent Optional Attributes Name class( watcher_t ), intent(inout) :: self logical, intent(in) :: print_header True for initial setup (fatal errors and startup logging); false for recoverable refreshes. logical, intent(out), optional :: watch_changed True on a successful refresh if paths or fingerprints differ from the previous snapshot. logical, intent(out), optional :: refreshed True only after the candidate graph and new fingerprint baseline are accepted. logical, intent(in), optional :: preserve_baseline Preserve accepted baselines for existing paths while initializing new paths. logical, intent(out), optional :: selection_changed True unless paths, root bits, and root names match the accepted selection mapping. Calls proc~~rebuild_watch_list~~CallsGraph proc~rebuild_watch_list rebuild_watch_list canon_path canon_path proc~rebuild_watch_list->canon_path get_current_directory get_current_directory proc~rebuild_watch_list->get_current_directory interface~log_int log_int proc~rebuild_watch_list->interface~log_int is_absolute_path is_absolute_path proc~rebuild_watch_list->is_absolute_path join_path join_path proc~rebuild_watch_list->join_path proc~compute_watch_snapshot compute_watch_snapshot proc~rebuild_watch_list->proc~compute_watch_snapshot proc~init_fingerprints init_fingerprints proc~rebuild_watch_list->proc~init_fingerprints proc~log_event log_event proc~rebuild_watch_list->proc~log_event proc~log_real log_real proc~rebuild_watch_list->proc~log_real proc~manifest_key_from_files manifest_key_from_files proc~rebuild_watch_list->proc~manifest_key_from_files proc~preserve_fingerprints preserve_fingerprints proc~rebuild_watch_list->proc~preserve_fingerprints proc~print_banner print_banner proc~rebuild_watch_list->proc~print_banner proc~print_configuration print_configuration proc~rebuild_watch_list->proc~print_configuration proc~print_file_list print_file_list proc~rebuild_watch_list->proc~print_file_list proc~report_refresh_error report_refresh_error proc~rebuild_watch_list->proc~report_refresh_error proc~root_mapping_changed root_mapping_changed proc~rebuild_watch_list->proc~root_mapping_changed proc~termination_requested termination_requested proc~rebuild_watch_list->proc~termination_requested proc~watch_state_changed watch_state_changed proc~rebuild_watch_list->proc~watch_state_changed str str proc~rebuild_watch_list->str proc~log_default_int log_default_int interface~log_