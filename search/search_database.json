 are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine execute_command ( cmd , exitstat , interrupted , silent , stderr , inherit_workspace ) character ( len =* ), intent ( in ) :: cmd !! Serialized command; caller is responsible for quoting individual argv tokens. integer , intent ( out ) :: exitstat !! Child/interrupt status, or 127 with a launch-failure event for OS execution errors. logical , intent ( out ), optional :: interrupted !! True if the wrapper handled a user interrupt during this command. logical , intent ( in ), optional :: silent !! Suppress both command output streams (default false); takes precedence over stderr. logical , intent ( in ), optional :: stderr !! Redirect command stdout to stderr (default false). logical , intent ( in ), optional :: inherit_workspace !! Keep supervisor workspace ownership for internal watcher/graph launches (default true). !! External commands clear that internal setting so surviving descendants own their workspaces. integer ( c_int ) :: status , was_interrupted , launch_error , silent_mode character ( len = :), allocatable :: effective_cmd , inherited_root logical :: isolate_workspace , root_defined integer :: environment_status type ( error_t ), allocatable :: error , restore_error silent_mode = 0_c_int if ( present ( stderr )) then if ( stderr ) silent_mode = 2_c_int end if if ( present ( silent )) then if ( silent ) silent_mode = 1_c_int end if effective_cmd = trim ( cmd ) if (. not . is_windows ()) then if ( silent_mode == 1_c_int ) effective_cmd = effective_cmd // \" >/dev/null 2>&1\" if ( silent_mode == 2_c_int ) effective_cmd = effective_cmd // \" 1>&2\" end if isolate_workspace = . false . if ( present ( inherit_workspace )) isolate_workspace = . not . inherit_workspace if ( present ( interrupted )) interrupted = . false . if ( isolate_workspace ) then inherited_root = get_env ( \"FPM_WATCH_WORKSPACE_ROOT\" ) call get_environment_variable ( \"FPM_WATCH_WORKSPACE_ROOT\" , status = environment_status ) root_defined = environment_status == 0 call set_workspace_root ( \"\" , error ) if ( allocated ( error )) then call set_workspace_root ( inherited_root , restore_error , defined = root_defined ) call log_event ( \"error\" , \"command.workspace_failed\" , error % message ) exitstat = 127 return end if end if status = fpm_watch_execute ( effective_cmd // c_null_char , silent_mode , was_interrupted , launch_error ) stop_requested = stop_requested . or . was_interrupted /= 0_c_int if ( present ( interrupted )) interrupted = was_interrupted /= 0_c_int if ( isolate_workspace ) then call set_workspace_root ( inherited_root , error , defined = root_defined ) if ( allocated ( error )) then call log_event ( \"error\" , \"command.workspace_failed\" , error % message ) exitstat = 127 return end if end if if ( launch_error /= 0_c_int ) then call log_event ( \"error\" , \"command.launch_failed\" , \"Cannot execute command: \" // trim ( cmd ), & [ log_int ( \"os_error\" , int ( launch_error )), log_string ( \"command\" , trim ( cmd ))]) exitstat = 127 else exitstat = int ( status ) end if end subroutine execute_command","tags":"","url":"proc/execute_command.html"},{"title":"remove_temp_directory – fpm-watch","text":"public  subroutine remove_temp_directory(path) Remove a workspace and its contents without following links, tolerating repeated cleanup. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: path Calls proc~~remove_temp_directory~~CallsGraph proc~remove_temp_directory remove_temp_directory interface~fpm_watch_remove_temp_directory fpm_watch_remove_temp_directory proc~remove_temp_directory->interface~fpm_watch_remove_temp_directory interface~log_int log_int proc~remove_temp_directory->interface~log_int proc~log_event log_event proc~remove_temp_directory->proc~log_event proc~log_string log_string proc~remove_temp_directory->proc~log_string proc~log_default_int log_default_int interface~log_int->proc~log_