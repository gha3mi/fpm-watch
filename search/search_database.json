unction Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code function project_directory ( first_arg , response_mode ) result ( directory ) integer , intent ( in ) :: first_arg logical , intent ( in ) :: response_mode character ( len = :), allocatable :: directory , base , arg , key , selected type ( error_t ), allocatable :: error integer :: i , narg , eq call get_current_directory ( base , error ) if ( allocated ( error )) call usage_and_stop ( error % message ) directory = base selected = \"\" if ( response_mode ) then selected = sget ( \"directory\" ) else narg = command_argument_count () i = subcommand_position ( first_arg ) + 1 do while ( i <= narg ) arg = get_arg ( i ) if ( arg == \"--\" ) exit key = arg eq = index ( arg , \"=\" ) if ( eq > 0 ) key = arg (: eq - 1 ) if ( key == \"--directory\" . or . key == \"-C\" ) then if ( eq > 0 ) then selected = arg ( eq + 1 :) else if ( i == narg ) exit i = i + 1 selected = get_arg ( i ) end if else if ( fpm_option_takes_value ( key ) . and . eq == 0 ) then i = i + 1 end if i = i + 1 end do end if if ( len_trim ( selected ) == 0 ) return if ( is_absolute_path ( selected )) then directory = canon_path ( selected ) else directory = canon_path ( join_path ( base , selected )) end if end function project_directory","tags":"","url":"proc/project_directory.html"},{"title":"subcommand_position – fpm-watch","text":"private  function subcommand_position(first_arg) result(position) Locate the original subc