de subroutine write_graph_response ( path , files , file_mask , roots , manifest_key , timings , graph_error , error ) character ( len =* ), intent ( in ) :: path type ( string_t ), allocatable , intent ( in ) :: files (:) integer ( int64 ), allocatable , intent ( in ) :: file_mask (:) type ( root_info_t ), allocatable , intent ( in ) :: roots (:) integer ( int64 ), intent ( in ) :: manifest_key real , intent ( in ) :: timings ( 4 ) type ( error_t ), allocatable , intent ( in ) :: graph_error type ( error_t ), allocatable , intent ( out ) :: error type ( toml_table ) :: table type ( toml_array ), pointer :: array type ( toml_error ), allocatable :: serialization_error integer :: i , unit , status , close_status character ( len = 512 ) :: message call new_table ( table ) call set_value ( table , \"version\" , RESPONSE_VERSION ) call set_value ( table , \"success\" , . not . allocated ( graph_error )) if ( allocated ( graph_error )) then call set_value ( table , \"error\" , encode_bytes ( graph_error % message )) else call set_value ( table , \"manifest-key\" , manifest_key ) call add_array ( table , \"files\" , array ) do i = 1 , size ( files ) call set_value ( array , i , encode_bytes ( files ( i )% s )) end do call add_array ( table , \"file-masks\" , array ) do i = 1 , size ( file_mask ) call set_value ( array , i , file_mask ( i )) end do call add_array ( table , \"root-names\" , array ) do i = 1 , size ( roots ) call set_value ( array , i , encode_bytes ( roots ( i )% name )) end do call add_array ( table , \"root-masks\" , array ) do i = 1 , size ( roots ) call set_value ( array , i , roots ( i )% mask ) end do call add_array ( table , \"timings\" , array ) do i = 1 , size ( timings ) call set_value ( array , i , timings ( i )) end do end if open ( newunit = unit , file = path , status = \"new\" , action = \"write\" , iostat = status , iomsg = message ) if ( status /= 0 ) then call fatal_error ( error , \"Cannot write watch graph response: \" // trim ( message )) return end if call toml_dump ( table , unit , serialization_error ) close ( unit , iostat = close_status , iomsg = message ) if ( allocated ( serialization_error )) then call fatal_error ( error , \"Cannot serialize watch graph response: \" // serialization_error % message ) else if ( close_status /= 0 ) then call fatal_error ( error , \"Cannot close watch graph response: \" // trim ( message )) end if end subroutine write_graph_response","tags":"","url":"proc/write_graph_response.html"},{"title":"build_run_command – fpm-watch","text":"public  function build_run_command(settings, full_cmdline, cmd_prefix, cmd_rest, roots, file_mask, changed_idx, changed_count) result(cmd) Uses watch_cmdsplice proc~~build_run_command~~UsesGraph proc~build_run_command build_run_command module~watch_cmdsplice watch_cmdsplice proc~build_run_command->module~watch_cmdsplice module~watch_cmdline watch_cmdline module~watch_cmdsplice->module~watch_cmdline ieee_arithmetic ieee_arithmetic module~watch_cmdline->ieee_arithmetic module~watch_platform watch_platform module~watch_cmdline->module~watch_platform module~watch_util watch_util module~watch_cmdline->module~watch_util fpm_environment fpm_environment module~watch_platform->fpm_environment fpm_error fpm_error module~watch_platform->fpm_error iso_c_binding iso_c_binding module~watch_platform->iso_c_binding iso_fortran_env iso_fortran_env module~watch_platform->iso_fortran_env module~watch_log watch_log module~watch_platform->module~watch_log fpm_strings fpm_strings module~watch_util->fpm_strings module~watch_log->module~watch_util module~watch_log->fpm_strings module~watch_log->iso_fortran_env module~watch_types watch_types module~watch_log->module~watch_types module~watch_types->fpm_strings module~watch_types->iso_fortran_env fpm_command_line fpm_command_line module~watch_types->fpm_command_line Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Inject affected root names into an unpinned run/test command. changed_idx(:changed_count) indexes file_mask , whose bits correspond\nto roots . Combine those bits and quote the matching root names before\nthe program-argument -- delimiter. Return full_cmdline unchanged for\nbuild mode, explicit target patterns, unavailable masks/roots, a changed\nzero-mask file (global metadata), no matched names, or an empty prefix. Arguments Type Intent Optional Attributes Name class(fpm_build_settings), intent(in) :: settings Run/test type and explicit target patterns used to decide whether injection is allowed. character(len=*), intent(in) :: full_cmdline Complete serialized command, returned when no target injection is possible. character(len=*), intent(in) :: cmd_prefix Serialized executable/subcommand prefix for the replacement command. character(len=*), intent(in) :: cmd_rest Serialized forwarded fpm/program arguments after the subcommand. type( root_info_t ), intent(in), allocatable :: roots (:) Root executable names and their single-bit membership masks. integer(kind=int64), intent(in), allocatable :: file_mask (:) Root bits per watched file, indexed by changed_idx. integer, intent(in) :: changed_idx (:) 1-based file indices; only the first changed_count entries are read. integer, intent(in) :: changed_count Number of changed indices in the active buffer prefix. Return Value character(len=:), allocatable Calls proc~~build_run_command~~CallsGraph proc~build_run_command build_run_command proc~inject_names_into_cmd inject_names_into_cmd proc~build_run_command->proc~inject_names_into_cmd proc~quote_arg quote_arg proc~build_run_command->pro