li_config->proc~prepare_response_options proc~handle_manifest_change handle_manifest_change proc~handle_manifest_change->proc~parse_cli_config proc~watcher_run watcher_t%watcher_run proc~watcher_run->proc~handle_manifest_change Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine prepare_response_options ( first_arg , response_files , enabled , subcmd , error ) integer , intent ( in ) :: first_arg type ( string_t ), allocatable , intent ( out ) :: response_files (:) logical , intent ( out ) :: enabled character ( len = :), allocatable , intent ( out ) :: subcmd type ( error_t ), allocatable , intent ( out ) :: error character ( len = :), allocatable :: arg , key , prototype , message integer :: i , j , eq , position , status , key_count , selected integer ( c_int ) :: saved_output logical :: available , has_options , has_os_options type ( string_t ), allocatable :: candidates (:), watcher_keys (:) allocate ( response_files ( 0 )) enabled = . false . subcmd = \"\" position = subcommand_position ( first_arg ) i = position + 1 do while ( i <= command_argument_count ()) arg = get_arg ( i ) if ( arg == \"--\" ) exit eq = index ( arg , \"=\" ) key = arg if ( eq > 0 ) key = arg (: eq - 1 ) if ( starts_with ( arg , \"@\" )) then enabled = . true . else if ( fpm_option_takes_value ( key ) . and . eq == 0 ) then i = i + 1 end if i = i + 1 end do if (. not . enabled ) return ! get_subcommand inspects raw argv, including leading watcher values and ! tokens after --. Preflight every response it can see, not just fpm inputs. do i = 1 , command_argument_count () arg = get_arg ( i ) eq = index ( arg , \"=\" ) if (. not . starts_with ( arg , \"@\" ) . and . eq > 0 ) then key = arg (: eq - 1 ) if ( fpm_option_takes_value ( key ) . or . watch_option_takes_value ( key )) cycle arg = arg ( eq + 1 :) end if if (. not . starts_with ( arg , \"@\" )) cycle call response_candidates ( arg , candidates , error ) if ( allocated ( error )) return selected = 0 available = . false . do j = 1 , size ( candidates ) call push_feature ( response_files , candidates ( j )% s ) end do ! Upstream searches all directories for the current OS section first, ! then searches for the first ordinary file. Inspect record kinds only; ! M_CLI2 remains responsible for selecting and parsing the actual options. do j = 1 , size ( candidates ) if (. not . exists ( candidates ( j )% s )) cycle call inspect_response_candidate ( candidates ( j )% s , has_options , has_os_options , error ) if ( allocated ( error )) return if ( has_os_options ) then selected = j exit end if if (. not . available . and . has_options ) selected = j available = available . or . has_options end do if ( selected == 0 ) then call fatal_error ( error , \"Response \" // arg // \" needs a named options-only file; \" // & \"use NAME.rsp or @./path/file.rsp. Executable compound response files are unsupported.\" ) return end if call validate_response_records ( candidates ( selected )% s , has_options , error ) if ( allocated ( error )) return end do prototype = ' --directory:C \" \" --verbose F --profile \" \" --features \" \" --target \" \"' // & ' --build-dir \" \" --compiler \" \" --c-compiler \" \" --cxx-compiler \" \" --archiver \" \"' // & ' --flag:: \" \" --c-flag:: \" \" --cxx-flag:: \" \" --link-flag:: \" \"' // & ' --runner \" \" --runner-args \" \" --config-file \" \" --no-prune F --prune F' // & ' --tests F --example F --all F --list F --show-model F --dump \" \" -q F -v F -vv F' ! M_CLI2 reads process argv. Describe leading watcher/internal flags only so ! it consumes them without treating their values as fpm target patterns. allocate ( watcher_keys ( 0 )) do i = 1 , position - 1 arg = get_arg ( i ) if (. not . starts_with ( arg , \"--watch-\" )) cycle eq = index ( arg , \"=\" ) key = arg if ( eq > 0 ) key = arg (: eq - 1 ) key_count = size ( watcher_keys ) call push_feature ( watcher_keys , key ) if ( size ( watcher_keys ) == key_count ) cycle if ( watch_option_takes_value ( key ) . or . key == \"--watch-graph-worker\" ) then prototype = prototype // \" \" // key // ':: \" \"' else prototype = prototype // \" \" // key // \" F\" end if end do CLI_RESPONSE_FILE = . true . call begin_raw_output (. true ., saved_output ) subcmd = get_subcommand () if (. not . is_supported_subcmd ( subcmd )) then call end_raw_output ( saved_output ) call fatal_error ( error , \"Response options must declare a supported subcommand with options build, options test, or options run\" ) return end if call set_args ( prototype // \" --\" , ierr = status , errmsg = message ) call end_raw_output ( saved_output ) if ( status /= 0 ) call fatal_error ( error , \"Cannot parse fpm response options: \" // message ) end subroutine prepare_response_options","tags":"","url":"proc/prepare_response_options.html"},{"title":"read_response_options – fpm-watch","text":"private  subroutine read_response_options(profile, build_dir, compiler, c_compiler, cxx_compiler, archiver, flag, cflag, cxxflag, ldflag, runner, runner_args, config_file, features, names, prune, example, build_tests, subcmd, original_subcmd) Normalize upstream response getters into the ordinary typed-settings assembly. Arguments Type Intent Optional Attributes Name character(len=:), intent(inout), allocatable :: profile character(len=:), intent(inout), allocatable :: build_dir character(len=:), in